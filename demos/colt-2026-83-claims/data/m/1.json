[{"id":95,"name":"Learning.LinearBandit.IsPAC","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.LinearBandit","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"606d760113bae79c","local":"ddf03df98504c46e","content":"0b407adc70f9ac41"},"doc":"An identification algorithm (with actions in `𝒳`, real feedbacks and recommendations in\n`𝒳`) is `(ε, δ)`-PAC on `𝒳` if for every reward vector `θ`, run against the linear Gaussian\nenvironment `linearGaussianEnv 𝒳 θ`, its recommendation has simple regret more than `ε` with\nprobability at most `δ`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":true,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":true,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":true,"name":"ε","role":"variable","type":"ℝ"},{"explicit":true,"name":"δ","role":"variable","type":"ℝ"}],"conclusion":"Prop","decl":"Learning.LinearBandit.IsPAC","value":"A.IsPAC (linearGaussianEnv 𝒳) (fun θ x => ε < simpleRegret 𝒳 θ ↑x) δ"},"code":"/-- An identification algorithm (with actions in `𝒳`, real feedbacks and recommendations in\n`𝒳`) is `(ε, δ)`-PAC on `𝒳` if for every reward vector `θ`, run against the linear Gaussian\nenvironment `linearGaussianEnv 𝒳 θ`, its recommendation has simple regret more than `ε` with\nprobability at most `δ`. -/\ndef IsPAC (𝒳 : Set E) (A : IdentAlg Unit 𝒳 ℝ 𝒳) (ε δ : ℝ) : Prop :=\n  A.IsPAC (linearGaussianEnv 𝒳) (fun θ x ↦ ε < simpleRegret 𝒳 θ x) δ","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/LinearBandit.lean","start":75,"end":80,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L75-L80"},"deps":[97,101],"outside":[],"external":[["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LT.lt","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["Membership.mem","lean4","definition"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instLT","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"],["iSup","mathlib","definition"],["instHSub","lean4","instance"]],"users":[646,648,651,721,1214,1236],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":97,"name":"Learning.LinearBandit.linearGaussianEnv","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.LinearBandit","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"bd40525f06aa862a","local":"98b5d179bffc4657","content":"5a7ec6b02de78910"},"doc":"The linear Gaussian environment on the action set `𝒳` with reward vector `θ`: the stationary\nenvironment with reward kernel `linearGaussianKernel 𝒳 θ`.\n\nThe Markov-kernel argument of `stationaryEnv` is given inline rather than through the instance\nabove: the nested proof of an exposed `def` becomes a public auxiliary constant, whereas the proof\ninside an instance (a theorem) becomes a module-private one, which the standalone comparator\nchallenges (`comparator/`) could not reproduce. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":true,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":true,"name":"θ","role":"variable","type":"E"}],"conclusion":"Environment Unit ↑𝒳 ℝ","decl":"Learning.LinearBandit.linearGaussianEnv","value":"stationaryEnv (linearGaussianKernel 𝒳 θ)"},"code":"/-- The linear Gaussian environment on the action set `𝒳` with reward vector `θ`: the stationary\nenvironment with reward kernel `linearGaussianKernel 𝒳 θ`.\n\nThe Markov-kernel argument of `stationaryEnv` is given inline rather than through the instance\nabove: the nested proof of an exposed `def` becomes a public auxiliary constant, whereas the proof\ninside an instance (a theorem) becomes a module-private one, which the standalone comparator\nchallenges (`comparator/`) could not reproduce. -/\nnoncomputable def linearGaussianEnv (𝒳 : Set E) (θ : E) : Environment Unit 𝒳 ℝ :=\n  @stationaryEnv _ _ _ _ (linearGaussianKernel 𝒳 θ)\n    ⟨fun _ ↦ inferInstanceAs (IsProbabilityMeasure (gaussianReal _ 1))⟩","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/LinearBandit.lean","start":59,"end":68,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L59-L68"},"deps":[100],"outside":[],"external":[["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["Membership.mem","lean4","definition"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instRCLike","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"]],"users":[95,1040],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":100,"name":"Learning.LinearBandit.linearGaussianKernel","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.LinearBandit","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"fa7e3d6c9b233d2f","local":"af56a83e458dd57f","content":"3199b3bb5c949104"},"doc":"Reward kernel of the linear Gaussian bandit on `𝒳` with reward vector `θ`: playing `x` gives an\nobservation with law `N(⟪x, θ⟫, 1)`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":true,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":true,"name":"θ","role":"variable","type":"E"}],"conclusion":"ProbabilityTheory.Kernel ↑𝒳 ℝ","decl":"Learning.LinearBandit.linearGaussianKernel","value":"{ toFun := fun x => ProbabilityTheory.gaussianReal (inner ℝ (↑x) θ) 1, measurable' := ⋯ }"},"code":"/-- Reward kernel of the linear Gaussian bandit on `𝒳` with reward vector `θ`: playing `x` gives an\nobservation with law `N(⟪x, θ⟫, 1)`. -/\nnoncomputable def linearGaussianKernel (𝒳 : Set E) (θ : E) : Kernel 𝒳 ℝ where\n  toFun x := gaussianReal ⟪(x : E), θ⟫ 1\n  measurable' := by\n    change Measurable (gaussianReal.uncurry ∘ fun x : 𝒳 ↦ (⟪(x : E), θ⟫, (1 : ℝ≥0)))\n    exact measurable_gaussianReal.comp (by fun_prop)","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/LinearBandit.lean","start":48,"end":54,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L48-L54"},"deps":[],"outside":[],"external":[["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["MeasurableSpace","mathlib","class"],["Membership.mem","lean4","definition"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instRCLike","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"]],"users":[97],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":101,"name":"Learning.LinearBandit.simpleRegret","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.LinearBandit","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"6d655b1a0816b88c","local":"c2fe185acbb5ba4e","content":"f97fbf756af00015"},"doc":"Simple regret of the arm `x` for the reward vector `θ` on the action set `𝒳`:\n`sup_{y ∈ 𝒳} ⟪y, θ⟫ - ⟪x, θ⟫`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":true,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":true,"name":"θ","role":"variable","type":"E"},{"explicit":true,"name":"x","role":"variable","type":"E"}],"conclusion":"ℝ","decl":"Learning.LinearBandit.simpleRegret","value":"(⨆ y, inner ℝ (↑y) θ) - inner ℝ x θ"},"code":"/-- Simple regret of the arm `x` for the reward vector `θ` on the action set `𝒳`:\n`sup_{y ∈ 𝒳} ⟪y, θ⟫ - ⟪x, θ⟫`. -/\nnoncomputable def simpleRegret (𝒳 : Set E) (θ x : E) : ℝ :=\n  (⨆ y : 𝒳, ⟪(y : E), θ⟫) - ⟪x, θ⟫","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/LinearBandit.lean","start":70,"end":73,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L70-L73"},"deps":[],"outside":[],"external":[["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["Membership.mem","lean4","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Real","mathlib","structure"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["iSup","mathlib","definition"],["instHSub","lean4","instance"]],"users":[95],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"