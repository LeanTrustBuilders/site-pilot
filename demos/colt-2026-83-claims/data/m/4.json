[{"id":721,"name":"Maiti2026Power.le_budget_of_isFixedDesign_of_isPAC","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.LowerNonadaptive","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"a0b9a3e587e9a5a4","local":"ee08b5bad503be05","content":"a464add8059a718c"},"doc":"**Theorem 3** (Maiti, Xu, Jamieson 2026): a fixed-design (non-adaptive) identification\nalgorithm with budget `T ≥ 1` which is `(ε, δ)`-PAC on a spanning compact action set `𝒳`, with\n`δ ≤ 1/10`, satisfies `T ≥ w(𝒳)² / (70 ε²)`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":true,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)"},{"explicit":true,"name":"h𝒳","role":"hypothesis","type":"IsCompact 𝒳"},{"explicit":true,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty"},{"explicit":true,"name":"hspan","role":"hypothesis","type":"Submodule.span ℝ 𝒳 = ⊤"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hε","role":"hypothesis","type":"0 < ε"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"δ ∈ Set.Ioc 0 (1 / 10)"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":true,"name":"hT","role":"hypothesis","type":"1 ≤ T"},{"explicit":true,"name":"A","role":"variable","type":"Learning.IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"hdes","role":"hypothesis","type":"A.IsFixedDesign"},{"explicit":true,"name":"hpac","role":"hypothesis","type":"Learning.LinearBandit.IsPAC 𝒳 A ε δ"}],"conclusion":"gw 𝒳 ^ 2 / (70 * ε ^ 2) ≤ ↑T","decl":"Maiti2026Power.le_budget_of_isFixedDesign_of_isPAC"},"code":"/-- **Theorem 3** (Maiti, Xu, Jamieson 2026): a fixed-design (non-adaptive) identification\nalgorithm with budget `T ≥ 1` which is `(ε, δ)`-PAC on a spanning compact action set `𝒳`, with\n`δ ≤ 1/10`, satisfies `T ≥ w(𝒳)² / (70 ε²)`. -/\ntheorem le_budget_of_isFixedDesign_of_isPAC (𝒳 : Set (EuclideanSpace ℝ ι)) (h𝒳 : IsCompact 𝒳)\n    (hne : 𝒳.Nonempty) (hspan : Submodule.span ℝ 𝒳 = ⊤)\n    {ε δ : ℝ} (hε : 0 < ε) (hδ : δ ∈ Set.Ioc 0 (1 / 10)) {T : ℕ} (hT : 1 ≤ T)\n    (A : IdentAlg Unit 𝒳 ℝ 𝒳) (hA : A.IsFixedBudget T)\n    (hdes : A.IsFixedDesign) (hpac : IsPAC 𝒳 A ε δ) :\n    gw 𝒳 ^ 2 / (70 * ε ^ 2) ≤ T","proof":":= by\n  obtain ⟨x, hx⟩ := hdes\n  obtain ⟨R, hR⟩ : ∃ R, ∀ z ∈ 𝒳, ‖z‖ ≤ R := by\n    obtain ⟨r, hr⟩ := h𝒳.isBounded.subset_closedBall (0 : EuclideanSpace ℝ ι)\n    exact ⟨r, fun z hz ↦ mem_closedBall_zero_iff.1 (hr hz)⟩\n  -- the design matrix is positive definite\n  have hS := posDef_of_isFixedDesign_of_isPAC h𝒳 hspan hε (hδ.2.trans_lt (by norm_num)) hT A hA\n    hx hpac\n  -- the Bayesian step: `0.12 w_T ≤ ε`\n  have hkey := gwMat_le_of_isFixedDesign_of_isPAC h𝒳 hne hε.le hδ A hA hx hpac hS\n  set w : ℝ := gwMat 𝒳 (∑ t : Fin T, outerSelf (x t : EuclideanSpace ℝ ι)) with hw_def\n  -- from the design width to the width term\n  have hTpos : 0 < T := hT\n  have hgw : gw 𝒳 ≤ √T * w :=\n    gw_le_sqrt_mul_gwMat_sum hne hR hTpos (x := fun t ↦ (x t : EuclideanSpace ℝ ι))\n      (fun t ↦ (x t).2) hS\n  have hgw0 : 0 ≤ gw 𝒳 := gw_nonneg hne hR\n  have hsqrtT : (0 : ℝ) ≤ √T := Real.sqrt_nonneg _\n  have hTsq : √T ^ 2 = T := Real.sq_sqrt (Nat.cast_nonneg T)\n  have h1 : (0.12 : ℝ) * gw 𝒳 ≤ √T * ε := by\n    calc (0.12 : ℝ) * gw 𝒳 ≤ 0.12 * (√T * w) := by gcongr\n      _ = √T * (0.12 * w) := by ring\n      _ ≤ √T * ε := by gcongr\n  have h2 : (0.0144 : ℝ) * gw 𝒳 ^ 2 ≤ T * ε ^ 2 := by\n    have := mul_self_le_mul_self (by positivity : (0 : ℝ) ≤ 0.12 * gw 𝒳) h1\n    nlinarith [hTsq]\n  rw [div_le_iff₀ (by positivity)]\n  nlinarith [h2, sq_nonneg (gw 𝒳)]","source":{"path":"Maiti2026Power/MXJ2026/LowerNonadaptive.lean","start":164,"end":199,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/LowerNonadaptive.lean#L164-L199"},"deps":[84,93,95,1249],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["BorelSpace.opensMeasurable","mathlib","instance"],["ChainCompletePartialOrder.instOfCompleteLattice","mathlib","instance"],["ChainCompletePartialOrder.toPartialOrder","mathlib","instance"],["ClosureOperator","mathlib","structure"],["ClosureOperator.instFunLike","mathlib","instance"],["CompleteAtomicBooleanAlgebra.toCompleteBooleanAlgebra","mathlib","instance"],["CompleteBooleanAlgebra.toCompleteLattice","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Finite.of_fintype","mathlib","instance"],["Finite.to_countable","mathlib","instance"],["Fintype","mathlib","class"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["Inv.inv","lean4","definition"],["IsCompact","mathlib","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.Iden