ι"},{"explicit":true,"name":"A","role":"variable","type":"Learning.IdentAlg Unit ↑(unitBall ι) ℝ ℝ"},{"explicit":true,"name":"ε","role":"variable","type":"ℝ"},{"explicit":true,"name":"δ","role":"variable","type":"ℝ"}],"conclusion":"Prop","decl":"Maiti2026Power.IsAccurateNormEst","value":"A.IsPAC (Learning.LinearBandit.linearGaussianEnv (unitBall ι)) (fun θ r => ε < |r - ‖θ‖|) δ"},"code":"/-- An estimation algorithm on the unit ball (an identification algorithm with actions in the\nunit ball, real observations and a real output) is `(ε, δ)`-accurate if for every reward vector `θ`,\nrun against the linear Gaussian environment with reward vector `θ`, its output `r̂` satisfies\n`ε < |r̂ - ‖θ‖|` with probability at most `δ`. -/\ndef IsAccurateNormEst (A : IdentAlg Unit (unitBall ι) ℝ ℝ) (ε δ : ℝ) : Prop :=\n  A.IsPAC (linearGaussianEnv (unitBall ι)) (fun θ r ↦ ε < |r - ‖θ‖|) δ","proof":"","source":{"path":"Maiti2026Power/MXJ2026/NormEstimation.lean","start":37,"end":42,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstimation.lean#L37-L42"},"deps":[97,1223],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["EuclideanSpace","mathlib","definition"],["Fintype","mathlib","class"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LT.lt","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["Measurabl