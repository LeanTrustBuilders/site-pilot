[{"id":1039,"name":"Maiti2026Power.exists_isAccurateNormEst","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.NormEstimation","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"f10b3ea927130da8","local":"760b248ceaf129c3","content":"3766ee4b0557f8e7"},"doc":"**Theorem 8** (Maiti, Xu, Jamieson 2026): for `ε ∈ (0, 1]` and `δ ∈ (0, 1)` there is an\n(adaptive) `(ε, δ)`-accurate `ℓ₂`-norm estimation algorithm on the unit ball of `ℝ^d` with budget\n`T ≤ 10⁵ d log(4/δ) / ε²`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hε","role":"hypothesis","type":"ε ∈ Set.Ioc 0 1"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"δ ∈ Set.Ioo 0 1"}],"conclusion":"∃ T,\n  ↑T ≤ 100000 * ↑(Fintype.card ι) * Real.log (4 / δ) / ε ^ 2 ∧\n    ∃ A, A.IsFixedBudget T ∧ IsAccurateNormEst A ε δ","decl":"Maiti2026Power.exists_isAccurateNormEst"},"code":"/-- **Theorem 8** (Maiti, Xu, Jamieson 2026): for `ε ∈ (0, 1]` and `δ ∈ (0, 1)` there is an\n(adaptive) `(ε, δ)`-accurate `ℓ₂`-norm estimation algorithm on the unit ball of `ℝ^d` with budget\n`T ≤ 10⁵ d log(4/δ) / ε²`. -/\ntheorem exists_isAccurateNormEst {ε δ : ℝ} (hε : ε ∈ Set.Ioc 0 1) (hδ : δ ∈ Set.Ioo 0 1) :\n    ∃ T : ℕ, (T : ℝ) ≤ 100000 * Fintype.card ι * log (4 / δ) / ε ^ 2 ∧\n      ∃ A : IdentAlg Unit (unitBall ι) ℝ ℝ, A.IsFixedBudget T ∧ IsAccurateNormEst A ε δ","proof":":= by\n  classical\n  let P : NormEstParam := ⟨ε, δ, hε, hδ⟩\n  have habs : ∀ θ : EuclideanSpace ℝ ι, Measurable fun r : ℝ ↦ |r - ‖θ‖| := fun θ ↦\n    continuous_abs.measurable.comp (measurable_id.sub_const _)\n  have hbad : ∀ θ : EuclideanSpace ℝ ι, MeasurableSet {r : ℝ | ε < |r - ‖θ‖|} := fun θ ↦\n    measurableSet_lt measurable_const (habs θ)\n  rcases isEmpty_or_nonempty ι with hι | hι\n  · -- degenerate case `d = 0`: every reward vector is `0`, the constant output `ε` is accurate\n    refine ⟨0, by simp, IdentAlg.fixedBudget (P.alg ι).toAlgorithm 0\n      (Kernel.deterministic (fun _ ↦ ε) measurable_const),\n      IdentAlg.isFixedBudget_fixedBudget _ _ _, ?_⟩\n    refine SeededAlg.linearBandit_isPAC_fixedBudget_deterministic (P.alg ι) measurable_const hbad\n      fun θ ↦ ?_\n    have hθ : θ = 0 := by\n      ext i\n      exact isEmptyElim i\n    have hempty : {ω : ℕ → (ι → Bool) × ℝ | ε < |ε - ‖θ‖|} = ∅ :=\n      Set.eq_empty_of_forall_notMem fun ω hω ↦ absurd hω (by simp [hθ, abs_of_pos hε.1])\n    rw [hempty, measureReal_empty]\n    exact hδ.1.le\n  · have hd : 0 < Fintype.card ι := Fintype.card_pos\n    refine ⟨P.T ι, P.T_le hd, IdentAlg.fixedBudget (P.alg ι).toAlgorithm (P.T ι)\n      (Kernel.deterministic (P.output ι) P.measurable_output),\n      IdentAlg.isFixedBudget_fixedBudget _ _ _, ?_⟩\n    exact SeededAlg.linearBandit_isPAC_fixedBudget_deterministic (P.alg ι) P.measurable_output\n      hbad fun θ ↦ measureReal_lt_le_of_one_sub_le_measureReal_le\n        ((habs θ).comp (P.measurable_output.comp\n          (SeededAlg.measurable_seedFinHist (by fun_prop) _)))\n        (P.one_sub_le_seedMeasure_real_output hd θ)","source":{"path":"Maiti2026Power/MXJ2026/NormEstimation.lean","start":44,"end":78,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstimation.lean#L44-L78"},"deps":[93,1040,1223],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Fintype","ma