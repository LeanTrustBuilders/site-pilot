[{"id":629,"name":"AlphaRAR.isBigO_target_sub_of_tendsto","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.PluginTargetRate","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"4fd39d7387515eb7","local":"01eead2d98fcc8a2","content":"af7e7820e97d6957"},"doc":"**Coordinatewise delta-method rate.** If the vector-valued sequence `g n → x₀` has each\ncoordinate `O(r n)` and `f` is differentiable at `x₀`, then every coordinate of `f (g n) - f x₀` is\n`O(r n)`. This is the delta method that turns the estimator's loglog rate into the plug-in target's\nloglog rate. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite ι","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"implicit":true,"name":"κ","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite κ","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"implicit":true,"name":"T","role":"variable","type":"(ι → ℝ) → κ → ℝ","typeRefs":[[5,6,"Real"],[14,15,"Real"]]},{"explicit":false,"implicit":true,"name":"θ","role":"variable","type":"ι → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"head":"DifferentiableAt","implicit":false,"name":"hT","role":"hypothesis","type":"DifferentiableAt ℝ T θ","typeRefs":[[0,16,"DifferentiableAt"],[17,18,"Real"]]},{"explicit":false,"implicit":true,"name":"g","role":"variable","type":"ℕ → ι → ℝ","typeRefs":[[0,1,"Nat"],[8,9,"Real"]]},{"explicit":true,"head":"Filter.Tendsto","implicit":false,"name":"hg","role":"hypothesis","type":"Filter.Tendsto g Filter.atTop (nhds θ)","typeRefs":[[0,14,"Filter.Tendsto"],[17,29,"Filter.atTop"],[31,35,"nhds"]]},{"explicit":false,"implicit":true,"name":"r","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"hrate","role":"hypothesis","type":"∀ (i : ι), (fun x => g x i - θ i) =O[Filter.atTop] r","typeRefs":[[27,28,"HSub.hSub"],[34,37,"Asymptotics.IsBigO"],[37,49,"Filter.atTop"]]},{"explicit":true,"implicit":false,"name":"k","role":"variable","type":"κ","typeRefs":[]}],"conclusion":"(fun n => T (g n) k - T θ k) =O[Filter.atTop] r","conclusionHead":"Asymptotics.IsBigO","conclusionRefs":[[20,21,"HSub.hSub"],[29,32,"Asymptotics.IsBigO"],[32,44,"Filter.atTop"]],"decl":"AlphaRAR.isBigO_target_sub_of_tendsto"},"code":"/-- **Coordinatewise delta-method rate.** If the vector-valued sequence `g n → x₀` has each\ncoordinate `O(r n)` and `f` is differentiable at `x₀`, then every coordinate of `f (g n) - f x₀` is\n`O(r n)`. This is the delta method that turns the estimator's loglog rate into the plug-in target's\nloglog rate. -/\nlemma isBigO_target_sub_of_tendsto {ι : Type*} [Finite ι] {κ : Type*} [Finite κ]\n    {T : (ι → ℝ) → κ → ℝ} {θ : ι → ℝ} (hT : DifferentiableAt ℝ T θ)\n    {g : ℕ → ι → ℝ} (hg : Tendsto g atTop (𝓝 θ))\n    {r : ℕ → ℝ} (hrate : ∀ i, (g · i - θ i) =O[atTop] r) (k : κ) :\n    (fun n ↦ T (g n) k - T θ k) =O[atTop] r","proof":":= by\n  cases nonempty_fintype ι\n  cases nonempty_fintype κ\n  -- the whole increment vector is `O(r n)`, coordinatewise\n  have hvec : (g · - θ) =O[atTop] r := isBigO_pi.mpr fun i ↦ hrate i\n  -- the delta method preserves the rate\n  have hdelta : (fun n ↦ T (g n) - T θ) =O[atTop] (g · - θ) :=\n    isBigO_sub_comp_of_differentiableAt hT hg\n  -- project onto coordinate `k`\n  have hproj : (fun n ↦ T (g n) k - T θ k) =O[atTop] (fun n ↦ T (g n) - T θ) := by\n    refine isBigO_of_le atTop fun n ↦ ?_\n    rw [← Pi.sub_apply]\n    exact norm_le_pi_norm _ k\n  exact hproj.trans (hdelta.trans hvec)","source":{"path":"AlphaRAR/YDK2026/PluginTargetRate.lean","start":50,"end":71,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/PluginTargetRate.lean#L50-L71"},"deps":[],"outside":[],"external":[["Asymptotics.IsBigO","mathlib","definition"],["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["DifferentiableAt","mathlib","definition"],["Field.toSemifield","mathlib","instance"],["Filter.Tendsto","mathlib","definition"],["Filter.atTop","mathlib","definition"],["Finite","mathlib","class"],["HSub.hSub","lean4","definition"],["Nat","lean4","inductive"],["Nat.instPreorder","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedField.toField","mathlib","instance"],["Pi.Function.module","mathlib","instance"],["Pi.addCommGroup","mathlib","instance"],["Pi.topologicalSpace","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.norm","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Ring.toSemiring","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["instHSub","lean4","instance"],["nhds","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Asymptotics.IsBigO","CommSemiring.toSemiring","DenselyNormedField.toNontriviallyNormedField","DifferentiableAt","Field.toSemifield","Filter.Tendsto","Filter.atTop","Finite","HSub.hSub","Nat","Nat.instPreorder","NontriviallyNormedField.toNormedField","NormedField.toField","Pi.Function.module","Pi.addCommGroup","Pi.topologicalSpace","PseudoMetricSpace.toUniformSpace","Real","Real.denselyNormedField","Real.instAddCommGroup","Real.instRing","Real.instSub","Real.norm","Real.pseudoMetricSpace","Ring.toSemiring","Semifield.toCommSemiring","Semiring.toAddCommMonoid","Semiring.toModule","UniformSpace.toTopologicalSpace","instHSub","nhds"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":630,"name":"AlphaRAR.rho_rate","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.PluginTargetRate","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"735556d4ef04ee1f","local":"0b33cb0d6ea646b9","content":"0eeae5d7392d64a8"},"doc":"**Rate for the plug-in target**, abstract-rate form. Given the estimator vector `θ̂_n → θ` a.s.,\neach component at the rate `θ̂_{n,k} - θ_k = O(r_n)` a.s., and the target map `T` differentiable at\n`θ` (Condition **B**), the plug-in target `ρ̂_{n,k} = T(θ̂_n)_k` converges to `v_k = T(θ)_k` at the\nsame rate: `ρ̂_{n,k} - v_k = O(r_n)` a.s. for every arm `k`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓐","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite 𝓐","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":true,"name":"A","role":"variable","type":"ℕ → Ω → 𝓐","typeRefs":[[0,1,"Nat"]]},{"explicit":false,"implicit":true,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ","typeRefs":[[0,1,"Nat"],[8,9,"Real"]]},{"explicit":false,"implicit":true,"name":"θ","role":"variable","type":"𝓐 → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":false,"implicit":true,"name":"θ₀","role":"variable","type":"𝓐 → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":false,"implicit":true,"name":"T","role":"variable","type":"(𝓐 → ℝ) → 𝓐 → ℝ","typeRefs":[[5,6,"Real"],[14,15,"Real"]]},{"explicit":true,"head":"DifferentiableAt","implicit":false,"name":"hT","role":"hypothesis","type":"DifferentiableAt ℝ T θ","typeRefs":[[0,16,"DifferentiableAt"],[17,18,"Real"]]},{"explicit":false,"implicit":true,"name":"r","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"head":"Filter.Eventually","implicit":false,"name":"hconsist","role":"hypothesis","type":"∀ᵐ (ω : Ω) ∂P,\n  Filter.Tendsto\n    (fun n k' => estimator (fun j => Learning.actionIndicator A k' j ω) (fun x => Y x ω) (θ₀ k') n)\n    Filter.atTop (nhds θ)","typeRefs":[[0,2,"Filter.Eventually"],[11,12,"Filter.Eventually"],[17,31,"Filter.Tendsto"],[49,58,"AlphaRAR.estimator"],[69,93,"Learning.actionIndicator"],[136,148,"Filter.atTop"],[150,154,"nhds"]]},{"explicit":true,"implicit":false,"name":"hrate","role":"hypothesis","type":"∀ (k : 𝓐),\n  ∀ᵐ (ω : Ω) ∂P,\n    (fun n =>\n        estimator (fun j => Learning.actionIndicator A k j ω) (fun x => Y x ω) (θ₀ k) n -\n          θ k) =O[Filter.atTop]\n      r","typeRefs":[[13,15,"Filter.Eventually"],[24,25,"Filter.Eventually"],[50,59,"AlphaRAR.estimator"],[70,94,"Learning.actionIndicator"],[130,131,"HSub.hSub"],[147,150,"Asymptotics.IsBigO"],[150,162,"Filter.atTop"]]},{"explicit":true,"implicit":false,"name":"k","role":"variable","type":"𝓐","typeRefs":[]}],"conclusion":"∀ᵐ (ω : Ω) ∂P,\n  (fun n =>\n      T\n          (fun k' =>\n            estimator (fun j => Learning.actionIndicator A k' j ω) (fun x => Y x ω) (θ₀ k') n)\n          k -\n        T θ k) =O[Filter.atTop]\n    r","conclusionHead":"Filter.Eventually","conclusionRefs":[[0,2,"Filter.Eventually"],[11,12,"Filter.Eventually"],[68,77,"AlphaRAR.estimator"],[88,112,"Learning.actionIndicator"],[163,164,"HSub.hSub"],[180,183,"Asymptotics.IsBigO"],[183,195,"Filter.atTop"]],"decl":"AlphaRAR.rho_rate"},"code":"/-- **Rate for the plug-in target**, abstract-rate form. Given the estimator vector `θ̂_n → θ` a.s.,\neach component at the rate `θ̂_{n,k} - θ_k = O(r_n)` a.s., and the target map `T` differentiable at\n`θ` (Condition **B**), the plug-in target `ρ̂_{n,k} = T(θ̂_n)_k` converges to `v_k = T(θ)_k` at the\nsame rate: `ρ̂_{n,k} - v_k = O(r_n)` a.s. for every arm `k`. -/\nlemma rho_rate {θ : 𝓐 → ℝ} {θ₀ : 𝓐 → ℝ} {T : (𝓐 → ℝ) → 𝓐 → ℝ} (hT : DifferentiableAt ℝ T θ)\n    {r : ℕ → ℝ}\n    (hconsist : ∀ᵐ ω ∂P, Tendsto (fun n k' ↦ estimator (fun j ↦ actionIndicator A k' j ω)\n      (Y · ω) (θ₀ k') n) atTop (𝓝 θ))\n    (hrate : ∀ k, ∀ᵐ ω ∂P, (fun n ↦ estimator (fun j ↦ actionIndicator A k j ω)\n      (Y · ω) (θ₀ k) n - θ k) =O[atTop] r) (k : 𝓐) :\n    ∀ᵐ ω ∂P, (fun n ↦ T (fun k' ↦ estimator (fun j ↦ actionIndicator A k' j ω)\n      (Y · ω) (θ₀ k') n) k - T θ k) =O[atTop] r","proof":":= by\n  filter_upwards [hconsist, ae_all_iff.mpr hrate] with ω hcω hrω\n  exact isBigO_target_sub_of_tendsto hT hcω hrω k","source":{"path":"AlphaRAR/YDK2026/PluginTargetRate.lean","start":80,"end":93,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/PluginTargetRate.lean#L80-L93"},"deps":[500],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Asymptotics.IsBigO","mathlib","definition"],["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["DifferentiableAt","mathlib","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["Field.toSemifield","mathlib","instance"],["Filter.Eventually","mathlib","definition"],["Filter.Tendsto","mathlib","definition"],["Filter.atTop","mathlib","definition"],["Finite","mathlib","class"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Learning.actionIndicator","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.ae","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instPreorder","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedField.toField","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Pi.Function.module","mathlib","instance"],["Pi.addCommGroup","mathlib","instance"],["Pi.topologicalSpace","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAdd","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.norm","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Ring.toSemiring","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["nhds","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Asymptotics.IsBigO","CommSemiring.toSemiring","DenselyNormedField.toNontriviallyNormedField","DifferentiableAt","Field.toSemifield","Filter.Eventually","Filter.Tendsto","Filter.atTop","Finite","HSub.hSub","Learning.actionIndicator","MeasurableSpace","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","MeasureTheory.Measure.instOuterMeasureClass","MeasureTheory.ae","Nat","Nat.instPreorder","NontriviallyNormedField.toNormedField","NormedField.toField","Pi.Function.module","Pi.addCommGroup","Pi.topologicalSpace","PseudoMetricSpace.toUniformSpace","Real","Real.denselyNormedField","Real.instAddCommGroup","Real.instRing","Real.instSub","Real.norm","Real.pseudoMetricSpace","Ring.toSemiring","Semifield.toCommSemiring","Semiring.toAddCommMonoid","Semiring.toModule","UniformSpace.toTopologicalSpace","instHSub","nhds"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":631,"name":"AlphaRAR.isBigO_sub_comp_of_differentiableAt","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.PluginTargetRate","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"8f7c40c07c15b901","local":"0ae04f3c796ebc5e","content":"22d1fc329c919a2f"},"doc":"**Delta-method estimate.** A map `f` differentiable at `x₀` preserves big-`O` rates through a\nsequence converging to `x₀`: if `g n → x₀` then `f (g n) - f x₀ = O(g n - x₀)`. This is\n`DifferentiableAt.isBigO_sub` (the difference is `O` of the increment) composed with `g → x₀`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"F","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"NormedSpace","implicit":false,"name":"","role":"instance","type":"NormedSpace ℝ E","typeRefs":[[0,11,"NormedSpace"],[12,13,"Real"]]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup F","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"NormedSpace","implicit":false,"name":"","role":"instance","type":"NormedSpace ℝ F","typeRefs":[[0,11,"NormedSpace"],[12,13,"Real"]]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"E → F","typeRefs":[]},{"explicit":false,"implicit":true,"name":"x₀","role":"variable","type":"E","typeRefs":[]},{"explicit":true,"head":"DifferentiableAt","implicit":false,"name":"hf","role":"hypothesis","type":"DifferentiableAt ℝ f x₀","typeRefs":[[0,16,"DifferentiableAt"],[17,18,"Real"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"Filter","implicit":true,"name":"l","role":"variable","type":"Filter ι","typeRefs":[[0,6,"Filter"]]},{"explicit":false,"implicit":true,"name":"g","role":"variable","type":"ι → E","typeRefs":[]},{"explicit":true,"head":"Filter.Tendsto","implicit":false,"name":"hg","role":"hypothesis","type":"Filter.Tendsto g l (nhds x₀)","typeRefs":[[0,14,"Filter.Tendsto"],[20,24,"nhds"]]}],"conclusion":"(fun n => f (g n) - f x₀) =O[l] fun x => g x - x₀","conclusionHead":"Asymptotics.IsBigO","conclusionRefs":[[18,19,"HSub.hSub"],[26,29,"Asymptotics.IsBigO"],[45,46,"HSub.hSub"]],"decl":"AlphaRAR.isBigO_sub_comp_of_differentiableAt"},"code":"/-- **Delta-method estimate.** A map `f` differentiable at `x₀` preserves big-`O` rates through a\nsequence converging to `x₀`: if `g n → x₀` then `f (g n) - f x₀ = O(g n - x₀)`. This is\n`DifferentiableAt.isBigO_sub` (the difference is `O` of the increment) composed with `g → x₀`. -/\nlemma isBigO_sub_comp_of_differentiableAt {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]\n    [NormedAddCommGroup F] [NormedSpace ℝ F] {f : E → F} {x₀ : E} (hf : DifferentiableAt ℝ f x₀)\n    {ι : Type*} {l : Filter ι} {g : ι → E} (hg : Tendsto g l (𝓝 x₀)) :\n    (fun n ↦ f (g n) - f x₀) =O[l] (g · - x₀)","proof":":=\n  hf.isBigO_sub.comp_tendsto hg","source":{"path":"AlphaRAR/YDK2026/PluginTargetRate.lean","start":41,"end":48,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/PluginTargetRate.lean#L41-L48"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["Asymptotics.IsBigO","mathlib","definition"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["DifferentiableAt","mathlib","definition"],["Filter","mathlib","structure"],["Filter.Tendsto","mathlib","definition"],["HSub.hSub","lean4","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedSpace","mathlib","class"],["NormedSpace.toModule","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.normedField","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["SubNegMonoid.toSub","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["instHSub","lean4","instance"],["nhds","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommGroup.toAddGroup","AddGroup.toSubNegMonoid","Asymptotics.IsBigO","DenselyNormedField.toNontriviallyNormedField","DifferentiableAt","Filter","Filter.Tendsto","HSub.hSub","NormedAddCommGroup","NormedAddCommGroup.toAddCommGroup","NormedAddCommGroup.toNorm","NormedAddCommGroup.toSeminormedAddCommGroup","NormedSpace","NormedSpace.toModule","PseudoMetricSpace.toUniformSpace","Real","Real.denselyNormedField","Real.normedField","SeminormedAddCommGroup.toPseudoMetricSpace","SubNegMonoid.toSub","UniformSpace.toTopologicalSpace","instHSub","nhds"],"provenance":null,"edited":{"commit":"6af52f16df6126afe