sis","type":"∀ (i : ι), A i =ᵐ[μ] B i","typeRefs":[]}],"conclusion":"Indistinguishable μ A B","conclusionHead":"AlphaRAR.Indistinguishable","conclusionRefs":[[0,17,"AlphaRAR.Indistinguishable"]],"decl":"AlphaRAR.Indistinguishable.of_forall_ae_eq"},"code":"/-- Over a countable index, agreeing a.e. at each fixed time upgrades to indistinguishability: the\nexceptional sets are countably many, so their union is still null. -/\nlemma Indistinguishable.of_forall_ae_eq [Countable ι] (h : ∀ i, A i =ᵐ[μ] B i) :\n    Indistinguishable μ A B","proof":":=\n  ⟨ae_all_iff.mpr h⟩","source":{"path":"AlphaRAR/Mathlib/Process.lean","start":47,"end":51,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/Process.lean#L47-L51"},"deps":[290],"outside":[],"external":[["Countable","mathlib","class"],["Eq","lean4","inductive"],["Filter.Eventually","mathlib","definition"],["Filter.EventuallyEq","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.ae","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Countable","Filter.EventuallyEq","MeasurableSpace","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","MeasureTheory.Measure.instOuterMeasureClass","MeasureTheory.ae"],"provenance":null,"edited":{"commit":"626a0ba966ded368c52c5fcad1f75afbe62507b6","date":"2026-09-01"}},{"id":290,"name":"AlphaRAR.Indistinguishable","kind":"Structure","keyword":"structure","module":"AlphaRAR.Mathlib.Process","package":"AlphaRAR","isProp":false,"hashes":{"meaning":"c175538acdbf66aa","local":"38ec096084851b98","content":"044bf2a7c219e635"},"doc":"Two processes are **indistinguishable**: almost surely they agree at every time — one null set\nfor the whole path, not one per time.\n\nOver a countable index this is no stronger than agreeing a.e. at each fixed time\n(`Indistinguishable.of_forall_ae_eq`), but it is the statement about paths, which is what a\nuniqueness claim for a *process* should say.\n\nA structure rather than an abbreviation because a characterization reads the \"up to what\" off the\nhead of a uniqueness statement, and an unfolded `∀ᵐ`/`∀` has none. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m0","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":true,"implicit":false,"name":"A","role":"variable","type":"ι → Ω → E","typeRefs":[]},{"explicit":true,"implicit":false,"name":"B","role":"variable","type":"ι → Ω → E","typeRefs":[]}],"conclusion":"Prop","conclusionRefs":[],"decl":"AlphaRAR.Indistinguishable","fields":[{"name":"ae_forall_eq","type":"∀ᵐ (ω : Ω) ∂μ, ∀ (i : ι), A i ω = B i ω","typeRefs":[[0,2,"Filter.Eventually"],[11,12,"Filter.Eventually"],[32,33,"Eq"]]}]},"code":"/-- Two processes are **indistinguishable**: almost surely they agree at every time — one null set\nfor the whole path, not one per time.\n\nOver a countable index this is no stronger than agreeing a.e. at each fixed time\n(`Indistinguishable.of_forall_ae_eq`), but it is the statement about paths, which is what a\nuniqueness claim for a *process* should say.\n\nA structure rather than an abbreviation because a characterization reads the \"up to what\" off the\nhead of a uniqueness statement, and an unfolded `∀ᵐ`/`∀` has none. -/\nstructure Indistinguishable (μ : Measure Ω) (A B : ι → Ω → E) : Prop where\n  /-- Almost surely, the two processes agree at every time. -/\n  ae_forall_eq : ∀ᵐ ω ∂μ, ∀ i, A i ω = B i ω","proof":"","source":{"path":"AlphaRAR/Mathlib/Process.lean","start":30,"end":41,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/Process.lean#L30-L41"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Filter.Eventually","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.ae","mathlib","definition"]],"users":[285,286,287,288,289,317],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Eq","Filter.Eventually","MeasurableSpace","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","MeasureTheory.Measure.instOuterMeasureClass","MeasureTheory.ae"],"provenance":null,"edited":{"commit":"626a0ba966ded368c52c5fcad1f75afbe62507b6","date":"2026-09-01"}}]