":{"meaning":"62ea7b65b27f2e2b","local":"efc7232e0da2c33c","content":"fad7dd4170a2aff3"},"doc":"**Uniqueness of the conditional expectation**: any version of `μ[f | m]` agrees with it a.e.\nThis is `ae_eq_condExp_of_forall_setIntegral_eq` with the three hypotheses packaged. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"E","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"NormedSpace ℝ E"},{"explicit":false,"name":"m","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"m0","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure α"},{"explicit":false,"name":"f","role":"variable","type":"α → E"},{"explicit":false,"name":"g","role":"variable","type":"α → E"},{"explicit":false,"name":"","role":"instance","type":"CompleteSpace E"},{"explicit":true,"name":"hm","role":"hypothesis","type":"m ≤ m0"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SigmaFinite (μ.trim hm)"},{"explicit":true,"name":"hf","role":"hypothesis","type":"MeasureTheory.Integrable f μ"},{"explicit":true,"name":"hg","role":"hypothesis","type":"IsCondExp μ m f g"}],"conclusion":"g =ᵐ[μ] μ[f | m]","decl":"AlphaRAR.IsCondExp.ae_eq_condExp"},"code":"/-- **Uniqueness of the conditional expectation**: any version of `μ[f | m]` agrees with it a.e.\nThis is `ae_eq_condExp_of_forall_setIntegral_eq` with the three hypotheses packaged. -/\nlemma IsCondExp.ae_eq_condExp [CompleteSpace E] (hm : m ≤ m0) [SigmaFinite (μ.trim hm)]\n    (hf : Integrable f μ) (hg : IsCondExp μ m f g) : g =ᵐ[μ] μ[f | m]","proof":":=\n  ae_eq_condExp_of_forall_setIntegral_eq hm hf hg.integrableOn hg.setIntegral_eq\n    hg.aestronglyMeasurable","source":{"path":"AlphaRAR/Mathlib/CondExp.lean","start":59,"end":64,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/CondExp.lean#L59-L64"},"deps":[14],"outside":[],"external":[["CompleteSpace","mathlib","class"],["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.instPartialOrder","mathlib","instance"],["ENNReal.instTop","mathlib","instance"],["Eq","lean4","inductive"],["Filter.EventuallyEq","mathlib","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.instLE","mathlib","instance"],["MeasureTheory.AEStronglyMeasurable","mathlib","definition"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IntegrableOn","mathlib","definition"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.Measure.restrict","mathlib","definition"],["MeasureTheory.Measure.trim","mathlib","definition"],["MeasureTheory.SigmaFinite","mathlib","class"],["MeasureTheory.ae","mathlib","definition"],["MeasureTheory.condExp","mathlib","definition"],["MeasureTheory.integral","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedSpace","mathlib","class"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLT","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.normedField","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["Set","mathlib","definition"],["Top.top","mathlib","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"626a0ba966ded368c52c5fcad1f75afbe62507b6","date":"2026-09-01"}},{"id":14,"name":"AlphaRAR.IsCondExp","kind":"Structure","keyword":"structure","module":"AlphaRAR.Mathlib.CondExp","package":"AlphaRAR","isProp":false,"hashes":{"meaning":"33b314f29a008492","local":"dcfc49bff255b20f","content":"a4991e3e92baf34f"},"doc":"**`g` is a version of the conditional expectation of `f` given `m`.**\n\nThe measure and the sub-σ-algebra come first so that `Measure α` still elaborates against the\nambient `m0` rather than against `m`, and so that the characterized object `g` is the last\nargument. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"E","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"NormedSpace ℝ E"},{"explicit":false,"name":"m0","role":"instance","type":"MeasurableSpace α"},{"explicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure α"},{"explicit":true,"name":"m","role":"instance","type":"MeasurableSpace α"},{"explicit":true,"name":"f","role":"variable","type":"α → E"},{"explicit":true,"name":"g","role":"variable","type":"α → E"}],"conclusion":"Prop","decl":"AlphaRAR.IsCondExp","fields":[{"name":"aestronglyMeasurable","type":"MeasureTheory.AEStronglyMeasurable g μ"},{"name":"integrableOn","type":"∀ (s : Set α), MeasurableSet s → μ s < ⊤ → MeasureTheory.IntegrableOn g s μ"},{"name":"setIntegral_eq","type":"∀ (s : Set α), MeasurableSet s → μ s < ⊤ → ∫ (x : α) in s, g x ∂μ = ∫ (x : α) in s, f x ∂μ"}]},"code":"/-- **`g` is a version of the conditional expectation of `f` given `m`.**\n\nThe measure and the sub-σ-algebra come first so that `Measure α` still elaborates against the\nambient `m0` rather than against `m`, and so that the characterized object `g` is the last\nargument. -/\nstructure IsCondExp (μ : Measure α) (m : MeasurableSpace α) (f g : α → E) : Prop where\n  /-- `g` is measurable for the smaller σ-algebra: it uses only the information in `m`. -/\n  aestronglyMeasurable : AEStronglyMeasurable[m] g μ\n  /-- `g` is integrable on every `m`-measurable set of finite measure. -/\n  integrableOn : ∀ s, MeasurableSet[m] s → μ s < ∞ → IntegrableOn g s μ\n  /-- `g` averages `f` correctly: it has the same integral as `f` over every `m`-measurable set of\n  finite measure. This is the content; the other two fields are what make it pin `g` down. -/\n  setIntegral_eq : ∀ s, MeasurableSet[m] s → μ s < ∞ → ∫ x in s, g x ∂μ = ∫ x in s, f x ∂μ","proof":"","source":{"path":"AlphaRAR/Mathlib/CondExp.lean","start":37,"end":49,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/CondExp.lean#L37-L49"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.instPartialOrder","mathlib","instance"],["ENNReal.instTop","mathlib","instance"],["Eq","lean4","inductive"],["LT.lt","lean4","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.AEStronglyMeasurable","mathlib","definition"],["MeasureTheory.IntegrableOn","mathlib","definition"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.restrict","mathlib","definition"],["MeasureTheory.integral","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedSpace","mathlib","class"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLT","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.normedField","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["Set","mathlib","definition"],["Top.top","mathlib","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"]],"users":[12,13,208,220,399,400],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"626a0ba966ded368c52c5fcad1f75afbe62507b6","date":"2026-09-01"}}]