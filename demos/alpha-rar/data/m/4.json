[{"id":12,"name":"AlphaRAR.isCondExp_condExp","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.CondExp","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"982a585458335895","local":"e0b5b97c3ca64ec9","content":"a2b041939ba0e8c6"},"doc":"`μ[f | m]` is a version of itself. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"E","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"NormedSpace ℝ E"},{"explicit":false,"name":"m","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"m0","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure α"},{"explicit":false,"name":"f","role":"variable","type":"α → E"},{"explicit":false,"name":"","role":"instance","type":"CompleteSpace E"},{"explicit":true,"name":"hm","role":"hypothesis","type":"m ≤ m0"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SigmaFinite (μ.trim hm)"},{"explicit":true,"name":"hf","role":"hypothesis","type":"MeasureTheory.Integrable f μ"}],"conclusion":"IsCondExp μ m f μ[f | m]","decl":"AlphaRAR.isCondExp_condExp"},"code":"/-- `μ[f | m]` is a version of itself. -/\nlemma isCondExp_condExp [CompleteSpace E] (hm : m ≤ m0) [SigmaFinite (μ.trim hm)]\n    (hf : Integrable f μ) :\n    IsCondExp μ m f (μ[f | m])","proof":"where\n  aestronglyMeasurable := stronglyMeasurable_condExp.aestronglyMeasurable\n  integrableOn _ _ _ := integrable_condExp.integrableOn\n  setIntegral_eq _ hs _ := setIntegral_condExp hm hf hs","source":{"path":"AlphaRAR/Mathlib/CondExp.lean","start":51,"end":57,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/CondExp.lean#L51-L57"},"deps":[14],"outside":[],"external":[["CompleteSpace","mathlib","class"],["DFunLike.coe","mathlib","definition"],["EN