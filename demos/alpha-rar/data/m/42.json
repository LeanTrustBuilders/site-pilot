 count `N_{n,k}` of arm `k`. -/\nlemma count_indicator_eq_pullCount (k : 𝓐) (n : ℕ) (ω : Ω) :\n    count (fun j ↦ actionIndicator A k j ω) n = (pullCount A k n ω : ℝ)","proof":":=\n  sum_actionIndicator_eq_pullCount A k n ω","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":118,"end":122,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L118-L122"},"deps":[475],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["DecidableEq","lean4","definition"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["Learning.actionIndicator","LeanMachineLearning","definition"],["Learning.pullCount","LeanMachineLearning","definition"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instNatCast","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DecidableEq","Eq","Learning.actionIndicator","Learning.pullCount","Nat","Nat.cast","Real","Real.instAddCommMonoid","Real.instNatCast"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}}]