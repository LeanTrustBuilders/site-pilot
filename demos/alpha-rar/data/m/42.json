 : ℕ) (ω : Ω) :\n    0 ≤ count (fun j ↦ actionIndicator A k j ω) n","proof":":=\n  Finset.sum_nonneg fun j _ ↦ actionIndicator_nonneg A k j ω","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":111,"end":114,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L111-L114"},"deps":[475],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["LE.le","lean4","definition"],["Learning.actionIndicator","LeanMachineLearning","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instZero","mathlib","instance"],["Zero.toOfNat0","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["LE.le","Learning.actionIndicator","Nat","OfNat.ofNat","Real","Real.instAddCommMonoid","Real.instLE","Real.instZero","Zero.toOfNat0"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":469,"name":"AlphaRAR.count_zero","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Count","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"db2814b0b83b0e2d","local":"ed46e0fb48b5588b","content":"29947551e9166670"},"doc":"","statement":{"binders":[{"explicit":false,"implicit":true,"name":"M","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"AddCommMonoid","implicit":false,"name":"","role":"instance","type":"AddCommMonoid M","typeRefs":[[0,13,"AddCommMonoid"]]},{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → M","typeRefs":[[0,1,"Nat"]]}],"conclusion":"count X 0 = 0","conclusionHead":"Eq","conclusionRefs":[[0,5,"AlphaRAR.count"],[10,11,"Eq"]],"decl":"AlphaRAR.count_zero"},"code":"@[simp, specifies count \"fixes the base of the count; with `count_succ` it determines every value, \\\nand it records the 0-indexing convention: nothing has been counted before patient `0`\"]\nlemma count_zero {M : Type*} [AddCommMonoid M] (X : ℕ → M) : count X 0 = 0","proof":":= by\n  simp [count]","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":48,"end":51,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L48-L51"},"deps":[475],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["AddCommMonoid.toAddMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddZero.toZero","mathlib","instance"],["AddZeroClass.toAddZero","mathlib","instance"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"fixes the base of the count; with `count_succ` it determines every value, and it records the 0-indexing convention: nothing has been counted before patient `0`","target":"AlphaRAR.count"}],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommMonoid","AddCommMonoid.toAddMonoid","AddMonoid.toAddZeroClass","AddZero.toZero","AddZeroClass.toAddZero","Eq","Nat","OfNat.ofNat","Zero.toOfNat0","instOfNatNat"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":470,"name":"AlphaRAR.stronglyAdapted_count","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Count","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"d4d5a5d6902a745d","local":"a9cb25c0bcf44b0f","content":"acd7573cd60989d3"},"doc":"The count process is adapted to the *previous-history* filtration `ℱ.shiftDown`: `count X n`\nsums `X 0, …, X (n-1)`, each of which is already `ℱ (n-1)`-measurable. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m0","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Filtration","implicit":true,"name":"ℱ","role":"variable","type":"MeasureTheory.Filtration ℕ m0","typeRefs":[[0,24,"MeasureTheory.Filtration"],[25,26,"Nat"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"ℕ → Ω → ℝ","typeRefs":[[0,1,"Nat"],[8,9,"Real"]]},{"explicit":true,"head":"MeasureTheory.StronglyAdapted","implicit":false,"name":"hX","role":"hypothesis","type":"MeasureTheory.StronglyAdapted ℱ X","typeRefs":[[0,29,"MeasureTheory.StronglyAdapted"]]}],"conclusion":"MeasureTheory.StronglyAdapted ℱ.shiftDown (count X)","conclusionHead":"MeasureTheory.StronglyAdapted","conclusionRefs":[[0,29,"MeasureTheory.StronglyAdapted"],[32,41,"MeasureTheory.Filtration.shiftDown"],[43,48,"AlphaRAR.count"]],"decl":"AlphaRAR.stronglyAdapted_count"},"code":"/-- The count process is adapted to the *previous-history* filtration `ℱ.shiftDown`: `count X n`\nsums `X 0, …, X (n-1)`, each of which is already `ℱ (n-1)`-measurable. -/\nlemma stronglyAdapted_count (hX : StronglyAdapted ℱ X) :\n    StronglyAdapted ℱ.shiftDown (count X)","proof":":= by\n  intro n\n  apply Finset.stronglyMeasurable_sum\n  intro i hi\n  rw [Finset.mem_range] at hi\n  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩\n  exact (hX i).mono (ℱ.mono (by omega : i ≤ m))","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":87,"end":96,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L87-L96"},"deps":[22,475],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Bot.bot