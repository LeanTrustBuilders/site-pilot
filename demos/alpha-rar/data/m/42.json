s \\\n`0, …, n-1` — the half-open convention every index computation in the development relies on\"]\nlemma count_succ {M : Type*} [AddCommMonoid M] (X : ℕ → M) (n : ℕ) :\n    count X (n + 1) = count X n + X n","proof":":= by\n  unfold count\n  rw [Finset.sum_range_succ]","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":53,"end":59,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L53-L59"},"deps":[475],"outside":[],"external":[["AddCommMagma.toAdd","mathlib","instance"],["AddCommMonoid","mathlib","class"],["AddCommMonoid.toAddCommSemigroup","mathlib","instance"],["AddCommSemigroup.toAddCommMagma","mathlib","instance"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"the step `n → n+1` adds patient `n`, so `count X n` covers patients `0, …, n-1` — the half-open convention every index computation in the development relies on","target":"AlphaRAR.count"}],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommMagma.toAdd","AddCommMonoid","AddCommMonoid.toAddCommSemigroup","AddCommSemigroup.toAddCommMagma","Eq","HAdd.hAdd","Nat","OfNat.ofNat","instAddNat","instHAdd","instOfNatNat"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":474,"name":"AlphaRAR.sum_count_sub_smul_eq_zero","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Count","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"a5e9be4d310ddc53","local":"73d02c07cb3ee15c","content":"c1ad2a73143ef8c6"},"doc":"**Deviation simplex identity** (backbone of the reverse step in the proportion-deviation\nbounds). If the assignment vector and the target vector each sum to one, then the deviations\n`N_{n,k} - n r_k` sum to zero. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":true,"implicit":false,"name":"Y","role":"variable","type":"ℕ → ι → ℝ","typeRefs":[[0,1,"Nat"],[8,9,"Real"]]},{"explicit":true,"implicit":false,"name":"r","role":"variable","type":"ι → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"hY","role":"hypothesis","type":"∀ (j : ℕ), ∑ k, Y j k = 1","typeRefs":[[7,8,"Nat"],[22,23,"Eq"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hr","role":"hypothesis","type":"∑ k, r k = 1","typeRefs":[[9,10,"Eq"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"∑ k, (count (fun x => Y x k) n - ↑n * r k) = 0","conclusionHead":"Eq","conclusionRefs":[[6,11,"AlphaRAR.count"],[31,32,"HSub.hSub"],[36,37,"HMul.hMul"],[43,44,"Eq"]],"decl":"AlphaRAR.sum_count_sub_smul_eq_zero"},"code":"/-- **Deviation simplex identity** (backbone of the reverse step in the proportion-deviation\nbounds). If the assignment vector and the target vector each sum to one, then the deviations\n`N_{n,k} - n r_k` sum to zero. -/\nlemma sum_count_sub_smul_eq_zero {ι : Type*} [Fintype ι] (Y : ℕ → ι → ℝ) (r : ι → ℝ)\n    (hY : ∀ j, ∑ k, Y j k = 1) (hr : ∑ k, r k = 1) (n : ℕ) :\n    ∑ k, (count (Y · k) n - (n : ℝ) * r k) = 0","proof":":= by\n  rw [Finset.sum_sub_distrib, counts_sum Y hY n, ← Finset.mul_sum, hr, mul_one, sub_self]","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":72,"end":78,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L72-L78"},"deps":[475],"outsid