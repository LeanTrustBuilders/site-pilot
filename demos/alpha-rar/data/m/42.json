e","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"AddCommMonoid","implicit":false,"name":"","role":"instance","type":"AddCommMonoid M","typeRefs":[[0,13,"AddCommMonoid"]]},{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → M","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"M","conclusionRefs":[],"decl":"AlphaRAR.count","value":"∑ j ∈ Finset.range n, X j","valueRefs":[[6,18,"Finset.range"]]},"code":"/-- Allocation count of a fixed arm, `N n = ∑_{j<n} X j`, the count `N_{n,k}` of Section 2 of the\npaper. Stated for a general `AddCommMonoid` so it serves both the deterministic per-path counts\n(`X : ℕ → ℝ`) and the process-level count (`X : ℕ → Ω → ℝ`, the assignment count process of\n`Assignment.lean`). -/\ndef count {M : Type*} [AddCommMonoid M] (X : ℕ → M) (n : ℕ) : M := ∑ j ∈ range n, X j","proof":"","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":42,"end":46,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L42-L46"},"deps":[],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["Nat","lean4","inductive"]],"users":[455,459,461,462,463,464,466,467,468,469,470,471,472,473,474,476,477,478,479,481,482,484,486,487,488,489,490,491,492,493,498,499,500,505,508,511,540,542,550,553,574,619,620,625,626,632,636,644,690,692,695,697,699,700,701,702,703,711,716,718,722,723,724,727,730,736,738,739,762],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[{"decl":"AlphaRAR.count_zero","comment":"fixes the base of the count; with `count_succ` it determines every value, and it records the 0-indexing convention: nothing has been counted before patient `0`","kind":"specifies"},{"decl":"AlphaRAR.count_succ","co