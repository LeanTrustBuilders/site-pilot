[{"id":456,"name":"AlphaRAR.isBigOpOne_assignMart_div_sqrt","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.AssignmentRate","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"7109990b87936c99","local":"422be5d5eafa8b11","content":"27018170c56e0403"},"doc":"**The assignment martingale is `O_p(√n)`.**\nFor a `[0,1]`-valued adapted integrable assignment indicator `X`, the assignment\nmartingale `M` satisfies `M n / √n = O_p(1)`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"m0","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"ℱ","role":"variable","type":"MeasureTheory.Filtration ℕ m0"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure μ"},{"explicit":true,"name":"hX","role":"hypothesis","type":"MeasureTheory.StronglyAdapted ℱ X"},{"explicit":true,"name":"hX_int","role":"hypothesis","type":"∀ (n : ℕ), MeasureTheory.Integrable (X n) μ"},{"explicit":true,"name":"h0X","role":"hypothesis","type":"∀ (n : ℕ), 0 ≤ᵐ[μ] X n"},{"explicit":true,"name":"h1X","role":"hypothesis","type":"∀ (n : ℕ), X n ≤ᵐ[μ] fun x => 1"}],"conclusion":"IsBigOpOne μ fun n ω => assignMart X ℱ μ n ω / √↑n","decl":"AlphaRAR.isBigOpOne_assignMart_div_sqrt"},"code":"/-- **The assignment martingale is `O_p(√n)`.**\nFor a `[0,1]`-valued adapted integrable assignment indicator `X`, the assignment\nmartingale `M` satisfies `M n / √n = O_p(1)`. -/\nlemma isBigOpOne_assignMart_div_sqrt [IsFiniteMeasure μ]\n    (hX : StronglyAdapted ℱ X) (hX_int : ∀ n, Integrable (X n) μ)\n    (h0X : ∀ n, 0 ≤ᵐ[μ] X n) (h1X : ∀ n, X n ≤ᵐ[μ] fun _ ↦ (1 : ℝ)) :\n    IsBigOpOne μ (fun n ω ↦ assignMart X ℱ μ n ω / √n)","proof":":= by\n  have h0 : assignMart X ℱ μ 0 = 0 := by rw [assignMart, martingalePart_zero, count_zero]\n  have hM0 : assignMart X ℱ μ 0 =ᵐ[μ] 0 := by filter_upwards with ω; rw [h0]\n  have hΔ : ∀ n, ∀ᵐ ω ∂μ,\n      |assignMart X ℱ μ (n + 1) ω - assignMart X ℱ μ n ω| ≤ 1 := by\n    intro n\n    filter_upwards [abs_assignMart_succ_sub_le hX_int h0X h1X n] with ω h\n    simpa only [Pi.sub_apply] using h\n  exact isBigOpOne_of_bdd_increments (martingale_assignMart hX hX_int) hM0 1 hΔ","source":{"path":"AlphaRAR/YDK2026/AssignmentRate.lean","start":35,"end":49,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/AssignmentRate.lean#L35-L49"},"deps":[360,455],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Bot.bot","mathlib","definition"],["BoundedOrder.toOrderBot","mathlib","instance"],["CompleteLattice.toBoundedOrder","mathlib","instance"],["CompleteLattice.toLattice","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instLE","mathlib","instance"],["ENNReal.instPartialOrder","mathlib","instance"],["ENNReal.instZero","mathlib","instance"],["Exists","lean4","inductive"],["Filter.EventuallyLE","mathlib","definition"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Lattice.toSemilatticeSup","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.instCompleteLattice","mathlib","instance"],["MeasureTheory.Filtration","mathlib","structure"],["MeasureTheory.Filtration.mk","mathlib","constructor"],["MeasureTheory.Filtration.seq","mathlib","definition"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.StronglyAdapted","mathlib","definition"],["MeasureTheory.ae","mathlib","definition"],["MeasureTheory.martingalePart","mathlib","definition"],["Nat","lean4","inductive"],["Nat.casesOn","lean4","definition"],["Nat.cast","lean4","definition"],["Nat.instPreorder","mathlib","instance"],["Nat.succ","lean4","constructor"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OrderBot.toBot","mathlib","instance"],["PartialOrder.toPreorder","mathlib","instance"],["Pi.addCommMonoid","mathlib","instance"],["Pi.instZero","mathlib","instance"],["Preorder.toLE","mathlib","instance"],["Preorder.toLT","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Real.sqrt","mathlib","definition"],["SemilatticeSup.toPartialOrder","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"],["Unit.unit","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["abs","mathlib","definition"],["instHDiv","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"2e14ceeca37f0c017134c369083a3dd68b3a6bfc","date":"2026-09-02"}},{"id":457,"name":"AlphaRAR.ae_eventually_abs_assignMart_le_sqrt_nat_mul_loglog","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.AssignmentRate","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"87ceb78565c19dfb","local":"a4b607d7b63db3f7","content":"a55a0248ba006f22"},"doc":"**Loglog LIL for the assignment martingale.**\nFor a `[0,1]`-valued adapted integrable assignment indicator `X` on a probability space, the\nassignment martingale `M` satisfies `|M_n| = O(√(n log log n))` almost surely. The increments are\nbounded by `1`, so the *unconditional* bounded-increment loglog LIL\n`ae_isBigO_sqrt_nat_mul_loglog_of_bdd` applies — crucially **without** requiring\n`⟨M⟩_n → ∞`, which can fail here (a design whose selection probabilities degenerate to `{0,1}` has\n`⟨M⟩ ≡ 0`). ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"m0","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"ℱ","role":"variable","type":"MeasureTheory.Filtration ℕ m0"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ"},{"explicit":true,"name":"hX","role":"hypothesis","type":"MeasureTheory.StronglyAdapted ℱ X"},{"explicit":true,"name":"hX_int","role":"hypothesis","type":"∀ (n : ℕ), MeasureTheory.Integrable (X n) μ"},{"explicit":true,"name":"h0X","role":"hypothesis","type":"∀ (n : ℕ), 0 ≤ᵐ[μ] X n"},{"explicit":true,"name":"h1X","role":"hypothesis","type":"∀ (n : ℕ), X n ≤ᵐ[μ] fun x => 1"}],"conclusion":"∀ᵐ (ω : Ω) ∂μ,\n  ∃ C, ∀ᶠ (n : ℕ) in Filter.atTop, |assignMart X ℱ μ n ω| ≤ C * √(↑n * Real.log (Real.log ↑n))","decl":"AlphaRAR.ae_eventually_abs_assignMart_le_sqrt_nat_mul_loglog"},"code":"/-- **Loglog LIL for the assignment martingale.**\nFor a `[0,1]`-valued adapted integrable assignment indicator `X` on a probability space, the\nassignment martingale `M` satisfies `|M_n| = O(√(n log log n))` almost surely. The increments are\nbounded by `1`, so the *unconditional* bounded-increment loglog LIL\n`ae_isBigO_sqrt_nat_mul_loglog_of_bdd` applies — crucially **without** requiring\n`⟨M⟩_n → ∞`, which can fail here (a design whose selection probabilities degenerate to `{0,1}` has\n`⟨M⟩ ≡ 0`). -/\nlemma ae_eventually_abs_assignMart_le_sqrt_nat_mul_loglog [IsProbabilityMeasure μ]\n    (hX : StronglyAdapted ℱ X) (hX_int : ∀ n, Integrable (X n) μ)\n    (h0X : ∀ n, 0 ≤ᵐ[μ] X n) (h1X : ∀ n, X n ≤ᵐ[μ] fun _ ↦ (1 : ℝ)) :\n    ∀ᵐ ω ∂μ, ∃ C, ∀ᶠ n in atTop,","proof":"|assignMart X ℱ μ n ω| ≤ C * √((n : ℝ) * Real.log (Real.log n)) := by\n  have h0 : assignMart X ℱ μ 0 = 0 := by rw [assignMart, martingalePart_zero, count_zero]\n  have hM0 : assignMart X ℱ μ 0 =ᵐ[μ] 0 := by filter_upwards with ω; rw [h0]\n  have hΔ k : ∀ᵐ ω ∂μ, |assignMart X ℱ μ (k + 1) ω - assignMart X ℱ μ k ω| ≤ 1 := by\n    filter_upwards [abs_assignMart_succ_sub_le hX_int h0X h1X k] with ω h\n    simpa only [Pi.sub_apply] using h\n  filter_upwards [ae_isBigO_sqrt_nat_mul_loglog_of_bdd (martingale_assignMart hX hX_int) hM0\n    one_pos hΔ] with ω hω\n  rw [Asymptotics.isBigO_iff] at hω\n  obtain ⟨C, hC⟩ := hω\n  exact ⟨C, hC.mono fun n hn ↦ by\n    simpa only [Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)] using hn⟩","source":{"path":"AlphaRAR/YDK2026/AssignmentRate.lean","start":64,"end":86,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/AssignmentRate.lean#L64-L86"},"deps":[455],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Bot.bot","mathlib","definition"],["BoundedOrder.toOrderBot","mathlib","instance"],["CompleteLattice.toBoundedOrder","mathlib","instance"],["CompleteLattice.toLattice","mathlib","instance"],["Exists","lean4","inductive"],["Filter.Eventually","mathlib","definition"],["Filter.EventuallyLE","mathlib","definition"],["Filter.atTop","mathlib","definition"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["Lattice.toSemilatticeSup","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.instCompleteLattice","mathlib","instance"],["MeasureTheory.Filtration","mathlib","structure"],["MeasureTheory.Filtration.mk","mathlib","constructor"],["MeasureTheory.Filtration.seq","mathlib","definition"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.StronglyAdapted","mathlib","definition"],["MeasureTheory.ae","mathlib","definition"],["MeasureTheory.martingalePart","mathlib","definition"],["Nat","lean4","inductive"],["Nat.casesOn","lean4","definition"],["Nat.cast","lean4","definition"],["Nat.instPreorder","mathlib","instance"],["Nat.succ","lean4","constructor"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","d