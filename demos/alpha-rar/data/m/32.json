[{"id":379,"name":"AlphaRAR.tsum_measure_abs_sub_ge_sqrt_ne_top","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.TsumMeasureIoi","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"448d2608d1e68973","local":"a6781d2dbc26e9c5","content":"9a6031b5c4220a4e"},"doc":"**Summable truncation tail with the closed window.** The `≤` variant of\n`tsum_measure_abs_sub_gt_sqrt_ne_top`: `∑' i, ρ {x : √i ≤ |x - θ|} < ∞`. This is what is needed for\nthe sampled tail term of the finite-variance LIL, because Mathlib's `truncation` uses the\nleft-open window `Ioc (-A) A`, so a value *equal* to `√i` in absolute value can still be off the\nwindow. Derived from the strict version by shifting the index: for `i ≥ 1`,\n`√i ≤ |x-θ| ⟹ √(i-1) < |x-θ|`, and the `i = 0` term is `ρ` of a set, hence finite. ","statement":{"binders":[{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"ρ","role":"variable","type":"MeasureTheory.Measure ℝ","typeRefs":[[0,21,"MeasureTheory.Measure"],[22,23,"Real"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure ρ","typeRefs":[[0,29,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"MeasureTheory.MemLp","implicit":false,"name":"hρ2","role":"hypothesis","type":"MeasureTheory.MemLp (fun x => x) 2 ρ","typeRefs":[[0,19,"MeasureTheory.MemLp"]]}],"conclusion":"∑' (i : ℕ), ρ {x | √↑i ≤ |x - θ|} ≠ ⊤","conclusionHead":"Ne","conclusionRefs":[[0,2,"tsum"],[8,9,"Nat"],[17,18,"Set.ofPred"],[19,20,"Real.sqrt"],[23,24,"LE.le"],[25,26,"abs"],[28,29,"HSub.hSub"],[31,32,"abs"],[34,35,"Ne"],[36,37,"Top.top"]],"decl":"AlphaRAR.tsum_measure_abs_sub_ge_sqrt_ne_top"},"code":"/-- **Summable truncation tail with the closed window.** The `≤` variant of\n`tsum_measure_abs_sub_gt_sqrt_ne_top`: `∑' i, ρ {x : √i ≤ |x - θ|} < ∞`. This is what is needed for\nthe sampled tail term of the finite-variance LIL, because Mathlib's `truncation` uses the\nleft-open window `Ioc (-A) A`, so a value *equal* to `√i` in absolute value can still be off the\nwindow. Derived from the strict version by shifting the index: for `i ≥ 1`,\n`√i ≤ |x-θ| ⟹ √(i-1) < |x-θ|`, and the `i = 0` term is `ρ` of a set, hence finite. -/\nlemma tsum_measure_abs_sub_ge_sqrt_ne_top {ρ : Measure ℝ} [IsFiniteMeasure ρ] (θ : ℝ)\n    (hρ2 : MemLp (fun x ↦ x) 2 ρ) :\n    (∑' i : ℕ, ρ {x | √i ≤ |x - θ|}) ≠ ∞","proof":":= by\n  have hbound : ∀ i : ℕ,\n      ρ {x | √(↑(i + 1)) ≤ |x - θ|} ≤ ρ {x | √i < |x - θ|} := by\n    intro i\n    refine measure_mono fun x hx ↦ ?_\n    simp only [Set.mem_ofPred_eq] at hx ⊢\n    exact lt_of_lt_of_le\n      (Real.sqrt_lt_sqrt (Nat.cast_nonneg i) (by exact_mod_cast Nat.lt_succ_self i)) hx\n  rw [tsum_eq_zero_add' ENNReal.summable]\n  refine ENNReal.add_ne_top.mpr ⟨measure_ne_top _ _, ?_⟩\n  exact ne_top_of_le_ne_top (tsum_measure_abs_sub_gt_sqrt_ne_top θ hρ2)\n    (ENNReal.tsum_le_tsum hbound)","source":{"path":"AlphaRAR/Mathlib/TsumMeasureIoi.lean","start":95,"end":114,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/TsumMeasureIoi.lean#L95-L114"},"deps":[],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["ContinuousENorm.toENorm","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoid","mathlib","instance"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["ENNReal.instTop","mathlib","instance"],["ENNReal.instTopologicalSpace","mathlib","instance"],["HSub.hSub","lean4","definition"],["LE.le","lean4","definition"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.MemLp","mathlib","definition"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Real.sqrt","mathlib","definition"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedAddGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["SummationFilter.unconditional","mathlib","definition"],["Top.top","mathlib","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["abs","mathlib","definition"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["tsum","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","ContinuousENorm.toENorm","DFunLike.coe","ENNReal","ENNReal.instAddCommMonoid","ENNReal.instAddCommMonoidWithOne","ENNReal.instTop","ENNReal.instTopologicalSpace","HSub.hSub","LE.le","MeasureTheory.IsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","MeasureTheory.MemLp","Nat","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Ne","NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","NonUnitalSeminormedRing.toSeminormedAddCommGroup","NormedCommRing.toSeminormedCommRing","OfNat.ofNat","PseudoMetricSpace.toUniformSpace","Real","Real.instAddGroup","Real.instLE","Real.instNatCast","Real.instSub","Real.lattice","Real.measurableSpace","Real.normedCommRing","Real.pseudoMetricSpace","Real.sqrt","SeminormedAddCommGroup.toSeminormedAddGroup","SeminormedAddGroup.toContinuousENorm","SeminormedAddGroup.toPseudoMetricSpace","SeminormedCommRing.toNonUnitalSeminormedCommRing","Set","Set.ofPred","SummationFilter.unconditional","Top.top","UniformSpace.toTopologicalSpace","abs","instHSub","instOfNatAtLeastTwo","instOfNatNat","tsum"],"provenance":null,"edited":{"commit":"626a0ba966ded368c52c5fcad1f75afbe62507b6","date":"2026-09-01"}},{"id":380,"name":"AlphaRAR.tsum_measure_Ioi_ne_top","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.TsumMeasureIoi","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"39e102089a43680c","local":"f9d6a13a084fd97f","content":"7bfb42331b0d845d"},"doc":"**Layer-cake summability of tail measures, general measure.** For a finite measure `μ` and a\nmeasurable, integrable, nonnegative `X`, `∑' i, μ {ω : (i : ℝ) < X ω} < ∞`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure μ","typeRefs":[[0,29,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"Ω → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"head":"Measurable","implicit":false,"name":"hX","role":"hypothesis","type":"Measurable X","typeRefs":[[0,10,"Measurable"]]},{"explicit":true,"head":"MeasureTheory.Integrable","implicit":false,"name":"hint","role":"hypothesis","type":"MeasureTheory.Integrable X μ","typeRefs":[[0,24,"MeasureTheory.Integrable"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hnn","role":"hypothesis","type":"0 ≤ X","typeRefs":[[2,3,"LE.le"]]}],"conclusion":"∑' (i : ℕ), μ {ω | ↑i < X ω} ≠ ⊤","conclusionHead":"Ne","conclusionRefs":[[0,2,"tsum"],[8,9,"Nat"],[17,18,"Set.ofPred"],[22,23,"LT.lt"],[29,30,"Ne"],[31,32,"Top.top"]],"decl":"AlphaRAR.tsum_measure_Ioi_ne_top"},"code":"/-- **Layer-cake summability of tail measures, general measure.** For a finite measure `μ` and a\nmeasurable, integrable, nonnegative `X`, `∑' i, μ {ω : (i : ℝ) < X ω} < ∞`. -/\nlemma tsum_measure_Ioi_ne_top {Ω : Type*} {mΩ : MeasurableSpace Ω} {μ : Measure Ω}\n    [IsFiniteMeasure μ] {X : Ω → ℝ} (hX : Measurable X) (hint : Integrable X μ) (hnn : 0 ≤ X) :\n    (∑' i : ℕ, μ {ω | (i : ℝ) < X ω}) ≠ ∞","proof":":= by\n  have hmeas : ∀ i : ℕ, MeasurableSet {ω | (i : ℝ) < X ω} :=\n    fun i ↦ measurableSet_lt measurable_const hX\n  -- Rewrite each tail measure as a `lintegral` of an indicator, then swap sum and integral.\n  have hμ : ∀ i : ℕ, μ {ω | (i : ℝ) < X ω}\n      = ∫⁻ ω, {ω | (i : ℝ) < X ω}.indicator (1 : Ω → ℝ≥0∞) ω ∂μ :=\n    fun i ↦ (lintegral_indicator_one (hmeas i)).symm\n  rw [tsum_congr hμ,\n    ← lintegral_tsum fun i ↦ (measurable_one.indicator (hmeas i)).aemeasurable]\n  -- Pointwise: `∑_i 𝟙{i < X ω} = ⌈X ω⌉₊ ≤ ofReal(X ω) + 1`.\n  have hptw : ∀ ω, (∑' i : ℕ, {ω | (i : ℝ) < X ω}.indicator (1 : Ω → ℝ≥0∞) ω)\n      ≤ ENNReal.ofReal (X ω) + 1 := by\n    intro ω\n    have hindic : ∀ i : ℕ, {ω | (i : ℝ) < X ω}.indicator (1 : Ω → ℝ≥0∞) ω\n        = if i < ⌈X ω⌉₊ then 1 else 0 := by\n      intro i\n      by_cases hi : (i : ℝ) < X ω\n      · rw [Set.indicator_of_mem (show ω ∈ {ω | (i : ℝ) < X ω} from hi), Pi.one_apply,\n          ite_eq_left (Nat.lt_ceil.mpr hi)]\n      · rw [Set.indicator_of_notMem (show ω ∉ {ω | (i : ℝ) < X ω} from hi),\n          ite_eq_right fun h ↦ hi (Nat.lt_ceil.mp h)]\n    simp_rw [hindic]\n    rw [tsum_eq_sum (s := Finset.range ⌈X ω⌉₊)\n      fun i hi ↦ ite_eq_right (by rw [Finset.mem_range] at hi; omega)]\n    rw [Finset.sum_congr rfl fun i hi ↦ ite_eq_left (Finset.mem_range.mp hi), Finset.sum_const,\n      Finset.card_range, nsmul_eq_mul, mul_one]\n    calc (⌈X ω⌉₊ : ℝ≥0∞) = ENNReal.ofReal ⌈X ω⌉₊ := (ENNReal.ofReal_natCast _).symm\n      _ ≤ ENNReal.ofReal (X ω + 1) := ENNReal.ofReal_le_ofReal (Nat.ceil_lt_add_one (hnn ω)).le\n      _ = ENNReal.ofReal (X ω) + 1 := by\n          rw [ENNReal.ofReal_add (hnn ω) zero_le_one, ENNReal.ofReal_one]\n  refine ne_top_of_le_ne_top ?_ (lintegral_mono hptw)\n  rw [lintegral_add_right _ measurable_const, lintegral_one,\n    ← ofReal_integral_eq_lintegral_ofReal hint (Eventually.of_forall hnn)]\n  exact ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, measure_ne_top _ _⟩","source":{"path":"AlphaRAR/Mathlib/TsumMeasureIoi.lean","start":41,"end":78,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/TsumMeasureIoi.lean#L41-L78"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoid","mathlib","instance"],["ENNReal.instTop","mathlib","instance"],["ENNReal.instTopologicalSpace","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Ne","lean4","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Pi.hasLe","mathlib","instance"],["Pi.instZero","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["SummationFilter.unconditional","mathlib","definition"],["Top.top","mathlib","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["tsum","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DFunLike.coe","ENNReal","ENNReal.instAddCommMonoid","ENNReal.instTop","ENNReal.instTopologicalSpace","LE.le","LT.lt","Measurable","MeasurableSpace","MeasureTheory.Integrable","MeasureTheory.IsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","Nat","Nat.cast","Ne","NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","NonUnitalSeminormedRing.toSeminormedAddCommGroup","NormedCommRing.toSeminormedCommRing","OfNat.ofNat","Pi.hasLe","Pi.instZero","PseudoMetricSpace.toUniformSpace","Real","Real.instLE","Real.instLT","Real.instNatCast","Real.instZero","Real.measurableSpace","Real.normedCommRing","Real.pseudoMetricSpace","SeminormedAddCommGroup.toSeminormedAddGroup","SeminormedAddGroup.toContinuousENorm","SeminormedCommRing.toNonUnitalSeminormedCommRing","Set","Set.ofPred","SummationFilter.unconditional","Top.top","UniformSpace.toTopologicalSpace","Zero.toOfNat0","tsum"],"provenance":null,"edited":{"commit":"626a0ba966ded368c52c5fcad1f75afbe62507b6","date":"2026-09-01"}},{"id":381,"name":"AlphaRAR.tsum_measure_abs_sub_gt_sqrt_ne_top","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.TsumMeasureIoi","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"f1bdc372c1c3f8f1","local":"a7c03d23e5997821","content":"5fcd255a15c244ea"},"doc":"**Summable truncation tail** at the law level. For a finite measure `ρ` on `ℝ` with finite\nsecond moment, `∑' i, ρ {x : √i < |x - θ|} < ∞`. Since `√i < |x-θ| ⟺ i < (x-θ)²`, this is\n`tsum_measure_Ioi_ne_top` for `X = (· - θ)²`. Applied to a reward law `ρ = ν k` (with\n`θ = θ_k`) this bounds `∑_i ν_k(|· - θ_k| > √i)`. ","statement":{"binders":[{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"ρ","role":"variable","type":"MeasureTheory.Measure ℝ","typeRefs":[[0,21,"MeasureTheory.Measure"],[22,23,"Real"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure ρ","typeRefs":[[0,29,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"MeasureTheory.MemLp","implicit":false,"name":"hρ2","role":"hypothesis","type":"MeasureTheory.MemLp (fun x => x) 2 ρ","typeRefs":[[0,19,"MeasureTheory.MemLp"]]}],"conclusion":"∑' (i : ℕ), ρ {x | √↑i < |x - θ|} ≠ ⊤","conclusionHead":"Ne","conclusionRefs":[[0,2,"tsum"],[8,9,"Nat"],[17,18,"Set.ofPred"],[19,20,"Real.sqrt"],[23,24,"LT.lt"],[25,26,"abs"],[28,29,"HSub.hSub"],[31,32,"abs"],[34,35,"Ne"],[36,37,"Top.top"]],"decl":"AlphaRAR.tsum_measure_abs_sub_gt_sqrt_ne_top"},"code":"/-- **Summable truncation tail** at the law level. For a finite measure `ρ` on `ℝ` with finite\nsecond moment, `∑' i, ρ {x : √i < |x - θ|} < ∞`. Since `√i < |x-θ| ⟺ i < (x-θ)²`, this is\n`tsum_measure_Ioi_ne_top` for `X = (· - θ)²`. Applied to a reward law `ρ = ν k` (with\n`θ = θ_k`) this bounds `∑_i ν_k(|· - θ_k| > √i)`. -/\nlemma tsum_measure_abs_sub_gt_sqrt_ne_top {ρ : Measure ℝ} [IsFiniteMeasure ρ] (θ : ℝ)\n    (hρ2 : MemLp (fun x ↦ x) 2 ρ) :\n    (∑' i : ℕ, ρ {x | √i < |x - θ|}) ≠ ∞","proof":":= by\n  have hset : ∀ i : ℕ, {x | √i < |x - θ|} = {x | (i : ℝ) < (x - θ) ^ 2} := fun i ↦ by\n    ext x\n    rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, ← Real.sqrt_sq_eq_abs,\n      Real.sqrt_lt_sqrt_iff (Nat.cast_nonneg i)]\n  simp_rw [hset]\n  exact tsum_measure_Ioi_ne_top (by fun_prop) ((hρ2.sub (memLp_const _)).integrable_sq)\n    fun x ↦ sq_nonneg _","source":{"path":"AlphaRAR/Mathlib/TsumMeasureIoi.lean","start":80,"end":93,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/TsumMeasureIoi.lean#L80-L93"},"deps":[],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["ContinuousENorm.toENorm","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoid","mathlib","instance"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["ENNReal.instTop","mathlib","instance"],["ENNReal.instTopologicalSpace","mathlib","instance"],["HSub.hSub","lean4","definition"],["LT.lt","lean4","definition"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.MemLp","mathlib","definition"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddGroup","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Real.sqrt","mathlib","definition"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedAddGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["SummationFilter.unconditional","mathlib","definition"],["Top.top","mathlib","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["abs","mathlib","definition"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["tsum","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","ContinuousENorm.toENorm","DFunLike.coe","ENNReal","ENNReal.instAddCommMonoid","ENNReal.instAddCommMonoidWithOne","ENNReal.instTop","ENNReal.instTopologicalSpace","HSub.hSub","LT.lt","MeasureTheory.IsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","MeasureTheory.MemLp","Nat","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Ne","NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","NonUnitalSeminormedRing.toSeminormedAddCommGroup","NormedCommRing.toSeminormedCommRing","OfNat.ofNat","PseudoMetricSpace.toUniformSpace","Real","Real.instAddGroup","Real.instLT","Real.instNatCast","Real.instSub","Real.lattice","Real.measurableSpace","Real.normedCommRing","Real.pseudoMetricSpace","Real.sqrt","SeminormedAddCommGroup.toSeminormedAddGroup","SeminormedAddGroup.toContinuousENorm","SeminormedAddGroup.toPseudoMetricSpace","SeminormedCommRing.toNonUnitalSeminormedCommRing","Set","Set.ofPred","SummationFilter.unconditional","Top.top","UniformSpace.toTopologicalSpace","abs","instHSub","instOfNatAtLeastTwo","instOfNatNat","tsum"],"provenance":null,"edited":{"commit":"626a0ba966ded368c52c5fcad1f75afbe62507b6","date":"2026-09-01"}}]