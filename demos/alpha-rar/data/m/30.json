,"PseudoEMetricSpace.toUniformSpace","PseudoMetricSpace.toUniformSpace","Real","Real.borelSpace","Real.instMul","Real.measurableSpace","Real.metricSpace","Real.pseudoMetricSpace","UniformSpace.toTopologicalSpace","WeakEMetricSpace.toWeakPseudoEMetricSpace","WeakPseudoEMetricSpace.toEDist","instHMul"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":375,"name":"MeasureTheory.TendstoInDistribution.comp","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.TendstoInDistribution","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"7e72a965337b20dc","local":"63fd7fe89bd50d76","content":"2de8b0464a491787"},"doc":"**Convergence in distribution along a subsequence**: precomposing with any `c` tending to the\nfilter (a subsequence, for `atTop`) preserves convergence in distribution. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω'","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_4","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mE","role":"instance","type":"MeasurableSpace E","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"TopologicalSpace","implicit":false,"name":"","role":"instance","type":"TopologicalSpace E","typeRefs":[[0,16,"TopologicalSpace"]]},{"explicit":false,"head":"OpensMeasurableSpace","implicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E","typeRefs":[[0,20,"OpensMeasurableSpace"]]},{"explicit":false,"head":"Filter","implicit":true,"name":"l","role":"variable","type":"Filter ι","typeRefs":[[0,6,"Filter"]]},{"explicit":false,"implicit":true,"name":"μ","role":"variable","type":"ι → Measure Ω","typeRefs":[[4,11,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"∀ (i : ι), IsProbabilityMeasure (μ i)","typeRefs":[[11,31,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ'","role":"variable","type":"Measure Ω'","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ'","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"ι → Ω → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Z","role":"variable","type":"Ω' → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"κ","role":"type","type":"Type u_5","typeRefs":[]},{"explicit":false,"head":"Filter","implicit":true,"name":"v","role":"variable","type":"Filter κ","typeRefs":[[0,6,"Filter"]]},{"explicit":false,"implicit":true,"name":"c","role":"variable","type":"κ → ι","typeRefs":[]},{"explicit":true,"head":"MeasureTheory.TendstoInDistribution","implicit":false,"name":"h","role":"hypothesis","type":"TendstoInDistribution X l Z μ μ'","typeRefs":[[0,21,"MeasureTheory.TendstoInDistribution"]]},{"explicit":true,"head":"Filter.Tendsto","implicit":false,"name":"hc","role":"hypothesis","type":"Filter.Tendsto c v l","typeRefs":[[0,14,"Filter.Tendsto"]]}],"conclusion":"TendstoInDistribution (fun k => X (c k)) v Z (fun k => μ (c k)) μ'","conclusionHead":"MeasureTheory.TendstoInDistribution","conclusionRefs":[[0,21,"MeasureTheory.TendstoInDistribution"]],"decl":"MeasureTheory.TendstoInDistribution.comp"},"code":"/-- **Convergence in distribution along a subsequence**: precomposing with any `c` tending to the\nfilter (a subsequence, for `atTop`) preserves convergence in distribution. -/\nlemma _root_.MeasureTheory.TendstoInDistribution.comp {X : ι → Ω → E} {Z : Ω' → E}\n    {κ : Type*} {v : Filter κ} {c : κ → ι}\n    (h : TendstoInDistribution X l Z μ μ') (hc : Tendsto c v l) :\n    TendstoInDistribution (fun k ↦ X (c k)) v Z (fun k ↦ μ (c k)) μ'","proof":"where\n  forall_aemeasurable k := h.forall_aemeasurable (c k)\n  aemeasurable_limit := h.aemeasurable_limit\n  tendsto := h.tendsto.comp hc","source":{"path":"AlphaRAR/Mathlib/TendstoInDistribution.lean","start":60,"end":68,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/TendstoInDistribution.lean#L60-L68"},"deps":[],"outside":[],"external":[["Filter","mathlib","structure"],["Filter.Tendsto","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.TendstoInDistribution","mathlib","structure"],["OpensMeasurableSpace","mathlib","class"],["TopologicalSpace","mathlib","class"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Filter","Filter.Tendsto","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.TendstoInDistribution","OpensMeasurableSpace","TopologicalSpace"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":376,"name":"MeasureTheory.TendstoInDistribution.congr'","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.TendstoInDistribution","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"578e2d7d4e7ce021","local":"efffa43260bd6756","content":"0325b20afc652726"},"doc":"**Congruence for convergence in distribution**, with the sequence changed only eventually:\nif `X i = Y i` a.e. for all large `i`, `Z = T` a.e., and every `Y i` is a.e.-measurable, then\n`X i → Z` in distribution gives `Y i → T` in distribution. Mathlib's `TendstoInDistribution.congr`\nasks for `X i = Y i` at every index. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω'","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_4","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mE","role":"instance","type":"MeasurableSpace E","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"TopologicalSpace","implicit":false,"name":"","role":"instance","type":"TopologicalSpace E","typeRefs":[[0,16,"TopologicalSpace"]]},{"explicit":false,"head":"OpensMeasurableSpace","implicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E","typeRefs":[[0,20,"OpensMeasurableSpace"]]},{"explicit":false,"head":"Filter","implicit":true,"name":"l","role":"variable","type":"Filter ι","typeRefs":[[0,6,"Filter"]]},{"explicit":false,"implicit":true,"name":"μ","role":"variable","type":"ι → Measure Ω","typeRefs":[[4,11,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"∀ (i : ι), IsProbabilityMeasure (μ i)","typeRefs":[[11,31,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ'","role":"variable","type":"Measure Ω'","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ'","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"ι → Ω → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Y","role":"variable","type":"ι → Ω → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Z","role":"variable","type":"Ω' → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"T","role":"variable","type":"Ω' → E","typeRefs":[]},{"explicit":true,"head":"Filter.Eventually","implicit":false,"name":"hXY","role":"hypothesis","type":"∀ᶠ (i : ι) in l, X i =ᵐ[μ i] Y i","typeRefs":[[0,2,"Filter.Eventually"],[11,13,"Filter.Eventually"]]},{"explicit":true,"head":"Filter.EventuallyEq","implicit":false,"name":"hZT","role":"hypothesis","type":"Z =ᵐ[μ'] T","typeRefs":[]},{"explicit":true,"implicit":false,"name":"hY","role":"hypothesis","type":"∀ (i : ι), AEMeasurable (Y i) (μ i)","typeRefs":[[11,23,"AEMeasurable"]]},{"explicit":true,"head":"MeasureTheory.TendstoInDistribution","implicit":false,"name":"h","role":"hypothesis","type":"TendstoInDistribution X l Z μ μ'","typeRefs":[[0,21,"MeasureTheory.TendstoInDistribution"]]}],"conclusion":"TendstoInDistribution Y l T μ μ'","conclusionHead":"MeasureTheory.TendstoInDistribution","conclusionRefs":[[0,21,"MeasureTheory.TendstoInDistribution"]],"decl":"MeasureTheory.TendstoInDistribution.congr'"},"code":"/-- **Congruence for convergence in distribution**, with the sequence changed only eventually:\nif `X i = Y i` a.e. for all large `i`, `Z = T` a.e., and every `Y i` is a.e.-measurable, then\n`X i → Z` in distribution gives `Y i → T` in distribution. Mathlib's `TendstoInDistribution.congr`\nasks for `X i = Y i` at every index. -/\nlemma _root_.MeasureTheory.TendstoInDistribution.congr' {X Y : ι → Ω → E} {Z T : Ω' → E}\n    (hXY : ∀ᶠ i in l, X i =ᵐ[μ i] Y i) (hZT : Z =ᵐ[μ'] T) (hY : ∀ i, AEMeasurable (Y i) (μ i))\n    (h : TendstoInDistribution X l Z μ μ') : TendstoInDistribution Y l T μ μ'","proof":"where\n  forall_aemeasurable := hY\n  aemeasurable_limit := h.aemeasurable_limit.congr hZT\n  tendsto := by\n    have ht := h.tendsto\n    rw [show (⟨μ'.map Z, inferInstance⟩ :\n          ProbabilityMeasure E)\n        = ⟨μ'.map T, inferInstance⟩ from\n        Subtype.ext (Measure.map_congr hZT)] at ht\n    refine ht.congr' ?_\n    filter_upwards [hXY] with i hi\n    exact Subtype.ext (Measure.map_congr hi)","source":{"path":"AlphaRAR/Mathlib/TendstoInDistribution.lean","start":41,"end":58,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/TendstoInDistribution.lean#L41-L58"},"deps":[],"outside":[],"external":[["AEMeasurable","mathlib","definition"],["Filter","mathlib","structure"],["Filter.Eventually","mathlib","definition"],["Filter.EventuallyEq","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.TendstoInDistribution","mathlib","structure"],["MeasureTheory.ae","mathlib","definition"],["OpensMeasurableSpace","mathlib","class"],["TopologicalSpace","mathlib","class"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AEMeasurable","Filter","Filter.Eventually","Filter.EventuallyEq","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","MeasureTheory.Measure.instOuterMeasureClass","MeasureTheory.TendstoInDistribution","MeasureTheory.ae","OpensMeasurableSpace","TopologicalSpace"],"provenance":null,"ed