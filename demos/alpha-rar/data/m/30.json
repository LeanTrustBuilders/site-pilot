μ i)","typeRefs":[[11,45,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ'","role":"variable","type":"MeasureTheory.Measure Ω'","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ'","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"ι → Ω → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Z","role":"variable","type":"Ω' → E","typeRefs":[]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"ν","role":"variable","type":"MeasureTheory.Measure E","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure ν","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":true,"head":"ProbabilityTheory.HasLaw","implicit":false,"name":"hZ","role":"hypothesis","type":"ProbabilityTheory.HasLaw Z ν μ'","typeRefs":[[0,24,"ProbabilityTheory.HasLaw"]]}],"conclusion":"MeasureTheory.TendstoInDistribution X l id μ ν ↔ MeasureTheory.TendstoInDistribution X l Z μ μ'","conclusionHead":"Iff","conclusionRefs":[[0,35,"MeasureTheory.TendstoInDistribution"],[40,42,"id"],[47,48,"Iff"],[49,84,"MeasureTheory.TendstoInDistribution"]],"decl":"AlphaRAR.tendstoInDistribution_id_iff"},"code":"/-- **A limit can be named by a variable or by its law**: `X i → Z` in distribution exactly when\n`X i → id` in distribution on the law `ν` of `Z`. -/\nlemma tendstoInDistribution_id_iff {X : ι → Ω → E} {Z : Ω' → E} {ν : Measure E}\n    [IsProbabilityMeasure ν] (hZ : HasLaw Z ν μ') :\n    TendstoInDistribution X l id μ ν ↔ TendstoInDistribution X l Z μ μ'","proof":":= by\n  have hlim : (⟨ν.map id, inferInstance⟩ : ProbabilityMeasure E)\n      = ⟨μ'.map Z, inferInstance⟩ :=\n    Subtype.ext (show ν.map id = μ'.map Z by rw [Measure.map_id, hZ.map_eq])\n  constructor\n  · intro h\n    refine ⟨h.forall_aemeasurable, hZ.aemeasurable, ?_⟩\n    have ht := h.tendsto\n    rwa [hlim] at ht\n  · intro h\n    refine ⟨h.forall_aemeasurable, aemeasurable_id, ?_⟩\n    have ht := h.tendsto\n    rwa [← hlim] at ht","source":{"path":"AlphaRAR/Mathlib/TendstoInDistribution.lean","start":70,"end":86,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/TendstoInDistribution.lean#L70-L86"},"deps":[],"outside":[],"external":[["Filter","mathlib","structure"],["Iff","lean4","structure"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.TendstoInDistribution","mathlib","structure"],["OpensMeasurableSpace","mathlib","class"],["ProbabilityTheory.HasLaw","mathlib","structure"],["TopologicalSpace","mathlib","class"],["id","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Filter","Iff","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.TendstoInDistribution","OpensMeasurableSpace","ProbabilityTheory.HasLaw","TopologicalSpace","id"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":374,"name":"MeasureTheory.TendstoInDistribution.mul_of_tendstoInMeasure_const","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.TendstoInDistribution","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"13d1946fbfcf09dc","local":"b034c6f316755ee7","content":"c39a4472ed76e504"},"doc":"**Slutsky's theorem for a product**: if `X n → Z` in distribution and `Y n → c` in\nprobability, then `X n * Y n → Z * c` in distribution. The multiplicative twin of Mathlib's\n`TendstoInDistribution.add_of_tendstoInMeasure_const`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω'","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"Filter","implicit":true,"name":"l","role":"variable","type":"Filter ι","typeRefs":[[0,6,"Filter"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ'","role":"variable","type":"Measure Ω'","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ'","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"Ω''","role":"type","type":"Type u_5","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ''","role":"instance","type":"MeasurableSpace Ω''","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ''","role":"variable","type":"Measure Ω''","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ''","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"Filter.IsCountablyGenerated","implicit":false,"name":"","role":"instance","type":"l.IsCountablyGenerated","typeRefs":[[2,22,"Filter.IsCountablyGenerated"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"ι → Ω'' → ℝ","typeRefs":[[10,11,"Real"]]},{"explicit":false,"implicit":true,"name":"Y","role":"variable","type":"ι → Ω'' → ℝ","typeRefs":[[10,11,"Real"]]},{"explicit":false,"implicit":true,"nam