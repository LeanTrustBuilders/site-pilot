[{"id":104,"name":"ProbabilityTheory.memLp_two_of_hasCondDistrib","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.HasCondDistrib","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"55c583fda0168378","local":"6a7034149de716df","content":"758407baaf09d47c"},"doc":"**A conditionally-distributed real random variable is in `L²` as soon as its conditional laws\nhave uniformly bounded second moments.** Disintegrating,\n`∫⁻ ‖f‖ₑ² dP = ∫⁻ x, (∫⁻ ‖y‖ₑ² dκ x) d(P.map X) ≤ C * P univ`, which is finite as `P` is. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P","typeRefs":[[0,29,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":false,"implicit":true,"name":"𝓧","role":"type","type":"Type u_4","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"Ω → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"Ω → 𝓧","typeRefs":[]},{"explicit":false,"head":"ProbabilityTheory.Kernel","implicit":true,"name":"κ","role":"variable","type":"Kernel 𝓧 ℝ","typeRefs":[[0,6,"ProbabilityTheory.Kernel"],[9,10,"Real"]]},{"explicit":false,"head":"ProbabilityTheory.IsSFiniteKernel","implicit":false,"name":"","role":"instance","type":"IsSFiniteKernel κ","typeRefs":[[0,15,"ProbabilityTheory.IsSFiniteKernel"]]},{"explicit":false,"head":"ENNReal","implicit":true,"name":"C","role":"variable","type":"ENNReal","typeRefs":[[0,7,"ENNReal"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hC","role":"hypothesis","type":"C ≠ ⊤","typeRefs":[[2,3,"Ne"],[4,5,"Top.top"]]},{"explicit":true,"head":"ProbabilityTheory.HasCondDistrib","implicit":false,"name":"hcd","role":"hypothesis","type":"HasCondDistrib f X κ P","typeRefs":[[0,14,"ProbabilityTheory.HasCondDistrib"]]},{"explicit":true,"head":"MeasureTheory.AEStronglyMeasurable","implicit":false,"name":"hf","role":"hypothesis","type":"MeasureTheory.AEStronglyMeasurable f P","typeRefs":[[0,34,"MeasureTheory.AEStronglyMeasurable"]]},{"explicit":true,"implicit":false,"name":"hb","role":"hypothesis","type":"∀ (x : 𝓧), ∫⁻ (y : ℝ), ‖y‖ₑ ^ 2 ∂κ x ≤ C","typeRefs":[[11,13,"MeasureTheory.lintegral"],[19,20,"Real"],[23,24,"ENorm.enorm"],[25,27,"ENorm.enorm"],[28,29,"HPow.hPow"],[32,33,"MeasureTheory.lintegral"],[37,38,"LE.le"]]}],"conclusion":"MeasureTheory.MemLp f 2 P","conclusionHead":"MeasureTheory.MemLp","conclusionRefs":[[0,19,"MeasureTheory.MemLp"]],"decl":"ProbabilityTheory.memLp_two_of_hasCondDistrib"},"code":"/-- **A conditionally-distributed real random variable is in `L²` as soon as its conditional laws\nhave uniformly bounded second moments.** Disintegrating,\n`∫⁻ ‖f‖ₑ² dP = ∫⁻ x, (∫⁻ ‖y‖ₑ² dκ x) d(P.map X) ≤ C * P univ`, which is finite as `P` is. -/\nlemma memLp_two_of_hasCondDistrib {𝓧 : Type*} [MeasurableSpace 𝓧]\n    {f : Ω → ℝ} {X : Ω → 𝓧} {κ : Kernel 𝓧 ℝ} [IsSFiniteKernel κ] {C : ℝ≥0∞} (hC : C ≠ ⊤)\n    (hcd : HasCondDistrib f X κ P) (hf : AEStronglyMeasurable f P)\n    (hb : ∀ x, ∫⁻ y, ‖y‖ₑ ^ 2 ∂(κ x) ≤ C) :\n    MemLp f 2 P","proof":":= by\n  have hXm : AEMeasurable X P := hcd.aemeasurable_fst\n  refine (memLp_two_iff_integrable_sq hf).mpr ⟨hf.pow 2, ?_⟩\n  have hg : Measurable fun p : 𝓧 × ℝ ↦ ‖p.2‖ₑ ^ 2 := (measurable_snd.enorm).pow_const 2\n  have hkey : ∫⁻ ω, ‖f ω ^ 2‖ₑ ∂P = ∫⁻ p : 𝓧 × ℝ, ‖p.2‖ₑ ^ 2 ∂((P.map X) ⊗ₘ κ) := by\n    rw [← hcd.map_eq, lintegral_map' hg.aemeasurable hcd.aemeasurable]\n    exact lintegral_congr fun ω ↦ by rw [enorm_pow]\n  rw [hasFiniteIntegral_iff_enorm, hkey, Measure.lintegral_compProd hg]\n  calc ∫⁻ x, ∫⁻ y, ‖y‖ₑ ^ 2 ∂(κ x) ∂(P.map X) ≤ ∫⁻ _, C ∂(P.map X) := lintegral_mono hb\n    _ = C * (P.map X) Set.univ := by rw [lintegral_const]\n    _ < ⊤ := by\n        rw [Measure.map_apply_of_aemeasurable hXm MeasurableSet.univ, Set.preimage_univ]\n        exact ENNReal.mul_lt_top hC.lt_top (measure_lt_top P Set.univ)","source":{"path":"AlphaRAR/Mathlib/HasCondDistrib.lean","start":39,"end":58,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/HasCondDistrib.lean#L39-L58"},"deps":[],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["ContinuousENorm.toENorm","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.instLE","mathlib","instance"],["ENNReal.instTop","mathlib","instance"],["ENorm.enorm","mathlib","definition"],["HPow.hPow","lean4","definition"],["LE.le","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.AEStronglyMeasurable","mathlib","definition"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.MemLp","mathlib","definition"],["MeasureTheory.lintegral","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","m