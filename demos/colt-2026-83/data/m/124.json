ypeRefs":[[0,23,"SecondCountableTopology"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"V","role":"variable","type":"Ω → 𝓥","typeRefs":[]},{"explicit":false,"implicit":true,"name":"W","role":"variable","type":"Ω → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"𝓥 → E","typeRefs":[]},{"explicit":false,"head":"Real","implicit":true,"name":"C","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"ProbabilityTheory.IndepFun","implicit":false,"name":"hind","role":"hypothesis","type":"IndepFun V W P","typeRefs":[[0,8,"ProbabilityTheory.IndepFun"]]},{"explicit":true,"head":"AEMeasurable","implicit":false,"name":"hV","role":"hypothesis","type":"AEMeasurable V P","typeRefs":[[0,12,"AEMeasurable"]]},{"explicit":true,"head":"Measurable","implicit":false,"name":"hf","role":"hypothesis","type":"Measurable f","typeRefs":[[0,10,"Measurable"]]},{"explicit":true,"implicit":false,"name":"hC","role":"hypothesis","type":"∀ (v : 𝓥), ‖f v‖ ≤ C","typeRefs":[[11,12,"Norm.norm"],[15,16,"Norm.norm"],[17,18,"LE.le"]]},{"explicit":true,"head":"MeasureTheory.Integrable","implicit":false,"name":"hW","role":"hypothesis","type":"MeasureTheory.Integrable W P","typeRefs":[[0,24,"MeasureTheory.Integrable"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hW0","role":"hypothesis","type":"∫ (ω : Ω), W ω ∂P = 0","typeRefs":[[0,1,"MeasureTheory.integral"],[15,16,"MeasureTheory.integral"],[18,19,"Eq"]]}],"conclusion":"∫ (ω : Ω), inner ℝ (f (V ω)) (W ω) ∂P = 0","conclusionHead":"Eq","conclusionRefs":[[0,1,"MeasureTheory.integral"],[11,16,"Inner.inner"],[17,18,"Real"],[35,36,"MeasureTheory.integral"],[38,39,"Eq"]],"decl":"ProbabilityTheory.IndepFun.integral_inner_comp_eq_zero"},"code":"/-- **Blueprint `lem:indep_integral_zero`**: if `W` is integrable and centered, `V` is independent\nof `W` and `f` is bounded and measurable, then `E⟪f(V), W⟫ = 0`. -/\nlemma IndepFun.integral_inner_comp_eq_zero (hind : IndepFun V W P) (hV : AEMeasurable V P)\n    (hf : Measurable f) (hC : ∀ v, ‖f v‖ ≤ C) (hW : Integrable W P)\n    (hW0 : ∫ ω, W ω ∂P = 0) :\n    ∫ ω, ⟪f (V ω), W ω⟫ ∂P = 0","proof":":= by\n  have hWm : AEMeasurable W P := hW.aemeasurable\n  have hmap : P.map (fun ω ↦ (V ω, W ω)) = (P.map V).prod (P.map W) :=\n    (indepFun_iff_map_prod_eq_prod_map_map hV hWm).1 hind\n  have hWmap : Integrable (fun w : E ↦ w) (P.map W) :=\n    (integrable_map_measure aestronglyMeasurable_id hWm).2 hW\n  have hprob : IsProbabilityMeasure (P.map V) := inferInstance\n  have hmeas : ∀ μ : Measure (𝓥 × E), AEStronglyMeasurable (fun p : 𝓥 × E ↦ ⟪f p.1, p.2⟫) μ :=\n    fun μ ↦ (hf.comp measurable_fst).aestronglyMeasurable.inner\n      measurable_snd.aestronglyMeasurable\n  have hint : Integrable (fun p : 𝓥 × E ↦ ⟪f p.1, p.2⟫) ((P.map V).prod (P.map W)) := by\n    refine ((hWmap.norm.comp_snd (P.map V)).const_mul C).mono' (hmeas _)\n      (Filter.Eventually.of_forall fun p ↦ ?_)\n    rw [Real.norm_eq_abs]\n    exact (abs_real_inner_le_norm _ _).trans\n      (mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _))\n  calc ∫ ω, ⟪f (V ω), W ω⟫ ∂P\n      = ∫ p : 𝓥 × E, ⟪f p.1, p.2⟫ ∂(P.map (fun ω ↦ (V ω, W ω))) :=\n        (integral_map (hV.prodMk hWm) (hmeas _)).symm\n    _ = ∫ p : 𝓥 × E, ⟪f p.1, p.2⟫ ∂((P.map V).prod (P.map W)) := by rw [hmap]\n    _ = ∫ v, ∫ w, ⟪f v, w⟫ ∂(P.map W) ∂(P.map V) := integral_prod _ hint\n    _ = ∫ v, ⟪f v, ∫ w, w ∂(P.map W)⟫ ∂(P.map V) := by\n        exact integral_congr_ae (Filter.Eventually.of_forall fun v ↦ integral_inner hWmap (f v))\n    _ = 0 := by\n        have : ∫ w : E, w ∂(P.map W) = 0 := by\n          rw [integral_map (f := fun w : E ↦ w) hWm measurable_id.aestronglyMeasurable]\n          exact hW0\n        simp [this]","source":{"path":"Maiti2026Power/Mathlib/Probability/IndepIntegral.lean","start":43,"end":75,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/IndepIntegral.lean#L43-L75"},"deps":[],"outside":[],"external":[["AEMeasurable","mathlib","definition"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["BorelSpace","mathlib","class"],["CompleteSpace","mathlib","class"],["Eq","lean4","inductive"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.integral","mathlib","definition"],["NegZeroClass.toZero","mathlib","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.IndepFun","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["SecondCountableTopology","mathlib","class"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGr