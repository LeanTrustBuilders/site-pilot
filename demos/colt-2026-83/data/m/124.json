[[0,1,"Real"]]},{"explicit":true,"head":"AEMeasurable","implicit":false,"name":"hV","role":"hypothesis","type":"AEMeasurable V P","typeRefs":[[0,12,"AEMeasurable"]]},{"explicit":true,"head":"Measurable","implicit":false,"name":"hf","role":"hypothesis","type":"Measurable f","typeRefs":[[0,10,"Measurable"]]},{"explicit":true,"implicit":false,"name":"hC","role":"hypothesis","type":"∀ (v : 𝓥), ‖f v‖ ≤ C","typeRefs":[[11,12,"Norm.norm"],[15,16,"Norm.norm"],[17,18,"LE.le"]]},{"explicit":true,"head":"MeasureTheory.Integrable","implicit":false,"name":"hW","role":"hypothesis","type":"MeasureTheory.Integrable W P","typeRefs":[[0,24,"MeasureTheory.Integrable"]]}],"conclusion":"MeasureTheory.Integrable (fun ω => inner ℝ (f (V ω)) (W ω)) P","conclusionHead":"MeasureTheory.Integrable","conclusionRefs":[[0,24,"MeasureTheory.Integrable"],[35,40,"Inner.inner"],[41,42,"Real"]],"decl":"ProbabilityTheory.integrable_inner_comp"},"code":"/-- `⟪f (V ω), W ω⟫` is integrable when `W` is integrable and `f` is bounded and measurable. -/\nlemma integrable_inner_comp (hV : AEMeasurable V P) (hf : Measurable f) (hC : ∀ v, ‖f v‖ ≤ C)\n    (hW : Integrable W P) :\n    Integrable (fun ω ↦ ⟪f (V ω), W ω⟫) P","proof":":= by\n  refine (hW.norm.const_mul C).mono' ?_ (Filter.Eventually.of_forall fun ω ↦ ?_)\n  · exact ((hf.comp_aemeasurable hV).aestronglyMeasurable.inner hW.aestronglyMeasurable)\n  · rw [Real.norm_eq_abs]\n    exact (abs_real_inner_le_norm _ _).trans\n      (mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _))","source":{"path":"Maiti2026Power/Mathlib/Probability/IndepIntegral.lean","start":33,"end":41,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/IndepIntegral.lean#L33-L41"},"deps":[],"outside":[],"external":[["AEMeasurable","mathlib","definition"],["BorelSpace","mathlib","class"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","insta