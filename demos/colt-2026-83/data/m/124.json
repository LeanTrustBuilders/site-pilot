[{"id":1675,"name":"ProbabilityTheory.IndepFun.integral_inner_comp_eq_zero","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.IndepIntegral","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"ae4bcaac14c04b8b","local":"4aca15052805d924","content":"2520c47550efc2df"},"doc":"**Blueprint `lem:indep_integral_zero`**: if `W` is integrable and centered, `V` is independent\nof `W` and `f` is bounded and measurable, then `E⟪f(V), W⟫ = 0`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓥","role":"type","type":"Type u_2"},{"explicit":false,"name":"E","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"m𝓥","role":"instance","type":"MeasurableSpace 𝓥"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"CompleteSpace E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"BorelSpace E"},{"explicit":false,"name":"","role":"instance","type":"SecondCountableTopology E"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"V","role":"variable","type":"Ω → 𝓥"},{"explicit":false,"name":"W","role":"variable","type":"Ω → E"},{"explicit":false,"name":"f","role":"variable","type":"𝓥 → E"},{"explicit":false,"name":"C","role":"variable","type":"ℝ"},{"explicit":true,"name":"hind","role":"hypothesis","type":"IndepFun V W P"},{"explicit":true,"name":"hV","role":"hypothesis","type":"AEMeasurable V P"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"},{"explicit":true,"name":"hC","role":"hypothesis","type":"∀ (v : 𝓥), ‖f v‖ ≤ C"},{"explicit":true,"name":"hW","role":"hypothesis","type":"MeasureTheory.Integrable W P"},{"explicit":true,"name":"hW0","role":"hypothesis","type":"∫ (ω : Ω), W ω ∂P = 0"}],"conclusion":"∫ (ω : Ω), inner ℝ (f (V ω)) (W ω) ∂P = 0","decl":"ProbabilityTheory.IndepFun.integral_inner_comp_eq_zero"},"code":"/-- **Blueprint `lem:indep_integral_zero`**: if `W` is integrable and centered, `V` is independent\nof `W` and `f` is bounded and measurable, then `E⟪f(V), W⟫ = 0`. -/\nlemma IndepFun.integral_inner_comp_eq_zero (hind : IndepFun V W P) (hV : AEMeasurable V P)\n    (hf : Measurable f) (hC : ∀ v, ‖f v‖ ≤ C) (hW : Integrable W P)\n    (hW0 : ∫ ω, W ω ∂P = 0) :\n    ∫ ω, ⟪f (V ω), W ω⟫ ∂P = 0","proof":":= by\n  have hWm : AEMeasurable W P := hW.aemeasurable\n  have hmap : P.map (fun ω ↦ (V ω, W ω)) = (P.map V).prod (P.map W) :=\n    (indepFun_iff_map_prod_eq_prod_map_map hV hWm).1 hind\n  have hWmap : Integrable (fun w : E ↦ w) (P.map W) :=\n    (integrable_map_measure aestronglyMeasurable_id hWm).2 hW\n  have hprob : IsProbabilityMeasure (P.map V) := inferInstance\n  have hmeas : ∀ μ : Measure (𝓥 × E), AEStronglyMeasurable (fun p : 𝓥 × E ↦ ⟪f p.1, p.2⟫) μ :=\n    fun μ ↦ (hf.comp measurable_fst).aestronglyMeasurable.inner\n      measurable_snd.aestronglyMeasurable\n  have hint : Integrable (fun p : 𝓥 × E ↦ ⟪f p.1, p.2⟫) ((P.map V).prod (P.map W)) := by\n    refine ((hWmap.norm.comp_snd (P.map V)).const_mul C).mono' (hmeas _)\n      (Filter.Eventually.of_forall fun p ↦ ?_)\n    rw [Real.norm_eq_abs]\n    exact (abs_real_inner_le_norm _ _).trans\n      (mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _))\n  calc ∫ ω, ⟪f (V ω), W ω⟫ ∂P\n      = ∫ p : 𝓥 × E, ⟪f p.1, p.2⟫ ∂(P.map (fun ω ↦ (V ω, W ω))) :=\n        (integral_map (hV.prodMk hWm) (hmeas _)).symm\n    _ = ∫ p : 𝓥 × E, ⟪f p.1, p.2⟫ ∂((P.map V).prod (P.map W)) := by rw [hmap]\n    _ = ∫ v, ∫ w, ⟪f v, w⟫ ∂(P.map W) ∂(P.map V) := integral_prod _ hint\n    _ = ∫ v, ⟪f v, ∫ w, w ∂(P.map W)⟫ ∂(P.map V) := by\n        exact integral_congr_ae (Filter.Eventually.of_forall fun v ↦ integral_inner hWmap (f v))\n    _ = 0 := by\n        have : ∫ w : E, w ∂(P.map W) = 0 := by\n          rw [integral_map (f := fun w : E ↦ w) hWm measurable_id.aestronglyMeasurable]\n          exact hW0\n        simp [this]","source":{"path":"Maiti2026Power/Mathlib/Probability/IndepIntegral.lean","start":43,"end":75,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/IndepIntegral.lean#L43-L75"},"deps":[],"outside":[],"external":[["AEMeasurable","mathlib","definition"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["BorelSpace","mathlib","class"],["CompleteSpace","mathlib","class"],["Eq","lean4","inductive"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.integral","mathlib","definition"],["NegZeroClass.toZero","mathlib","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.IndepFun","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["SecondCountableTopology","mathlib","class"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1676,"name":"ProbabilityTheory.integrable_inner_comp","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.IndepIntegral","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"d5902fa7ce9ff4ac","local":"374b99b179843d55","content":"023d3c5a3a699a6d"},"doc":"`⟪f (V ω), W ω⟫` is integrable when `W` is integrable and `f` is bounded and measurable. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓥","role":"type","type":"Type u_2"},{"explicit":false,"name":"E","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"m𝓥","role":"instance","type":"MeasurableSpace 𝓥"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"BorelSpace E"},{"explicit":false,"name":"","role":"instance","type":"SecondCountableTopology E"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"V","role":"variable","type":"Ω → 𝓥"},{"explicit":false,"name":"W","role":"variable","type":"Ω → E"},{"explicit":false,"name":"f","role":"variable","type":"𝓥 → E"},{"explicit":false,"name":"C","role":"variable","type":"ℝ"},{"explicit":true,"name":"hV","role":"hypothesis","type":"AEMeasurable V P"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"},{"explicit":true,"name":"hC","role":"hypothesis","type":"∀ (v : 𝓥), ‖f v‖ ≤ C"},{"explicit":true,"name":"hW","role":"hypothesis","type":"MeasureTheory.Integrable W P"}],"conclusion":"MeasureTheory.Integrable (fun ω => inner ℝ (f (V ω)) (W ω)) P","decl":"ProbabilityTheory.integrable_inner_comp"},"code":"/-- `⟪f (V ω), W ω⟫` is integrable when `W` is integrable and `f` is bounded and measurable. -/\nlemma integrable_inner_comp (hV : AEMeasurable V P) (hf : Measurable f) (hC : ∀ v, ‖f v‖ ≤ C)\n    (hW : Integrable W P) :\n    Integrable (fun ω ↦ ⟪f (V ω), W ω⟫) P","proof":":= by\n  refine (hW.norm.const_mul C).mono' ?_ (Filter.Eventually.of_forall fun ω ↦ ?_)\n  · exact ((hf.comp_aemeasurable hV).aestronglyMeasurable.inner hW.aestronglyMeasurable)\n  · rw [Real.norm_eq_abs]\n    exact (abs_real_inner_le_norm _ _).trans\n      (mul_le_mul_of_nonneg_right (hC _) (norm_nonneg _))","source":{"path":"Maiti2026Power/Mathlib/Probability/IndepIntegral.lean","start":33,"end":41,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/IndepIntegral.lean#L33-L41"},"deps":[],"outside":[],"external":[["AEMeasurable","mathlib","definition"],["BorelSpace","mathlib","class"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.Measure","mathlib","structure"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["SecondCountableTopology","mathlib","class"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}}]