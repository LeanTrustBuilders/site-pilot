`\nto `P'`. -/\nlemma IsAlgEnvSeq.comp_hasLaw (h : IsAlgEnvSeq O X Y alg env P') (hg : HasLaw g P' P)\n    (hgm : Measurable g) :\n    IsAlgEnvSeq (fun n ↦ O n ∘ g) (fun n ↦ X n ∘ g) (fun n ↦ Y n ∘ g) alg env P","proof":"where\n  measurable_obs n := (h.measurable_obs n).comp hgm\n  measurable_action n := (h.measurable_action n).comp hgm\n  measurable_feedback n := (h.measurable_feedback n).comp hgm\n  hasCondDistrib_obs n := (h.hasCondDistrib_obs n).comp_hasLaw hg\n  hasCondDistrib_action n := (h.hasCondDistrib_action n).comp_hasLaw hg\n  hasCondDistrib_feedback n := (h.hasCondDistrib_feedback n).comp_hasLaw hg","source":{"path":"Maiti2026Power/LeanMachineLearning/Run.lean","start":47,"end":57,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/Run.lean#L47-L57"},"deps":[],"outside":[],"external":[["Function.comp","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.IsAlgEnvSeq","LeanMachineLearning","structure"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Nat","lean4","inductive"],["ProbabilityTheory.HasLaw","mathlib","structure"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Function.comp","Learning.Algorithm","Learning.Environment","Learning.IsAlgEnvSeq","Measurable","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.instIsZeroOrP