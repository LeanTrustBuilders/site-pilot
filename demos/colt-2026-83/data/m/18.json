,48,"Learning.IT.feedback"]],"decl":"Learning.measurable_history_traj"},"code":"/-- The history of the first `T` rounds of a trajectory `ℕ → Round 𝓞 𝓐 𝓨` is measurable. -/\nlemma measurable_history_traj (T : ℕ) :\n    Measurable (history (IT.obs (𝓞 := 𝓞) (𝓐 := 𝓐) (𝓨 := 𝓨)) IT.action IT.feedback T)","proof":":=\n  measurable_history IT.measurable_obs IT.measurable_action IT.measurable_feedback T","source":{"path":"Maiti2026Power/LeanMachineLearning/Run.lean","start":69,"end":72,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/Run.lean#L69-L72"},"deps":[],"outside":[],"external":[["Fin","lean4","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IT.action","LeanMachineLearning","definition"],["Learning.IT.feedback","LeanMachineLearning","definition"],["Learning.IT.obs","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Nat","lean4","inductive"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Fin","Learning.Hist","Learning.IT.action","Learning.IT.feedback","Learning.IT.obs","Learning.Round","Learning.history","Measurable","MeasurableSpace","MeasurableSpace.pi","Nat","Prod","Prod.instMeasurableSpace"],"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":267,"name":"Learning.IdentAlg.IsPAC.of_forall_isRun","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.Run","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"023fa51f0488f2aa","local":"0ffe4be84c00889a","content":"8f9ca3963f267173"},"doc":"**PAC from a bound on every run.** To prove that `A` is PAC at level `δ` it suffices to\nbound by `δ` the probability of a bad output for every run of `A` on a probability space in the\nuniverse of the canonical run `runMeasure` (the converse, for runs in any universe, is\n`IsPAC.measureReal_bad_of_isRun`). ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"𝓞","role":"type","type":"Type u","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓐","role":"type","type":"Type v","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓨","role":"type","type":"Type w","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓓","role":"type","type":"Type z","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"Learning.IdentAlg","implicit":true,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓","typeRefs":[[0,8,"Learning.IdentAlg"]]},{"explicit":false,"implicit":true,"name":"Θ","role":"type","type":"Type u_7","typeRefs":[]},{"explicit":false,"implicit":true,"name":"env","role":"variable","type":"Θ → Environment 𝓞 𝓐 𝓨","typeRefs":[[4,15,"Learning.Environment"]]},{"explicit":false,"implicit":true,"name":"bad","role":"type","type":"Θ → 𝓓 → Prop","typeRefs":[]},{"explicit":false,"head":"Real","implicit":true,"name":"δ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"implicit":false,"name":"hbad","role":"hypothesis","type":"∀ (θ : Θ), MeasurableSet {d | bad θ d}","typeRefs":[[11,24,"MeasurableSet"],[28,29,"Set.ofPred"]]},{"explicit":true,"implicit":false,"name":"h","role":"hypothesis","type":"∀ (θ : Θ) {Ω : Type (max u v w z)} {_mΩ : MeasurableSpace Ω} (P : MeasureTheory.Measure Ω)\n  [inst : MeasureTheory.IsProbabilityMeasure P] (O : ℕ → Ω → 𝓞) (X : ℕ → Ω → 𝓐) (Y : ℕ → Ω → 𝓨)\n  (out : Ω → 𝓓), A.IsRun (env θ) O X Y out P → P.real {ω | bad θ (out ω)} ≤ δ","typeRefs":[[42,57,"MeasurableSpace"],[66,87,"MeasureTheory.Measure"],[101,135,"MeasureTheory.IsProbabilityMeasure"],[144,145,"Nat"],[160,161,"Nat"],[176,177,"Nat"],[206,211,"Learning.IdentAlg.IsRun"],[236,240,"MeasureTheory.Measure.real"],[244,245,"Set.ofPred"],[261,262,"LE.le"]]}],"conclusion":"A.IsPAC env bad δ","conclusionHead":"Learning.IdentAlg.IsPAC","conclusionRefs":[[2,7,"Learning.IdentAlg.IsPAC"]],"decl":"Learning.IdentAlg.IsPAC.of_forall_isRun"},"code":"/-- **PAC from a bound on every run.** To prove that `A` is PAC at level `δ` it suffices to\nbound by `δ` the probability of a bad output for every run of `A` on a probability space in the\nuniverse of the canonical run `runMeasure` (the converse, for runs in any universe, is\n`IsPAC.measureReal_bad_of_isRun`). -/\nlemma IsPAC.of_forall_isRun {𝓞 : Type u} {𝓐 : Type v} {𝓨 : Type w} {𝓓 : Type z}\n    {m𝓞 : MeasurableSpace 𝓞} {m𝓐 : MeasurableSpace 𝓐} {m𝓨 : MeasurableSpace 𝓨}\n    {m𝓓 : MeasurableSpace 𝓓} {A : IdentAlg 𝓞 𝓐 𝓨 𝓓} {Θ : Type*} {env : Θ → Environment 𝓞 𝓐 𝓨}\n    {bad : Θ → 𝓓 → Prop} {δ : ℝ} (hbad : ∀ θ, MeasurableSet {d | bad θ d})\n    (h : ∀ θ, ∀ {Ω : Type (max u v w z)} {_mΩ : MeasurableSpace Ω} (P : Measure Ω)\n      [IsProbabilityMeasure P] (O : ℕ → Ω → 𝓞) (X : ℕ → Ω → 𝓐) (Y : ℕ → Ω → 𝓨) (out : Ω → 𝓓),\n      A.IsRun (env θ) O X Y out P → P.real {ω | bad θ (out ω)} ≤ δ) :\n    A.IsPAC env bad δ","proof":":= by\n  intro θ\n  have hrun := A.isRun_runMeasure (env θ)\n  rw [← hrun.hasLaw_output.measureReal_eq (hbad θ)]\n  exact h θ _ _ _ _ _ hrun","source":{"path":"Maiti2026Power/LeanMachineLearning/Run.lean","start":111,"end":126,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/Run.lean#L111-L126"},"deps":[],"outside":[],"external":[["LE.le","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Nat","lean4","inductive"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Set.ofPred","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["LE.le","Learning.Environment","Learning.IdentAlg","Learning.IdentAlg.IsPAC","Learning.IdentAlg.IsRun","MeasurableSet","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.Measure.real","MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","Nat","Real","Real.instLE","Set.ofPred"],"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":268,"name":"Learning.IdentAlg.isRun_runMeasure","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.Run","package":"Maiti2026Power","isProp":true,"h