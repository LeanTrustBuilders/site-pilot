":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":true,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓"}],"conclusion":"Measurable (A.stoppedHist IT.obs IT.action IT.feedback)","decl":"Learning.IdentAlg.measurable_stoppedHist_traj"},"code":"/-- The history at the stopping time of `A`, as a function of the trajectory\n`ℕ → Round 𝓞 𝓐 𝓨`, is measurable. -/\nlemma measurable_stoppedHist_traj :\n    Measurable (A.stoppedHist (IT.obs (𝓞 := 𝓞) (𝓐 := 𝓐) (𝓨 := 𝓨)) IT.action IT.feedback)","proof":":=\n  measurable_stoppedValue_sigmaHistory IT.measurable_obs IT.measurable_action\n    IT.measurable_feedback (measurable_hittingAfter_sigmaHistory IT.measurable_obs\n      IT.measurable_action IT.measurable_feedback A.measurableSet_stopSet)","source":{"path":"Maiti2026Power/LeanMachineLearning/Run.lean","start":78,"end":84,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/Run.lean#L78-L84"},"deps":[],"outside":[],"external":[["Fin","lean4","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IT.action","LeanMachineLearning","definition"],["Learning.IT.feedback","LeanMachineLearning","definition"],["Learning.IT.obs","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.stoppedHist","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Nat","lean4","inductive"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Sigma","lean4","structure"],["Sigma.instMeasurableSpace","mathlib","instance"]],"users":[],"sorr