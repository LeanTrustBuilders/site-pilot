ma","module":"Maiti2026Power.LeanMachineLearning.Run","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"b6fc0043e6c4c786","local":"b6c0e4f039bb01e1","content":"dfa50b7491e12ad9"},"doc":"A run of an identification algorithm is transported along a measurable map `g` carrying `P`\nto `P'`. ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_5"},{"explicit":false,"name":"Ω'","role":"type","type":"Type u_6"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"P'","role":"variable","type":"MeasureTheory.Measure Ω'"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P'"},{"explicit":false,"name":"g","role":"variable","type":"Ω → Ω'"},{"explicit":false,"name":"env","role":"variable","type":"Environment 𝓞 𝓐 𝓨"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω' → 𝓞"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω' → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω' → 𝓨"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓"},{"explicit":false,"name":"out","role":"variable","type":"Ω' → 𝓓"},{"expli