"doc":"The sub-Gaussian constant of a random variable can be increased. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"Ω → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"c","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"c'","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":true,"head":"ProbabilityTheory.HasSubgaussianMGF","implicit":false,"name":"h","role":"hypothesis","type":"HasSubgaussianMGF X c μ","typeRefs":[[0,17,"ProbabilityTheory.HasSubgaussianMGF"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hc","role":"hypothesis","type":"c ≤ c'","typeRefs":[[2,3,"LE.le"]]}],"conclusion":"HasSubgaussianMGF X c' μ","conclusionHead":"ProbabilityTheory.HasSubgaussianMGF","conclusionRefs":[[0,17,"ProbabilityTheory.HasSubgaussianMGF"]],"decl":"ProbabilityTheory.HasSubgaussianMGF.mono"},"code":"/-- The sub-Gaussian constant of a random variable can be increased. -/\nlemma HasSubgaussianMGF.mono (h : HasSubgaussianMGF X c μ) (hc : c ≤ c') :\n    HasSubgaussianMGF X c' μ","proof":"where\n  integrable_exp_mul := h.integrable_exp_mul\n  mgf_le t := (h.mgf_le t).trans (exp_le_exp.2 (by gcongr))","source":{"path":"Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean","start":38,"end":42,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean#L38-L42"},"deps":[],"outside":[],"external":[["LE.le","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["NNReal","mathlib","definition"],["NNReal.instPartialOrder","mathlib","instance"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLE","mathlib","instance"],["ProbabilityTheory.HasSubgaussianMGF","mathlib","structure"],["Real","mathlib","structure"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["LE.le","MeasurableSpace","MeasureTheory.Measure","NNReal","NNReal.instPartialOrder","PartialOrder.toPreorder","Preorder.toLE","ProbabilityTheory.HasSubgaussianMGF","Real"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1802,"name":"ProbabilityTheory.integral_iSup_inner_stdGaussian_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SubgaussianMax","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"658fa9dbabaea762","local":"33998c67c0fa025c","content":"a6aea35f6a324f27"},"doc":"**Expected maximum of Gaussian linear forms**: for finitely many vectors `y i` with\n`‖y i‖ ≤ σ`, `E[max_i ⟪y i, g⟫] ≤ σ √(2 log |ι|)` under the standard Gaussian measure. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"InnerProductSpace","implicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E","typeRefs":[[0,17,"InnerProductSpace"],[18,19,"Real"]]},{"explicit":false,"head":"FiniteDimensional","implicit":false,"name":"","role":"instance","type":"FiniteDimensional ℝ E","typeRefs":[[0,17,"FiniteDimensional"],[18,19,"Real"]]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace E","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"BorelSpace","implicit":false,"name":"","role":"instance","type":"BorelSpace E","typeRefs":[[0,10,"BorelSpace"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite ι","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty ι","typeRefs":[[0,8,"Nonempty"]]},{"explicit":false,"implicit":true,"name":"y","role":"variable","type":"ι → E","typeRefs":[]},{"explicit":false,"head":"Real","implicit":true,"name":"σ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"implicit":false,"name":"hσ","role":"hypothesis","type":"∀ (i : ι), ‖y i‖ ≤ σ","typeRefs":[[11,12,"Norm.norm"],[15,16,"Norm.norm"],[17,18,"LE.le"]]}],"conclusion":"∫ (x : E), ⨆ i, inner ℝ (y i) x ∂stdGaussian E ≤ σ * √(2 * Real.log ↑(Nat.card ι))","conclusionHead":"LE.le","conclusionRefs":[[0,1,"MeasureTheory.integral"],[16,21,"Inner.inner"],[22,23,"Real"],[32,33,"MeasureTheory.integral"],[33,44,"ProbabilityTheory.stdGaussian"],[47,48,"LE.le"],[51,52,"HMul.hMul"],[53,54,"Real.sqrt"],[57,58,"HMul.hMul"],[59,67,"Real.log"],[70,78,"Nat.card"]],"decl":"ProbabilityTheory.integral_iSup_inner_stdGaussian_le"},"code":"/-- **Expected maximum of Gaussian linear forms**: for finitely many vectors `y i` with\n`‖y i‖ ≤ σ`, `E[max_i ⟪y i, g⟫] ≤ σ √(2 log |ι|)` under the standard Gaussian measure. -/\nlemma integral_iSup_inner_stdGaussian_le (hσ : ∀ i, ‖y i‖ ≤ σ) :\n    ∫ x, ⨆ i, ⟪y i, x⟫ ∂stdGaussian E ≤ σ * √(2 * log (Nat.card ι))","proof":":= by\n  obtain ⟨i₀⟩ := ‹Nonempty ι›\n  have hσ0 : 0 ≤ σ := (norm_nonneg _).trans (hσ i₀)\n  have h : ∀ i, HasSubgaussianMGF (fun x ↦ ⟪y i, x⟫) (σ.toNNReal ^ 2) (stdGaussian E) :=\n    fun i ↦ (hasSubgaussianMGF_inner_stdGaussian (y i)).mono (by\n      rw [← NNReal.coe_le_coe]\n      push_cast\n      rw [Real.coe_toNNReal σ hσ0]\n      gcongr\n      exact hσ i)\n  refine (integral_iSup_le_of_hasSubgaussianMGF h).trans (le_of_eq ?_)\n  push_cast\n  rw [Real.coe_toNNReal σ hσ0,\n    show 2 * σ ^ 2 * log (Nat.card ι) = σ ^ 2 * (2 * log (Nat.card ι)) by ring,\n    Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hσ0]","source":{"path":"Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean","start":167,"end":184,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean#L167-L184"},"deps":[],"outside":[],"external":[["BorelSpace","mathlib","class"],["Finite","mathlib","class"],["FiniteDimensional","mathlib","definition"],["HMul.hMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.integral","mathlib","definition"],["Nat","lean4","inductive"],["Nat.card","mathlib","definition"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Nonempty","lean4","class"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedSpace.toModule","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.stdGaussian","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instDivisionRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.log","mathlib","definition"],["Real.normedAddCommGroup","mathlib","instance"],["Real.normedField","mathlib","instance"],["Real.sqrt","mathlib","definition"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["iSup","mathlib","definition"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["BorelSpace","Finite","FiniteDimensional","HMul.hMul","Inner.inner","InnerProductSpace","InnerProductSpace.toInner","InnerProductSpace.toNormedSpace","LE.le","MeasurableSpace","MeasureTheory.integral","Nat","Nat.card","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Nonempty","Norm.norm","NormedAddCommGroup","NormedAddCommGroup.toAddCommGroup","NormedAddCommGroup.toNorm","NormedAddCommGroup.toSeminormedAddCommGroup","NormedSpace.toModule","OfNat.ofNat","ProbabilityTheory.stdGaussian","PseudoMetricSpace.toUniformSpace","RCLike.toInnerProductSpaceReal","Real","Real.instDivisionRing","Real.instLE","Real.instMul","Real.instNatCast","Real.instRCLike","Real.instSupSet","Real.log","Real.normedAddCommGroup","Real.normedField","Real.sqrt","SeminormedAddCommGroup.toPseudoMetricSpace","UniformSpace.toTopologicalSpace","iSup","instHMul","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1803,"name":"ProbabilityTheory.integral_iSup_le_of_hasSubgaussianMGF","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SubgaussianMax","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"4de4503607aca793","local":"0b1e50545b848c22","content":"cd64f9c7ddc9a82c"},"doc":"**Expected maximum of finitely many sub-Gaussian variables**: if the `Z i`, `i ∈ ι` (finite,\nnonempty), have sub-Gaussian moment generating functions with constant `c` (no assumption on\ntheir joint law), then `E[max_i Z i] ≤ √(2 c log |ι|)`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"c","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite ι","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty ι","typeRefs":[[0,8,"Nonempty"]]},{"explicit":false,"implicit":true,"name":"Z","role":"variable","type":"ι → Ω → ℝ","typeRefs":[[8,9,"Real"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":true,"implicit":false,"name":"h","role":"hypothesis","type":"∀ (i : ι), HasSubgaussianMGF (Z i) c μ","typeRefs":[[11,28,"ProbabilityTheory.HasSubgaussianMGF"]]}],"conclusion":"∫ (x : Ω), (fun ω => ⨆ i, Z i ω) x ∂μ ≤ √(2 * ↑c * Real.log ↑(Nat.card ι))","conclusionHead":"LE.le","conclusionRefs":[[0,1,"MeasureTheory.integral"],[35,36,"MeasureTheory.integral"],[38,39,"LE.le"],[40,41,"Real.sqrt"],[44,45,"HMul.hMul"],[49,50,"HMul.hMul"],[51,59,"Real.log"],[62,70,"Nat.card"]],"decl":"ProbabilityTheory.integral_iSup_le_of_hasSubgaussianMGF"},"code":"/-- **Expected maximum of finitely many sub-Gaussian variables**: if the `Z i`, `i ∈ ι` (finite,\nnonempty), have sub-Gaussian moment generating functions with constant `c` (no assumption on\ntheir joint law), then `E[max_i Z i] ≤ √(2 c log |ι|)`. -/\nlemma integral_iSup_le_of_hasSubgaussianMGF [IsProbabilityMeasure μ]\n    (h : ∀ i, HasSubgaussianMGF (Z i) c μ) :\n    μ[fun ω ↦ ⨆ i, Z i ω] ≤ √(2 * c * log (Nat.card ι))","proof":":= by\n  have key : ∀ β : ℝ, 0 < β → μ[fun ω ↦ ⨆ i, Z i ω] ≤ log (Nat.card ι) / β + c * β / 2 :=\n    fun β hβ ↦ integral_iSup_le_of_hasSubgaussianMGF_aux h hβ\n  set L := log (Nat.card ι) with hL\n  have hL0 : 0 ≤ L := log_natCast_nonneg _\n  rcases eq_or_lt_of_le hL0 with hL0' | hLpos\n  · -- `log |ι| = 0`: let `β → 0`\n    rw [← hL0', mul_zero, Real.sqrt_zero]\n    refine le_of_forall_pos_lt_add fun ε hε ↦ ?_\n    have hβ : 0 < ε / (c + 1) := by positivity\n    refine (key _ hβ).trans_lt ?_\n    rw [← hL0', zero_div, zero_add]\n    have : (c : ℝ) * (ε / (c + 1)) ≤ ε := by\n      rw [mul_div_assoc', div_le_iff₀ (by positivity)]\n      nlinarith [hε.le]\n    linarith\n  rcases eq_zero_or_pos c with rfl | hcpos\n  · -- `c = 0`: let `β → ∞`\n    simp only [NNReal.coe_zero, mul_zero, zero_mul, Real.sqrt_zero]\n    refine le_of_forall_pos_lt_add fun ε hε ↦ ?_\n    have hβ : 0 < 2 * L / ε := by positivity\n    refine (key _ hβ).trans_lt ?_\n    have : L / (2 * L / ε) = ε / 2 := by\n      rw [div_div_eq_mul_div, div_eq_iff (by positivity)]\n      ring\n    simp only [NNReal.coe_zero, zero_mul, zero_div, add_zero, this]\n    linarith\n  · -- main case: `β = √(2 L / c)`\n    have hcpos' : (0 : ℝ) < c := hcpos\n    set s := √(2 * L / c) with hs_def\n    have hβ : 0 < s := by positivity\n    have hs2 : s ^ 2 = 2 * L / c := Real.sq_sqrt (by positivity)\n    have hs : √(2 * c * L) = c * s := by\n      calc √(2 * c * L) = √(c ^ 2 * (2 * L / c)) := by\n            congr 1\n            field_simp\n        _ = √(c ^ 2) * s := Real.sqrt_mul (sq_nonneg _) _\n        _ = c * s := by rw [Real.sqrt_sq hcpos'.le]\n    have hLs : L / s = c * s / 2 := by\n      rw [div_eq_iff hβ.ne']\n      have : (c : ℝ) * s / 2 * s = c * s ^ 2 / 2 := by ring\n      rw [this, hs2, mul_div_assoc', mul_div_cancel_left₀ _ hcpos'.ne']\n      ring\n    refine (key _ hβ).trans (le_of_eq ?_)\n    rw [hLs, hs]\n    ring","source":{"path":"Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean","start":96,"end":146,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean#L96-L146"},"deps":[],"outside":[],"external":[["Finite","mathlib","class"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.integral","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.toReal","mathlib","definition"],["Nat","lean4","inductive"],["Nat.card","mathlib","definition"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Nonempty","lean4","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.HasSubgaussianMGF","mathlib","structure"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.log","mathlib","definition"],["Real.normedAddCommGroup","mathlib","instance"],["Real.sqrt","mathlib","definition"],["iSup","mathlib","definition"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Finite","HMul.hMul","InnerProductSpace.toNormedSpace","LE.le","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.integral","NNReal","NNReal.toReal","Nat","Nat.card","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Nonempty","NormedAddCommGroup.toSeminormedAddCommGroup","OfNat.ofNat","ProbabilityTheory.HasSubgaussianMGF","RCLike.toInnerProductSpaceReal","Real","Real.instLE","Real.instMul","Real.instNatCast","Real.instRCLike","Real.instSupSet","Real.log","Real.normedAddCommGroup","Real.sqrt","iSup","instHMul","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1804,"name":"ProbabilityTheory.integral_iSup_le_of_hasSubgaussianMGF_aux","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SubgaussianMax","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"ca3d811c54e343ac","local":"3bd932930521d470","content":"f391d653e34c93a8"},"doc":"For every `β > 0`, `E[max_i Z i] ≤ log |ι| / β + c β / 2`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"c","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite ι","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty ι","typeRefs":[[0,8,"Nonempty"]]},{"explicit":false,"implicit":true,"name":"Z","role":"variable","type":"ι → Ω → ℝ","typeRefs":[[8,9,"Real"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":true,"implicit":false,"name":"h","role":"hypothesis","type":"∀ (i : ι), HasSubgaussianMGF (Z i) c μ","typeRefs":[[11,28,"ProbabilityTheory.HasSubgaussianMGF"]]},{"explicit":false,"head":"Real","implicit":true,"name":"β","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hβ","role":"hypothesis","type":"0 < β","typeRefs":[[2,3,"LT.lt"]]}],"conclusion":"∫ (x : Ω), (fun ω => ⨆ i, Z i ω) x ∂μ ≤ Real.log ↑(Nat.card ι) / β + ↑c * β / 2","conclusionHead":"LE.le","conclusionRefs":[[0,1,"MeasureTheory.integral"],[35,36,"MeasureTheory.integral"],[38,39,"LE.le"],[40,48,"Real.log"],[51,59,"Nat.card"],[63,64,"HDiv.hDiv"],[67,68,"HAdd.hAdd"],[72,73,"HMul.hMul"],[76,77,"HDiv.hDiv"]],"decl":"ProbabilityTheory.integral_iSup_le_of_hasSubgaussianMGF_aux"},"code":"/-- For every `β > 0`, `E[max_i Z i] ≤ log |ι| / β + c β / 2`. -/\nlemma integral_iSup_le_of_hasSubgaussianMGF_aux [IsProbabilityMeasure μ]\n    (h : ∀ i, HasSubgaussianMGF (Z i) c μ) {β : ℝ} (hβ : 0 < β) :\n    μ[fun ω ↦ ⨆ i, Z i ω] ≤ log (Nat.card ι) / β + c * β / 2","proof":":= by\n  have := Fintype.ofFinite ι\n  set M : Ω → ℝ := fun ω ↦ ⨆ i, Z i ω with hM\n  have hMint : Integrable M μ := integrable_iSup_of_hasSubgaussianMGF h\n  have hexp_le : ∀ ω, exp (β * M ω) ≤ ∑ i, exp (β * Z i ω) := fun ω ↦\n    exp_mul_iSup_le_sum β fun i ↦ Z i ω\n  have hsum_int : Integrable (fun ω ↦ ∑ i, exp (β * Z i ω)) μ :=\n    integrable_finsetSum _ fun i _ ↦ (h i).integrable_exp_mul β\n  have hexp_int : Integrable (fun ω ↦ exp (β * M ω)) μ := by\n    refine hsum_int.mono' ?_ (Filter.Eventually.of_forall fun ω ↦ ?_)\n    · exact (measurable_exp.comp_aemeasurable (hMint.aemeasurable.const_mul β)).aestronglyMeasurable\n    · rw [Real.norm_eq_abs, abs_of_pos (exp_pos _)]\n      exact hexp_le ω\n  -- Jensen: `exp (β E M) ≤ E exp (β M)`\n  have hjensen : exp (β * μ[M]) ≤ μ[fun ω ↦ exp (β * M ω)] := by\n    have h := convexOn_exp.map_integral_le continuous_exp.continuousOn isClosed_univ\n      (Filter.Eventually.of_forall fun ω ↦ Set.mem_univ _) (hMint.const_mul β) (by\n        simpa [Function.comp_def] using hexp_int)\n    simpa [integral_const_mul] using h\n  have hsum : μ[fun ω ↦ ∑ i, exp (β * Z i ω)] ≤ Nat.card ι * exp (c * β ^ 2 / 2) := by\n    rw [integral_finsetSum _ fun i _ ↦ (h i).integrable_exp_mul β, Nat.card_eq_fintype_card]\n    calc ∑ i, ∫ ω, exp (β * Z i ω) ∂μ ≤ ∑ _i : ι, exp (c * β ^ 2 / 2) :=\n          Finset.sum_le_sum fun i _ ↦ (h i).mgf_le β\n      _ = Fintype.card ι * exp (c * β ^ 2 / 2) := by simp\n  have hbound : exp (β * μ[M]) ≤ Nat.card ι * exp (c * β ^ 2 / 2) :=\n    hjensen.trans ((integral_mono hexp_int hsum_int hexp_le).trans hsum)\n  have hcard : (0 : ℝ) < Nat.card ι := by exact_mod_cast Nat.card_pos\n  have hlog : β * μ[M] ≤ log (Nat.card ι) + c * β ^ 2 / 2 := by\n    have := Real.log_le_log (exp_pos _) hbound\n    rwa [log_exp, log_mul hcard.ne' (exp_pos _).ne', log_exp] at this\n  have heq : log (Nat.card ι) / β + c * β / 2 = (log (Nat.card ι) + c * β ^ 2 / 2) / β := by\n    field_simp\n  rw [heq, le_div_iff₀ hβ, mul_comm]\n  exact hlog","source":{"path":"Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean","start":58,"end":94,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean#L58-L94"},"deps":[],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["Finite","mathlib","class"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.integral","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.toReal","mathlib","definition"],["Nat","lean4","inductive"],["Nat.card","mathlib","definition"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Nonempty","lean4","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.HasSubgaussianMGF","mathlib","structure"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Real.normedAddCommGroup","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["iSup","mathlib","definition"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DivInvMonoid.toDiv","Finite","HAdd.hAdd","HDiv.hDiv","HMul.hMul","InnerProductSpace.toNormedSpace","LE.le","LT.lt","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.integral","NNReal","NNReal.toReal","Nat","Nat.card","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Nonempty","NormedAddCommGroup.toSeminormedAddCommGroup","OfNat.ofNat","ProbabilityTheory.HasSubgaussianMGF","RCLike.toInnerProductSpaceReal","Real","Real.instAdd","Real.instDivInvMonoid","Real.instLE","Real.instLT","Real.instMul","Real.instNatCast","Real.instRCLike","Real.instSupSet","Real.instZero","Real.log","Real.normedAddCommGroup","Zero.toOfNat0","iSup","instHAdd","instHDiv","instHMul","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1805,"name":"ProbabilityTheory.gaussianWidth_stdGaussian_le_of_finite","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SubgaussianMax","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"60375690a779fc3c","local":"ab8f4ef6c05b822c","content":"4de4e7192d963d54"},"doc":"**Gaussian width of a finite set**: if `K` is finite, nonempty and contained in the ball of\nradius `σ`, then its Gaussian width under the standard Gaussian measure is at most\n`σ √(2 log |K|)`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"InnerProductSpace","implicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E","typeRefs":[[0,17,"InnerProductSpace"],[18,19,"Real"]]},{"explicit":false,"head":"FiniteDimensional","implicit":false,"name":"","role":"instance","type":"FiniteDimensional ℝ E","typeRefs":[[0,17,"FiniteDimensional"],[18,19,"Real"]]