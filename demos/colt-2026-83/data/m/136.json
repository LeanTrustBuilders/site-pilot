l","implicit":true,"name":"c","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite ι","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty ι","typeRefs":[[0,8,"Nonempty"]]},{"explicit":false,"implicit":true,"name":"Z","role":"variable","type":"ι → Ω → ℝ","typeRefs":[[8,9,"Real"]]},{"explicit":true,"implicit":false,"name":"h","role":"hypothesis","type":"∀ (i : ι), HasSubgaussianMGF (Z i) c μ","typeRefs":[[11,28,"ProbabilityTheory.HasSubgaussianMGF"]]}],"conclusion":"MeasureTheory.Integrable (fun ω => ⨆ i, Z i ω) μ","conclusionHead":"MeasureTheory.Integrable","conclusionRefs":[[0,24,"MeasureTheory.Integrable"]],"decl":"ProbabilityTheory.integrable_iSup_of_hasSubgaussianMGF"},"code":"/-- The maximum of finitely many sub-Gaussian random variables is integrable. -/\nlemma integrable_iSup_of_hasSubgaussianMGF (h : ∀ i, HasSubgaussianMGF (Z i) c μ) :\n    Integrable (fun ω ↦ ⨆ i, Z i ω) μ","proof":":= by\n  have := Fintype.ofFinite ι\n  refine (integrable_finsetSum Finset.univ fun i _ ↦ (h i).integrable.abs).mono' ?_ ?_\n  · exact aestronglyMeasurable_iff_aemeasurable.2\n      (AEMeasurable.iSup fun i ↦ (h i).aemeasurable)\n  · exact Filter.Eventually.of_forall fun ω ↦ by\n      simpa [Real.norm_eq_abs] using abs_le_sum_abs_iSup (fun i ↦ Z i ω)","source":{"path":"Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean","start":48,"end":56,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SubgaussianMax.lean#L48-L56"},"deps":[],"outside":[],"external":[["Finite","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.Measure","mathlib","structure"],["NNReal","ma