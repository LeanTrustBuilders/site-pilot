rs":[{"explicit":false,"head":"Real","implicit":true,"name":"m₁","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"m₂","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"v","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hv","role":"hypothesis","type":"v ≠ 0","typeRefs":[[2,3,"Ne"]]}],"conclusion":"(gaussianReal m₁ v).rnDeriv (gaussianReal m₂ v) =ᵐ[gaussianReal m₁ v] fun y =>\n  gaussianPDF m₁ v y / gaussianPDF m₂ v y","conclusionHead":"Filter.EventuallyEq","conclusionRefs":[[1,13,"ProbabilityTheory.gaussianReal"],[20,27,"MeasureTheory.Measure.rnDeriv"],[29,41,"ProbabilityTheory.gaussianReal"],[51,63,"ProbabilityTheory.gaussianReal"],[81,92,"ProbabilityTheory.gaussianPDF"],[100,101,"HDiv.hDiv"],[102,113,"ProbabilityTheory.gaussianPDF"]],"decl":"ProbabilityTheory.rnDeriv_gaussianReal_gaussianReal"},"code":"/-- The Radon-Nikodym derivative of a Gaussian measure with respect to another one with the same\nnonzero variance is the ratio of the densities. -/\nlemma rnDeriv_gaussianReal_gaussianReal (hv : v ≠ 0) :\n    ∂(gaussianReal m₁ v)/∂(gaussianReal m₂ v)\n      =ᵐ[gaussianReal m₁ v] fun y ↦ gaussianPDF m₁ v y / gaussianPDF m₂ v y","proof":":= by\n  refine (gaussianReal_absolutelyContinuous m₁ hv).ae_eq ?_\n  have h := Measure.rnDeriv_withDensity_right (gaussianReal m₁ v) volume\n    (measurable_gaussianPDF m₂ v).aemeasurable (ae_of_all _ fun x ↦ (gaussianPDF_pos _ hv x).ne')\n    (ae_of_all _ fun _ ↦ gaussianPDF_ne_top)\n  rw [← gaussianReal_of_var_ne_zero m₂ hv] at h\n  filter_upwards [h, rnDeriv_gaussianReal m₁ v] with y hy₁ hy₂\n  rw [hy₁, hy₂, ENNReal.div_eq_inv_mul]","source":{"path":"Maiti2026Power/Mathlib/Probability/KLGaussian.lean","start":40,"end":51,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/KLGaussian.lean#L40-L51"},"deps":[],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instDivInvMonoid","mathlib","instance"],["Filter.EventuallyEq","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.Measure.rnDeriv","mathlib","definition"],["MeasureTheory.ae","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.instZero","mathlib","instance"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.gaussianPDF","mathlib","definition"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["Real","mathlib","structure"],["Real.measurableSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DivInvMonoid.toDiv","ENNReal","ENNReal.instDivInvMonoid","Filter.EventuallyEq","HDiv.hDiv","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","MeasureTheory.Measure.instOuterMeasureClass","MeasureTheory.Measure.rnDeriv","MeasureTheory.ae","NNReal","NNReal.instZero","Ne","OfNat.ofNat","ProbabilityTheory.gaussianPDF","ProbabilityTheory.gaussianReal","Real","Real.measurableSpace","Zero.toOfNat0","instHDiv"],"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1685,"name":"ProbabilityTheory.klDiv_gaussianReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.KLGaussian","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"78f554e2f3b60d98","local":"3aae48b57e22bef4","content":"8c91dfcf15f84ad4"},"doc":"The Kullback-Leibler divergence between two Gaussian measures with the same nonzero\nvariance `v` and means `m₁`, `m₂` is `(m₁ - m₂) ^ 2 / (2 * v)`. ","statement":{"binders":[{"explicit":false,"head":"Real","implicit":true,"name":"m₁","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"m₂","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"v","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hv","role":"hypothesis","type":"v ≠ 0","typeRefs":[[2,3,"Ne"]]}],"conclusion":"InformationTheory.klDiv (gaussianReal m₁ v) (gaussianReal m₂ v) =\n  ENNReal.ofReal ((m₁ - m₂) ^ 2 / (2 * ↑v))","conclusionHead":"Eq","conclusionRefs":[[0,23,"InformationTheory.klDiv"],[25,37,"ProbabilityTheory.gaussianReal"],[45,57,"ProbabilityTheory.gaussianReal"],[64,65,"Eq"],[68,82,"ENNReal.ofReal"],[88,89,"HSub.hSub"],[94,95,"HPow.hPow"],[98,99,"HDiv.hDiv"],[103,104,"HMul.hMul"]],"decl":"ProbabilityTheory.klDiv_gaussianReal"},"code":"/-- The Kullback-Leibler divergence between two Gaussian measures with the same nonzero\nvariance `v` and means `m₁`, `m₂` is `(m₁ - m₂) ^ 2 / (2 * v)`. -/\nlemma klDiv_gaussianReal (hv : v ≠ 0) :\n    klDiv (gaussianReal m₁ v) (gaussianReal m₂ v) = ENNReal.ofReal ((m₁ - m₂) ^ 2 / (2 * v))","proof":":= by\n  rw [klDiv_of_ac_of_integrable (gaussianReal_absolutelyContinuous_gaussianReal hv)\n    (integrable_llr_gaussianReal hv), integral_congr_ae (llr_gaussianReal hv)]\n  have h_id : Integrable (fun y ↦ y) (gaussianReal m₁ v) :=\n    memLp_one_iff_integrable.mp (memLp_id_gaussianReal' 1 ENNReal.one_ne_top)\n  rw [integral_const_mul, integral_sub h_id (integrable_const _), integral_id_gaussianReal,\n    integral_const]\n  simp only [probReal_univ, one_smul, add_sub_cancel_right]\n  congr 1\n  ring","source":{"path":"Maiti2026Power/Mathlib/Probability/KLGaussian.lean","start":76,"end":88,"url":"https://github.com