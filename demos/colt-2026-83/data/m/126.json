[{"id":1682,"name":"ProbabilityTheory.gaussianReal_absolutelyContinuous_gaussianReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.KLGaussian","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"9cdf97ad3f991c2f","local":"db8f32569e54a3f8","content":"aeb47979f5cd7f2d"},"doc":"Two Gaussian measures with the same nonzero variance are mutually absolutely continuous. ","statement":{"binders":[{"explicit":false,"head":"Real","implicit":true,"name":"m₁","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"m₂","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"v","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hv","role":"hypothesis","type":"v ≠ 0","typeRefs":[[2,3,"Ne"]]}],"conclusion":"(gaussianReal m₁ v).AbsolutelyContinuous (gaussianReal m₂ v)","conclusionHead":"MeasureTheory.Measure.AbsolutelyContinuous","conclusionRefs":[[1,13,"ProbabilityTheory.gaussianReal"],[20,40,"MeasureTheory.Measure.AbsolutelyContinuous"],[42,54,"ProbabilityTheory.gaussianReal"]],"decl":"ProbabilityTheory.gaussianReal_absolutelyContinuous_gaussianReal"},"code":"/-- Two Gaussian measures with the same nonzero variance are mutually absolutely continuous. -/\nlemma gaussianReal_absolutelyContinuous_gaussianReal (hv : v ≠ 0) :\n    gaussianReal m₁ v ≪ gaussianReal m₂ v","proof":":=\n  (gaussianReal_absolutelyContinuous m₁ hv).trans (gaussianReal_absolutelyContinuous' m₂ hv)","source":{"path":"Maiti2026Power/Mathlib/Probability/KLGaussian.lean","start":35,"end":38,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/KLGaussian.lean#L35-L38"},"deps":[],"outside":[],"external":[["MeasureTheory.Measure.AbsolutelyContinuous","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.instZero","mathlib","instance"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["Real","mathlib","structure"],["Real.measurableSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["MeasureTheory.Measure.AbsolutelyContinuous","NNReal","NNReal.instZero","Ne","OfNat.ofNat","ProbabilityTheory.gaussianReal","Real","Real.measurableSpace","Zero.toOfNat0"],"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1683,"name":"ProbabilityTheory.llr_gaussianReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.KLGaussian","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"6da59e327c45ba7d","local":"8eb6c56c7c822ea4","content":"e7c139b0e5d46ab4"},"doc":"The log-likelihood ratio of a Gaussian measure with respect to another one with the same\nnonzero variance is an affine function. ","statement":{"binders":[{"explicit":false,"head":"Real","implicit":true,"name":"m₁","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"m₂","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"v","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hv","role":"hypothesis","type":"v ≠ 0","typeRefs":[[2,3,"Ne"]]}],"conclusion":"MeasureTheory.llr (gaussianReal m₁ v) (gaussianReal m₂ v) =ᵐ[gaussianReal m₁ v] fun y =>\n  (m₁ - m₂) / ↑v * (y - (m₁ + m₂) / 2)","conclusionHead":"Filter.EventuallyEq","conclusionRefs":[[0,17,"MeasureTheory.llr"],[19,31,"ProbabilityTheory.gaussianReal"],[39,51,"ProbabilityTheory.gaussianReal"],[61,73,"ProbabilityTheory.gaussianReal"],[95,96,"HSub.hSub"],[101,102,"HDiv.hDiv"],[106,107,"HMul.hMul"],[111,112,"HSub.hSub"],[117,118,"HAdd.hAdd"],[123,124,"HDiv.hDiv"]],"decl":"ProbabilityTheory.llr_gaussianReal"},"code":"/-- The log-likelihood ratio of a Gaussian measure with respect to another one with the same\nnonzero variance is an affine function. -/\nlemma llr_gaussianReal (hv : v ≠ 0) :\n    llr (gaussianReal m₁ v) (gaussianReal m₂ v)\n      =ᵐ[gaussianReal m₁ v] fun y ↦ (m₁ - m₂) / v * (y - (m₁ + m₂) / 2)","proof":":= by\n  have hv' : (0 : ℝ) < v := NNReal.coe_pos.mpr hv.bot_lt\n  filter_upwards [rnDeriv_gaussianReal_gaussianReal (m₁ := m₁) (m₂ := m₂) hv] with y hy\n  rw [llr, hy, ENNReal.toReal_div, gaussianPDF, gaussianPDF,\n    ENNReal.toReal_ofReal (gaussianPDFReal_nonneg _ _ _),\n    ENNReal.toReal_ofReal (gaussianPDFReal_nonneg _ _ _), gaussianPDFReal, gaussianPDFReal,\n    mul_div_mul_left _ _ (by positivity), ← Real.exp_sub, Real.log_exp]\n  field_simp\n  ring","source":{"path":"Maiti2026Power/Mathlib/Probability/KLGaussian.lean","start":53,"end":65,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/KLGaussian.lean#L53-L65"},"deps":[],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["Filter.EventuallyEq","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.ae","mathlib","definition"],["MeasureTheory.llr","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.instZero","mathlib","instance"],["NNReal.toReal","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","defini