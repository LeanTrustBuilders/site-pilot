[{"id":1272,"name":"Maiti2026Power.sum_mul_inner_sqrt_inv_sq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.WidthLower","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"295667904d21844d","local":"3799777582e1ac98","content":"4b5462a7bbc6b963"},"doc":"The whitened weighted family `(w x, A^{-1/2} x)` of a design `w` with positive definite\ndesign matrix `A` is in isotropic position: `∑ₓ w x ⟪A^{-1/2} x, v⟫² = ‖v‖²`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"DecidableEq","implicit":false,"name":"","role":"instance","type":"DecidableEq ι","typeRefs":[[0,11,"DecidableEq"]]},{"explicit":false,"head":"Finsupp","implicit":true,"name":"w","role":"variable","type":"EuclideanSpace ℝ ι →₀ ℝ","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"],[19,21,"Finsupp"],[22,23,"Real"]]},{"explicit":true,"head":"Matrix.PosDef","implicit":false,"name":"hA","role":"hypothesis","type":"(designMatrix w).PosDef","typeRefs":[[1,13,"Maiti2026Power.designMatrix"],[17,23,"Matrix.PosDef"]]},{"explicit":true,"head":"EuclideanSpace","implicit":false,"name":"v","role":"variable","type":"EuclideanSpace ℝ ι","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"]]}],"conclusion":"∑ x ∈ w.support, w x * inner ℝ ((Matrix.toEuclideanCLM (CFC.sqrt (designMatrix w)⁻¹)) x) v ^ 2 =\n  ‖v‖ ^ 2","conclusionHead":"Eq","conclusionRefs":[[8,15,"Finsupp.support"],[21,22,"HMul.hMul"],[23,28,"Inner.inner"],[29,30,"Real"],[33,54,"Matrix.toEuclideanCLM"],[56,64,"CFC.sqrt"],[66,78,"Maiti2026Power.designMatrix"],[81,83,"Inv.inv"],[91,92,"HPow.hPow"],[95,96,"Eq"],[99,100,"Norm.norm"],[101,102,"Norm.norm"],[103,104,"HPow.hPow"]],"decl":"Maiti2026Power.sum_mul_inner_sqrt_inv_sq"},"code":"/-- The whitened weighted family `(w x, A^{-1/2} x)` of a design `w` with positive definite\ndesign matrix `A` is in isotropic position: `∑ₓ w x ⟪A^{-1/2} x, v⟫² = ‖v‖²`. -/\nlemma sum_mul_inner_sqrt_inv_sq (hA : (designMatrix w).PosDef) (v : EuclideanSpace ℝ ι) :\n    ∑ x ∈ w.support,\n      w x * ⟪toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt (designMatrix w)⁻¹) x, v⟫ ^ 2 = ‖v‖ ^ 2","proof":":= by\n  set L := toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt (designMatrix w)⁻¹)\n  have h1 : ∑ x ∈ w.support, w x * ⟪L x, v⟫ ^ 2 =\n      WithLp.ofLp v ⬝ᵥ designMatrix (Finsupp.mapDomain L w) *ᵥ WithLp.ofLp v := by\n    rw [designMatrix_mapDomain, sum_mulVec, dotProduct_sum]\n    refine Finset.sum_congr rfl fun x _ ↦ ?_\n    rw [smul_mulVec, dotProduct_smul, smul_eq_mul, dotProduct_outerSelf_mulVec, real_inner_comm]\n  rw [h1, designMatrix_mapDomain_toEuclideanCLM, transpose_sqrt, hA.sqrt_inv_mul_mul_sqrt_inv,\n    one_mulVec, ← real_inner_self_eq_norm_sq, EuclideanSpace.inner_eq_star_dotProduct,\n    star_trivial]","source":{"path":"Maiti2026Power/MXJ2026/WidthLower.lean","start":37,"end":50,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthLower.lean#L37-L50"},"deps":[1082],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoid.toAddMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["AddZero.toZero","mathlib","instance"],["AddZeroClass.toAddZero","mathlib","instance"],["Algebra.id","mathlib","instance"],["Algebra.to_smulCommClass","mathlib","instance"],["CFC.sqrt","mathlib","definition"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["ContinuousFunctionalCalculus.toNonUnital","mathlib","instance"],["Continuo