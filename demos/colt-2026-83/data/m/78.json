","Real.instRCLike","Real.instRing","Real.instZero","Real.metricSpace","Real.norm","Real.normedAddCommGroup","Real.partialOrder","Real.pseudoMetricSpace","Real.semiring","Ring.toAddCommGroup","Ring.toSemiring","RingHom.id","SMulZeroClass.toSMul","Semifield.toCommSemiring","SemigroupAction.toSMul","SeminormedAddCommGroup.toIsTopologicalAddGroup","SeminormedAddCommGroup.toPseudoMetricSpace","SeminormedCommRing.toNonUnitalSeminormedCommRing","SeminormedCommRing.toSeminormedRing","SeminormedRing.toPseudoMetricSpace","Semiring.toAddCommMonoid","Semiring.toModule","Semiring.toMonoid","Semiring.toNonAssocSemiring","StarAddMonoid.toInvolutiveStar","StarAlgEquiv","StarAlgEquiv.instFunLike","StarRing.toStarAddMonoid","SubNegMonoid.toAddMonoid","SubNegZeroMonoid.toNegZeroClass","SubtractionCommMonoid.toSubtractionMonoid","SubtractionMonoid.toSubNegZeroMonoid","UniformContinuousConstSMul.instContinuousConstSMul","UniformSpace.toTopologicalSpace","WithLp.instAddCommGroup","WithLp.instDistribMulAction","WithLp.instModule","WithLp.instSMulCommClass","fact_one_le_two_ennreal","instContinuousStarReal","instDistribOfSemiring","instHMul","instHPow","instIsTopologicalRingReal","instMulZeroClassOfSemiring","instOfNatAtLeastTwo","instOfNatNat","instSMulOfMul","instStarRingReal","instTopologicalSpaceMatrix"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1273,"name":"Maiti2026Power.sqrt_log_le_gwMat","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.WidthLower","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"ab53c82864496ff4","local":"edead73d93b52388","content":"29819cce91bcfe81"},"doc":"**Sudakov minoration for a design matrix**: for a design `w` on `𝒳 ⊆ ℝ^d` with positive\ndefinite design matrix `A` and `d ≥ 4`, `gwMat 𝒳 A ≥ √(d log ⌊d/2⌋) / 8`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"DecidableEq","implicit":false,"name":"","role":"instance","type":"DecidableEq ι","typeRefs":[[0,11,"DecidableEq"]]},{"explicit":false,"head":"Set","implicit":true,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)","typeRefs":[[0,3,"Set"],[5,19,"EuclideanSpace"],[20,21,"Real"]]},{"explicit":false,"head":"Finsupp","implicit":true,"name":"w","role":"variable","type":"EuclideanSpace ℝ ι →₀ ℝ","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"],[19,21,"Finsupp"],[22,23,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"R","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Maiti2026Power.IsDesign","implicit":false,"name":"hw","role":"hypothesis","type":"IsDesign 𝒳 w","typeRefs":[[0,8,"Maiti2026Power.IsDesign"]]},{"explicit":true,"head":"Matrix.PosDef","implicit":false,"name":"hA","role":"hypothesis","type":"(designMatrix w).PosDef","typeRefs":[[1,13,"Maiti2026Power.designMatrix"],[17,23,"Matrix.PosDef"]]},{"explicit":true,"head":"Set.Nonempty","implicit":false,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty","typeRefs":[[2,10,"Set.Nonempty"]]},{"explicit":true,"implicit":false,"name":"hR","role":"hypothesis","type":"∀ x ∈ 𝒳, ‖x‖ ≤ R","typeRefs":[[9,10,"Norm.norm"],[11,12,"Norm.norm"],[13,14,"LE.le"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hd","role":"hypothesis","type":"4 ≤ Fintype.card ι","typeRefs":[[2,3,"LE.le"],[4,16,"Fintype.card"]]}],"conclusion":"√(↑(Fintype.card ι) * Real.log ↑(Fintype.card ι / 2)) / 8 ≤ gwMat 𝒳 (designMatrix w)","conclusionHead":"LE.le","conclusionRefs":[[0,1,"Real.sqrt"],[4,16,"Fintype.card"],[20,21,"HMul.hMul"],[22,30,"Real.log"],[33,45,"Fintype.card"],[48,49,"HDiv.hDiv"],[54,55,"HDiv.hDiv"],[58,59,"LE.le"],[60,65,"Maiti2026Power.gwMat"],[69,81,"Maiti2026Power.designMatrix"]],"decl":"Maiti2026Power.sqrt_log_le_gwMat"},"code":"/-- **Sudakov minoration for a design matrix**: for a design `w` on `𝒳 ⊆ ℝ^d` with positive\ndefinite design matrix `A` and `d ≥ 4`, `gwMat 𝒳 A ≥ √(d log ⌊d/2⌋) / 8`. -/\nlemma sqrt_log_le_gwMat (hw : IsDesign 𝒳 w) (hA : (designMatrix w).PosDef) (hne : 𝒳.Nonempty)\n    (hR : ∀ x ∈ 𝒳, ‖x‖ ≤ R) (hd : 4 ≤ Fintype.card ι) :\n    √(Fintype.card ι * log (Fintype.card ι / 2 : ℕ)) / 8 ≤ gwMat 𝒳 (designMatrix w)","proof":":= by\n  classical\n  set d := Fintype.card ι with hd_def\n  set m := d / 2 with hm_def\n  have hm2 : 2 ≤ m := by omega\n  have hmd : (m : ℝ) ≤ d / 2 := by rw [hm_def]; exact Nat.cast_div_le\n  have : Nonempty (Fin m) := ⟨⟨0, by omega⟩⟩\n  have hR0 : 0 ≤ R := nonneg_of_norm_le hne hR\n  set L := toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt (designMatrix w)⁻¹) with hL\n  -- separated points in the whitened support\n  have hiso : ∀ v, ∑ x : w.support, w x * ⟪L x, v⟫ ^ 2 = ‖v‖ ^ 2 := fun v ↦ by\n    rw [← sum_mul_inner_sqrt_inv_sq hA v]\n    exact Finset.sum_coe_sort w.support fun x ↦ w x * ⟪L x, v⟫ ^ 2\n  obtain ⟨t, -, ht⟩ := exists_separated_of_isotropic (u := fun x : w.support ↦ L x)\n    (w := fun x : w.support ↦ w x) (fun x ↦ hw.nonneg x)\n    (by rw [Finset.sum_coe_sort w.support fun x ↦ w x]; exact hw.sum_eq_one) hiso m\n  set y : Fin m → EuclideanSpace ℝ ι := fun k ↦ L (t k) with hy_def\n  have hsep : ∀ k l, k ≠ l → (d : ℝ) / 2 ≤ ‖y k - y l‖ ^ 2 := fun k l hkl ↦ by\n    refine le_trans ?_ (ht k l hkl)\n    rw [finrank_euclideanSpace]\n    linarith\n  have hy𝒳 : ∀ k, (t k : EuclideanSpace ℝ ι) ∈ w.support := fun k ↦ (t k).2\n  -- the Gaussian process over the separated points is below the support function\n  have hLR : ∀ x ∈ L '' 𝒳, ‖x‖ ≤ ‖L‖ * R := by\n    rintro _ ⟨x, hx, rfl⟩\n    exact (L.le_opNorm x).trans (mul_le_mul_of_nonneg_left (hR x hx) (norm_nonneg _))\n  have hy : ∀ k, ‖y k‖ ≤ ((‖L‖₊ * ‖R‖₊ : ℝ≥0) : ℝ) := fun k ↦ by\n    simp only [NNReal.coe_mul, coe_nnnorm, Real.norm_eq_abs, abs_of_nonneg hR0]\n    exact (L.le_opNorm _).trans\n      (mul_le_mul_of_nonneg_left (hR _ (hw.mem_of_mem_support (hy𝒳 k))) (norm_nonneg _))\n  have hyint : Integrable (fun g ↦ ⨆ k, ⟪y k, g⟫) (stdGaussian (EuclideanSpace ℝ ι)) := by\n    refine IsGaussian.integrable_of_abs_le_add_mul_norm (A := 0) (B := ‖L‖ * R)\n      (measurable_ciSup_inner y).aestronglyMeasurable fun g ↦ ?_\n    rw [zero_add]\n    simpa [abs_of_nonneg hR0] using abs_ciSup_inner_le hy g\n  have hA1 : ∫ g, ⨆ k, ⟪y k, g⟫ ∂stdGaussian (EuclideanSpace ℝ ι) ≤\n      gaussianWidth (L '' 𝒳) (stdGaussian (EuclideanSpace ℝ ι)) := by\n    refine integral_mono hyint (integrable_supportFn_of_isGaussian (hne.image L) hLR) fun g ↦ ?_\n    exact ciSup_le fun k ↦ inner_le_supportFn hLR ⟨t k, hw.mem_of_mem_support (hy𝒳 k), rfl⟩ g\n  -- the law of the Gaussian process is `N(0, C Cᵀ)` with `C` the matrix of rows `y k`\n  set C : Matrix (Fin m) ι ℝ := Matrix.of fun k j ↦ y k j with hC_def\n  have hCg : ∀ (g : EuclideanSpace ℝ ι) (k : Fin m),\n      (LinearMap.toContinuousLinearMap (toEuclideanLin C) g) k = ⟪y k, g⟫ := fun g k ↦ by\n    simp only [LinearMap.coe_toContinuousLinearMap', EuclideanSpace.inner_eq_star_dotProduct,\n      star_trivial, dotProduct]\n    rw [show (toEuclideanLin C g) k = (C *ᵥ WithLp.ofLp g) k from rfl]\n    simp only [mulVec, dotProduct, hC_def, Matrix.of_apply]\n    exact Finset.sum_congr rfl fun j _ ↦ mul_comm _ _\n  have hCC : ∀ k l, (C * Cᵀ) k l = ⟪y k, y l⟫ := fun k l ↦ by\n    simp only [mul_apply, transpose_apply, hC_def, Matrix.of_apply,\n      EuclideanSpace.inner_eq_star_dotProduct, star_trivial, dotProduct]\n    exact Finset.sum_congr rfl fun j _ ↦ mul_comm _ _\n  have hlaw : (stdGaussian (EuclideanSpace ℝ ι)).map\n      (LinearMap.toContinuousLinearMap (toEuclideanLin C)) = multivariateGaussian 0 (C * Cᵀ) := by\n    rw [← multivariateGaussian_zero_one, multivariateGaussian_zero_map_toEuclideanLin\n      PosSemidef.one, Matrix.mul_one]\n  have hB : ∫ g, ⨆ k, ⟪y k, g⟫ ∂stdGaussian (EuclideanSpace ℝ ι) =\n      ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (C * Cᵀ) := by\n    rw [← hlaw, integral_map (by fun_prop) measurable_ciSup_apply.aestronglyMeasurable]\n    simp_rw [hCg]\n  -- Sudakov–Fernique comparison with `√(d/4)` times independent standard Gaussians\n  set c : ℝ := √d / 2 with hc_def\n  have hc0 : 0 ≤ c := by positivity\n  have hc : c ^ 2 = d / 4 := by\n    rw [hc_def, div_pow, Real.sq_sqrt (Nat.cast_nonneg d)]\n    ring\n  have hSF : ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (c ^ 2 • (1 : Matrix (Fin m) (Fin m) ℝ)) ≤\n      ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (C * Cᵀ) := by\n    refine sudakov_fernique (PosSemidef.one.smul (by positivity)) ?_ fun k l ↦ ?_\n    · simpa [conjTranspose_eq_transpose_of_trivial] using posSemidef_self_mul_conjTranspose C\n    · rw [hCC, hCC, hCC]\n      by_cases hkl : k = l\n      · subst hkl\n        simp only [Matrix.smul_apply, one_apply_eq, smul_eq_mul, mul_one]\n        linarith\n      · have h1 := hsep k l hkl\n        rw [norm_sub_sq_real, real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq] at *\n        simp only [Matrix.smul_apply, one_apply_eq, one_apply_ne hkl, smul_eq_mul, mul_one,\n          mul_zero, hc]\n        linarith\n  have hD : ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (c ^ 2 • (1 : Matrix (Fin m) (Fin m) ℝ)) =\n      c * ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (1 : Matrix (Fin m) (Fin m) ℝ) := by\n    rw [← multivariateGaussian_zero_map_smul PosSemidef.one c,\n      integral_map (by fun_prop) measurable_ciSup_apply.aestronglyMeasurable, ← integral_const_mul]\n    congr 1\n    ext x\n    rw [Real.mul_iSup_of_nonneg hc0]\n    simp\n  have hE : √(log m) / 4 ≤\n      ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (1 : Matrix (Fin m) (Fin m) ℝ) := by\n    rw [multivariateGaussian_zero_one, ← map_pi_eq_stdGaussian,\n      integral_map (by fun_prop) measurable_ciSup_apply.aestronglyMeasurable]\n    have := sqrt_log_div_four_le_integral_iSup_pi_gaussianReal (ι := Fin m) (by simpa using hm2)\n    simpa using this\n  rw [gwMat_eq_gaussianWidth_stdGaussian hne hR]\n  calc √(d * log m) / 8 = c * (√(log m) / 4) := by\n        rw [Real.sqrt_mul (Nat.cast_nonneg d), hc_def]\n        ring\n    _ ≤ c * ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (1 : Matrix (Fin m) (Fin m) ℝ) := by gcongr\n    _ = ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (c ^ 2 • (1 : Matrix (Fin m) (Fin m) ℝ)) := hD.symm\n    _ ≤ ∫ x, ⨆ k, x k ∂multivariateGaussian 0 (C * Cᵀ) := hSF\n    _ = ∫ g, ⨆ k, ⟪y k, g⟫ ∂stdGaussian (EuclideanSpace ℝ ι) := hB.symm\n    _ ≤ gaussianWidth (L '' 𝒳) (stdGaussian (EuclideanSpace ℝ ι)) := hA1","source":{"path":"Maiti2026Power/MXJ2026/WidthLower.lean","start":52,"end":158,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthLower.lean#L52-L158"},"deps":[1066,1082,1254],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Finset","mathlib","structure"],["Finset.instSetLike","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finsupp","mathlib","structure"],["Finsupp.instAddCommMonoid","mathlib","instance"],["Finsupp.instFunLike","mathlib","instance"],["Finsupp.linearCombination","mathlib","definition"],["Finsupp.module","mathlib","instance"],["Finsupp.support","mathlib","definition"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["Inv.inv","lean4","definition"],["LE.le","lean4","definition"],["LinearMa