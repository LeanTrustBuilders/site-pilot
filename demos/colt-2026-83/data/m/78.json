edAddCommGroup","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Real.sqrt","mathlib","definition"],["RingHom.id","mathlib","definition"],["Semiring.toModule","mathlib","instance"],["Semiring.toNonAssocSemiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Nonempty","mathlib","definition"],["Set.instLE","mathlib","instance"],["Set.instMembership","mathlib","instance"],["SetLike.coe","mathlib","definition"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["Subtype.val","lean4","definition"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.measurableSpace","mathlib","instance"],["WithLp.ofLp","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["iSup","mathlib","definition"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instLENat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","DFunLike.coe","DecidableEq","DivInvMonoid.toDiv","ENNReal","ENNReal.instAddCommMonoidWithOne","EuclideanSpace","Finsupp","Finsupp.instAddCommMonoid","Finsupp.module","Fintype","Fintype.card","HDiv.hDiv","HMul.hMul","LE.le","LinearMap","LinearMap.instFunLike","Matrix","Matrix.PosDef","Matrix.addCommMonoid","Matrix.module","Membership.mem","Nat","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instDiv","Nat.instNeZeroSucc","Norm.norm","OfNat.ofNat","PiLp.innerProductSpace._proof_1","PiLp.instNorm","Real","Real.instAddCommMonoid","Real.instDivInvMonoid","Real.instLE