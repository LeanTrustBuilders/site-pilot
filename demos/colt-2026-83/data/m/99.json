ionTheory.klBerReal"]]},"code":"/-- The Kullback-Leibler divergence between Bernoulli distributions with parameters `p` and `q`,\nin `ℝ≥0∞`: it is `ENNReal.ofReal (klBerReal p q)`, except that it is infinite when `q ∈ {0, 1}`\nand `p ≠ q`, where the Bernoulli measures are not absolutely continuous. -/\nnoncomputable def klBer (p q : ℝ) : ℝ≥0∞ :=\n  if q = 0 then (if p = 0 then 0 else ∞)\n  else if q = 1 then (if p = 1 then 0 else ∞)\n  else ENNReal.ofReal (klBerReal p q)","proof":"","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/KLBer.lean","start":66,"end":72,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/KLBer.lean#L66-L72"},"deps":[1434],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instTop","mathlib","instance"],["ENNReal.instZero","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.decidableEq","mathlib","instance"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Top.top","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["ite","lean4","definition"]],"users":[1433,1436,1437,1438,1440,1441,1443,1445,1449,1453],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characteriza