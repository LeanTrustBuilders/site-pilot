[{"id":1790,"name":"ProbabilityTheory.hasDerivAt_gaussianPDFReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"206568bc1181b729","local":"9da1f3ab5db6976c","content":"aacf40a18ec3bc0a"},"doc":"The derivative of the Gaussian density `φ = gaussianPDFReal μ v` is\n`φ' x = -((x - μ) / v) * φ x`. Also true (as `0 = 0`) for `v = 0`. ","statement":{"binders":[{"explicit":true,"name":"μ","role":"variable","type":"ℝ"},{"explicit":true,"name":"v","role":"variable","type":"NNReal"},{"explicit":true,"name":"x","role":"variable","type":"ℝ"}],"conclusion":"HasDerivAt (gaussianPDFReal μ v) (-((x - μ) / ↑v) * gaussianPDFReal μ v x) x","decl":"ProbabilityTheory.hasDerivAt_gaussianPDFReal"},"code":"/-- The derivative of the Gaussian density `φ = gaussianPDFReal μ v` is\n`φ' x = -((x - μ) / v) * φ x`. Also true (as `0 = 0`) for `v = 0`. -/\nlemma hasDerivAt_gaussianPDFReal (μ : ℝ) (v : ℝ≥0) (x : ℝ) :\n    HasDerivAt (gaussianPDFReal μ v) (-((x - μ) / v) * gaussianPDFReal μ v x) x","proof":":= by\n  simp only [gaussianPDFReal]\n  have h : HasDerivAt (fun y ↦ -(y - μ) ^ 2 / (2 * v)) (-(x - μ) / v) x := by\n    refine ((((hasDerivAt_id' x).sub_const μ).fun_pow 2).fun_neg.div_const\n      (2 * (v : ℝ))).congr_deriv ?_\n    norm_num\n    ring\n  refine (h.exp.const_mul (√(2 * π * v))⁻¹).congr_deriv ?_\n  ring","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":35,"end":46,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L35-L46"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddZero.toZero","mathlib","instance"],["AddZeroClass.toAddZero","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["DistribMulAction.toDistribSMul","mathlib","instance"],["DistribSMul.toSMulZeroClass","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["Field.toSemifield","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["HasDerivAt","mathlib","definition"],["IsModuleTopology.toContinuousSMul","mathlib","instance"],["IsTopologicalRing.toIsTopologicalSemiring","mathlib","instance"],["IsTopologicalSemiring.toIsModuleTopology","mathlib","instance"],["Module.toDistribMulAction","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.toReal","mathlib","definition"],["Neg.neg","lean4","definition"],["NonUnitalCommRing.toNonUnitalNonAssocCommRing","mathlib","instance"],["NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["NormedField.toField","mathlib","instance"],["NormedField.toNormedCommRing","mathlib","instance"],["ProbabilityTheory.gaussianPDFReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.denselyNormedField","mathlib","instance"],["Real.instAdd","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNeg","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Real.semiring","mathlib","instance"],["SMulZeroClass.toSMul","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SeminormedCommRing.toSeminormedRing","mathlib","instance"],["SeminormedRing.toPseudoMetricSpace","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["Semiring.toMonoid","mathlib","instance"],["SubNegMonoid.toAddMonoid","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["instIsTopologicalRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1791,"name":"ProbabilityTheory.integral_mul_gaussianReal_zero_one","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"51885b83931d3e73","local":"2ccd771eb8c94b40","content":"e67a92a12ec95106"},"doc":"**Stein's identity** for the standard Gaussian: `E[ξ f(ξ)] = E[f'(ξ)]` when `f` is\ndifferentiable with bounded derivative. ","statement":{"binders":[{"explicit":false,"name":"f","role":"variable","type":"ℝ → ℝ"},{"explicit":false,"name":"L","role":"variable","type":"ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Differentiable ℝ f"},{"explicit":true,"name":"hL","role":"hypothesis","type":"∀ (x : ℝ), |deriv f x| ≤ L"}],"conclusion":"∫ (x : ℝ), x * f x ∂gaussianReal 0 1 = ∫ (x : ℝ), deriv f x ∂gaussianReal 0 1","decl":"ProbabilityTheory.integral_mul_gaussianReal_zero_one"},"code":"/-- **Stein's identity** for the standard Gaussian: `E[ξ f(ξ)] = E[f'(ξ)]` when `f` is\ndifferentiable with bounded derivative. -/\nlemma integral_mul_gaussianReal_zero_one (hf : Differentiable ℝ f) (hL : ∀ x, |deriv f x| ≤ L) :\n    ∫ x, x * f x ∂gaussianReal 0 1 = ∫ x, deriv f x ∂gaussianReal 0 1","proof":":= by\n  simpa using integral_sub_mul_gaussianReal hf hL 0 1","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":138,"end":142,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L138-L142"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["Differentiable","mathlib","definition"],["Eq","lean4","inductive"],["Field.toSemifield","mathlib","instance"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["MeasureTheory.integral","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedField.toField","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["abs","mathlib","definition"],["deriv","mathlib","definition"],["instHMul","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1792,"name":"ProbabilityTheory.integrable_deriv_gaussianReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"7df751ae2ad5ebe2","local":"0112027aeb5def0d","content":"842330e300bb9715"},"doc":"A bounded derivative is integrable under `gaussianReal μ v`. ","statement":{"binders":[{"explicit":false,"name":"f","role":"variable","type":"ℝ → ℝ"},{"explicit":false,"name":"L","role":"variable","type":"ℝ"},{"explicit":true,"name":"hL","role":"hypothesis","type":"∀ (x : ℝ), |deriv f x| ≤ L"},{"explicit":true,"name":"μ","role":"variable","type":"ℝ"},{"explicit":true,"name":"v","role":"variable","type":"NNReal"}],"conclusion":"MeasureTheory.Integrable (deriv f) (gaussianReal μ v)","decl":"ProbabilityTheory.integrable_deriv_gaussianReal"},"code":"/-- A bounded derivative is integrable under `gaussianReal μ v`. -/\nlemma integrable_deriv_gaussianReal (hL : ∀ x, |deriv f x| ≤ L) (μ : ℝ) (v : ℝ≥0) :\n    Integrable (deriv f) (gaussianReal μ v)","proof":":=\n  Integrable.of_bound (measurable_deriv f).aestronglyMeasurable L\n    (Filter.Eventually.of_forall fun x ↦ (Real.norm_eq_abs _).trans_le (hL x))","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":101,"end":105,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L101-L105"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["Field.toSemifield","mathlib","instance"],["LE.le","lean4","definition"],["MeasureTheory.Integrable","mathlib","definition"],["NNReal","mathlib","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["NormedField.toField","mathlib","instance"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["abs","mathlib","definition"],["deriv","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1793,"name":"ProbabilityTheory.integrable_gaussianReal_iff","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"254cf6e52b5299eb","local":"a28a145f367ceaa1","content":"ae331a3e4ec95dc2"},"doc":"For `v ≠ 0`, a function is integrable under `gaussianReal μ v` iff its product with the\nGaussian density is integrable under the Lebesgue measure. ","statement":{"binders":[{"explicit":false,"name":"μ","role":"variable","type":"ℝ"},{"explicit":false,"name":"v","role":"variable","type":"NNReal"},{"explicit":true,"name":"hv","role":"hypothesis","type":"v ≠ 0"},{"explicit":false,"name":"g","role":"variable","type":"ℝ → ℝ"}],"conclusion":"MeasureTheory.Integrable g (gaussianReal μ v) ↔\n  MeasureTheory.Integrable (fun x => gaussianPDFReal μ v x * g x) MeasureTheory.volume","decl":"ProbabilityTheory.integrable_gaussianReal_iff"},"code":"/-- For `v ≠ 0`, a function is integrable under `gaussianReal μ v` iff its product with the\nGaussian density is integrable under the Lebesgue measure. -/\nlemma integrable_gaussianReal_iff {μ : ℝ} {v : ℝ≥0} (hv : v ≠ 0) {g : ℝ → ℝ} :\n    Integrable g (gaussianReal μ v) ↔ Integrable (fun x ↦ gaussianPDFReal μ v x * g x)","proof":":= by\n  rw [gaussianReal_of_var_ne_zero _ hv, integrable_withDensity_iff_integrable_smul'\n    (measurable_gaussianPDF _ _) (ae_of_all _ fun _ ↦ gaussianPDF_lt_top)]\n  simp only [toReal_gaussianPDF, smul_eq_mul]","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":48,"end":54,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L48-L54"},"deps":[],"outside":[],"external":[["HMul.hMul","lean4","definition"],["Iff","lean4","structure"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.MeasureSpace.toMeasurableSpace","mathlib","instance"],["MeasureTheory.MeasureSpace.volume","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.instZero","mathlib","instance"],["Ne","lean4","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.gaussianPDFReal","mathlib","definition"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instMul","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.measureSpace","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHMul","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1794,"name":"ProbabilityTheory.integral_mul_gaussianReal_zero_one_of_hasDerivAt","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"136bd7fe57d5bcb4","local":"732dabed03243dd8","content":"4cb5b98e2cebad05"},"doc":"**Stein's identity** for the standard Gaussian, `HasDerivAt` form: if `f'` is a bounded\nderivative of `f`, then `E[ξ f(ξ)] = E[f'(ξ)]` for `ξ ~ N(0, 1)`. ","statement":{"binders":[{"explicit":false,"name":"f","role":"variable","type":"ℝ → ℝ"},{"explicit":false,"name":"L","role":"variable","type":"ℝ"},{"explicit":false,"name":"f'","role":"variable","type":"ℝ → ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"∀ (x : ℝ), HasDerivAt f (f' x) x"},{"explicit":true,"name":"hL","role":"hypothesis","type":"∀ (x : ℝ), |f' x| ≤ L"}],"conclusion":"∫ (x : ℝ), x * f x ∂gaussianReal 0 1 = ∫ (x : ℝ), f' x ∂gaussianReal 0 1","decl":"ProbabilityTheory.integral_mul_gaussianReal_zero_one_of_hasDerivAt"},"code":"/-- **Stein's identity** for the standard Gaussian, `HasDerivAt` form: if `f'` is a bounded\nderivative of `f`, then `E[ξ f(ξ)] = E[f'(ξ)]` for `ξ ~ N(0, 1)`. -/\nlemma integral_mul_gaussianReal_zero_one_of_hasDerivAt {f' : ℝ → ℝ}\n    (hf : ∀ x, HasDerivAt f (f' x) x) (hL : ∀ x, |f' x| ≤ L) :\n    ∫ x, x * f x ∂gaussianReal 0 1 = ∫ x, f' x ∂gaussianReal 0 1","proof":":= by\n  have hf' : deriv f = f' := funext fun x ↦ (hf x).deriv\n  rw [← hf'] at hL ⊢\n  exact integral_mul_gaussianReal_zero_one (fun x ↦ (hf x).differentiableAt) hL","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":144,"end":151,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L144-L151"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddZero.toZero","mathlib","instance"],["AddZeroClass.toAddZero","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["DistribMulAction.toDistribSMul","mathlib","instance"],["DistribSMul.toSMulZeroClass","mathlib","instance"],["Eq","lean4","inductive"],["Field.toSemifield","mathlib","instance"],["HMul.hMul","lean4","definition"],["HasDerivAt","mathlib","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["IsModuleTopology.toContinuousSMul","mathlib","instance"],["IsTopologicalRing.toIsTopologicalSemiring","mathlib","instance"],["IsTopologicalSemiring.toIsModuleTopology","mathlib","instance"],["LE.le","lean4","definition"],["MeasureTheory.integral","mathlib","definition"],["Module.toDistribMulAction","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NonUnitalCommRing.toNonUnitalNonAssocCommRing","mathlib","instance"],["NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["NormedField.toField","mathlib","instance"],["NormedField.toNormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.denselyNormedField","mathlib","instance"],["Real.instAdd","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Real.semiring","mathlib","instance"],["SMulZeroClass.toSMul","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SeminormedCommRing.toSeminormedRing","mathlib","instance"],["SeminormedRing.toPseudoMetricSpace","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["Semiring.toMonoid","mathlib","instance"],["SubNegMonoid.toAddMonoid","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["abs","mathlib","definition"],["instHMul","lean4","instance"],["instIsTopologicalRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1795,"name":"ProbabilityTheory.integrable_gaussianReal_of_abs_deriv_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"9799f19b6bd0f8ad","local":"65ee44c888b7c63f","content":"98696a4234f499a4"},"doc":"A differentiable function with bounded derivative is integrable under `gaussianReal μ v`. ","statement":{"binders":[{"explicit":false,"name":"f","role":"variable","type":"ℝ → ℝ"},{"explicit":false,"name":"L","role":"variable","type":"ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Differentiable ℝ f"},{"explicit":true,"name":"hL","role":"hypothesis","type":"∀ (x : ℝ), |deriv f x| ≤ L"},{"explicit":true,"name":"μ","role":"variable","type":"ℝ"},{"explicit":true,"name":"v","role":"variable","type":"NNReal"}],"conclusion":"MeasureTheory.Integrable f (gaussianReal μ v)","decl":"ProbabilityTheory.integrable_gaussianReal_of_abs_deriv_le"},"code":"/-- A differentiable function with bounded derivative is integrable under `gaussianReal μ v`. -/\nlemma integrable_gaussianReal_of_abs_deriv_le (hf : Differentiable ℝ f)\n    (hL : ∀ x, |deriv f x| ≤ L) (μ : ℝ) (v : ℝ≥0) :\n    Integrable f (gaussianReal μ v)","proof":":= by\n  have h_abs : Integrable (fun x ↦ |x - μ|) (gaussianReal μ v) :=\n    (((memLp_id_gaussianReal' 1 (by simp)).integrable le_rfl).sub (integrable_const μ)).abs\n  refine Integrable.mono' (g := fun x ↦ |f μ| + L * |x - μ|)\n    ((integrable_const _).add (h_abs.const_mul L)) hf.continuous.aestronglyMeasurable\n    (Filter.Eventually.of_forall fun x ↦ ?_)\n  rw [Real.norm_eq_abs]\n  exact abs_le_add_mul_abs_sub_of_abs_deriv_le hf hL x μ","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":70,"end":80,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L70-L80"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["Differentiable","mathlib","definition"],["Field.toSemifield","mathlib","instance"],["LE.le","lean4","definition"],["MeasureTheory.Integrable","mathlib","definition"],["NNReal","mathlib","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["NormedField.toField","mathlib","instance"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["abs","mathlib","definition"],["deriv","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1796,"name":"ProbabilityTheory.abs_le_add_mul_abs_sub_of_abs_deriv_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"5724f7ce9ade2100","local":"628038db7ff95fcf","content":"065c4824436a1e35"},"doc":"A differentiable function whose derivative is bounded by `L` has linear growth:\n`|f x| ≤ |f y| + L * |x - y|`. ","statement":{"binders":[{"explicit":false,"name":"f","role":"variable","type":"ℝ → ℝ"},{"explicit":false,"name":"L","role":"variable","type":"ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Differentiable ℝ f"},{"explicit":true,"name":"hL","role":"hypothesis","type":"∀ (x : ℝ), |deriv f x| ≤ L"},{"explicit":true,"name":"x","role":"variable","type":"ℝ"},{"explicit":true,"name":"y","role":"variable","type":"ℝ"}],"conclusion":"|f x| ≤ |f y| + L * |x - y|","decl":"ProbabilityTheory.abs_le_add_mul_abs_sub_of_abs_deriv_le"},"code":"/-- A differentiable function whose derivative is bounded by `L` has linear growth:\n`|f x| ≤ |f y| + L * |x - y|`. -/\nlemma abs_le_add_mul_abs_sub_of_abs_deriv_le (hf : Differentiable ℝ f)\n    (hL : ∀ x, |deriv f x| ≤ L) (x y : ℝ) :","proof":"|f x| ≤ |f y| + L * |x - y| := by\n  have h := convex_univ.norm_image_sub_le_of_norm_deriv_le (fun z _ ↦ hf z)\n    (fun z _ ↦ (Real.norm_eq_abs _).trans_le (hL z)) (Set.mem_univ y) (Set.mem_univ x)\n  simp only [Real.norm_eq_abs] at h\n  calc |f x| = |f y + (f x - f y)| := by congr 1; ring\n    _ ≤ |f y| + |f x - f y| := abs_add_le _ _\n    _ ≤ |f y| + L * |x - y| := by gcongr","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":58,"end":68,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L58-L68"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["Differentiable","mathlib","definition"],["Field.toSemifield","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["LE.le","lean4","definition"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedField.toField","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAdd","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["abs","mathlib","definition"],["deriv","mathlib","definition"],["instHAdd","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1797,"name":"ProbabilityTheory.integral_sub_mul_gaussianReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"37fd2bc2a89a99a0","local":"b56cfceb63cd20b1","content":"ebdde5db4cbc32f6"},"doc":"**Stein's identity** for `N(μ, v)`: `E[(ξ - μ) f(ξ)] = v E[f'(ξ)]` when `f` is differentiable\nwith bounded derivative. Also true for `v = 0`. ","statement":{"binders":[{"explicit":false,"name":"f","role":"variable","type":"ℝ → ℝ"},{"explicit":false,"name":"L","role":"variable","type":"ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Differentiable ℝ f"},{"explicit":true,"name":"hL","role":"hypothesis","type":"∀ (x : ℝ), |deriv f x| ≤ L"},{"explicit":true,"name":"μ","role":"variable","type":"ℝ"},{"explicit":true,"name":"v","role":"variable","type":"NNReal"}],"conclusion":"∫ (x : ℝ), (x - μ) * f x ∂gaussianReal μ v = ↑v * ∫ (x : ℝ), deriv f x ∂gaussianReal μ v","decl":"ProbabilityTheory.integral_sub_mul_gaussianReal"},"code":"/-- **Stein's identity** for `N(μ, v)`: `E[(ξ - μ) f(ξ)] = v E[f'(ξ)]` when `f` is differentiable\nwith bounded derivative. Also true for `v = 0`. -/\nlemma integral_sub_mul_gaussianReal (hf : Differentiable ℝ f) (hL : ∀ x, |deriv f x| ≤ L)\n    (μ : ℝ) (v : ℝ≥0) :\n    ∫ x, (x - μ) * f x ∂gaussianReal μ v = v * ∫ x, deriv f x ∂gaussianReal μ v","proof":":= by\n  by_cases hv : v = 0\n  · simp [hv]\n  have hv' : (v : ℝ) ≠ 0 := NNReal.coe_ne_zero.mpr hv\n  -- integration by parts on `ℝ` with `u = gaussianPDFReal μ v` and `v = f`\n  have h_ibp : ∫ x, gaussianPDFReal μ v x * deriv f x\n      = - ∫ x, (-((x - μ) / v) * gaussianPDFReal μ v x) * f x := by\n    refine integral_mul_deriv_eq_deriv_mul_of_integrable\n      (fun x _ ↦ hasDerivAt_gaussianPDFReal μ v x) (fun x _ ↦ (hf x).hasDerivAt) ?_ ?_ ?_\n    · exact (integrable_gaussianReal_iff hv).mp (integrable_deriv_gaussianReal hL μ v)\n    · have h := ((integrable_gaussianReal_iff hv).mp\n        (integrable_sub_mul_gaussianReal hf hL μ v)).const_mul (-(v : ℝ)⁻¹)\n      refine h.congr (Filter.Eventually.of_forall fun x ↦ ?_)\n      simp only [Pi.mul_apply]\n      ring\n    · exact (integrable_gaussianReal_iff hv).mp (integrable_gaussianReal_of_abs_deriv_le hf hL μ v)\n  calc ∫ x, (x - μ) * f x ∂gaussianReal μ v\n      = ∫ x, gaussianPDFReal μ v x * ((x - μ) * f x) := by\n        simp only [integral_gaussianReal_eq_integral_smul hv, smul_eq_mul]\n    _ = ∫ x, -v * ((-((x - μ) / v) * gaussianPDFReal μ v x) * f x) := by\n        congr 1 with x\n        field_simp\n    _ = -v * ∫ x, (-((x - μ) / v) * gaussianPDFReal μ v x) * f x := integral_const_mul _ _\n    _ = v * ∫ x, gaussianPDFReal μ v x * deriv f x := by rw [h_ibp]; ring\n    _ = v * ∫ x, deriv f x ∂gaussianReal μ v := by\n        simp only [integral_gaussianReal_eq_integral_smul hv, smul_eq_mul]","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":107,"end":136,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L107-L136"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["Differentiable","mathlib","definition"],["Eq","lean4","inductive"],["Field.toSemifield","mathlib","instance"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["MeasureTheory.integral","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.toReal","mathlib","definition"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedField.toField","mathlib","instance"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["abs","mathlib","definition"],["deriv","mathlib","definition"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1798,"name":"ProbabilityTheory.integrable_sub_mul_gaussianReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.SteinReal","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"cfbce19c03b81e2d","local":"3fc1cc6823c122bc","content":"a185ba2e07b4f062"},"doc":"`x ↦ (x - μ) * f x` is integrable under `gaussianReal μ v` when `f` has bounded derivative\n(hence linear growth). ","statement":{"binders":[{"explicit":false,"name":"f","role":"variable","type":"ℝ → ℝ"},{"explicit":false,"name":"L","role":"variable","type":"ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Differentiable ℝ f"},{"explicit":true,"name":"hL","role":"hypothesis","type":"∀ (x : ℝ), |deriv f x| ≤ L"},{"explicit":true,"name":"μ","role":"variable","type":"ℝ"},{"explicit":true,"name":"v","role":"variable","type":"NNReal"}],"conclusion":"MeasureTheory.Integrable (fun x => (x - μ) * f x) (gaussianReal μ v)","decl":"ProbabilityTheory.integrable_sub_mul_gaussianReal"},"code":"/-- `x ↦ (x - μ) * f x` is integrable under `gaussianReal μ v` when `f` has bounded derivative\n(hence linear growth). -/\nlemma integrable_sub_mul_gaussianReal (hf : Differentiable ℝ f) (hL : ∀ x, |deriv f x| ≤ L)\n    (μ : ℝ) (v : ℝ≥0) :\n    Integrable (fun x ↦ (x - μ) * f x) (gaussianReal μ v)","proof":":= by\n  have h_sub : MemLp (fun x ↦ x - μ) 2 (gaussianReal μ v) :=\n    (memLp_id_gaussianReal' 2 (by simp)).sub (memLp_const μ)\n  have h_abs : Integrable (fun x ↦ |x - μ|) (gaussianReal μ v) :=\n    (h_sub.integrable (by norm_num)).abs\n  have hfc := hf.continuous\n  refine Integrable.mono' (g := fun x ↦ |f μ| * |x - μ| + L * (x - μ) ^ 2)\n    ((h_abs.const_mul _).add (h_sub.integrable_sq.const_mul L)) (by fun_prop)\n    (Filter.Eventually.of_forall fun x ↦ ?_)\n  rw [Real.norm_eq_abs, abs_mul, ← sq_abs]\n  calc |x - μ| * |f x| ≤ |x - μ| * (|f μ| + L * |x - μ|) := by\n        gcongr\n        exact abs_le_add_mul_abs_sub_of_abs_deriv_le hf hL x μ\n    _ = |f μ| * |x - μ| + L * |x - μ| ^ 2 := by ring","source":{"path":"Maiti2026Power/Mathlib/Probability/SteinReal.lean","start":82,"end":99,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/SteinReal.lean#L82-L99"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["Differentiable","mathlib","definition"],["Field.toSemifield","mathlib","instance"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["LE.le","lean4","definition"],["MeasureTheory.Integrable","mathlib","definition"],["NNReal","mathlib","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NontriviallyNormedField.toNormedField","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["NormedField.toField","mathlib","instance"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.denselyNormedField","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["abs","mathlib","definition"],["deriv","mathlib","definition"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}}]