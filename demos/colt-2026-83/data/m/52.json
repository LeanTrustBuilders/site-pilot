{"id":871,"name":"Maiti2026Power.NormEstParam.K_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"af6fe51917efe1e3","local":"fd0592af18c1e473","content":"a9858bfd39313f97"},"doc":"`K_j ≤ 5120 (j log 2 + L) + 1 ≤ 3549 j + 5121 L`. ","statement":{"binders":[{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"j","role":"variable","type":"ℕ"}],"conclusion":"↑(P.K j) ≤ 3549 * ↑j + 5121 * Real.log (4 / P.δ)","decl":"Maiti2026Power.NormEstParam.K_le"},"code":"/-- `K_j ≤ 5120 (j log 2 + L) + 1 ≤ 3549 j + 5121 L`. -/\nlemma K_le (j : ℕ) : (P.K j : ℝ) ≤ 3549 * j + 5121 * log (4 / P.δ)","proof":":= by\n  have hL := P.one_lt_L\n  have h2 := Real.log_two_lt_d9\n  have h2' := Real.log_two_gt_d9\n  have hj : (0 : ℝ) ≤ j := Nat.cast_nonneg j\n  have hc : (P.K j : ℝ) < 5120 * log (1 / nsDelta P.δ j) + 1 :=\n    Nat.ceil_lt_add_one (by rw [P.log_one_div_nsDelta]; nlinarith)\n  rw [P.log_one_div_nsDelta] at hc\n  nlinarith","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":84,"end":93,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L84-L93"},"deps":[962,971],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["FloorRing.toFloorSemiring","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.ceil","mathlib","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instFloorRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.linearOrder","mathlib","instance"],["Real.log","mathlib","definition"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.Ioo","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":872,"name":"Maiti2026Power.NormEstParam.s'_mul_K'_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"dbb0c4ba12dc1a19","local":"a41a32d09bd84614","content":"38922ac5bd68addc"},"doc":"For `j < J`, the additive estimator at scale `j` uses at most `32776 d L / ε²` rounds. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι"},{"explicit":false,"name":"j","role":"variable","type":"ℕ"},{"explicit":true,"name":"hj","role":"hypothesis","type":"j < P.J ι"}],"conclusion":"↑(P.s' ι j) * ↑(P.K' j) ≤ 32776 * ↑(Fintype.card ι) * Real.log (4 / P.δ) / P.ε ^ 2","decl":"Maiti2026Power.NormEstParam.s'_mul_K'_le"},"code":"/-- For `j < J`, the additive estimator at scale `j` uses at most `32776 d L / ε²` rounds. -/\nlemma s'_mul_K'_le (hd : 0 < Fintype.card ι) {j : ℕ} (hj : j < P.J ι) :\n    (P.s' ι j * P.K' j : ℝ) ≤ 32776 * Fintype.card ι * log (4 / P.δ) / P.ε ^ 2","proof":":= by\n  have hε := P.hε.1\n  have hL := P.one_lt_L\n  have hd' : (0 : ℝ) < Fintype.card ι := Nat.cast_pos.2 hd\n  have hs : (P.s' ι j : ℝ) ≤ 8 * Fintype.card ι / P.ε ^ 2 * (1 / 4) ^ j := P.s_le hd hj\n  have heq : 4096 * nsScale P.ε j ^ 2 * log (4 / P.δ) / P.ε ^ 2\n      = 4096 * 4 ^ j * log (4 / P.δ) := by\n    rw [P.nsScale_sq]\n    field_simp\n  have hK : (P.K' j : ℝ) < 4096 * 4 ^ j * log (4 / P.δ) + 1 := by\n    have : (P.K' j : ℝ) < 4096 * nsScale P.ε j ^ 2 * log (4 / P.δ) / P.ε ^ 2 + 1 :=\n      Nat.ceil_lt_add_one (by positivity)\n    rwa [heq] at this\n  have h4 : (1 / 4 : ℝ) ^ j * 4 ^ j = 1 := by\n    rw [← mul_pow]\n    norm_num\n  have h14 : (1 / 4 : ℝ) ^ j ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)\n  calc (P.s' ι j * P.K' j : ℝ)\n      ≤ (8 * Fintype.card ι / P.ε ^ 2 * (1 / 4) ^ j) * (4096 * 4 ^ j * log (4 / P.δ) + 1) :=\n        mul_le_mul hs hK.le (Nat.cast_nonneg _) (by positivity)\n    _ = 8 * Fintype.card ι / P.ε ^ 2\n          * (4096 * log (4 / P.δ) * ((1 / 4) ^ j * 4 ^ j) + (1 / 4) ^ j) := by ring\n    _ ≤ 8 * Fintype.card ι / P.ε ^ 2 * (4096 * log (4 / P.δ) * 1 + 1) := by\n        rw [h4]\n        gcongr\n    _ ≤ 8 * Fintype.card ι / P.ε ^ 2 * (4097 * log (4 / P.δ)) :=\n        mul_le_mul_of_nonneg_left (by linarith) (by positivity)\n    _ = 32776 * Fintype.card ι * log (4 / P.δ) / P.ε ^ 2 := by ring","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":142,"end":171,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L142-L171"},"deps":[953,961,971,974],"outside":[],"external":[["And.left","lean4","theorem"],["DivInvMonoid.toDiv","mathlib","instance"],["Exists","lean4","inductive"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["FloorRing.toFloorSemiring","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.ceil","mathlib","definition"],["Nat.find","mathlib","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Preorder.toLE","mathlib","instance"],["Preorder.toLT","mathlib","instance"],["Real","mathlib","structure"],["Real.decidableLE","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instFloorRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.linearOrder","mathlib","instance"],["Real.log","mathlib","definition"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Real.sqrt","mathlib","definition"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.Ioo","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instLTNat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":873,"name":"Maiti2026Power.NormEstParam.log_one_div_nsDelta","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"af75e2399ac7ef83","local":"e8b2e40e00617c5a","content":"fcb366d246825d7b"},"doc":"","statement":{"binders":[{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"j","role":"variable","type":"ℕ"}],"conclusion":"Real.log (1 / nsDelta P.δ j) = ↑j * Real.log 2 + Real.log (4 / P.δ)","decl":"Maiti2026Power.NormEstParam.log_one_div_nsDelta"},"code":"lemma log_one_div_nsDelta (j : ℕ) :\n    log (1 / nsDelta P.δ j) = j * log 2 + log (4 / P.δ)","proof":":= by\n  have hδ := P.hδ.1\n  rw [nsDelta, one_div_div, Real.log_div (by positivity) hδ.ne', Real.log_div (by norm_num) hδ.ne',\n    Real.log_pow, show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]\n  push_cast\n  ring","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":76,"end":82,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L76-L82"},"deps":[877,971],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast",