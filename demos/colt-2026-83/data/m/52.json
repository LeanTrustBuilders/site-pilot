nge":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":865,"name":"Maiti2026Power.NormEstParam.N₂_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"d9f8205ac011a424","local":"615726637ad73f40","content":"66991b875a7991de"},"doc":"The second phase uses at most `32776 d L / ε²` rounds. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι"}],"conclusion":"↑(P.N₂ ι) ≤ 32776 * ↑(Fintype.card ι) * Real.log (4 / P.δ) / P.ε ^ 2","decl":"Maiti2026Power.NormEstParam.N₂_le"},"code":"/-- The second phase uses at most `32776 d L / ε²` rounds. -/\nlemma N₂_le (hd : 0 < Fintype.card ι) :\n    (P.N₂ ι : ℝ) ≤ 32776 * Fintype.card ι * log (4 / P.δ) / P.ε ^ 2","proof":":= by\n  have hε := P.hε.1\n  have hL := P.one_lt_L\n  have hd' : (0 : ℝ) < Fintype.card ι := Nat.cast_pos.2 hd\n  unfold N₂ nsN2\n  rw [Nat.cast_max, max_le_iff]\n  constructor\n  · push_cast\n    calc (Fintype.card ι : ℝ) * lnN P.ε P.δ ≤ Fintype.card ι * (49 * log (4 / P.δ) / P.ε ^ 2) :=\n          mul_le_mul_of_nonneg_left P.n_le hd'.le\n      _ = 49 * (Fintype.card ι * log (4 / P.δ) / P.ε ^ 2) := by ring\n      _ ≤ 32776 * (Fintype.card ι * log (4 / P.δ) / P.ε ^ 2) := by gcongr; norm_num\n      _ = 32776 * Fintype.card ι * log (4 / P.δ) / P.ε ^ 2 := by ring\n  · change (((range (P.J ι)).sup fun j ↦\n      addS (Fintype.card ι) (nsScale P.ε j) * addK (nsScale P.ε j) P.ε P.δ : ℕ) : ℝ) ≤ _\n    rcases (range (P.J ι)).eq_empty_or_nonempty with h | h\n    · rw [h, Finset.sup_empty]\n      simp only [bot_eq_zero', Nat.cast_zero]\n      positivity\n    · obtain ⟨j, hj, hsup⟩ := Finset.exists_mem_eq_sup _ h\n        (fun j ↦ addS (Fintype.card ι) (nsScale P.ε j) * addK (nsScale P.ε j) P.ε P.δ)\n      rw [hsup]\n      push_cast\n      exact P.s'_mul_K'_le hd (mem_range.1 hj)","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":173,"end":198,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L173-L198"},"deps":[965,971],"outside":[],"external":[["And.left","lean4","theorem"],["DivInvMonoid.toDiv","mathlib","instance"],["Exists","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sup","mathlib","definition"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["FloorRing.toFloorSemiring","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Lattice.toSemilatticeSup","mathlib","instance"],["Max.max","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.ceil","mathlib","definition"],["Nat.find","mathlib","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instLattice","mathlib","instance"],["Nat.instMax","lean4","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Nat.instOrderBot","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Preorder.toLE","mathlib","instance"],["Preorder.toLT","mathlib","instance"],["Real","mathlib","structure"],["Real.decidableLE","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instFloorRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.linearOrder","mathlib","instance"],["Real.log","mathlib","definition"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Real.sqrt","mathlib","definition"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.Ioo","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instLTNat","lean4","instance"],["instMulNat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":866,"name":"Maiti2026Power.NormEstParam.nsScale_sq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"3fa1670d45ea6186","local":"8a296c326bb599e7","content":"14ebe541fc4e8427"},"doc":"","statement":{"binders":[{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"j","role":"variable","type":"ℕ"}],"conclusion":"nsScale P.ε j ^ 2 = 4 ^ j * P.ε ^ 2","decl":"Maiti2026Power.NormEstParam.nsScale_sq"},"code":"lemma nsScale_sq (j : ℕ) : nsScale P.ε j ^ 2 = 4 ^ j * P.ε ^ 2","proof":":= by\n  rw [nsScale, mul_pow, ← pow_mul, mul_comm j 2, pow_mul]\n  norm_num","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":48,"end":50,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L48-L50"},"deps":[888,971],"outside":[],"external":[["Eq","lean4","inductive"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instZero","mathlib","instance"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.Ioo","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":867,"name":"Maiti2026Power.NormEstParam.T₁_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"547bdc5831621502","local":"c620b749fb5be97a","content":"796a22de0b6c534d"},"doc":"The multi-scale phase uses at most `63736 d L / ε²` rounds. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι"}],"conclusion":"↑(P.T₁ ι) ≤ 63736 * ↑(Fintype.card ι) * Real.log (4 / P.δ) / P.ε ^ 2","decl":"Maiti2026Power.NormEstParam.T₁_le"},"code":"/-- The multi-scale phase uses at most `63736 d L / ε²` rounds. -/\nlemma T₁_le (hd : 0 < Fintype.card ι) :\n    (P.T₁ ι : ℝ) ≤ 63736 * Fintype.card ι * log (4 / P.δ) / P.ε ^ 2","proof":":= by\n  have hε := P.hε.1\n  have hL := P.d1386_lt_L\n  have hd' : (0 : ℝ) < Fintype.card ι := Nat.cast_pos.2 hd\n  have hA := sum_pow_le (x := 1 / 4) (by norm_num) (by norm_num) (P.J ι)\n  have hB := sum_mul_pow_le (x := 1 / 4) (by norm_num) (by norm_num) (P.J ι)\n  have hA0 : 0 ≤ ∑ j ∈ range (P.J ι), (1 / 4 : ℝ) ^ j :=\n    Finset.sum_nonneg fun _ _ ↦ by positivity\n  have hB0 : 0 ≤ ∑ j ∈ range (P.J ι), (j : ℝ) * (1 / 4) ^ j :=\n    Finset.sum_nonneg fun _ _ ↦ by positivity\n  norm_num at hA hB\n  have hc0 : 0 ≤ 8 * (Fintype.card ι : ℝ) / P.ε ^ 2 := by positivity\n  calc (P.T₁ ι : ℝ) = ∑ j ∈ range (P.J ι), (P.s ι j : ℝ) * P.K j := P.T₁_eq\n    _ ≤ ∑ j ∈ range (P.J ι), (8 * Fintype.card ι / P.ε ^ 2 * (1 / 4) ^ j)\n          * (3549 * j + 5121 * log (4 / P.δ)) :=\n        Finset.sum_le_sum fun j hj ↦ mul_le_mul (P.s_le hd (mem_range.1 hj)) (P.K_le j)\n          (Nat.cast_nonneg _) (by positivity)\n    _ = 8 * Fintype.card ι / P.ε ^ 2 * (3549 * ∑ j ∈ range (P.J ι), (j : ℝ) * (1 / 4) ^ j\n          + 5121 * log (4 / P.δ) * ∑ j ∈ range (P.J ι), (1 / 4 : ℝ) ^ j) := by\n        simp only [Finset.mul_sum, ← Finset.sum_add_distrib]\n        refine Finset.sum_congr rfl fun j _ ↦ ?_\n        ring\n    _ ≤ 8 * Fintype.card ι / P.ε ^ 2 * (3549 * (4 / 9) + 5121 * log (4 / P.δ) * (4 / 3)) := by\n        gcongr\n    _ ≤ 8 * Fintype.card ι / P.ε ^ 2 * (7967 * log (4 / P.δ)) :=\n        mul_le_mul_of_nonneg_left (by linarith) hc0\n    _ = 63736 * Fintype.card ι * log (4 / P.δ) / P.ε ^ 2 := by ring","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":99,"end":127,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8f