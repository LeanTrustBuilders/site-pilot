) < 48 * log (4 / P.δ) / P.ε ^ 2 + 1 := Nat.ceil_lt_add_one (by positivity)\n  have h1 : 1 ≤ log (4 / P.δ) / P.ε ^ 2 := by\n    rw [le_div_iff₀ (by positivity)]\n    nlinarith [hε.2, hε.1]\n  calc (P.n : ℝ) ≤ 48 * log (4 / P.δ) / P.ε ^ 2 + 1 := hc.le\n    _ ≤ 48 * log (4 / P.δ) / P.ε ^ 2 + log (4 / P.δ) / P.ε ^ 2 := by linarith\n    _ = 49 * log (4 / P.δ) / P.ε ^ 2 := by ring","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":129,"end":140,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L129-L140"},"deps":[971,984],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["FloorRing.toFloorSemiring","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.ceil","mathlib","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instFloorRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.linearOrder","mathlib","instance"],["Real.log","mathlib","definition"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.Ioo","mathlib","definition"],["Set.instMembership","mathlib",