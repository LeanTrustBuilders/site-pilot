ip","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instLTNat","lean4","instance"],["instMulNat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":868,"name":"Maiti2026Power.NormEstParam.T_le","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"84ff6c8194046098","local":"d43d29f22a4537de","content":"a47fdbaf5f0af41e"},"doc":"**Budget of the norm-estimation meta-algorithm**: `T ≤ 10⁵ d log(4/δ) / ε²`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι"}],"conclusion":"↑(P.T ι) ≤ 100000 * ↑(Fintype.card ι) * Real.log (4 / P.δ) / P.ε ^ 2","decl":"Maiti2026Power.NormEstParam.T_le"},"code":"/-- **Budget of the norm-estimation meta-algorithm**: `T ≤ 10⁵ d log(4/δ) / ε²`. -/\ntheorem T_le (hd : 0 < Fintype.card ι) :\n    (P.T ι : ℝ) ≤ 100000 * Fintype.card ι * log (4 / P.δ) / P.ε ^ 2","proof":":= by\n  have hL := P.one_lt_L\n  have h0 : 0 ≤ (Fintype.card ι : ℝ) * log (4 / P.δ) / P.ε ^ 2 := by positivity\n  have h1 := P.T₁_le hd\n  have h2 := P.N₂_le hd\n  rw [T_eq, Nat.cast_add]\n  have e1 : 63736 * (Fintype.card ι : ℝ) * log (4 / P.δ) / P.ε ^ 2\n      = 63736 * (Fintype.card ι * log (4 / P.δ) / P.ε ^ 2) := by ring\n  have e2 : 32776 * (Fintype.card ι : ℝ) * log (4 / P.δ) / P.ε ^ 2\n      = 32776 * (Fintype.card ι * log (4 / P.δ) / P.ε ^ 2) := by ring\n  have e3 : 100000 * (Fintype.card ι : ℝ) * log (4 / P.δ) / P.ε ^ 2\n      = 100000 * (Fintype.card ι * log (4 / P.δ) / P.ε ^ 2) := by ring\n  rw [e3]\n  rw [e1] at h1\n  rw [e2] at h2\n  linarith","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":200,"end":217,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L200-L217"},"deps":[968,971],"outside":[],"external":[["And.left","lean4","theorem"],["DivInvMonoid.toDiv","mathlib","instance"],["Exists","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["Finset.sup","mathlib","definition"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["FloorRing.toFloorSemiring","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Lattice.toSemilatticeSup","mathlib","instance"],["Max.max","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.ceil","mathlib","definition"],["Nat.find","mathlib","definition"],["Nat.instAddCommMonoid","mathlib","instance"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instLattice","mathlib","instance"],["Nat.instMax","lean4","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Nat.instOrderBot","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Preorder.toLE","mathlib","instance"],["Preorder.toLT","mathlib","instance"],["Real","mathlib","structure"],["Real.decidableLE","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instFloorRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.linearOrder","mathlib","instance"],["Real.log","mathlib","definition"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Real.sqrt","mathlib","definition"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.Ioo","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instLTNat","lean4","instance"],["instMulNat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":869,"name":"Maiti2026Power.NormEstParam.s_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.NormEstBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"64da85b0f08582b1","local":"b1b7776360ea3c51","content":"9b3845f37659edaa"},"doc":"For `j < J`, `s_j ≤ 8 d / t_j² = (8 d / ε²) 4⁻ʲ`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":true,"name":"P","role":"variable","type":"NormEstParam"},{"explicit":true,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι"},{"explicit":false,"name":"j","role":"variable","type":"ℕ"},{"explicit":true,"name":"hj","role":"hypothesis","type":"j < P.J ι"}],"conclusion":"↑(P.s ι j) ≤ 8 * ↑(Fintype.card ι) / P.ε ^ 2 * (1 / 4) ^ j","decl":"Maiti2026Power.NormEstParam.s_le"},"code":"/-- For `j < J`, `s_j ≤ 8 d / t_j² = (8 d / ε²) 4⁻ʲ`. -/\nlemma s_le (hd : 0 < Fintype.card ι) {j : ℕ} (hj : j < P.J ι) :\n    (P.s ι j : ℝ) ≤ 8 * Fintype.card ι / P.ε ^ 2 * (1 / 4) ^ j","proof":":= by\n  have hε := P.hε.1\n  have ht : 0 < nsScale P.ε j := nsScale_pos hε j\n  have htd : nsScale P.ε j < 2 * √(Fintype.card ι) := nsScale_lt_of_lt_nsJ hε hj\n  have hd' : (0 : ℝ) < Fintype.card ι := Nat.cast_pos.2 hd\n  have ht2 : nsScale P.ε j ^ 2 < 4 * Fintype.card ι := by\n    have := Real.sq_sqrt hd'.le\n    nlinarith [Real.sqrt_nonneg (Fintype.card ι : ℝ)]\n  have h1 : (1 : ℝ) < 4 * Fintype.card ι / nsScale P.ε j ^ 2 := by\n    rw [lt_div_iff₀ (by positivity)]\n    linarith\n  have hceil : (P.s ι j : ℝ) < 4 * Fintype.card ι / nsScale P.ε j ^ 2 + 1 :=\n    Nat.ceil_lt_add_one (by positivity)\n  have hsq := P.nsScale_sq j\n  calc (P.s ι j : ℝ) ≤ 4 * Fintype.card ι / nsScale P.ε j ^ 2 + 1 := hceil.le\n    _ ≤ 4 * Fintype.card ι / nsScale P.ε j ^ 2 + 4 * Fintype.card ι / nsScale P.ε j ^ 2 := by\n        linarith\n    _ = 8 * Fintype.card ι / P.ε ^ 2 * (1 / 4) ^ j := by\n        rw [hsq, one_div_pow]\n        field_simp\n        ring","source":{"path":"Maiti2026Power/MXJ2026/NormEstBudget.lean","start":52,"end":74,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/NormEstBudget.lean#L52-L74"},"deps":[953,960,971],"outside":[],"external":[["And.left","lean4","theorem"],["DivInvMonoid.toDiv","mathlib","instance"],["Exists","lean4","inductive"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["FloorRing.toFloorSemiring","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","def