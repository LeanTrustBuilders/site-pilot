[{"id":1184,"name":"Maiti2026Power.two_mul_exp_neg_mul_min_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.RademacherTest","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"b3ca41ffd5c21ff5","local":"4b46025f107ac743","content":"db2bbb4e0906c3bf"},"doc":"The three terms of the union bound are each at most `2 exp (-K/2048)` when the minimum in the\nexponent is at least `1/2048`. ","statement":{"binders":[{"explicit":false,"head":"Real","implicit":true,"name":"K","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"A","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"B","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hK","role":"hypothesis","type":"0 ≤ K","typeRefs":[[2,3,"LE.le"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hA","role":"hypothesis","type":"1 / 2048 ≤ A","typeRefs":[[9,10,"LE.le"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hB","role":"hypothesis","type":"1 / 2048 ≤ B","typeRefs":[[9,10,"LE.le"]]}],"conclusion":"2 * Real.exp (-(K * min A B)) ≤ 2 * Real.exp (-(K / 2048))","conclusionHead":"LE.le","conclusionRefs":[[2,3,"HMul.hMul"],[4,12,"Real.exp"],[14,15,"Neg.neg"],[18,19,"HMul.hMul"],[20,23,"Min.min"],[30,31,"LE.le"],[34,35,"HMul.hMul"],[36,44,"Real.exp"],[46,47,"Neg.neg"],[50,51,"HDiv.hDiv"]],"decl":"Maiti2026Power.two_mul_exp_neg_mul_min_le"},"code":"/-- The three terms of the union bound are each at most `2 exp (-K/2048)` when the minimum in the\nexponent is at least `1/2048`. -/\nlemma two_mul_exp_neg_mul_min_le {K A B : ℝ} (hK : 0 ≤ K) (hA : 1 / 2048 ≤ A) (hB : 1 / 2048 ≤ B) :\n    2 * exp (-(K * min A B)) ≤ 2 * exp (-(K / 2048))","proof":":= by\n  gcongr\n  rw [show K / 2048 = K * (1 / 2048) by ring]\n  exact le_mul_min (by gcongr) (by gcongr)","source":{"path":"Maiti2026Power/MXJ2026/RademacherTest.