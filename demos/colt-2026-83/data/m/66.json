stance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instSMulOfMul","lean4","instance"],["ite","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","Bool","Bool.instMeasurableSpace","DivInvMonoid.toDiv","ENNReal","ENNReal.instAddCommMonoidWithOne","EuclideanSpace","Fin","Fintype","Fintype.card","HDiv.hDiv","HMul.hMul","HPow.hPow","LE.le","LT.lt","MeasurableSpace.pi","MeasureTheory.Measure.real","Membership.mem","Monoid.toNPow","NPow.toPow","Nat","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Norm.norm","OfNat.ofNat","One.toOfNat1","PiLp.innerProductSpace._proof_1","PiLp.instNorm","Prod","Prod.instMeasurableSpace","Real","Real.instDivInvMonoid","Real.instLE","Real.instLT","Real.instMonoid","Real.instMul","Real.instNatCast","Real.instOne","Real.instPreorder","Real.instZero","Real.measurableSpace","Real.norm","Set","Set.Ioc","Set.instMembership","Set.ofPred","Zero.toOfNat0","instHDiv","instHMul","instHPow","instLTNat","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"9c6478b137dc8420c69aff4ebc5499b633cb4457","date":"2026-09-07"}},{"id":1190,"name":"Maiti2026Power.six_mul_exp_neg_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.RademacherTest","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"52f0c31e045eeefa","local":"04a92bbb1fd241b5","content":"9894c8b62038f3d0"},"doc":"`6 exp (-x) ≤ 3 δ' / 4` when `2048 x ≥ 5120 log (1 / δ')` and `δ' ≤ 1/4`. ","statement":{"binders":[{"explicit":false,"head":"Real","implicit":true,"name":"δ'","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"x","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hδ","role":"hypothesis","type":"δ' ∈ Set.Ioc 0 (1 / 4)","typeRefs":[[3,4,"Membership.mem"],[5,12,"Set.Ioc"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hx","role":"hypothesis","type":"5120 * Real.log (1 / δ') ≤ 2048 * x","typeRefs":[[5,6,"HMul.hMul"],[7,15,"Real.log"],[19,20,"HDiv.hDiv"],[25,26,"LE.le"],[32,33,"HMul.hMul"]]}],"conclusion":"6 * Real.exp (-x) ≤ 3 * δ' / 4","conclusionHead":"LE.le","conclusionRefs":[[2,3,"HMul.hMul"],[4,12,"Real.exp"],[14,15,"Neg.neg"],[18,19,"LE.le"],[22,23,"HMul.hMul"],[27,28,"HDiv.hDiv"]],"decl":"Maiti2026Power.six_mul_exp_neg_le"},"code":"/-- `6 exp (-x) ≤ 3 δ' / 4` when `2048 x ≥ 5120 log (1 / δ')` and `δ' ≤ 1/4`. -/\nlemma six_mul_exp_neg_le {δ' x : ℝ} (hδ : δ' ∈ Set.Ioc 0 (1 / 4))\n    (hx : 5120 * log (1 / δ') ≤ 2048 * x) : 6 * exp (-x) ≤ 3 * δ' / 4","proof":":= by\n  set L := log (1 / δ') with hL\n  have hδ1 : δ' ≤ 1 := hδ.2.trans (by norm_num)\n  have hL0 : 0 ≤ L := Real.log_nonneg (one_le_one_div hδ.1 hδ1)\n  have h1 : exp (-x) ≤ exp (-(2 * L)) * exp (-(L / 2)) := by\n    rw [← exp_add]\n    exact exp_le_exp.2 (by linarith)\n  have h2 : exp (-(2 * L)) = δ' ^ 2 := by\n    rw [exp_neg, show (2 : ℝ) * L = ((2 : ℕ) : ℝ) * L by norm_num, Real.exp_nat_mul, hL,\n      Real.exp_log (one_div_pos.2 hδ.1)]\n    field_simp\n  have h3 : exp (-(L / 2)) ≤ 1 / 2 := by\n    have h4 : log 4 ≤ L := by\n      rw [hL]\n      exact Real.log_le_log (by norm_num) ((le_one_div (by norm_num) hδ.1).2 hδ.2)\n    have h5 : exp (-(L / 2)) ≤ exp (-(log 4 / 2)) := exp_le_exp.2 (by linarith)\n    have h6 : exp (-(log 4 / 2)) = 1 / 2 := by\n      rw [exp_neg, show log 4 / 2 = log 2 by\n        rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]\n        push_cast\n        ring, Real.exp_log (by norm_num)]\n      norm_num\n    linarith\n  have h7 : exp (-x) ≤ δ' ^ 2 * (1 / 2) := by\n    rw [h2] at h1\n    exact h1.trans (mul_le_mul_of_nonneg_left h3 (sq_nonneg _))\n  nlinarith [hδ.1, hδ.2]","source":{"path":"Maiti2026Power/MXJ2026/RademacherTest.lean","start":36,"end":64,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/RademacherTest.lean#L36-L64"},"deps":[],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Neg.neg","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.exp","mathlib","definition"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instNeg","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DivInvMonoid.toDiv","HDiv.hDiv","HMul.hMul","LE.le","Membership.mem","Nat","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Neg.neg","OfNat.ofNat","One.toOfNat1","Real","Real.exp","Real.instDivInvMonoid","Real.instLE","Real.instMul","Real.instNatCast","Real.instNeg","Real.instOne","Real.instPreorder","Real.instZero","Real.log","Set","Set.Ioc","Set.instMembership","Zero.toOfNat0","instHDiv","instHMul","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"9c6478b137dc8420c69aff4ebc5499b633cb4457","date":"2026-09-07"}},{"id":1191,"name":"Maiti2026Power.testS_facts","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.RademacherTest","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"940c79c38477fcf9","local":"a250c7409e4242a8","content":"591e42236e0f8bb2"},"doc":"Common facts on the parameters of the scale test. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι","typeRefs":[[2,3,"LT.lt"],[4,16,"Fintype.card"]]},{"explicit":false,"head":"Real","implicit":true,"name":"t","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"ht","role":"hypothesis","type":"0 < t","typeRefs":[[2,3,"LT.lt"]]}],"conclusion":"0 < testS (Fintype.card ι) t ∧ ↑(Fintype.card ι) / ↑(testS (Fintype.card ι) t) ≤ t ^ 2 / 4","conclusionHead":"And","conclusionRefs":[[2,3,"LT.lt"],[4,9,"Maiti2026Power.testS"],[11,23,"Fintype.card"],[29,30,"And"],[33,45,"Fintype.card"],[49,50,"HDiv.hDiv"],[53,58,"Maiti2026Power.testS"],[60,72,"Fintype.card"],[79,80,"LE.le"],[83,84,"HPow.hPow"],[87,88,"HDiv.hDiv"]],"decl":"Maiti2026Power.testS_facts"},"code":"/-- Common facts on the parameters of the scale test. -/\nlemma testS_facts (hd : 0 < Fintype.card ι) {t : ℝ} (ht : 0 < t) :\n    0 < testS (Fintype.card ι) t ∧ (Fintype.card ι : ℝ) / testS (Fintype.card ι) t ≤ t ^ 2 / 4","proof":":= by\n  have hsge : 4 * (Fintype.card ι : ℝ) / t ^ 2 ≤ testS (Fintype.card ι) t := Nat.le_ceil _\n  have hspos : 0 < testS (Fintype.card ι) t := Nat.ceil_pos.2 (by positivity)\n  refine ⟨hspos, ?_⟩\n  have hspos' : (0 : ℝ) < testS (Fintype.card ι) t := by positivity\n  rw [div_le_iff₀ hspos']\n  calc (Fintype.card ι : ℝ) = t ^ 2 / 4 * (4 * Fintype.card ι / t ^ 2) := by field_simp\n    _ ≤ t ^ 2 / 4 * testS (Fintype.card ι) t := by gcongr","source":{"path":"Maiti2026Power/MXJ2026/RademacherTest.lean","start":66,"end":75,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/RademacherTest.lean#L66-L75"},"deps":[1185],"outside":[],"external":[["And","lean4","structure"],["DivInvMonoid.toDiv","mathlib","instance"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["FloorRing.toFloorSemiring","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.ceil","mathlib","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instFloorRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.linearOrder","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instLTNat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"sp