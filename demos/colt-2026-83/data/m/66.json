g","mathlib","definition"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instLTNat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["And","DivInvMonoid.toDiv","HDiv.hDiv","HMul.hMul","LE.le","LT.lt","Membership.mem","Nat","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","OfNat.ofNat","One.toOfNat1","Real","Real.instDivInvMonoid","Real.instLE","Real.instMul","Real.instNatCast","Real.instOne","Real.instPreorder","Real.instZero","Real.log","Set","Set.Ioc","Set.instMembership","Zero.toOfNat0","instHDiv","instHMul","instLTNat","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"9c6478b137dc8420c69aff4ebc5499b633cb4457","date":"2026-09-07"}},{"id":1188,"name":"Maiti2026Power.rbMeasure_real_test_h1_le","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.RademacherTest","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"51612c42113760a3","local":"6ac1b14beb7a7784","content":"750d92f85a68da2b"},"doc":"**Error of the scale test under `H₁`** (blueprint `lem:test_error_h1`): if `2t ≤ ‖θ‖`, the test\nreturns `H₀` (`Z̄ < 3t²/2`) with probability at most `3δ'/4`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"EuclideanSpace","implicit":true,"name":"θ","role":"variable","type":"EuclideanSpace ℝ ι","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι","typeRefs":[[2,3,"LT.lt"],[4,16,"Fintype.card"]]},{"explicit":false,"head":"Real","implicit":true,"name":"t","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"δ'","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"ht","role":"hypothesis","type":"0 < t","typeRefs":[[2,3,"LT.lt"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hδ","role":"hypothesis","type":"δ' ∈ Set.Ioc 0 (1 / 4)","typeRefs":[[3,4,"Membership.mem"],[5,12,"Set.Ioc"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hθ","role":"hypothesis","type":"2 * t ≤ ‖θ‖","typeRefs":[[2,3,"HMul.hMul"],[6,7,"LE.le"],[8,9,"Norm.norm"],[10,11,"Norm.norm"]]}],"conclusion":"(rbMeasure ι (testS (Fintype.card ι) t) (testK δ')).real\n    {p | rbStat (testS (Fintype.card ι) t) (testK δ') θ p < 3 * t ^ 2 / 2} ≤\n  3 * δ' / 4","conclusionHead":"LE.le","conclusionRefs":[[1,10,"Maiti2026Power.rbMeasure"],[14,19,"Maiti2026Power.testS"],[21,33,"Fintype.card"],[41,46,"Maiti2026Power.testK"],[52,56,"MeasureTheory.Measure.real"],[64,65,"Set.ofPred"],[66,72,"Maiti2026Power.rbStat"],[74,79,"Maiti2026Power.testS"],[81,93,"Fintype.card"],[101,106,"Maiti2026Power.testK"],[115,116,"LT.lt"],[119,120,"HMul.hMul"],[123,124,"HPow.hPow"],[127,128,"HDiv.hDiv"],[132,133,"LE.le"],[138,139,"HMul.hMul"],[143,144,"HDiv.hDiv"]],"decl":"Maiti2026Power.rbMeasure_real_test_h1_le"},"code":"/-- **Error of the scale test under `H₁`** (blueprint `lem:test_error_h1`): if `2t ≤ ‖θ‖`, the test\nreturns `H₀` (`Z̄ < 3t²/2`) with probability at most `3δ'/4`. -/\ntheorem rbMeasure_real_test_h1_le (hd : 0 < Fintype.card ι) {t δ' : ℝ} (ht : 0 < t)\n    (hδ : δ' ∈ Set.Ioc 0 (1 / 4)) (hθ : 2 * t ≤ ‖θ‖) :\n    (rbMeasure ι (testS (Fintype.card ι) t) (testK δ')).real\n      {p | rbStat (testS (Fintype.card ι) t) (testK δ') θ p < 3 * t ^ 2 / 2} ≤ 3 * δ' / 4","proof":":= by\n  obtain ⟨hspos, hds⟩ := testS_facts hd ht\n  obtain ⟨hKpos, hKge⟩ := testK_facts hδ\n  have hd' : (0 : ℝ) < Fintype.card ι := by positivity\n  set s : ℕ := testS (Fintype.card ι) t with hs_def\n  set K : ℕ := testK δ' with hK_def\n  clear_value s K\n  have hspos' : (0 : ℝ) < s := by positivity\n  have hK' : (0 : ℝ) ≤ K := by positivity\n  have hds0 : (0 : ℝ) ≤ Fintype.card ι / s := by positivity\n  have hr : 0 < ‖θ‖ := by linarith\n  have ht2 : t ^ 2 ≤ ‖θ‖ ^ 2 / 4 := by nlinarith\n  set a : ℝ := ‖θ‖ ^ 2 / 8 with ha_def\n  have ha : 0 ≤ a := by\n    rw [ha_def]\n    positivity\n  set τ : ℝ := 8 * (((Fintype.card ι : ℝ) / s) ^ 2 + 3 * Fintype.card ι * ‖θ‖ ^ 2 / (2 * s))\n    with hτ_def\n  have hτ0 : 0 < τ := by\n    rw [hτ_def]\n    positivity\n  clear_value a τ\n  have hsub : {p | rbStat s K θ p < 3 * t ^ 2 / 2}\n      ⊆ {p | 2 * a < |rbStat s K θ p - ‖θ‖ ^ 2|} := by\n    intro p hp\n    simp only [Set.mem_ofPred_eq] at hp ⊢\n    rw [ha_def, lt_abs]\n    right\n    nlinarith\n  refine (measureReal_mono hsub (measure_ne_top _ _)).trans ?_\n  refine (rbMeasure_real_abs_rbStat_sub_gt_le (θ := θ) (τ := τ) hd hspos hKpos ha).trans ?_\n  have hb1 : (rbMeasure ι s K).real {p | a < |(∑ k, rbX K θ p.1 k) / K|}\n      ≤ 2 * exp (-(K / 2048)) := by\n    refine (rbMeasure_real_avg_rbX_gt_le hKpos ha).trans\n      (two_mul_exp_neg_mul_min_le hK' ?_ ?_)\n    · rw [ha_def, le_div_iff₀ (by positivity)]\n      nlinarith\n    · rw [ha_def, le_div_iff₀ (by positivity)]\n      nlinarith\n  have hb2 : (rbMeasure ι s K).real {p | τ < rbVbar s K θ p.1} ≤ 2 * exp (-(K / 2048)) := by\n    rw [hτ_def]\n    refine (rbMeasure_real_rbVbar_gt_le hKpos).trans ?_\n    gcongr\n    linarith\n  have hb3 : 2 * exp (-(K * min (a ^ 2 / (2 * τ)) (a / (2 * (4 * ((Fintype.card ι : ℝ) / s))))))\n      ≤ 2 * exp (-(K / 2048)) := by\n    have hds' : (Fintype.card ι : ℝ) / s ≤ ‖θ‖ ^ 2 / 16 := by linarith\n    have hτle : τ ≤ 25 * ‖θ‖ ^ 4 / 32 := by\n      rw [hτ_def]\n      have h1 : ((Fintype.card ι : ℝ) / s) ^ 2 ≤ (‖θ‖ ^ 2 / 16) ^ 2 := pow_le_pow_left₀ hds0 hds' 2\n      have h2 : 3 * (Fintype.card ι : ℝ) * ‖θ‖ ^ 2 / (2 * s)\n          = 3 * ‖θ‖ ^ 2 / 2 * ((Fintype.card ι : ℝ) / s) := by ring\n      have h3 : 3 * ‖θ‖ ^ 2 / 2 * ((Fintype.card ι : ℝ) / s) ≤ 3 * ‖θ‖ ^ 2 / 2 * (‖θ‖ ^ 2 / 16) :=\n        mul_le_mul_of_nonneg_left hds' (by positivity)\n      rw [h2]\n      nlinarith\n    have hb : 4 * ((Fintype.card ι : ℝ) / s) ≤ ‖θ‖ ^ 2 / 4 := by linarith\n    have hbpos : 0 < 4 * ((Fintype.card ι : ℝ) / s) := by positivity\n    refine two_mul_exp_neg_mul_min_le hK' ?_ ?_\n    · rw [ha_def, le_div_iff₀ (by positivity)]\n      nlinarith\n    · rw [ha_def, le_div_iff₀ (by positivity)]\n      nlinarith\n  have hfinal : 6 * exp (-(K / 2048)) ≤ 3 * δ' / 4 :=\n    six_mul_exp_neg_le hδ (by linarith)\n  linarith","source":{"path":"Maiti2026Power/MXJ2026/RademacherTest.lean","start":179,"end":249,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/RademacherTest.lean#L179-L249"},"deps":[1150,1154,1185,1186],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["Bool","lean4","inductive"],["Bool.false","lean4","constructor"],["Bool.instMeasurableSpace","mathlib","instance"],["Bool.true","lean4","constructor"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.instInv","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definiti