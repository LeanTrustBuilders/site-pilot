:[],"pulled":false,"directExternal":["AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","Bool","Bool.instMeasurableSpace","DivInvMonoid.toDiv","ENNReal","ENNReal.instAddCommMonoidWithOne","EuclideanSpace","Fin","Fintype","Fintype.card","HDiv.hDiv","HMul.hMul","HPow.hPow","LE.le","LT.lt","MeasurableSpace.pi","MeasureTheory.Measure.real","Membership.mem","Monoid.toNPow","NPow.toPow","Nat","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Norm.norm","OfNat.ofNat","One.toOfNat1","PiLp.innerProductSpace._proof_1","PiLp.instNorm","Prod","Prod.instMeasurableSpace","Real","Real.instDivInvMonoid","Real.instLE","Real.instLT","Real.instMonoid","Real.instMul","Real.instNatCast","Real.instOne","Real.instPreorder","Real.instZero","Real.measurableSpace","Real.norm","Set","Set.Ioc","Set.instMembership","Set.ofPred","Zero.toOfNat0","instHDiv","instHMul","instHPow","instLTNat","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"9c6478b137dc8420c69aff4ebc5499b633cb4457","date":"2026-09-07"}},{"id":1189,"name":"Maiti2026Power.rbMeasure_real_test_h0_le","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.RademacherTest","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"12f0381db084cf7e","local":"25f66df6c7bdf637","content":"cd5bc8c236498039"},"doc":"**Error of the scale test under `H₀`** (blueprint `lem:test_error_h0`): if `‖θ‖ ≤ t`, the test\nreturns `H₁` (`Z̄ ≥ 3t²/2`) with probability at most `3δ'/4`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"EuclideanSpace","implicit":true,"name":"θ","role":"variable","type":"EuclideanSpace ℝ ι","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hd","role":"hypothesis","type":"0 < Fintype.card ι","typeRefs":[[2,3,"LT.lt"],[4,16,"Fintype.card"]]},{"explicit":false,"head":"Real","implicit":true,"name":"t","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"δ'","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"ht","role":"hypothesis","type":"0 < t","typeRefs":[[2,3,"LT.lt"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hδ","role":"hypothesis","type":"δ' ∈ Set.Ioc 0 (1 / 4)","typeRefs":[[3,4,"Membership.mem"],[5,12,"Set.Ioc"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hθ","role":"hypothesis","type":"‖θ‖ ≤ t","typeRefs":[[0,1,"Norm.norm"],[2,3,"Norm.norm"],[4,5,"LE.le"]]}],"conclusion":"(rbMeasure ι (testS (Fintype.card ι) t) (testK δ')).real\n    {p | 3 * t ^ 2 / 2 ≤ rbStat (testS (Fintype.card ι) t) (testK δ') θ p} ≤\n  3 * δ' / 4","conclusionHead":"LE.le","conclusionRefs":[[1,10,"Maiti2026Power.rbMeasure"],[14,19,"Maiti2026Power.testS"],[21,33,"Fintype.card"],[41,46,"Maiti2026Power.testK"],[52,56,"MeasureTheory.Measure.real"],[64,65,"Set.ofPred"],[68,69,"HMul.hMul"],[72,73,"HPow.hPow"],[76,77,"HDiv.hDiv"],[80,81,"LE.le"],[82,88,"Maiti2026Power.rbStat"],[90,95,"Maiti2026Power.testS"],[97,109,"Fintype.card"],[117,122,"Maiti2026Power.testK"],[132,133,"LE.le"],[138,139,"HMul.hMul"],[143,144,"HDiv.hDiv"]],"decl":"Maiti2026Power.rbMeasure_real_test_h0_le"},"code":"/-- **Error of the scale test under `H₀`** (blueprint `lem:test_error_h0`): if `‖θ‖ ≤ t`, the test\nreturns `H₁` (`Z̄ ≥ 3t²/2`) with probability at most `3δ'/4`. -/\ntheorem rbMeasure_real_test_h0_le (hd : 0 < Fintype.card ι) {t δ' : ℝ} (ht : 0 < t)\n    (hδ : δ' ∈ Set.Ioc 0 (1 / 4)) (hθ : ‖θ‖ ≤ t) :\n    (rbMeasure ι (testS (Fintype.card ι) t) (testK δ')).real\n      {p | 3 * t ^ 2 / 2 ≤ rbStat (testS (Fintype.card ι) t) (testK δ') θ p} ≤ 3 * δ' / 4","proof":":= by\n  obtain ⟨hspos, hds⟩ := testS_facts hd ht\n  obtain ⟨hKpos, hKge⟩ := testK_facts hδ\n  have hd' : (0 : ℝ) < Fintype.card ι := by positivity\n  set s : ℕ := testS (Fintype.card ι) t with hs_def\n  set K : ℕ := testK δ' with hK_def\n  clear_value s K\n  have hspos' : (0 : ℝ) < s := by positivity\n  have hK' : (0 : ℝ) ≤ K := by positivity\n  have hds0 : (0 : ℝ) ≤ Fintype.card ι / s := by positivity\n  have hr0 : 0 ≤ ‖θ‖ := norm_nonneg θ\n  set a : ℝ := t ^ 2 / 8 with ha_def\n  have ha : 0 ≤ a := by\n    rw [ha_def]\n    positivity\n  set τ : ℝ := 8 * (((Fintype.card ι : ℝ) / s) ^ 2 + 3 * Fintype.card ι * ‖θ‖ ^ 2 / (2 * s))\n    with hτ_def\n  have hτ0 : 0 < τ := by\n    rw [hτ_def]\n    positivity\n  clear_value a τ\n  -- the error event is contained in `{2a < |Z̄ - r²|}`\n  have hsub : {p | 3 * t ^ 2 / 2 ≤ rbStat s K θ p}\n      ⊆ {p | 2 * a < |rbStat s K θ p - ‖θ‖ ^ 2|} := by\n    intro p hp\n    simp only [Set.mem_ofPred_eq] at hp ⊢\n    have : ‖θ‖ ^ 2 ≤ t ^ 2 := by nlinarith\n    rw [ha_def, lt_abs]\n    left\n    nlinarith\n  refine (measureReal_mono hsub (measure_ne_top _ _)).trans ?_\n  refine (rbMeasure_real_abs_rbStat_sub_gt_le (θ := θ) (τ := τ) hd hspos hKpos ha).trans ?_\n  -- Term 1\n  have hb1 : (rbMeasure ι s K).real {p | a < |(∑ k, rbX K θ p.1 k) / K|}\n      ≤ 2 * exp (-(K / 2048)) := by\n    rcases eq_or_lt_of_le hr0 with hr | hr\n    · have hθ0 : θ = 0 := norm_eq_zero.1 hr.symm\n      subst hθ0\n      have hapos : 0 < a := by\n        rw [ha_def]\n        positivity\n      have : {p : (Fin K → ι → Bool) × (Fin K → Fin s → ℝ) | a < |(∑ k, rbX K 0 p.1 k) / K|}\n          = ∅ := by\n        ext p\n        simp [rbX_eq_zero_of_eq_zero, hapos.le]\n      rw [this, measureReal_empty]\n      positivity\n    · refine (rbMeasure_real_avg_rbX_gt_le hKpos ha).trans\n        (two_mul_exp_neg_mul_min_le hK' ?_ ?_)\n      · rw [ha_def, le_div_iff₀ (by positivity)]\n        have : ‖θ‖ ^ 4 ≤ t ^ 4 := pow_le_pow_left₀ hr0 hθ 4\n        nlinarith\n      · rw [ha_def, le_div_iff₀ (by positivity)]\n        nlinarith\n  -- variance proxy\n  have hb2 : (rbMeasure ι s K).real {p | τ < rbVbar s K θ p.1} ≤ 2 * exp (-(K / 2048)) := by\n    rw [hτ_def]\n    refine (rbMeasure_real_rbVbar_gt_le hKpos).trans ?_\n    gcongr\n    linarith\n  -- Term 2\n  have hb3 : 2 * exp (-(K * min (a ^ 2 / (2 * τ)) (a / (2 * (4 * ((Fintype.card ι : ℝ) / s))))))\n      ≤ 2 * exp (-(K / 2048)) := by\n    have hτle : τ ≤ 7 * t ^ 4 / 2 := by\n      rw [hτ_def]\n      have h1 : ((Fintype.card ι : ℝ) / s) ^ 2 ≤ (t ^ 2 / 4) ^ 2 := pow_le_pow_left₀ hds0 hds 2\n      have h2 : 3 * (Fintype.card ι : ℝ) * ‖θ‖ ^ 2 / (2 * s)\n          = 3 * ‖θ‖ ^ 2 / 2 * ((Fintype.card ι : ℝ) / s) := by ring\n      have h3 : 3 * ‖θ‖ ^ 2 / 2 * ((Fintype.card ι : ℝ) / s) ≤ 3 * t ^ 2 / 2 * (t ^ 2 / 4) :=\n        mul_le_mul (by nlinarith) hds hds0 (by positivity)\n      rw [h2]\n      nlinarith\n    have hb : 4 * ((Fintype.card ι : ℝ) / s) ≤ t ^ 2 := by linarith\n    have hbpos : 0 < 4 * ((Fintype.card ι : ℝ) / s) := by positivity\n    refine two_mul_exp_neg_mul_min_le hK' ?_ ?_\n    · rw [ha_def, le_div_iff₀ (by positivity)]\n      nlinarith\n    · rw [ha_def, le_div_iff₀ (by positivity)]\n      nlinarith\n  have hfinal : 6 * exp (-(K / 2048)) ≤ 3 * δ' / 4 :=\n    six_mul_exp_neg_le hδ (by linarith)\n  linarith","source":{"path":"Maiti2026Power/MXJ2026/RademacherTest.lean","start":91,"end":177,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/RademacherTest.lean#L91-L177"},"deps":[1150,1154,1185,1186],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["Bool","lean4","inductive"],["Bool.false","lean4","constructor"],["Bool.instMeasurableSpace","mathlib","instance"],["Bool.true","lean4","constructor"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","ma