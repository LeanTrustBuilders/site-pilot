":"EuclideanSpace ℝ ι →₀ ℝ"},{"explicit":false,"name":"w₂","role":"variable","type":"EuclideanSpace ℝ ι →₀ ℝ"},{"explicit":true,"name":"h₁","role":"hypothesis","type":"IsDesign 𝒳 w₁"},{"explicit":true,"name":"h₂","role":"hypothesis","type":"IsDesign 𝒳 w₂"}],"conclusion":"IsDesign 𝒳 (Maiti2026Power.mixDesign w₁ w₂)","decl":"Maiti2026Power.IsDesign.mixDesign"},"code":"/-- The mixture of two design distributions on `𝒳` is a design distribution on `𝒳`. -/\nlemma IsDesign.mixDesign (h₁ : IsDesign 𝒳 w₁) (h₂ : IsDesign 𝒳 w₂) :\n    IsDesign 𝒳 (mixDesign w₁ w₂)","proof":"where\n  support_subset := by\n    classical\n    refine (Finset.coe_subset.2 Finsupp.support_add).trans ?_\n    rw [Finset.coe_union]\n    exact Set.union_subset\n      ((Finset.coe_subset.2 Finsupp.support_smul).trans h₁.support_subset)\n      ((Finset.coe_subset.2 Finsupp.support_smul).trans h₂.support_subset)\n  nonneg x := by\n    simp only [Maiti2026Power.mixDesign, Finsupp.coe_add, Finsupp.coe_smul, Pi.add_apply,\n      Pi.smul_apply, smul_eq_mul]\n    have := h₁.nonneg x\n    have := h₂.nonneg x\n    positivity\n  sum_eq_one := by\n    change (Maiti2026Power.mixDesign w₁ w₂).sum (fun _ v ↦ v) = 1\n    rw [Maiti2026Power.mixDesign, Finsupp.sum_add_index' (fun _ ↦ rfl) (fun _ _ _ ↦ rfl),\n      Finsupp.sum_smul_index' (fun _ ↦ rfl), Finsupp.sum_smul_index' (fun _ ↦ rfl)]\n    simp only [smul_eq_mul, ← Finsupp.mul_sum]\n    change 1 / 2 * ∑ x ∈ w₁.support, w₁ x + 1 / 2 * ∑ x ∈ w₂.support, w₂ x = 1\n    rw [h₁.sum_eq_one, h₂.sum_eq_one]\n    norm_num","source":{"path":"Maiti2026Power/MXJ2026/MixedDesign.lean","start":40,"end":63,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/MixedDesign.lean#L40-L63"},"deps":[742,1066],"outside":[],"external":[["AddMonoid.toAddZeroClass","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DistribSMul.toSMulZeroClass","mathlib","insta