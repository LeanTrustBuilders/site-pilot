[{"id":735,"name":"Maiti2026Power.gwMat_designMatrix_mixDesign_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.MixedDesign","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"b5e0db1b89d6520d","local":"12ed126b76297f84","content":"2141dedffb3aed13"},"doc":"**Bounds for the mixed design, width part** (blueprint `lem:mixed_design_bounds`):\n`gwMat 𝒳 A₀ ≤ √2 gwMat 𝒳 A(w₁)` for the mixed design matrix `A₀`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)"},{"explicit":false,"name":"w₁","role":"variable","type":"EuclideanSpace ℝ ι →₀ ℝ"},{"explicit":false,"name":"w₂","role":"variable","type":"EuclideanSpace ℝ ι →₀ ℝ"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":true,"name":"h𝒳","role":"hypothesis","type":"IsCompact 𝒳"},{"explicit":true,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty"},{"explicit":true,"name":"h₁","role":"hypothesis","type":"(designMatrix w₁).PosDef"},{"explicit":true,"name":"h₂","role":"hypothesis","type":"(designMatrix w₂).PosSemidef"}],"conclusion":"gwMat 𝒳 (designMatrix (mixDesign w₁ w₂)) ≤ √2 * gwMat 𝒳 (designMatrix w₁)","decl":"Maiti2026Power.gwMat_designMatrix_mixDesign_le"},"code":"/-- **Bounds for the mixed design, width part** (blueprint `lem:mixed_design_bounds`):\n`gwMat 𝒳 A₀ ≤ √2 gwMat 𝒳 A(w₁)` for the mixed design matrix `A₀`. -/\nlemma gwMat_designMatrix_mixDesign_le (h𝒳 : IsCompact 𝒳) (hne : 𝒳.Nonempty)\n    (h₁ : (designMatrix w₁).PosDef) (h₂ : (designMatrix w₂).PosSemidef) :\n    gwMat 𝒳 (designMatrix (mixDesign w₁ w₂)) ≤ √2 * gwMat 𝒳 (designMatrix w₁)","proof":":= by\n  obtain ⟨R, hR⟩ : ∃ R, ∀ x ∈ 𝒳, ‖x‖ ≤ R := by\n    obtain ⟨r, hr⟩ := h𝒳.isBounded.subset_closedBall (0 : EuclideanSpace ℝ ι)\n    exact ⟨r, fun x hx ↦ mem_closedBall_zero_iff.1 (hr hx)⟩\n  calc gwMat 𝒳 (designMatrix (mixDesign w₁ w₂))\n      ≤ gwMat 𝒳 ((1 / 2 : ℝ) • designMatrix w₁) :=\n        gwMat_anti h𝒳 hne (h₁.smul (by norm_num))\n          (smul_designMatrix_le_designMatrix_mixDesign_left h₂)\n    _ = √2 * gwMat 𝒳 (designMatrix w₁) := by\n        rw [gwMat_smul hne hR h₁ (by norm_num), one_div, Real.sqrt_inv, inv_inv]","source":{"path":"Maiti2026Power/MXJ2026/MixedDesign.lean","start":99,"end":112,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/MixedDesign.lean#L99-L112"},"deps":[742,1082,1254],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["DistribSMul.toSMulZeroClass","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["EuclideanSpace","mathlib","definition"],["Finsupp","mathlib","structure"],["Finsupp.instAdd","mathlib","instance"],["Finsupp.instAddCommMonoid","mathlib","instance"],["Finsupp.instZero","mathlib","instance"],["Finsupp.linearCombination","mathlib","definition"],["Finsupp.module","mathlib","instance"],["Finsupp.smulZeroClass","mathlib","instance"],["Fintype","mathlib","class"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSMul.hSMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["Inv.inv","lean4","definition"],["IsCompact","mathlib","definition"],["LE.le","lean4","definition"],["LinearMap","mathlib","structure"],["LinearMap