fNat","One.toOfNat1","Semiring.toAddCommMonoid","instDistribOfSemiring","instHSMul","instSMulOfMul"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1502,"name":"MeasureTheory.Measure.rnDeriv_finsetSum","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.MeasureTheory.MixtureMeasure","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"678c72801219484b","local":"371ecb567cf7bb3f","content":"6d82de2e0e7c39aa"},"doc":"The Radon–Nikodym derivative of a finite sum of finite measures is the sum of the\nRadon–Nikodym derivatives. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"α","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mα","role":"instance","type":"MeasurableSpace α","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"Finset","implicit":false,"name":"s","role":"variable","type":"Finset ι","typeRefs":[[0,6,"Finset"]]},{"explicit":true,"implicit":false,"name":"ν","role":"variable","type":"ι → Measure α","typeRefs":[[4,11,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"∀ (i : ι), IsFiniteMeasure (ν i)","typeRefs":[[11,26,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"Measure α","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.SigmaFinite","implicit":false,"name":"","role":"instance","type":"SigmaFinite μ","typeRefs":[[0,11,"MeasureTheory.SigmaFinite"]]}],"conclusion":"(∑ i ∈ s, ν i).rnDeriv μ =ᵐ[μ] ∑ i ∈ s, (ν i).rnDeriv μ","conclusionHead":"Filter.EventuallyEq","conclusionRefs":[[15,22,"MeasureTheory.Measure.rnDeriv"],[46,53,"MeasureTheory.Measure.rnDeriv"]],"decl":"MeasureTheory.Measure.rnDeriv_finsetSum"},"code":"/-- The Radon–Nikodym derivative of a finite sum of finite measures is the sum of the\nRadon–Nikodym derivatives. -/\nlemma rnDeriv_finsetSum (s : Finset ι) (ν : ι → Measure α) [∀ i, IsFiniteMeasure (ν i)]\n    (μ : Measure α) [SigmaFinite μ] :\n    (∑ i ∈ s, ν i).rnDeriv μ =ᵐ[μ] ∑ i ∈ s, (ν i).rnDeriv μ","proof":":= by\n  classical\n  induction s using Finset.induction_on with\n  | empty => simp\n  | insert i s hi ih =>\n    rw [Finset.sum_insert hi, Finset.sum_insert hi]\n    exact (rnDeriv_add' _ _ _).trans (Filter.EventuallyEq.rfl.add ih)","source":{"path":"Maiti2026Power/Mathlib/MeasureTheory/MixtureMeasure.lean","start":52,"end":62,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/MeasureTheory/MixtureMeasure.lean#L52-L62"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoid","mathlib","instance"],["Filter.EventuallyEq","mathlib","definition"],["Finset","mathlib","structure"],["Finset.sum","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instAddCommMonoid","mathlib","instance"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.Measure.rnDeriv","mathlib","definition"],["MeasureTheory.SigmaFinite","mathlib","class"],["MeasureTheory.ae","mathlib","definition"],["Pi.addCommMonoid","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["ENNReal","ENNReal.instAddCommMonoid","Filter.EventuallyEq","Finset","Finset.sum","MeasurableSpace","MeasureTheory.IsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.Measure.instAddCommMonoid","MeasureTheory.Measure.instFunLike","MeasureTheory.Measure.instOuterMeasureClass","MeasureTheory.Measure.rnDeriv","MeasureTheory.SigmaFinite","MeasureTheory.ae","Pi.addCommMonoid"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1503,"name":"MeasureTheory.isProbabilityMeasure_finsetSum_smul","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.MeasureTheory.MixtureMeasure","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"ce0d7b1f2a22a51c","local":"8e9dc327d0d6c7dc","content":"fdea9525c2b0699e"},"doc":"A finite mixture of probability measures, with weights summing to `1`, is a probability\nmeasure. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"implicit":true,"name":"ν","role":"variable","type":"ι → Measure Ω","typeRefs":[[4,11,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":true,"name":"c","role":"variable","type":"ι → NNReal","typeRefs":[[4,10,"NNReal"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"∀ (i : ι), IsProbabilityMeasure (ν i)","typeRefs":[[11,31,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"Finset","implicit":true,"name":"s","role":"variable","type":"Finset ι","typeRefs":[[0,6,"Finset"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hc","role":"hypothesis","type":"∑ i ∈ s, c i = 1","typeRefs":[[13,14,"Eq"]]}],"conclusion":"IsProbabilityMeasure (∑ i ∈ s, ↑(c i) • ν i)","conclusionHead":"MeasureTheory.IsProbabilityMeasure","conclusionRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"],[38,39,"HSMul.hSMul"]],"decl":"MeasureTheory.isProbabilityMeasure_finsetSum_smul"},"code":"/-- A finite mixture of probability measures, with weights summing to `1`, is a probability\nmeasure. -/\nlemma isProbabilityMeasure_finsetSum_smul [∀ i, IsProbabilityMeasure (ν i)] {s : Finset ι}\n    (hc : ∑ i ∈ s, c i = 1) :\n    IsProbabilityMeasure (∑ i ∈ s, (c i : ℝ≥0∞) • ν i)","proof":"where\n  measure_univ := by\n    simp only [Measure.finsetSum_apply, Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]\n    rw [← ENNReal.ofNNReal_finsetSum, hc, ENNReal.coe_one]","source":{"path":"Maiti2026Power/Mathlib/MeasureTheory/MixtureMeasure.lean","start":30,"end":37,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/MeasureTheory/MixtureMeasure.lean#L30-L37"},"deps":[],"outside":[],"external":[["Algebra.id","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.ofNNReal","mathlib","definition"],["Eq","lean4","inductive"],["Finset","mathlib","structure"],["Finset.sum","mathlib","definition"],["HSMul.hSMul","lean4","definition"],["IsScalarTower.right","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instAddCommMonoid","mathlib","instance"],["MeasureTheory.Measure.instSMul","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NNReal.instSemiring","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["instDistribOfSemiring","mathlib","instance"],["instHSMul","lean4","instance"],["instSMulOfMul","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Algebra.id","CommSemiring.toSemiring","Distrib.toMul","ENNReal","ENNReal.instCommSemiring","ENNReal.ofNNReal","Eq","Finset","Finset.sum","HSMul.hSMul","IsScalarTower.right","MeasurableSpace","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.instAddCommMonoid","MeasureTheory.Measure.instSMul","NNReal","NNReal.instOne","NNReal.instSemiring","OfNat.ofNat","One.toOfNat1","Semiring.toAddCommMonoid","instDistribOfSemiring","instHSMul","instSMulOfMul"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1504,"name":"MeasureTheory.Measure.rnDeriv_finsetSum_smul","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.MeasureTheory.MixtureMeasure","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"0cf62b4273eead04","local":"e7711637a529cc1f","content":"102541bdd83fe7ef"},"doc":"The Radon–Nikodym derivative of a finite mixture `∑ i ∈ s, c i • ν i` of finite measures\nwith respect to `μ` is the mixture of the Radon–Nikodym derivatives. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"α","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mα","role":"instance","type":"MeasurableSpace α","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"Finset","implicit":false,"name":"s","role":"variable","type":"Finset ι","typeRefs":[[0,6,"Finset"]]},{"explicit":true,"implicit":false,"name":"c","role":"variable","type":"ι → NNReal","typeRefs":[[4,10,"NNReal"]]},{"explicit":true,"implicit":false,"name":"ν","role":"variable","type":"ι → Measure α","typeRefs":[[4,11,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"∀ (i : ι), IsFiniteMeasure (ν i)","typeRefs":[[11,26,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"Measure α","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.SigmaFinite","implicit":false,"name":"","role":"instance","type":"SigmaFinite μ","typeRefs":[[0,11,"MeasureTheory.SigmaFinite"]]}],"conclusion":"(∑ i ∈ s, ↑(c i) • ν i).rnDeriv μ =ᵐ[μ] fun x => ∑ i ∈ s, ↑(c i) * (ν i).rnDeriv μ x","conclusionHead":"Filter.EventuallyEq","conclusionRefs":[[17,18,"HSMul.hSMul"],[24,31,"MeasureTheory.Measure.rnDeriv"],[65,66,"HMul.hMul"],[73,80,"MeasureTheory.Measure.rnDeriv"]],"decl":"MeasureTheory.Measure.rnDeriv_finsetSum_smul"},"code":"/-- The Radon–Nikodym derivative of a finite mixture `∑ i ∈ s, c i • ν i` of finite measures\nwith respect to `μ` is the mixture of the Radon–Nikodym derivatives. -/\nlemma rnDeriv_finsetSum_smul (s : Finset ι) (c : ι → ℝ≥0) (ν : ι → Measure α)\n    [∀ i, IsFiniteMeasure (ν i)] (μ : Measure α) [SigmaFinite μ] :\n    (∑ i ∈ s, (c i : ℝ≥0∞) • ν i).rnDeriv μ\n      =ᵐ[μ] fun x ↦ ∑ i ∈ s, (c i : ℝ≥0∞) * (ν i).rnDeriv μ x","proof":":= by\n  have : ∀ i, IsFiniteMeasure ((c i : ℝ≥0∞) • ν i) :=\n    fun i ↦ Measure.smul_finite _ ENNReal.coe_ne_top\n  filter_upwards [rnDeriv_finsetSum s (fun i ↦ (c i : ℝ≥0∞) • ν i) μ,\n    (Filter.eventually_all_finset s).mpr\n      fun i _ ↦ rnDeriv_smul_left_of_ne_top (ν i) μ (ENNReal.coe_ne_top (r := c i))]\n    with x hx hx_smul\n  rw [hx, Finset.sum_apply]\n  exact Finset.sum_congr rfl fun i hi ↦ by rw [hx_smul i hi, Pi.smul_apply, smul_eq_mul]","source":{"path":"Maiti2026Power/Mathlib/MeasureTheory/MixtureMeasure.lean","start":64,"end":77,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/MeasureTheory/MixtureMeasure.lean#L64-L77"},"deps":[],"outside":[],"external":[["Algebra.id","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoid","mathlib","instance"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.ofNNReal","mathlib","definition"],["Filter.EventuallyEq","mathlib","definition"],["Finset","mathlib","structure"],["Finset.sum","mathlib","definition"],["HMul.hMul","lean4","definition"],["HSMul.hSMul","lean4","definition"],["IsScalarTower.right","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instAddCommMonoid","mathlib","instance"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.Measure.instSMul","mathlib","instance"],["MeasureTheory.Measure.rnDeriv","mathlib","definition"],["MeasureTheory.SigmaFinite","mathlib","class"],["MeasureTheory.ae","mathlib","definition"],["NNReal","mathlib","definition"],["instDistribOfSemiring","mathlib","instance"],["instHMul","lean4","instance"],["instHSMul","lean4","instance"],["instSMulOfMul","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Algebra.id","CommSemiring.toSemiring","Distrib.toMul","ENNReal","ENNReal.instAddCommMonoid","ENNReal.instCommSemiring","ENNReal.ofNNReal","Filter.EventuallyEq","Finset","Finset.sum","HMul.hMul","HSMul.hSMul","IsScalarTower.right","MeasurableSpace","MeasureTheory.IsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.Measure.instAddCommMonoid","MeasureTheory.Measure.instFunLike","MeasureTheory.Measure.instOuterMeasureClass","MeasureTheory.Measure.instSMul","MeasureTheory.Measure.rnDeriv","MeasureTheory.SigmaFinite","MeasureTheory.ae","NNReal","instDistribOfSemiring","instHMul","instHSMul","instSMulOfMul"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}}]