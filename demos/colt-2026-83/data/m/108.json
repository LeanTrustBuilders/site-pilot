[{"id":1501,"name":"MeasureTheory.isProbabilityMeasure_sum_smul","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.MeasureTheory.MixtureMeasure","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"a6823e601ec3eba0","local":"f1ea17141dcf83f5","content":"69ec713ffd58afc8"},"doc":"A finite mixture of probability measures, with weights summing to `1`, is a probability\nmeasure. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"implicit":true,"name":"ν","role":"variable","type":"ι → Measure Ω","typeRefs":[[4,11,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":true,"name":"c","role":"variable","type":"ι → NNReal","typeRefs":[[4,10,"NNReal"]]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"∀ (i : ι), IsProbabilityMeasure (ν i)","typeRefs":[[11,31,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hc","role":"hypothesis","type":"∑ i, c i = 1","typeRefs":[[9,10,"Eq"]]}],"conclusion":"IsProbabilityMeasure (∑ i, ↑(c i) • ν i)","conclusionHead":"MeasureTheory.IsProbabilityMeasure","conclusionRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"],[34,35,"HSMul.hSMul"]],"decl":"MeasureTheory.isProbabilityMeasure_sum_smul"},"code":"/-- A finite mixture of probability measures, with weights summing to `1`, is a probability\nmeasure. -/\nlemma isProbabilityMeasure_sum_smul [Fintype ι] [∀ i, IsProbabilityMeasure (ν i)]\n    (hc : ∑ i, c i = 1) :\n    IsProbabilityMeasure (∑ i, (c i : ℝ≥0∞) • ν i)","proof":":=\n  isProbabilityMeasure_fi