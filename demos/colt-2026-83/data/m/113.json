,93,"HMul.hMul"]],"decl":"ProbabilityTheory.lintegral_bernoulliMeasure"},"code":"/-- The Lebesgue integral of a function against a Bernoulli measure. -/\nlemma lintegral_bernoulliMeasure (x y : X) (p : I) (f : X → ℝ≥0∞) :\n    ∫⁻ z, f z ∂Ber(x, y, p) = ENNReal.ofReal p * f x + ENNReal.ofReal (1 - p) * f y","proof":":= by\n  rw [bernoulliMeasure_def, lintegral_add_measure, lintegral_smul_measure, lintegral_smul_measure,\n    lintegral_dirac, lintegral_dirac, ENNReal.smul_def, ENNReal.smul_def, coe_toNNReal_eq_ofReal,\n    coe_toNNReal_eq_ofReal, coe_symm_eq, smul_eq_mul, smul_eq_mul]","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":53,"end":58,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L53-L58"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAdd","mathlib","instance"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.lintegral","mathlib","definition"],["Membership.mem","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["instDistribOfSemiring","mathlib","instance"],["instHAdd","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["u