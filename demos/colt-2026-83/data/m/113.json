s":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DFunLike.coe","ENNReal","ENNReal.ofReal","Eq","HSub.hSub","MeasurableSingletonClass","MeasurableSpace","MeasureTheory.Measure","MeasureTheory.Measure.instFunLike","Membership.mem","Ne","OfNat.ofNat","One.toOfNat1","ProbabilityTheory.bernoulliMeasure","Real","Real.instOne","Real.instSub","Set","Set.Elem","Set.instMembership","Set.instSingletonSet","Singleton.singleton","Subtype.val","instHSub","unitInterval"],"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1540,"name":"ProbabilityTheory.bernoulliMeasure_absolutelyContinuous_iff","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"5c5a2631fbcfcfef","local":"a90a5d627ccdf70f","content":"11f2a362e65ae7e2"},"doc":"For `x ≠ y`, `Ber(x, y, p) ≪ Ber(x, y, q)` unless `q ∈ {0, 1}` and `p ≠ q`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"X","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace X","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSingletonClass","implicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X","typeRefs":[[0,24,"MeasurableSingletonClass"]]},{"explicit":false,"implicit":true,"name":"x","role":"variable","type":"X","typeRefs":[]},{"explicit":false,"implicit":true,"name":"y","role":"variable","type":"X","typeRefs":[]},{"explicit":false,"head":"Set.Elem","implicit":true,"name":"p","role":"variable","type":"↑unitInterval","typeRefs":[[1,13,"unitInterval"]]},{"explicit":false,"head":"Set.Elem","implicit":true,"name":"q","role":"variable","type":"↑unitInterval","typeRefs":[[1,13,"unitInterval"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hxy","role":"hypothesis","type":"x ≠ y","typeRefs":[[2,3,"Ne"]]}],"conclusion":"(bernoulliMeasure x y p).AbsolutelyContinuous (bernoulliMeasure x y q) ↔\n  (q = 0 → p = 0) ∧ (q = 1 → p = 1)","conclusionHead":"Iff","conclusionRefs":[[1,17,"ProbabilityTheory.bernoulliMeasure"],[25,45,"MeasureTheory.Measure.AbsolutelyContinuous"],[47,63,"ProbabilityTheory.bernoulliMeasure"],[71,72,"Iff"],[78,79,"Eq"],[86,87,"Eq"],[91,92,"And"],[96,97,"Eq"],[104,105,"Eq"]],"decl":"ProbabilityTheory.bernoulliMeasure_absolutelyContinuous_iff"},"code":"/-- For `x ≠ y`, `Ber(x, y, p) ≪ Ber(x, y, q)` unless `q ∈ {0, 1}` and `p ≠ q`. -/\nlemma bernoulliMeasure_absolutelyContinuous_iff (hxy : x ≠ y) :\n    Ber(x, y, p) ≪ Ber(x, y, q) ↔ (q = 0 → p = 0) ∧ (q = 1 → p = 1)","proof":":= by\n  refine ⟨fun h ↦ ⟨fun hq ↦ ?_, fun hq ↦ ?_⟩, fun ⟨h0, h1⟩ ↦ ?_⟩\n  · subst hq\n    have hx : Ber(x, y, p) {x} = 0 := h (by simp [hxy.symm])\n    rw [bernoulliMeasure_apply_singleton_left hxy, ENNReal.ofReal_eq_zero] at hx\n    exact Set.Icc.coe_eq_zero.1 (le_antisymm hx p.2.1)\n  · subst hq\n    have hy : Ber(x, y, p) {y} = 0 := h (by simp [hxy])\n    rw [bernoulliMeasure_apply_singleton_right hxy, ENNReal.ofReal_eq_zero, sub_nonpos] at hy\n    exact Set.Icc.coe_eq_one.1 (le_antisymm p.2.2 hy)\n  · by_cases hq : q = 0\n    · rw [h0 hq, hq]\n    by_cases hq1 : q = 1\n    · rw [h1 hq1, hq1]\n    exact bernoulliMeasure_absolutelyContinuous hxy p hq hq1","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":89,"end":105,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L89-L105"},"deps":[],"outside":[],"external":[["And","lean4","structure"],["Eq","lean4","inductive"],["Iff","lean4","structure"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure.AbsolutelyContinuous","mathlib","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instIsOrderedRing","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set.Elem","mathlib","definition"],["Set.Icc.instOne","mathlib","instance"],["Set.Icc.instZero","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["And","Eq","Iff","MeasurableSingletonClass","MeasurableSpace","MeasureTheory.Measure.AbsolutelyContinuous","Ne","OfNat.ofNat","One.toOfNat1","ProbabilityTheory.bernoulliMeasure","Real","Real.instIsOrderedRing","Real.partialOrder","Real.semiring","Set.Elem","Set.Icc.instOne","Set.Icc.instZero","Zero.toOfNat0","unitInterval"],"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1541,"name":"ProbabilityTheory.bernoulliMeasure_apply_singleton_left","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"a7d63e816f75aa8e","local":"a6883ff6638645f4","content":"40dc029a9202033b"},"doc":"","statement":{"binders":[{"explicit":false,"implicit":true,"name":"X","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace X","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSingletonClass","implicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X","typeRefs":[[0,24,"MeasurableSingletonClass"]]},{"explicit":false,"implicit":true,"name":"x","role":"variable","type":"X","typeRefs"