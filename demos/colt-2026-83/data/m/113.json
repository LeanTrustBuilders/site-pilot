"Ne","implicit":false,"name":"hq1","role":"hypothesis","type":"q ≠ 1","typeRefs":[[2,3,"Ne"]]}],"conclusion":"bernoulliMeasure x y p =\n  (bernoulliMeasure x y q).withDensity fun z =>\n    if z = x then ENNReal.ofReal (↑p / ↑q) else ENNReal.ofReal ((1 - ↑p) / (1 - ↑q))","conclusionHead":"Eq","conclusionRefs":[[0,16,"ProbabilityTheory.bernoulliMeasure"],[23,24,"Eq"],[28,44,"ProbabilityTheory.bernoulliMeasure"],[52,63,"MeasureTheory.Measure.withDensity"],[77,79,"ite"],[82,83,"Eq"],[86,90,"ite"],[91,105,"ENNReal.ofReal"],[110,111,"HDiv.hDiv"],[116,120,"ite"],[121,135,"ENNReal.ofReal"],[140,141,"HSub.hSub"],[146,147,"HDiv.hDiv"],[151,152,"HSub.hSub"]],"decl":"ProbabilityTheory.bernoulliMeasure_eq_withDensity"},"code":"/-- For `x ≠ y` and `q ∉ {0, 1}`, the Bernoulli measure `Ber(x, y, p)` has density `p / q` at `x`\nand `(1 - p) / (1 - q)` at `y` with respect to `Ber(x, y, q)`. -/\nlemma bernoulliMeasure_eq_withDensity [DecidableEq X] (hxy : x ≠ y) (p : I) (hq : q ≠ 0)\n    (hq1 : q ≠ 1) :\n    Ber(x, y, p) = Ber(x, y, q).withDensity\n      (fun z ↦ if z = x then ENNReal.ofReal (p / q) else ENNReal.ofReal ((1 - p) / (1 - q)))","proof":":= by\n  have hq0 : (q : ℝ) ≠ 0 := coe_ne_zero.2 hq\n  have hq1' : (1 : ℝ) - q ≠ 0 := sub_ne_zero.2 (coe_ne_one.2 hq1).symm\n  rw [bernoulliMeasure_def, bernoulliMeasure_def, withDensity_add_measure]\n  simp_rw [ENNReal.smul_def]\n  rw [withDensity_smul_measure, withDensity_smul_measure, dirac_withDensity, dirac_withDensity,\n    ite_eq_left rfl, ite_eq_right hxy.symm, smul_smul, smul_smul, coe_toNNReal_eq_ofReal,\n    coe_toNNReal_eq_ofReal, coe_toNNReal_eq_ofReal, coe_toNNReal_eq_ofReal, coe_symm_eq,\n    coe_symm_eq]\n  congr 1 <;> congr 1\n  · rw [← ENNReal.ofReal_mul q.2.1]\n    congr 1\n    field_simp\n  · rw [← ENNReal.ofReal_mul (sub_nonneg.2 q.2.2)]\n    congr 1\n    field_simp","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":60,"end":80,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L60-L80"},"deps":[],"outside":[],"external":[["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HDiv.hDiv","lean4","definition"],["HSub.hSub","lean4","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.withDensity","mathlib","definition"],["Membership.mem","lean4","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instIsOrderedRing","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Icc.instOne","mathlib","instance"],["Set.Icc.instZero","mathlib","instance"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHSub","lean4","instance"],["ite","lean4","definition"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DecidableEq","DivInvMonoid.toDiv","ENNReal","ENNReal.ofReal","Eq","HDiv.hDiv","HSub.hSub","MeasurableSingletonClass","MeasurableSpace","MeasureTheory.Measure","MeasureTheory.Measure.withDensity","Membership.mem","Ne","OfNat.ofNat","One.toOfNat1","ProbabilityTheory.bernoulliMeasure","Real","Real.instDivInvMono