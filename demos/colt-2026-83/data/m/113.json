[{"id":1536,"name":"unitInterval.coe_toNNReal_eq_ofReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"7bfb4e6e385c38fe","local":"6c4fb06a2744a29f","content":"9021c1761f90d8d7"},"doc":"The coercion `unitInterval → ℝ≥0 → ℝ≥0∞` is `ENNReal.ofReal`. ","statement":{"binders":[{"explicit":true,"head":"Set.Elem","implicit":false,"name":"p","role":"variable","type":"↑unitInterval","typeRefs":[[1,13,"unitInterval"]]}],"conclusion":"↑(toNNReal p) = ENNReal.ofReal ↑p","conclusionHead":"Eq","conclusionRefs":[[2,10,"unitInterval.toNNReal"],[14,15,"Eq"],[16,30,"ENNReal.ofReal"]],"decl":"unitInterval.coe_toNNReal_eq_ofReal"},"code":"/-- The coercion `unitInterval → ℝ≥0 → ℝ≥0∞` is `ENNReal.ofReal`. -/\nlemma coe_toNNReal_eq_ofReal (p : I) : ((toNNReal p : ℝ≥0) : ℝ≥0∞) = ENNReal.ofReal p","proof":":= by\n  rw [ENNReal.ofReal, Real.toNNReal_of_nonneg p.2.1]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":32,"end":35,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L32-L35"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["ENNReal.ofNNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["Membership.mem","lean4","definition"],["Real","mathlib","structure"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["unitInterval","mathlib","definition"],["unitInterval.toNNReal","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["ENNReal","ENNReal.ofNNReal","ENNReal.ofReal","Eq","Member