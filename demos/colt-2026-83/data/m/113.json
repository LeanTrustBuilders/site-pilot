[{"id":1536,"name":"unitInterval.coe_toNNReal_eq_ofReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"7bfb4e6e385c38fe","local":"6c4fb06a2744a29f","content":"9021c1761f90d8d7"},"doc":"The coercion `unitInterval → ℝ≥0 → ℝ≥0∞` is `ENNReal.ofReal`. ","statement":{"binders":[{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"}],"conclusion":"↑(toNNReal p) = ENNReal.ofReal ↑p","decl":"unitInterval.coe_toNNReal_eq_ofReal"},"code":"/-- The coercion `unitInterval → ℝ≥0 → ℝ≥0∞` is `ENNReal.ofReal`. -/\nlemma coe_toNNReal_eq_ofReal (p : I) : ((toNNReal p : ℝ≥0) : ℝ≥0∞) = ENNReal.ofReal p","proof":":= by\n  rw [ENNReal.ofReal, Real.toNNReal_of_nonneg p.2.1]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":32,"end":35,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L32-L35"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["ENNReal.ofNNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["Membership.mem","lean4","definition"],["Real","mathlib","structure"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["unitInterval","mathlib","definition"],["unitInterval.toNNReal","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1537,"name":"ProbabilityTheory.bernoulliMeasure_eq_withDensity","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"de508c453a7e55ad","local":"2446d7769fb4f42f","content":"bb49033b6bef01e4"},"doc":"For `x ≠ y` and `q ∉ {0, 1}`, the Bernoulli measure `Ber(x, y, p)` has density `p / q` at `x`\nand `(1 - p) / (1 - q)` at `y` with respect to `Ber(x, y, q)`. ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":false,"name":"q","role":"variable","type":"↑unitInterval"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq X"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"hq","role":"hypothesis","type":"q ≠ 0"},{"explicit":true,"name":"hq1","role":"hypothesis","type":"q ≠ 1"}],"conclusion":"bernoulliMeasure x y p =\n  (bernoulliMeasure x y q).withDensity fun z =>\n    if z = x then ENNReal.ofReal (↑p / ↑q) else ENNReal.ofReal ((1 - ↑p) / (1 - ↑q))","decl":"ProbabilityTheory.bernoulliMeasure_eq_withDensity"},"code":"/-- For `x ≠ y` and `q ∉ {0, 1}`, the Bernoulli measure `Ber(x, y, p)` has density `p / q` at `x`\nand `(1 - p) / (1 - q)` at `y` with respect to `Ber(x, y, q)`. -/\nlemma bernoulliMeasure_eq_withDensity [DecidableEq X] (hxy : x ≠ y) (p : I) (hq : q ≠ 0)\n    (hq1 : q ≠ 1) :\n    Ber(x, y, p) = Ber(x, y, q).withDensity\n      (fun z ↦ if z = x then ENNReal.ofReal (p / q) else ENNReal.ofReal ((1 - p) / (1 - q)))","proof":":= by\n  have hq0 : (q : ℝ) ≠ 0 := coe_ne_zero.2 hq\n  have hq1' : (1 : ℝ) - q ≠ 0 := sub_ne_zero.2 (coe_ne_one.2 hq1).symm\n  rw [bernoulliMeasure_def, bernoulliMeasure_def, withDensity_add_measure]\n  simp_rw [ENNReal.smul_def]\n  rw [withDensity_smul_measure, withDensity_smul_measure, dirac_withDensity, dirac_withDensity,\n    ite_eq_left rfl, ite_eq_right hxy.symm, smul_smul, smul_smul, coe_toNNReal_eq_ofReal,\n    coe_toNNReal_eq_ofReal, coe_toNNReal_eq_ofReal, coe_toNNReal_eq_ofReal, coe_symm_eq,\n    coe_symm_eq]\n  congr 1 <;> congr 1\n  · rw [← ENNReal.ofReal_mul q.2.1]\n    congr 1\n    field_simp\n  · rw [← ENNReal.ofReal_mul (sub_nonneg.2 q.2.2)]\n    congr 1\n    field_simp","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":60,"end":80,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L60-L80"},"deps":[],"outside":[],"external":[["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HDiv.hDiv","lean4","definition"],["HSub.hSub","lean4","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.withDensity","mathlib","definition"],["Membership.mem","lean4","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instIsOrderedRing","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Icc.instOne","mathlib","instance"],["Set.Icc.instZero","mathlib","instance"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHSub","lean4","instance"],["ite","lean4","definition"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1538,"name":"ProbabilityTheory.lintegral_bernoulliMeasure","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"dde5da28dd50f8e9","local":"bf23f352177208ce","content":"66304fc1bac24090"},"doc":"The Lebesgue integral of a function against a Bernoulli measure. ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":true,"name":"x","role":"variable","type":"X"},{"explicit":true,"name":"y","role":"variable","type":"X"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"f","role":"variable","type":"X → ENNReal"}],"conclusion":"∫⁻ (z : X), f z ∂bernoulliMeasure x y p = ENNReal.ofReal ↑p * f x + ENNReal.ofReal (1 - ↑p) * f y","decl":"ProbabilityTheory.lintegral_bernoulliMeasure"},"code":"/-- The Lebesgue integral of a function against a Bernoulli measure. -/\nlemma lintegral_bernoulliMeasure (x y : X) (p : I) (f : X → ℝ≥0∞) :\n    ∫⁻ z, f z ∂Ber(x, y, p) = ENNReal.ofReal p * f x + ENNReal.ofReal (1 - p) * f y","proof":":= by\n  rw [bernoulliMeasure_def, lintegral_add_measure, lintegral_smul_measure, lintegral_smul_measure,\n    lintegral_dirac, lintegral_dirac, ENNReal.smul_def, ENNReal.smul_def, coe_toNNReal_eq_ofReal,\n    coe_toNNReal_eq_ofReal, coe_symm_eq, smul_eq_mul, smul_eq_mul]","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":53,"end":58,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L53-L58"},"deps":[],"outside":[],"external":[["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAdd","mathlib","instance"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.lintegral","mathlib","definition"],["Membership.mem","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["instDistribOfSemiring","mathlib","instance"],["instHAdd","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1539,"name":"ProbabilityTheory.bernoulliMeasure_apply_singleton_right","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"555b6e288bd44715","local":"8cc11500ac4e7f61","content":"87af1b33bd5e9d09"},"doc":"","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"}],"conclusion":"(bernoulliMeasure x y p) {y} = ENNReal.ofReal (1 - ↑p)","decl":"ProbabilityTheory.bernoulliMeasure_apply_singleton_right"},"code":"lemma bernoulliMeasure_apply_singleton_right (hxy : x ≠ y) (p : I) :\n    Ber(x, y, p) {y} = ENNReal.ofReal (1 - p)","proof":":= by\n  rw [bernoulliMeasure_apply_of_notMem_of_mem _ (measurableSet_singleton y) (by simpa using hxy)\n    (Set.mem_singleton y), coe_toNNReal_eq_ofReal, coe_symm_eq]","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":48,"end":51,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L48-L51"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HSub.hSub","lean4","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["Membership.mem","lean4","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.instSingletonSet","mathlib","instance"],["Singleton.singleton","lean4","definition"],["Subtype.val","lean4","definition"],["instHSub","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1540,"name":"ProbabilityTheory.bernoulliMeasure_absolutelyContinuous_iff","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"5c5a2631fbcfcfef","local":"a90a5d627ccdf70f","content":"11f2a362e65ae7e2"},"doc":"For `x ≠ y`, `Ber(x, y, p) ≪ Ber(x, y, q)` unless `q ∈ {0, 1}` and `p ≠ q`. ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":false,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":false,"name":"q","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"}],"conclusion":"(bernoulliMeasure x y p).AbsolutelyContinuous (bernoulliMeasure x y q) ↔\n  (q = 0 → p = 0) ∧ (q = 1 → p = 1)","decl":"ProbabilityTheory.bernoulliMeasure_absolutelyContinuous_iff"},"code":"/-- For `x ≠ y`, `Ber(x, y, p) ≪ Ber(x, y, q)` unless `q ∈ {0, 1}` and `p ≠ q`. -/\nlemma bernoulliMeasure_absolutelyContinuous_iff (hxy : x ≠ y) :\n    Ber(x, y, p) ≪ Ber(x, y, q) ↔ (q = 0 → p = 0) ∧ (q = 1 → p = 1)","proof":":= by\n  refine ⟨fun h ↦ ⟨fun hq ↦ ?_, fun hq ↦ ?_⟩, fun ⟨h0, h1⟩ ↦ ?_⟩\n  · subst hq\n    have hx : Ber(x, y, p) {x} = 0 := h (by simp [hxy.symm])\n    rw [bernoulliMeasure_apply_singleton_left hxy, ENNReal.ofReal_eq_zero] at hx\n    exact Set.Icc.coe_eq_zero.1 (le_antisymm hx p.2.1)\n  · subst hq\n    have hy : Ber(x, y, p) {y} = 0 := h (by simp [hxy])\n    rw [bernoulliMeasure_apply_singleton_right hxy, ENNReal.ofReal_eq_zero, sub_nonpos] at hy\n    exact Set.Icc.coe_eq_one.1 (le_antisymm p.2.2 hy)\n  · by_cases hq : q = 0\n    · rw [h0 hq, hq]\n    by_cases hq1 : q = 1\n    · rw [h1 hq1, hq1]\n    exact bernoulliMeasure_absolutelyContinuous hxy p hq hq1","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":89,"end":105,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L89-L105"},"deps":[],"outside":[],"external":[["And","lean4","structure"],["Eq","lean4","inductive"],["Iff","lean4","structure"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure.AbsolutelyContinuous","mathlib","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instIsOrderedRing","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set.Elem","mathlib","definition"],["Set.Icc.instOne","mathlib","instance"],["Set.Icc.instZero","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1541,"name":"ProbabilityTheory.bernoulliMeasure_apply_singleton_left","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"a7d63e816f75aa8e","local":"a6883ff6638645f4","content":"40dc029a9202033b"},"doc":"","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"}],"conclusion":"(bernoulliMeasure x y p) {x} = ENNReal.ofReal ↑p","decl":"ProbabilityTheory.bernoulliMeasure_apply_singleton_left"},"code":"lemma bernoulliMeasure_apply_singleton_left (hxy : x ≠ y) (p : I) :\n    Ber(x, y, p) {x} = ENNReal.ofReal p","proof":":= by\n  rw [bernoulliMeasure_apply_of_mem_of_notMem _ (measurableSet_singleton x) (Set.mem_singleton x)\n    (by simpa using hxy.symm), coe_toNNReal_eq_ofReal]","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":43,"end":46,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L43-L46"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["Membership.mem","lean4","definition"],["Ne","lean4","definition"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.instSingletonSet","mathlib","instance"],["Singleton.singleton","lean4","definition"],["Subtype.val","lean4","definition"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1542,"name":"ProbabilityTheory.bernoulliMeasure_absolutelyContinuous","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Distributions.Bernoulli","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"f1c9f49f8a54519e","local":"f4b8934c6a2a6a21","content":"1e8bb218331d0158"},"doc":"For `x ≠ y` and `q ∉ {0, 1}`, `Ber(x, y, p) ≪ Ber(x, y, q)`. ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":false,"name":"q","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"hq","role":"hypothesis","type":"q ≠ 0"},{"explicit":true,"name":"hq1","role":"hypothesis","type":"q ≠ 1"}],"conclusion":"(bernoulliMeasure x y p).AbsolutelyContinuous (bernoulliMeasure x y q)","decl":"ProbabilityTheory.bernoulliMeasure_absolutelyContinuous"},"code":"/-- For `x ≠ y` and `q ∉ {0, 1}`, `Ber(x, y, p) ≪ Ber(x, y, q)`. -/\nlemma bernoulliMeasure_absolutelyContinuous (hxy : x ≠ y) (p : I) (hq : q ≠ 0) (hq1 : q ≠ 1) :\n    Ber(x, y, p) ≪ Ber(x, y, q)","proof":":= by\n  classical\n  rw [bernoulliMeasure_eq_withDensity hxy p hq hq1]\n  exact withDensity_absolutelyContinuous _ _","source":{"path":"Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean","start":82,"end":87,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Distributions/Bernoulli.lean#L82-L87"},"deps":[],"outside":[],"external":[["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure.AbsolutelyContinuous","mathlib","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instIsOrderedRing","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set.Elem","mathlib","definition"],["Set.Icc.instOne","mathlib","instance"],["Set.Icc.instZero","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}}]