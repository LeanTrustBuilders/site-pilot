x`, and\napply `π`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"F","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace F"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"𝒴","role":"variable","type":"Set F"},{"explicit":true,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":true,"name":"T","role":"variable","type":"ℕ"},{"explicit":true,"name":"x","role":"variable","type":"ℕ → ↑𝒳"},{"explicit":true,"name":"x'","role":"variable","type":"ℕ → ↑𝒴"},{"explicit":false,"name":"π","role":"variable","type":"↑𝒳 → ↑𝒴"},{"explicit":true,"name":"hπ","role":"hypothesis","type":"Measurable π"}],"conclusion":"IdentAlg Unit ↑𝒴 ℝ ↑𝒴","decl":"Learning.LinearBandit.fixedDesignTransport","value":"IdentAlg.fixedBudget (fixedDesignAlg x') T (transportKernel (A.output.comap (Sigma.mk T) ⋯) x hπ)"},"code":"/-- The transported fixed-design algorithm: play the design `x'` on `𝒴`, then draw a\nrecommendation from the output rule of `A` on the history relabelled with the actions of `x`, and\napply `π`. -/\nnoncomputable def fixedDesignTransport (A : IdentAlg Unit 𝒳 ℝ 𝒳) (T : ℕ) (x : ℕ → 𝒳)\n    (x' : ℕ → 𝒴) {π : 𝒳 → 𝒴} (hπ : Measurable π) : IdentAlg Unit 𝒴 ℝ 𝒴 :=\n  haveI : Nonempty 𝒴 := ⟨x' 0⟩\n  IdentAlg.fixedBudget (fixedDesignAlg x') T\n    (transportKernel (A.output.comap (Sigma.mk T) (measurable_sigma_mk T)) x hπ)","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/FixedDesignTransport.lean","start":56,"end":63,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/FixedDesignTransport.lean#L56-L63"},"deps":[58,86,88],"outside":[],"external":[["Classical.arbitrary","mathlib","definition"],["Eq","lean4","inductive"],["Fin","lean4","structure"],["Fin.cast","lean4","definition"],["Fin.val","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.mk","LeanMachineLearning","constructor"],["Learning.IdentAlg.output","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["Learning.Round.feedback","LeanMachineLearning","definition"],["Learning.detAlgorithm","LeanMachineLearning","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.Measure.dirac","mathlib","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Nonempty","lean4","class"],["Not","lean4","definition"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.IsMarkovKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["ProbabilityTheory.Kernel.comp","mathlib","definition"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.deterministic","mathlib","definition"],["ProbabilityTheory.Kernel.sigma","LeanMachineLearning","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Real","mathlib","structure"],["Real.measurableSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Sigma.instMeasurableSpace","mathlib","instance"],["Sigma.mk","lean4","constructor"],["Subtype.instMeasurableSpace","mathlib","instance"],["Unit","lean4","definition"],["Unit.unit","lean4","definition"],["dite","lean4","definition"],["instDecidableEqNat","lean4","instance"]],"users":[60,61,63,65,66,1215],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":65,"name":"Learning.LinearBandit.isPAC_fixedDesignTransport","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.LeanMachineLearning.FixedDesignTransport","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"8c9d636b06fbb4da","local":"6b794f15e1c1a62a","content":"70d07d162d5e2e69"},"doc":"**Transport of the PAC guarantee** (blueprint `lem:fixed_design_transport`): if `A` is\n`(ε, δ)`-PAC on `𝒳`, the design `x'` on `𝒴` has the same observation laws as `x` through `L`,\nand `π` does not increase the simple regret, then the transported algorithm is `(ε, δ)`-PAC on\n`𝒴`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_3"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"SecondCountableTopology E"},{"explicit":false,"name":"F","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup F"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ F"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace F"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace F"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"𝒴","role":"variable","type":"Set F"},{"explicit":false,"name":"","role":"instance","type":"MeasurableEq ↑𝒴"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":false,"name":"x","role":"variable","type":"ℕ → ↑𝒳"},{"explicit":true,"name":"hdes","role":"hypothesis","type":"A.alg = fixedDesignAlg x"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hpac","role":"hypothesis","type":"IsPAC 𝒳 A ε δ"},{"explicit":true,"name":"L","role":"variable","type":"F →ₗ[ℝ] E"},{"explicit":false,"name":"x'","role":"variable","type":"ℕ → ↑𝒴"},{"explicit":true,"name":"hx'","role":"hypothesis","type":"∀ (t : ℕ) (ϑ : F), inner ℝ (↑(x' t)) ϑ = inner ℝ (↑(x t)) (L ϑ)"},{"explicit":false,"name":"π","role":"variable","type":"↑𝒳 → ↑𝒴"},{"explicit":true,"name":"hπ","role":"hypothesis","type":"Measurable π"},{"explicit":true,"name":"hreg","role":"hypothesis","type":"∀ (ϑ : F) (y : ↑𝒳), simpleRegret 𝒴 ϑ ↑(π y) ≤ simpleRegret 𝒳 (L ϑ) ↑y"}],"conclusion":"IsPAC 𝒴 (fixedDesignTransport A T x x' hπ) ε δ","decl":"Learning.LinearBandit.isPAC_fixedDesignTransport"},"code":"/-- **Transport of the PAC guarantee** (blueprint `lem:fixed_design_transport`): if `A` is\n`(ε, δ)`-PAC on `𝒳`, the design `x'` on `𝒴` has the same observation laws as `x` through `L`,\nand `π` does not increase the simple regret, then the transported algorithm is `(ε, δ)`-PAC on\n`𝒴`. -/\ntheorem isPAC_fixedDesignTransport {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [MeasurableSpace E] [OpensMeasurableSpace E] [SecondCountableTopology E]\n    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [MeasurableSpace F]\n    [OpensMeasurableSpace F] {𝒳 : Set E} {𝒴 : Set F} [MeasurableEq 𝒴]\n    {A : IdentAlg Unit 𝒳 ℝ 𝒳} {T : ℕ} (hA : A.IsFixedBudget T)\n    {x : ℕ → 𝒳} (hdes : A.alg = fixedDesignAlg x) {ε δ : ℝ} (hpac : IsPAC 𝒳 A ε δ)\n    (L : F →ₗ[ℝ] E) {x' : ℕ → 𝒴} (hx' : ∀ t (ϑ : F), ⟪(x' t : F), ϑ⟫ = ⟪(x t : E), L ϑ⟫)\n    {π : 𝒳 → 𝒴} (hπ : Measurable π)\n    (hreg : ∀ (ϑ : F) (y : 𝒳), simpleRegret 𝒴 ϑ (π y) ≤ simpleRegret 𝒳 (L ϑ) y) :\n    IsPAC 𝒴 (fixedDesignTransport A T x x' hπ) ε δ","proof":":= by\n  refine isPAC_of_forall_isRun fun ϑ Ω _ P _ O X Y out hrun ↦ ?_\n  have hlaw := hrun.hasLaw_history_out_of_fixedDesign isFixedBudget_fixedDesignTransport\n    alg_fixedDesignTransport\n  have hG' : MeasurableSet {y : 𝒴 | simpleRegret 𝒴 ϑ y ≤ ε} :=\n    measurableSet_le\n      (continuous_const.sub (continuous_subtype_val.inner continuous_const)).measurable\n      measurable_const\n  have hG : MeasurableSet {y : 𝒳 | simpleRegret 𝒳 (L ϑ) y ≤ ε} :=\n    measurableSet_le\n      (continuous_const.sub (continuous_subtype_val.inner continuous_const)).measurable\n      measurable_const\n  have h1 : P.real {ω | simpleRegret 𝒴 ϑ (out ω) ≤ ε} =\n      (fixedDesignPairLaw (fixedDesignTransport A T x x' hπ) (fun t : Fin T ↦ x' t) ϑ).real\n        (Prod.snd ⁻¹' {y : 𝒴 | simpleRegret 𝒴 ϑ y ≤ ε}) :=\n    hlaw.measureReal_eq (p := fun p ↦ simpleRegret 𝒴 ϑ p.2 ≤ ε) (measurable_snd hG')\n  rw [h1, fixedDesignPairLaw, output_fixedDesignTransport, Measure.real, ← Measure.snd_apply hG',\n    Measure.snd_compProd, transportKernel, ← Measure.comp_assoc,\n    Measure.deterministic_comp_eq_map, ← Kernel.comp_deterministic_eq_comap, ← Measure.comp_assoc,\n    Measure.deterministic_comp_eq_map, fixedDesignHistLaw_map_relabelHist L hx' ϑ,\n    Measure.map_apply hπ hG']\n  have h4 := hpac.le_measureReal_fixedDesignPairLaw hA hdes (L ϑ)\n  change 1 - δ ≤ (fixedDesignPairLaw A (fun t : Fin T ↦ x t) (L ϑ)).real\n    (Prod.snd ⁻¹' {y : 𝒳 | simpleRegret 𝒳 (L ϑ) y ≤ ε}) at h4\n  rw [fixedDesignPairLaw, Measure.real, ← Measure.snd_apply hG, Measure.snd_compProd] at h4\n  refine h4.trans (measureReal_mono ?_)\n  intro y hy\n  exact (hreg ϑ y).trans hy","source":{"path":"Maiti2026Power/LeanMachineLearning/FixedDesignTransport.lean","start":97,"end":137,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8