[{"id":1297,"name":"exp_mul_integral_le_integral_exp","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.Calculus.QuarterCircle","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"3f8965d8de61f6e5","local":"b64376c38a925e28","content":"3f186db2be0460fa"},"doc":"**Jensen's inequality for the uniform measure on `[0, π/2]`**: for a continuous `h`,\n`exp (s ∫₀^{π/2} h) ≤ (2/π) ∫₀^{π/2} exp (π s / 2 · h θ) dθ`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"h","role":"variable","type":"ℝ → ℝ","typeRefs":[[0,1,"Real"],[4,5,"Real"]]},{"explicit":true,"head":"Continuous","implicit":false,"name":"hc","role":"hypothesis","type":"Continuous h","typeRefs":[[0,10,"Continuous"]]},{"explicit":true,"head":"Real","implicit":false,"name":"s","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]}],"conclusion":"Real.exp (s * ∫ (θ : ℝ) in 0..Real.pi / 2, h θ) ≤\n  2 / Real.pi * ∫ (θ : ℝ) in 0..Real.pi / 2, Real.exp (Real.pi * s / 2 * h θ)","conclusionHead":"LE.le","conclusionRefs":[[0,8,"Real.exp"],[12,13,"HMul.hMul"],[14,15,"intervalIntegral"],[21,22,"Real"],[24,26,"intervalIntegral"],[28,30,"intervalIntegral"],[30,37,"Real.pi"],[38,39,"HDiv.hDiv"],[48,49,"LE.le"],[54,55,"HDiv.hDiv"],[56,63,"Real.pi"],[64,65,"HMul.hMul"],[66,67,"intervalIntegral"],[73,74,"Real"],[76,78,"intervalIntegral"],[80,82,"intervalIntegral"],[82,89,"Real.pi"],[90,91,"HDiv.hDiv"],[95,103,"Real.exp"],[105,112,"Real.pi"],[113,114,"HMul.hMul"],[117,118,"HDiv.hDiv"],[121,122,"HMul.hMul"]],"decl":"exp_mul_integral_le_integral_exp"},"code":"/-- **Jensen's inequality for the uniform measure on `[0, π/2]`**: for a continuous `h`,\n`exp (s ∫₀^{π/2} h) ≤ (2/π) ∫₀^{π/2} exp (π s / 2 · h θ) dθ`. -/\nlemma exp_mul_integral_le_integral_exp {h : ℝ → ℝ} (hc : Continuous h) (s : ℝ) :\n    exp (s * ∫ θ in (0 : ℝ)..(π / 2), h θ) ≤\n      2 / π * ∫ θ in (0 : ℝ)..(π / 2), exp (π * s / 2 * h θ)","proof":":= by\n  have hπ : 0 < π / 2 := by positivity\n  set ν : Measure ℝ := volume.restrict (Ioc 0 (π / 2)) with hν\n  have hν_univ : ν.real univ = π / 2 := by\n    rw [hν, measureReal_restrict_apply_univ, measureReal_def, Real.volume_Ioc, sub_zero,\n      ENNReal.toReal_ofReal hπ.le]\n  have : NeZero ν := ⟨fun h0 ↦ by simp [h0] at hν_univ; linarith⟩\n  have hint : ∀ g : ℝ → ℝ, Continuous g → Integrable g ν := fun g hg ↦\n    hg.integrableOn_Icc.mono_set Ioc_subset_Icc_self\n  have hJ := ConvexOn.map_average_le (μ := ν) (f := fun θ ↦ π * s / 2 * h θ) convexOn_exp\n    continuous_exp.continuousOn isClosed_univ (Filter.Eventually.of_forall fun _ ↦ mem_univ _)\n    (hint _ (by fun_prop)) (hint _ (by fun_prop))\n  rw [average_eq, average_eq, hν_univ, smul_eq_mul, smul_eq_mul, integral_const_mul] at hJ\n  rw [intervalIntegral.integral_of_le hπ.le, intervalIntegral.integral_of_le hπ.le]\n  have h1 : (π / 2)⁻¹ * (π * s / 2 * ∫ θ, h θ ∂ν) = s * ∫ θ, h θ ∂ν := by\n    field_simp\n  rw [h1, inv_div] at hJ\n  exact hJ","source":{"path":"Maiti2026Power/Mathlib/Analysis/Calculus/QuarterCircle.lean","start":54,"end":75,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/Calculus/QuarterCircle.lean#L54-L75"},"deps":[],"outside":[],"external":[["Continuous","mathlib","structure"],["DivInvMonoid.toDiv","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["MeasureTheory.MeasureSpace.volume","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.exp","mathlib","definition"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.measureSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.pi","mathlib","definition"],["Real.pseudoMetricSpace","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["intervalIntegral","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Continuous","DivInvMonoid.toDiv","HDiv.hDiv","HMul.hMul","InnerProductSpace.toNormedSpace","LE.le","MeasureTheory.MeasureSpace.volume","Nat","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","NormedAddCommGroup.toSeminormedAddCommGroup","OfNat.ofNat","PseudoMetricSpace.toUniformSpace","RCLike.toInnerProductSpaceReal","Real","Real.exp","Real.instDivInvMonoid","Real.instLE","Real.instMul","Real.instNatCast","Real.instRCLike","Real.instZero","Real.measureSpace","Real.normedAddCommGroup","Real.pi","Real.pseudoMetricSpace","UniformSpace.toTopologicalSpace","Zero.toOfNat0","instHDiv","instHMul","instOfNatAtLeastTwo","instOfNatNat","intervalIntegral"],"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1298,"name":"hasDerivAt_comp_quarterCircle","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.Calculus.QuarterCircle","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"9fc2e1036d7968af","local":"c0702ce1d2f98af4","content":"2e203a8008a2c5a9"},"doc":"The derivative of `θ ↦ f (sin θ • u + cos θ • v)`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"InnerProductSpace","implicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E","typeRefs":[[0,17,"InnerProductSpace"],[18,19,"Real"]]},{"explicit":false,"head":"CompleteSpace","implicit":false,"name":"","role":"instance","type":"CompleteSpace E","typeRefs":[[0,13,"CompleteSpace"]]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"E → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"head":"Differentiable","implicit":false,"name":"hf","role":"hypothesis","type":"Differentiable ℝ f","typeRefs":[[0,14,"Differentiable"],[15,16,"Real"]]},{"explicit":true,"implicit":false,"name":"u","role":"variable","type":"E","typeRefs":[]},{"explicit":true,"implicit":false,"name":"v","role":"variable","type":"E","typeRefs":[]},{"explicit":true,"head":"Real","implicit":false,"name":"θ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]}],"conclusion":"HasDerivAt (fun θ => f (Real.sin θ • u + Real.cos θ • v))\n  (inner ℝ (gradient f (Real.sin θ • u + Real.cos θ • v)) (Real.cos θ • u - Real.sin θ • v)) θ","conclusionHead":"HasDerivAt","conclusionRefs":[[0,10,"HasDerivAt"],[24,32,"Real.sin"],[35,36,"HSMul.hSMul"],[39,40,"HAdd.hAdd"],[41,49,"Real.cos"],[52,53,"HSMul.hSMul"],[61,66,"Inner.inner"],[67,68,"Real"],[70,78,"gradient"],[82,90,"Real.sin"],[93,94,"HSMul.hSMul"],[97,98,"HAdd.hAdd"],[99,107,"Real.cos"],[110,111,"HSMul.hSMul"],[117,125,"Real.cos"],[128,129,"HSMul.hSMul"],[132,133,"HSub.hSub"],[134,142,"Real.sin"],[145,146,"HSMul.hSMul"]],"decl":"hasDerivAt_comp_quarterCircle"},"code":"/-- The derivative of `θ ↦ f (sin θ • u + cos θ • v)`. -/\nlemma hasDerivAt_comp_quarterCircle (hf : Differentiable ℝ f) (u v : E) (θ : ℝ) :\n    HasDerivAt (fun θ ↦ f (sin θ • u + cos θ • v))\n      ⟪gradient f (sin θ • u + cos θ • v), cos θ • u - sin θ • v⟫ θ","proof":":= by\n  have hγ : HasDerivAt (fun θ ↦ sin θ • u + cos θ • v) (cos θ • u + (-sin θ) • v) θ :=\n    ((hasDerivAt_sin θ).smul_const u).add ((hasDerivAt_cos θ).smul_const v)\n  have h := (hasGradientAt_iff_hasFDerivAt.1 (hf _).hasGradientAt).comp_hasDerivAt θ hγ\n  exact h.congr_deriv (by rw [toDual_apply_apply, sub_eq_add_neg, neg_smul])","source":{"path":"Maiti2026Power/Mathlib/Analysis/Calculus/QuarterCircle.lean","start":32,"end":39,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/Calculus/QuarterCircle.lean#L32-L39"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddCommMagma.toAdd","mathlib","instance"],["AddCommMonoid.toAddCommSemigroup","mathlib","instance"],["AddCommSemigroup.toAddCommMagma","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddZero.toZero","mathlib","instance"],["AddZeroClass.toAddZero","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["CompleteSpace","mathlib","class"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["Differentiable","mathlib","definition"],["DistribMulAction.toDistribSMul","mathlib","instance"],["DistribSMul.toSMulZeroClass","mathlib","instance"],["Field.toSemifield","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HSMul.hSMul","lean4","definition"],["HSub.hSub","lean4","definition"],["HasDerivAt","mathlib","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["IsModuleTopology.toContinuousSMul","mathlib","instance"],["IsTopologicalRing.toIsTopologicalSemiring","mathlib