:"Ω → 𝓓"},{"explicit":false,"name":"out'","role":"variable","type":"Ω' → 𝓓"},{"explicit":false,"name":"C","role":"variable","type":"ℝ"},{"explicit":false,"name":"K","role":"variable","type":"ℝ"},{"explicit":true,"name":"hC","role":"hypothesis","type":"∀ x ∈ 𝒳, inner ℝ x (θ - θ') ^ 2 ≤ C"},{"explicit":true,"name":"hK","role":"hypothesis","type":"∑ t ∈ Finset.range T, ∫ (ω : Ω), inner ℝ (↑(X t ω)) (θ - θ') ^ 2 / 2 ∂P ≤ K"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P"},{"explicit":true,"name":"h'","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P'"},{"explicit":false,"name":"B","role":"variable","type":"Set 𝓓"},{"explicit":true,"name":"hB","role":"hypothesis","type":"MeasurableSet B"}],"conclusion":"|P.real (out ⁻¹' B) - P'.real (out' ⁻¹' B)| ≤ √(K / 2)","decl":"Learning.LinearBandit.IsRun.abs_measureReal_sub_le_of_sum_le"},"code":"/-- **Two-point inequality with a data-dependent divergence** (blueprint `lem:two_point_pinsker`):\nif the expected sum of the squared gaps along the trajectory is at most `K`, the probabilities of\nany event of the output differ by at most `√(K / 2)`. -/\nlemma IsRun.abs_measureReal_sub_le_of_sum_le {C K : ℝ} (hC : ∀ x ∈ 𝒳, ⟪x, θ - θ'⟫ ^ 2 ≤ C)\n    (hK : ∑ t ∈ Finset.range T, ∫ ω, ⟪(X t ω : E), θ - θ'⟫ ^ 2 / 2 ∂P ≤ K)\n    (hA : A.IsFixedBudget T) (h : A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P)\n    (h' : A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P') {B : Set 𝓓} (hB : MeasurableSet B) :","proof":"|P.real (out ⁻¹' B) - P'.real (out' ⁻¹' B)| ≤ √(K / 2) := by\n  have hout : AEMeasurable out P := h.hasCondDistrib_output.aemeasurable_snd\n  have hout' : AEMeasurable out' P' := h'.hasCondDistrib_output.aemeasurable_snd\n  have hkl := (IsRun.klDiv_map_out_le_sum_integral hC hA h h').trans\n    (ENNReal.ofReal_le_ofReal hK)\n  have hne : klDiv (P.map out) (P'.map out') ≠ ∞ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hkl\n  have : IsProbabilityMeasure (P.map out) := inferInstance\n  have : IsProbabilityMeasure (P'.map out') := inferInstance\n  have hK0 : 0 ≤ K :=\n    le_trans (Finset.sum_nonneg fun t _ ↦ integral_nonneg fun ω ↦ by positivity) hK\n  rw [← map_measureReal_apply_of_aemeasurable hout hB,\n    ← map_measureReal_apply_of_aemeasurable hout' hB]\n  refine (abs_sub_le_sqrt_klDiv hB hne).trans (Real.sqrt_le_sqrt ?_)\n  have : (klDiv (P.map out) (P'.map out')).toReal ≤ K :=\n    ENNReal.toReal_le_of_le_ofReal hK0 hkl\n  linarith","source":{"path":"Maiti2026Power/LeanMachineLearning/TwoPoint.lean","start":61,"end":83,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/TwoPoint.lean#L61-L83"},"deps":[93,97],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["MeasureTheory.integral","mathlib","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.sqrt","mathlib","definition"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.ofPred","mathlib","definition"],["Set.preimage","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["SubNegMonoid.toSub","mathlib","instance"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"],["abs","mathlib","definition"],["instHDiv","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":354,"name":"Learning.LinearBandit.IsRun.abs_measureReal_sub_le_of_sq_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.TwoPoint","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"9c51cd5644685003","local":"4250b1882b305293","content":"f5c72b2fac0e0dda"},"doc":"**Two-point inequality** (blueprint `lem:two_point_pinsker`): for two runs of a fixed-budget\nidentification algorithm with budget `T` in the linear Gaussian environments with reward vectors\n`θ` and `θ'`, with `⟪x, θ - θ'⟫ ^ 2 ≤ C` on the action set, the probabilities of any event of the\noutput differ by at most `√(T C / 4)`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"θ","role":"variable","type":"E"},{"explicit":false,"name":"θ'","role":"variable","type":"E"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ 𝓓"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_3"},{"explicit":false,"name":"Ω'","role":"type","type":"Type u_4"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"P'","role":"variable","type":"MeasureTheory.Measure Ω'"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P'"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ↑𝒳"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"O'","role":"variable","type":"ℕ → Ω' → Unit"},{"explicit":false,"name":"X'","role":"variable","type":"ℕ → Ω' → ↑𝒳"},{"explicit":false,"name":"Y'","role":"variable","type":"ℕ → Ω' → ℝ"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"out'","role":"variable","type":"Ω' → 𝓓"},{"explicit":false,"name":"C","role":"variable","type":"ℝ"},{"explicit":true,"name":"hC","role":"hypothesis","type":"∀ x ∈ 𝒳, inner ℝ x (θ - θ') ^ 2 ≤ C"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P"},{"explicit":true,"name":"h'","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P'"},{"explicit":false,"name":"B","role":"variable","type":"Set 𝓓"},{"explicit":true,"name":"hB","role":"hypothesis","type":"MeasurableSet B"}],"conclusion":"|P.real (out ⁻¹' B) - P'.real (out' ⁻¹' B)| ≤ √(↑T * C / 4)","decl":"Learning.LinearBandit.IsRun.abs_measureReal_sub_le_of_sq_le"},"code":"/-- **Two-point inequality** (blueprint `lem:two_point_pinsker`): for two runs of a fixed-budget\nidentification algorithm with budget `T` in the linear Gaussian environments with reward vectors\n`θ` and `θ'`, with `⟪x, θ - θ'⟫ ^ 2 ≤ C` on the action set, the probabilities of any event of the\noutput differ by at most `√(T C / 4)`. -/\nlemma IsRun.abs_measureReal_sub_le_of_sq_le {C : ℝ} (hC : ∀ x ∈ 𝒳, ⟪x, θ - θ'⟫ ^ 2 ≤ C)\n    (hA : A.IsFixedBudget T) (h : A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P)\n    (h' : A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P') {B : Set 𝓓} (hB : MeasurableSet B) :","proof":"|P.real (out ⁻¹' B) - P'.real (out' ⁻¹' B)| ≤ √(T * C / 4) := by\n  have hout : AEMeasurable out P := h.hasCondDistrib_output.aemeasurable_snd\n  have hout' : AEMeasurable out' P' := h'.hasCondDistrib_output.aemeasurable_snd\n  have hkl := IsRun.klDiv_map_out_le_of_sq_le hC hA h h'\n  have hne : klDiv (P.map out) (P'.map out') ≠ ∞ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hkl\n  have : IsProbabilityMeasure (P.map out) := inferInstance\n  have : IsProbabilityMeasure (P'.map out') := inferInstance\n  have hC0 : 0 ≤ C := by\n    obtain ⟨ω⟩ := Measure.nonempty_of_neZero P\n    exact (sq_nonneg _).trans (hC _ (X 0 ω).2)\n  rw [← map_measureReal_apply_of_aemeasurable hout hB,\n    ← map_measureReal_apply_of_aemeasurable hout' hB]\n  refine (abs_sub_le_sqrt_klDiv hB hne).trans (Real.sqrt_le_sqrt ?_)\n  have : (klDiv (P.map out) (P'.map out')).toReal ≤ T * (C / 2) :=\n    ENNReal.toReal_le_of_le_ofReal (by positivity) hkl\n  linarith","source":{"path":"Maiti2026Power/LeanMachineLearning/TwoPoint.lean","start":85,"end":107,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/TwoPoint.lean#L85-L107"},"deps":[93,97],"outside":[],"external":[["AddCommGro