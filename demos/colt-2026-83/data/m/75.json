ype":"DecidableEq ι"},{"explicit":true,"name":"A","role":"variable","type":"Matrix ι ι ℝ"}],"conclusion":"gwMat (unitBall ι) A = ∫ (x : EuclideanSpace ℝ ι), ‖x‖ ∂ProbabilityTheory.multivariateGaussian 0 A⁻¹","decl":"Maiti2026Power.gwMat_unitBall"},"code":"/-- The width of the unit ball for `A` is `E‖Y‖` with `Y ~ N(0, A⁻¹)`. -/\nlemma gwMat_unitBall (A : Matrix ι ι ℝ) :\n    gwMat (unitBall ι) A = ∫ x, ‖x‖ ∂multivariateGaussian 0 A⁻¹","proof":":= by\n  simp only [gwMat, gaussianWidth, supportFn_unitBall]","source":{"path":"Maiti2026Power/MXJ2026/WidthBall.lean","start":34,"end":37,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBall.lean#L34-L37"},"deps":[1223,1254],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DecidableEq","lean4","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fintype","mathlib","class"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["Inv.inv","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.inv","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.integral","mathlib","definition"],["Membership.mem","lean4","definition"],["Metric.closedBall","mathlib","definition"],["NegZeroClass.toZero","mathlib","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.instNorm","mathlib","instance"],["PiLp.instPseudoMetricSpace","mathlib","instance"],["PiLp.normedAddCommGroup","mathlib","instance"],["ProbabilityTheory.multivariateGaussian","mathlib","definition"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.norm","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["Subtype.val","lean4","definition"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.measurableSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["iSup","mathlib","definition"],["instOfNatAtLeastTwo","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1263,"name":"Maiti2026Power.le_gwMat_unitBall","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.WidthBall","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"bde8ab4409bd6dea","local":"352a87a5e3aad457","content":"011292c79144894d"},"doc":"**Width of the unit ball for a matrix**: `gwMat (unitBall) A ≥ √(2/π) d / √(tr A)` for\n`A` positive definite. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":false,"name":"A","role":"variable","type":"Matrix ι ι ℝ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.PosDef"}],"conclusion":"√(2 / Real.pi) * ↑(Fintype.card ι) / √A.trace ≤ gwMat (unitBall ι) A","decl":"Maiti2026Power.le_gwMat_unitBall"},"code":"/-- **Width of the unit ball for a matrix**: `gwMat (unitBall) A ≥ √(2/π) d / √(tr A)` for\n`A` positive definite. -/\nlemma le_gwMat_unitBall (hA : A.PosDef) :\n    √(2 / π) * Fintype.card ι / √A.trace ≤ gwMat (unitBall ι) A","proof":":= by\n  rcases isEmpty_or_nonempty ι with hι | hι\n  · simp [gwMat_of_isEmpty]\n  have htr : 0 < A.trace := hA.trace_pos\n  rw [gwMat_unitBall]\n  set c : ι → ℝ := fun i ↦ √(A i i) / √A.trace with hc\n  have hc0 : ∀ i, 0 ≤ c i := fun i ↦ by positivity\n  have hcsum : ∑ i, c i ^ 2 ≤ 1 := by\n    have : ∑ i, c i ^ 2 = 1 := by\n      simp only [hc, div_pow, Real.sq_sqrt hA.posSemidef.diag_nonneg, Real.sq_sqrt htr.le,\n        ← Finset.sum_div]\n      exact div_self htr.ne'\n    exact this.le\n  refine le_trans ?_\n    (sum_mul_sqrt_diag_le_integral_norm_multivariateGaussian hA.inv.posSemidef hc0 hcsum)\n  rw [mul_div_assoc]\n  gcongr\n  calc (Fintype.card ι : ℝ) / √A.trace = ∑ _i : ι, 1 / √A.trace := by\n        simp [Finset.sum_const, div_eq_mul_inv]\n    _ ≤ ∑ i, c i * √(A⁻¹ i i) := Finset.sum_le_sum fun i _ ↦ by\n        rw [hc, div_mul_eq_mul_div]\n        gcongr\n        exact one_le_sqrt_diag_mul_sqrt_diag_inv hA i","source":{"path":"Maiti2026Power/MXJ2026/WidthBall.lean","start":61,"end":86,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBall.lean#L61-L86"},"deps":[1223,1254],"outside":[],"external":[["AddCommGroup.toDivisionAdd