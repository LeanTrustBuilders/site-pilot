[{"id":1259,"name":"Maiti2026Power.le_gw_unitBall","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.WidthBall","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"0c4e7758a777d505","local":"6a19f401ca50e8c0","content":"8754719d87e28409"},"doc":"**Width of the unit ball** (blueprint `prop:width_ball`, lower bound):\n`gw (unitBall) ≥ √(2/π) d`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"}],"conclusion":"√(2 / Real.pi) * ↑(Fintype.card ι) ≤ gw (unitBall ι)","decl":"Maiti2026Power.le_gw_unitBall"},"code":"/-- **Width of the unit ball** (blueprint `prop:width_ball`, lower bound):\n`gw (unitBall) ≥ √(2/π) d`. -/\nlemma le_gw_unitBall : √(2 / π) * Fintype.card ι ≤ gw (unitBall ι)","proof":":= by\n  rcases isEmpty_or_nonempty ι with hι | hι\n  · simp [gw_of_isEmpty]\n  refine le_gw (exists_posDef_mem_designSet span_unitBall) fun A hA hA' ↦ ?_\n  have htr : A.trace ≤ 1 := by\n    simpa using trace_le_of_mem_designSet (R := 1) (fun x hx ↦ norm_le_one_of_mem_unitBall hx) hA\n  have htr0 : 0 < A.trace := hA'.trace_pos\n  refine le_trans ?_ (le_gwMat_unitBall hA')\n  rw [le_div_iff₀ (Real.sqrt_pos.2 htr0)]\n  have hs : √A.trace ≤ 1 := Real.sqrt_le_one.2 htr\n  calc √(2 / π) * Fintype.card ι = √(2 / π) * Fintype.card ι * 1 := (mul_one _).symm\n    _ ≥ √(2 / π) * Fintype.card ι * √A.trace := by gcongr","source":{"path":"Maiti2026Power/MXJ2026/WidthBall.lean","start":88,"end":101,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBall.lean#L88-L101"},"deps":[1223,1249],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["ChainCom