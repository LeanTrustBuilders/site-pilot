ddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.pi","mathlib","definition"],["Real.pseudoMetricSpace","mathlib","instance"],["Real.sqrt","mathlib","definition"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["Subtype.val","lean4","definition"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.measurableSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["iSup","mathlib","definition"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1264,"name":"Maiti2026Power.one_le_sqrt_diag_mul_sqrt_diag_inv","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.WidthBall","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"c124172ee3aac340","local":"bc52e03c9aab82ce","content":"f764bb96d76ada12"},"doc":"`√(Aᵢᵢ) √((A⁻¹)ᵢᵢ) ≥ 1` for a positive definite matrix `A`: Cauchy–Schwarz for\n`⟪A^{1/2} eᵢ, A^{-1/2} eᵢ⟫ = 1`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":false,"name":"A","role":"variable","type":"Matrix ι ι ℝ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.PosDef"},{"explicit":true,"name":"i","role":"variable","type":"ι"}],"conclusion":"1 ≤ √(A i i) * √(A⁻¹ i i)","decl":"Maiti2026Power.one_le_sqrt_diag_mul_sqrt_diag_inv"},"code":"/-- `√(Aᵢᵢ) √((A⁻¹)ᵢᵢ) ≥ 1` for a positive definite matrix `A`: Cauchy–Schwarz for\n`⟪A^{1/2} eᵢ, A^{-1/2} eᵢ⟫ = 1`. -/\nlemma one_le_sqrt_diag_mul_sqrt_diag_inv (hA : A.PosDef) (i : ι) :\n    1 ≤ √(A i i) * √(A⁻¹ i i)","proof":":= by\n  set e : EuclideanSpace ℝ ι := EuclideanSpace.single i 1 with he\n  have h := inner_toEuclideanCLM_sqrt_sqrt_inv hA e e\n  have h1 := norm_toEuclideanCLM_sqrt_sq hA.posSemidef e\n  have h2 := norm_toEuclideanCLM_sqrt_inv_sq hA e\n  have hee : ⟪e, e⟫ = 1 := by simp [he]\n  have hq1 : WithLp.ofLp e ⬝ᵥ A *ᵥ WithLp.ofLp e = A i i := by\n    simp [he]\n  have hq2 : WithLp.ofLp e ⬝ᵥ A⁻¹ *ᵥ WithLp.ofLp e = A⁻¹ i i := by\n    simp [he]\n  rw [hq1] at h1\n  rw [hq2] at h2\n  calc (1 : ℝ) = ⟪toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt A) e,\n        toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt A⁻¹) e⟫ := by rw [h, hee]\n    _ ≤ ‖toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt A) e‖ *\n        ‖toEuclideanCLM (𝕜 := ℝ) (CFC.sqrt A⁻¹) e‖ := real_inner_le_norm _ _\n    _ = √(A i i) * √(A⁻¹ i i) := by\n        rw [← Real.sqrt_sq (norm_nonneg _), h1, ← Real.sqrt_sq (norm_nonneg _), h2]","source":{"path":"Maiti2026Power/MXJ2026/WidthBall.lean","start":39,"end":59,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBall.lean#L39-L59"},"deps":[],"outside":[],"external":[["DecidableEq","lean4","definition"],["Fintype","mathlib","class"],["HMul.hMul","lean4","definition"],["Inv.inv","lean4","definition"],["LE.le","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.PosDef","mathlib","definition"],["Matrix.inv","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.sqrt","mathlib","definition"],["instHMul","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}}]