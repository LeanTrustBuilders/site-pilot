[{"id":81,"name":"Learning.IsAlgEnvSeq.map_history_succ","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.HistoryLaw","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"6e0cd7182806badc","local":"8ca23c45ab49bccb","content":"a94adb2eead605d0"},"doc":"The law of the first `n + 1` rounds is the composition-product of the law of the first `n`\nrounds with the step kernel. ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → 𝓞"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"alg","role":"variable","type":"Algorithm 𝓞 𝓐 𝓨"},{"explicit":false,"name":"env","role":"variable","type":"Environment 𝓞 𝓐 𝓨"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":true,"name":"h","role":"hypothesis","type":"IsAlgEnvSeq O X Y alg env P"},{"explicit":true,"name":"n","role":"variable","type":"ℕ"}],"conclusion":"MeasureTheory.Measure.map (history O X Y (n + 1)) P =\n  MeasureTheory.Measure.map (⇑(MeasurableEquiv.finSuccProd (Round 𝓞 𝓐 𝓨) n).symm)\n    ((MeasureTheory.Measure.map (history O X Y n) P).compProd (stepKernel alg env n))","decl":"Learning.IsAlgEnvSeq.map_history_succ"},"code":"/-- The law of the first `n + 1` rounds is the composition-product of the law of the first `n`\nrounds with the step kernel. -/\nlemma IsAlgEnvSeq.map_history_succ {P : Measure Ω} [IsFiniteMeasure P]\n    (h : IsAlgEnvSeq O X Y alg env P) (n : ℕ) :\n    P.map (history O X Y (n + 1)) =\n      (P.map (history O X Y n) ⊗ₘ stepKernel alg env n).map\n        (MeasurableEquiv.finSuccProd (Round 𝓞 𝓐 𝓨) n).symm","proof":":=\n  map_history_succ_of_hasCondDistrib h.measurable_obs h.measurable_action h.measurable_feedback\n    (h.hasCondDistrib_step n)","source":{"path":"Maiti2026Power/LeanMachineLearning/HistoryLaw.lean","start":46,"end":54,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/HistoryLaw.lean#L46-L54"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["EquivLike.toFunLike","mathlib","instance"],["Fin","lean4","structure"],["HAdd.hAdd","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IsAlgEnvSeq","LeanMachineLearning","structure"],["Learning.Round","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["Learning.stepKernel","LeanMachineLearning","definition"],["MeasurableEquiv","mathlib","structure"],["MeasurableEquiv.finSuccProd","LeanMachineLearning","definition"],["MeasurableEquiv.instEquivLike","mathlib","instance"],["MeasurableEquiv.symm","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":82,"name":"Learning.map_history_succ_of_hasCondDistrib","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.HistoryLaw","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"5176b86e0bb1ff89","local":"35d575c4691af926","content":"53e55840ac26b48e"},"doc":"If the step at round `n` has conditional law `stepKernel alg env n` given the first `n`\nrounds under a measure `Q`, then the law of the first `n + 1` rounds under `Q` is the\ncomposition-product of the law of the first `n` rounds with the step kernel. ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → 𝓞"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"alg","role":"variable","type":"Algorithm 𝓞 𝓐 𝓨"},{"explicit":false,"name":"env","role":"variable","type":"Environment 𝓞 𝓐 𝓨"},{"explicit":false,"name":"Q","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"n","role":"variable","type":"ℕ"},{"explicit":true,"name":"hO","role":"hypothesis","type":"∀ (n : ℕ), Measurable (O n)"},{"explicit":true,"name":"hX","role":"hypothesis","type":"∀ (n : ℕ), Measurable (X n)"},{"explicit":true,"name":"hY","role":"hypothesis","type":"∀ (n : ℕ), Measurable (Y n)"},{"explicit":true,"name":"h","role":"hypothesis","type":"ProbabilityTheory.HasCondDistrib (step O X Y n) (history O X Y n) (stepKernel alg env n) Q"}],"conclusion":"MeasureTheory.Measure.map (history O X Y (n + 1)) Q =\n  MeasureTheory.Measure.map (⇑(MeasurableEquiv.finSuccProd (Round 𝓞 𝓐 𝓨) n).symm)\n    ((MeasureTheory.Measure.map (history O X Y n) Q).compProd (stepKernel alg env n))","decl":"Learning.map_history_succ_of_hasCondDistrib"},"code":"/-- If the step at round `n` has conditional law `stepKernel alg env n` given the first `n`\nrounds under a measure `Q`, then the law of the first `n + 1` rounds under `Q` is the\ncomposition-product of the law of the first `n` rounds with the step kernel. -/\nlemma map_history_succ_of_hasCondDistrib {Q : Measure Ω} {n : ℕ}\n    (hO : ∀ n, Measurable (O n)) (hX : ∀ n, Measurable (X n)) (hY : ∀ n, Measurable (Y n))\n    (h : HasCondDistrib (step O X Y n) (history O X Y n) (stepKernel alg env n) Q) :\n    Q.map (history O X Y (n + 1)) =\n      (Q.map (history O X Y n) ⊗ₘ stepKernel alg env n).map\n        (MeasurableEquiv.finSuccProd (Round 𝓞 𝓐 𝓨) n).symm","proof":":= by\n  rw [history_succ, ← h.map_eq,\n    Measure.map_map (MeasurableEquiv.finSuccProd (Round 𝓞 𝓐 𝓨) n).symm.measurable\n      (by fun_prop)]","source":{"path":"Maiti2026Power/LeanMachineLearning/HistoryLaw.lean","start":33,"end":44,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/HistoryLaw.lean#L33-L44"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["EquivLike.toFunLike","mathlib","instance"],["Fin","lean4","structure"],["HAdd.hAdd","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["Learning.step","LeanMachineLearning","definition"],["Learning.stepKernel","LeanMachineLearning","definition"],["Measurable","mathlib","definition"],["MeasurableEquiv","mathlib","structure"],["MeasurableEquiv.finSuccProd","LeanMachineLearning","definition"],["MeasurableEquiv.instEquivLike","mathlib","instance"],["MeasurableEquiv.symm","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}}]