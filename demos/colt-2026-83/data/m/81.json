[{"id":1285,"name":"barrier_sum_ineq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.BarrierSum","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"8ef0b35eb5834878","local":"56a85ec62446a570","content":"0b978d86428646b7"},"doc":"The averaged barrier inequality: for `a i ≥ 1` with `∑ 1/a i ≤ 1`, writing `b i = a i - 1/2`,\n`P = ∑ 1/b i ^ 2`, `Δ = ∑ (1/b i - 1/a i)`, one has `P / Δ - ∑ 1/b i ≥ 2 - ∑ 1/a i`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty ι","typeRefs":[[0,8,"Nonempty"]]},{"explicit":true,"implicit":false,"name":"a","role":"variable","type":"ι → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"ha","role":"hypothesis","type":"∀ (i : ι), 1 ≤ a i","typeRefs":[[13,14,"LE.le"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hΦ","role":"hypothesis","type":"∑ i, (a i)⁻¹ ≤ 1","typeRefs":[[10,12,"Inv.inv"],[13,14,"LE.le"]]}],"conclusion":"2 - ∑ i, (a i)⁻¹ ≤\n  (∑ i, (a i - 1 / 2)⁻¹ ^ 2) / ∑ i, ((a i - 1 / 2)⁻¹ - (a i)⁻¹) - ∑ i, (a i - 1 / 2)⁻¹","conclusionHead":"LE.le","conclusionRefs":[[2,3,"HSub.hSub"],[14,16,"Inv.inv"],[17,18,"LE.le"],[32,33,"HSub.hSub"],[40,42,"Inv.inv"],[43,44,"HPow.hPow"],[48,49,"HDiv.hDiv"],[61,62,"HSub.hSub"],[69,71,"Inv.inv"],[72,73,"HSub.hSub"],[79,81,"Inv.inv"],[83,84,"HSub.hSub"],[95,96,"HSub.hSub"],[103,105,"Inv.inv"]],"decl":"barrier_sum_ineq"},"code":"/-- The averaged barrier inequality: for `a i ≥ 1` with `∑ 1/a i ≤ 1`, writing `b i = a i - 1/2`,\n`P = ∑ 1/b i ^ 2`, `Δ = ∑ (1/b i - 1/a i)`, one has `P / Δ - ∑ 1/b i ≥ 2 - ∑ 1/a i`. -/\nlemma barrier_sum_ineq {ι : Type*} [Fintype ι] [Nonempty ι] (a : ι → ℝ) (ha : ∀ i, 1 ≤ a i)\n    (hΦ : ∑ i, (a i)⁻¹ ≤ 1) :\n    2 - ∑ i, (a i)⁻¹ ≤\n      (∑ i, ((a i - 1 / 2)⁻¹) ^ 2) / (∑ i, ((a i - 1 / 2)⁻¹ - (a i)⁻¹)) - ∑ i, (a i - 1 / 2)⁻¹","proof":":= by\n  set b : ι → ℝ := fun i ↦ a i - 1 / 2 with hb\n  have ha_pos : ∀ i, 0 < a i := fun i ↦ by linarith [ha i]\n  have hb_pos : ∀ i, 0 < b i := fun i ↦ by simp only [hb]; linarith [ha i]\n  -- pointwise identities\n  have h1 : ∀ i, (b i)⁻¹ - (a i)⁻¹ = (a i * b i)⁻¹ / 2 := fun i ↦ by\n    have hab : a i - b i = 1 / 2 := by simp only [hb]; ring\n    rw [inv_sub_inv (hb_pos i).ne' (ha_pos i).ne', hab]\n    ring\n  have h2 : ∀ i, (b i)⁻¹ ^ 2 - (a i * b i)⁻¹ = (a i * b i ^ 2)⁻¹ / 2 := fun i ↦ by\n    have ha' : a i ≠ 0 := (ha_pos i).ne'\n    have hb' : a i - 1 / 2 ≠ 0 := (hb_pos i).ne'\n    simp only [hb]\n    field_simp\n    ring\n  -- the auxiliary sums\n  set Q := ∑ i, (a i * b i)⁻¹ with hQ\n  set R := ∑ i, (a i * b i ^ 2)⁻¹ with hR\n  have hQ_pos : 0 < Q :=\n    sum_pos (fun i _ ↦ by have := ha_pos i; have := hb_pos i; positivity) univ_nonempty\n  have hR_pos : 0 < R :=\n    sum_pos (fun i _ ↦ by have := ha_pos i; have := hb_pos i; positivity) univ_nonempty\n  have hΔ : ∑ i, ((b i)⁻¹ - (a i)⁻¹) = Q / 2 := by\n    rw [hQ, eq_div_iff two_ne_zero, sum_mul]\n    exact sum_congr rfl fun i _ ↦ by rw [h1 i, div_mul_cancel₀ _ two_ne_zero]\n  have hPQ : ∑ i, (b i)⁻¹ ^ 2 - Q = R / 2 := by\n    rw [hQ, hR, ← sum_sub_distrib, eq_div_iff two_ne_zero, sum_mul]\n    exact sum_congr rfl fun i _ ↦ by rw [h2 i, div_mul_cancel₀ _ two_ne_zero]\n  have hΦ' : ∑ i, (b i)⁻¹ = ∑ i, (a i)⁻¹ + Q / 2 := by\n    rw [← hΔ, ← sum_add_distrib]\n    simp\n  -- Cauchy–Schwarz: `Q ^ 2 ≤ R * ∑ 1 / a i ≤ R`\n  have hCS : Q ^ 2 ≤ R * ∑ i, (a i)⁻¹ := by\n    refine sum_sq_le_sum_mul_sum_of_sq_le_mul _ (fun i _ ↦ ?_) (fun i _ ↦ ?_) (fun i _ ↦ ?_)\n    · have := ha_pos i; have := hb_pos i; positivity\n    · have := (ha_pos i).le; positivity\n    · have := ha_pos i\n      have := hb_pos i\n      refine le_of_eq ?_\n      field_simp\n  have hQ2 : Q ^ 2 ≤ R := hCS.trans (mul_le_of_le_one_right hR_pos.le hΦ)\n  -- conclusion\n  rw [hΔ, hΦ', le_sub_iff_add_le, le_div_iff₀ (by positivity)]\n  nlinarith [hPQ, hQ2, hQ_pos]","source":{"path":"Maiti2026Power/Mathlib/Analysis/BarrierSum.lean","start":38,"end":86,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/BarrierSum.lean#L38-L86"},"deps":[],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HDiv.hDiv","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inv.inv","lean4","definition"],["LE.le","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Nonempty","lean4","class"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instInv","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["instHDiv","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DivInvMonoid.toDiv","Finset.sum","Finset.univ","Fintype","HDiv.hDiv","HPow.hPow","HSub.hSub","Inv.inv","LE.le","Monoid.toNPow","NPow.toPow","Nat","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Nonempty","OfNat.ofNat","One.toOfNat1","Real","Real.instAddCommMonoid","Real.instDivInvMonoid","Real.instInv","Real.instLE","Real.instMonoid","Real.instNatCast","Real.instOne","Real.instSub","instHDiv","instHPow","instHSub","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1286,"name":"sum_inv_sub_half_sub_inv_pos","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.BarrierSum","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"6850f83d67c21d69","local":"a6c5ca867394ecd3","content":"b09c5299fd9b6113"},"doc":"With `b i = a i - 1/2`: `∑ (1/b i - 1/a i) > 0`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty ι","typeRefs":[[0,8,"Nonempty"]]},{"explicit":true,"implicit":false,"name":"a","role":"variable","type":"ι → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"ha","role":"hypothesis","type":"∀ (i : ι), 1 ≤ a i","typeRefs":[[13,14,"LE.le"]]}],"conclusion":"0 < ∑ i, ((a i - 1 / 2)⁻¹ - (a i)⁻¹)","conclusionHead":"LT.lt","conclusionRefs":[[2,3,"LT.lt"],[15,16,"HSub.hSub"],[23,25,"Inv.inv"],[26,27,"HSub.hSub"],[33,35,"Inv.inv"]],"decl":"sum_inv_sub_half_sub_inv_pos"},"code":"/-- With `b i = a i - 1/2`: `∑ (1/b i - 1/a i) > 0`. -/\nlemma sum_inv_sub_half_sub_inv_pos {ι : Type*} [Fintype ι] [Nonempty ι] (a : ι → ℝ)\n    (ha : ∀ i, 1 ≤ a i) :\n    0 < ∑ i, ((a i - 1 / 2)⁻¹ - (a i)⁻¹)","proof":":= by\n  refine sum_pos (fun i _ ↦ sub_pos.2 (inv_strictAnti₀ ?_ ?_)) univ_nonempty\n  · linarith [ha i]\n  · linarith","source":{"path":"Maiti2026Power/Mathlib/Analysis/BarrierSum.lean","start":30,"end":36,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8