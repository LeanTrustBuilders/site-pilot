[{"id":1513,"name":"ProbabilityTheory.map_snd_compProd_comap","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"bee22486beff559e","local":"9ec8c7599e9acd9d","content":"8e4d47318e314738"},"doc":"The law of the second coordinate is unchanged by that transport. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"γ","role":"type","type":"Type u_3"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"mγ","role":"instance","type":"MeasurableSpace γ"},{"explicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure α"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite μ"},{"explicit":true,"name":"η","role":"variable","type":"Kernel β γ"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel η"},{"explicit":false,"name":"f","role":"variable","type":"α → β"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"},{"explicit":true,"name":"hη","role":"instance","type":"∀ (a : α), MeasureTheory.IsProbabilityMeasure (η (f a))"}],"conclusion":"MeasureTheory.Measure.map Prod.snd (μ.compProd (η.comap f hf)) =\n  MeasureTheory.Measure.map Prod.snd ((MeasureTheory.Measure.map f μ).compProd η)","decl":"ProbabilityTheory.map_snd_compProd_comap"},"code":"/-- The law of the second coordinate is unchanged by that transport. -/\nlemma map_snd_compProd_comap (μ : Measure α) [SFinite μ] (η : Kernel β γ) [IsSFiniteKernel η]\n    {f : α → β} (hf : Measurable f) (hη : ∀ a, IsProbabilityMeasure (η (f a))) :\n    (μ ⊗ₘ η.comap f hf).map Prod.snd = (μ.map f ⊗ₘ η).map Prod.snd","proof":":= by\n  rw [← map_prodMk_compProd_comap μ η hf hη, Measure.map_map measurable_snd (by fun_prop)]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":158,"end":163,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L158-L163"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1514,"name":"MeasureTheory.Measure.map_compProd_of_forall_map_eq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"c88b6ccfe396d5ad","local":"e913c82b13ea48c0","content":"893804490cd134fc"},"doc":"The image of `μ ⊗ₘ κ` by `(a, b) ↦ (G a, F a b)` is `μ.map G ⊗ₘ K` as soon as `K (G a)` is\nthe image of `κ a` by `F a` for every `a`. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"γ","role":"type","type":"Type u_3"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"mγ","role":"instance","type":"MeasurableSpace γ"},{"explicit":false,"name":"δ","role":"type","type":"Type u_4"},{"explicit":false,"name":"mδ","role":"instance","type":"MeasurableSpace δ"},{"explicit":true,"name":"μ","role":"variable","type":"Measure α"},{"explicit":false,"name":"","role":"instance","type":"SFinite μ"},{"explicit":true,"name":"κ","role":"variable","type":"ProbabilityTheory.Kernel α β"},{"explicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsSFiniteKernel κ"},{"explicit":false,"name":"G","role":"variable","type":"α → γ"},{"explicit":true,"name":"hG","role":"hypothesis","type":"Measurable G"},{"explicit":false,"name":"F","role":"variable","type":"α → β → δ"},{"explicit":true,"name":"hF","role":"hypothesis","type":"Measurable (Function.uncurry F)"},{"explicit":true,"name":"K","role":"variable","type":"ProbabilityTheory.Kernel γ δ"},{"explicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsSFiniteKernel K"},{"explicit":true,"name":"hK","role":"hypothesis","type":"∀ (a : α), K (G a) = map (F a) (κ a)"}],"conclusion":"map (fun p => (G p.1, F p.1 p.2)) (μ.compProd κ) = (map G μ).compProd K","decl":"MeasureTheory.Measure.map_compProd_of_forall_map_eq"},"code":"/-- The image of `μ ⊗ₘ κ` by `(a, b) ↦ (G a, F a b)` is `μ.map G ⊗ₘ K` as soon as `K (G a)` is\nthe image of `κ a` by `F a` for every `a`. -/\nlemma _root_.MeasureTheory.Measure.map_compProd_of_forall_map_eq {δ : Type*}\n    {mδ : MeasurableSpace δ} (μ : Measure α) [SFinite μ] (κ : Kernel α β) [IsSFiniteKernel κ]\n    {G : α → γ} (hG : Measurable G)\n    {F : α → β → δ} (hF : Measurable (Function.uncurry F)) (K : Kernel γ δ) [IsSFiniteKernel K]\n    (hK : ∀ a, K (G a) = (κ a).map (F a)) :\n    (μ ⊗ₘ κ).map (fun p ↦ (G p.1, F p.1 p.2)) = μ.map G ⊗ₘ K","proof":":= by\n  have hφ : Measurable fun p : α × β ↦ (G p.1, F p.1 p.2) := (hG.comp measurable_fst).prodMk hF\n  ext s hs\n  rw [Measure.map_apply hφ hs, Measure.compProd_apply (hφ hs), Measure.compProd_apply hs,\n    lintegral_map (Kernel.measurable_kernel_prodMk_left hs) hG]\n  refine lintegral_congr fun a ↦ ?_\n  have hFa : Measurable (F a) := hF.comp measurable_prodMk_left\n  rw [hK a, Measure.map_apply hFa (measurable_prodMk_left hs)]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":127,"end":142,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L127-L142"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1515,"name":"MeasureTheory.Measure.restrict_compProd_prod_univ","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"2810d2318d74c6dc","local":"e3e5e275d7e64ea9","content":"078fbf24a6f64cb9"},"doc":"The restriction of `μ ⊗ₘ κ` to `s ×ˢ univ` is `μ.restrict s ⊗ₘ κ`. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":true,"name":"μ","role":"variable","type":"Measure α"},{"explicit":false,"name":"","role":"instance","type":"SFinite μ"},{"explicit":true,"name":"κ","role":"variable","type":"ProbabilityTheory.Kernel α β"},{"explicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsSFiniteKernel κ"},{"explicit":false,"name":"s","role":"variable","type":"Set α"},{"explicit":true,"name":"hs","role":"hypothesis","type":"MeasurableSet s"}],"conclusion":"(μ.compProd κ).restrict (s ×ˢ Set.univ) = (μ.restrict s).compProd κ","decl":"MeasureTheory.Measure.restrict_compProd_prod_univ"},"code":"/-- The restriction of `μ ⊗ₘ κ` to `s ×ˢ univ` is `μ.restrict s ⊗ₘ κ`. -/\nlemma _root_.MeasureTheory.Measure.restrict_compProd_prod_univ (μ : Measure α) [SFinite μ]\n    (κ : Kernel α β) [IsSFiniteKernel κ] {s : Set α} (hs : MeasurableSet s) :\n    (μ ⊗ₘ κ).restrict (s ×ˢ Set.univ) = μ.restrict s ⊗ₘ κ","proof":":= by\n  ext t ht\n  rw [Measure.restrict_apply ht, Measure.compProd_apply (ht.inter (hs.prod MeasurableSet.univ)),\n    Measure.compProd_apply ht, ← lintegral_indicator hs]\n  refine lintegral_congr fun a ↦ ?_\n  by_cases ha : a ∈ s\n  · have : Prod.mk a ⁻¹' (t ∩ s ×ˢ Set.univ) = Prod.mk a ⁻¹' t := by ext b; simp [ha]\n    simp [Set.indicator, ha, this]\n  · have : Prod.mk a ⁻¹' (t ∩ s ×ˢ Set.univ) = ∅ := by ext b; simp [ha]\n    simp [Set.indicator, ha, this]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":144,"end":156,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L144-L156"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.restrict","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["SProd.sprod","mathlib","definition"],["Set","mathlib","definition"],["Set.instSProd","mathlib","instance"],["Set.univ","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1516,"name":"ProbabilityTheory.HasCondDistrib.measureReal_le_mul","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"77d2b727f3531e70","local":"55c9b2ed772ee094","content":"0ec29974d37c0331"},"doc":"If the conditional law of `W` given `Z` is `κ` and, for every `z` in the measurable set `G`,\nthe section of the measurable set `G'` at `z` has `κ z`-probability at most `δ`, then\n`P(Z ∈ G, (Z, W) ∈ G') ≤ δ P(Z ∈ G)`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"m𝓩","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"W","role":"variable","type":"Ω → β"},{"explicit":false,"name":"Z","role":"variable","type":"Ω → 𝓩"},{"explicit":false,"name":"κ","role":"variable","type":"Kernel 𝓩 β"},{"explicit":false,"name":"G","role":"variable","type":"Set 𝓩"},{"explicit":false,"name":"G'","role":"variable","type":"Set (𝓩 × β)"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":false,"name":"","role":"instance","type":"IsFiniteKernel κ"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib W Z κ P"},{"explicit":true,"name":"hG","role":"hypothesis","type":"MeasurableSet G"},{"explicit":true,"name":"hG'","role":"hypothesis","type":"MeasurableSet G'"},{"explicit":true,"name":"hδ0","role":"hypothesis","type":"0 ≤ δ"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"∀ z ∈ G, (κ z).real (Prod.mk z ⁻¹' G') ≤ δ"}],"conclusion":"P.real (Z ⁻¹' G ∩ (fun ω => (Z ω, W ω)) ⁻¹' G') ≤ δ * P.real (Z ⁻¹' G)","decl":"ProbabilityTheory.HasCondDistrib.measureReal_le_mul"},"code":"/-- If the conditional law of `W` given `Z` is `κ` and, for every `z` in the measurable set `G`,\nthe section of the measurable set `G'` at `z` has `κ z`-probability at most `δ`, then\n`P(Z ∈ G, (Z, W) ∈ G') ≤ δ P(Z ∈ G)`. -/\nlemma HasCondDistrib.measureReal_le_mul [IsFiniteKernel κ] (h : HasCondDistrib W Z κ P)\n    (hG : MeasurableSet G) (hG' : MeasurableSet G') (hδ0 : 0 ≤ δ)\n    (hδ : ∀ z ∈ G, (κ z).real (Prod.mk z ⁻¹' G') ≤ δ) :\n    P.real (Z ⁻¹' G ∩ (fun ω ↦ (Z ω, W ω)) ⁻¹' G') ≤ δ * P.real (Z ⁻¹' G)","proof":":= by\n  have hS : MeasurableSet ((G ×ˢ Set.univ) ∩ G') := (hG.prod MeasurableSet.univ).inter hG'\n  have h1 : Z ⁻¹' G ∩ (fun ω ↦ (Z ω, W ω)) ⁻¹' G' =\n      (fun ω ↦ (Z ω, W ω)) ⁻¹' ((G ×ˢ Set.univ) ∩ G') := by\n    ext ω\n    simp\n  have h2 : ∀ z, κ z (Prod.mk z ⁻¹' ((G ×ˢ Set.univ) ∩ G')) =\n      G.indicator (fun z ↦ κ z (Prod.mk z ⁻¹' G')) z := fun z ↦ by\n    by_cases hz : z ∈ G\n    · rw [Set.indicator_of_mem hz]\n      congr 1\n      ext w\n      simp [hz]\n    · rw [Set.indicator_of_notMem hz]\n      convert measure_empty (μ := κ z)\n      ext w\n      simp [hz]\n  rw [h1, measureReal_def, measureReal_def,\n    ← Measure.map_apply_of_aemeasurable h.aemeasurable_fst hG,\n    ← Measure.map_apply_of_aemeasurable h.aemeasurable hS, h.map_eq, Measure.compProd_apply hS]\n  simp_rw [h2]\n  rw [lintegral_indicator hG, ← ENNReal.toReal_ofReal hδ0, ← ENNReal.toReal_mul]\n  refine ENNReal.toReal_mono (ENNReal.mul_ne_top ENNReal.ofReal_ne_top (measure_ne_top _ _)) ?_\n  rw [← setLIntegral_const]\n  refine setLIntegral_mono' hG fun z hz ↦ ?_\n  rw [← ENNReal.ofReal_toReal (measure_ne_top (κ z) _)]\n  exact ENNReal.ofReal_le_ofReal (hδ z hz)","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":219,"end":251,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L219-L251"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["HMul.hMul","lean4","definition"],["Inter.inter","lean4","definition"],["LE.le","lean4","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["Membership.mem","lean4","definition"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.IsFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instZero","mathlib","instance"],["Set","mathlib","definition"],["Set.instInter","mathlib","instance"],["Set.instMembership","mathlib","instance"],["Set.preimage","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHMul","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1517,"name":"ProbabilityTheory.HasCondDistrib.restrict_preimage","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"812116d2df1ff91e","local":"5d941a17303483ab","content":"46d1e1476db7bef2"},"doc":"A conditional law given `X` is a conditional law given `X` under the restriction of `P` to an\nevent determined by `X`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"α","role":"type","type":"Type u_2"},{"explicit":false,"name":"β","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite P"},{"explicit":false,"name":"X","role":"variable","type":"Ω → α"},{"explicit":false,"name":"Y","role":"variable","type":"Ω → β"},{"explicit":false,"name":"κ","role":"variable","type":"Kernel α β"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel κ"},{"explicit":true,"name":"hX","role":"hypothesis","type":"Measurable X"},{"explicit":true,"name":"hY","role":"hypothesis","type":"Measurable Y"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib Y X κ P"},{"explicit":false,"name":"s","role":"variable","type":"Set α"},{"explicit":true,"name":"hs","role":"hypothesis","type":"MeasurableSet s"}],"conclusion":"HasCondDistrib Y X κ (P.restrict (X ⁻¹' s))","decl":"ProbabilityTheory.HasCondDistrib.restrict_preimage"},"code":"/-- A conditional law given `X` is a conditional law given `X` under the restriction of `P` to an\nevent determined by `X`. -/\nlemma HasCondDistrib.restrict_preimage (hX : Measurable X) (hY : Measurable Y)\n    (h : HasCondDistrib Y X κ P) {s : Set α} (hs : MeasurableSet s) :\n    HasCondDistrib Y X κ (P.restrict (X ⁻¹' s))","proof":":= by\n  refine ⟨(hX.prodMk hY).aemeasurable, ?_⟩\n  have h1 : (fun ω ↦ (X ω, Y ω)) ⁻¹' (s ×ˢ Set.univ) = X ⁻¹' s := by ext ω; simp\n  calc (P.restrict (X ⁻¹' s)).map (fun ω ↦ (X ω, Y ω))\n      = (P.map (fun ω ↦ (X ω, Y ω))).restrict (s ×ˢ Set.univ) := by\n        rw [Measure.restrict_map (hX.prodMk hY) (hs.prod MeasurableSet.univ), h1]\n    _ = (P.map X ⊗ₘ κ).restrict (s ×ˢ Set.univ) := by rw [h.map_eq]\n    _ = (P.map X).restrict s ⊗ₘ κ := Measure.restrict_compProd_prod_univ _ _ hs\n    _ = (P.restrict (X ⁻¹' s)).map X ⊗ₘ κ := by rw [Measure.restrict_map hX hs]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":197,"end":209,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L197-L209"},"deps":[],"outside":[],"external":[["Measurable","mathlib","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.restrict","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["Set","mathlib","definition"],["Set.preimage","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1518,"name":"ProbabilityTheory.map_prodMk_compProd_comap","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"14b5c19f4d08a1b8","local":"535320ee60798d9b","content":"0b6a24ab7236a5a1"},"doc":"Transporting `μ ⊗ₘ η.comap f` along `f` in the first coordinate gives `μ.map f ⊗ₘ η`. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"γ","role":"type","type":"Type u_3"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"mγ","role":"instance","type":"MeasurableSpace γ"},{"explicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure α"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite μ"},{"explicit":true,"name":"η","role":"variable","type":"Kernel β γ"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel η"},{"explicit":false,"name":"f","role":"variable","type":"α → β"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"},{"explicit":true,"name":"hη","role":"instance","type":"∀ (a : α), MeasureTheory.IsProbabilityMeasure (η (f a))"}],"conclusion":"MeasureTheory.Measure.map (fun p => (f p.1, p.2)) (μ.compProd (η.comap f hf)) =\n  (MeasureTheory.Measure.map f μ).compProd η","decl":"ProbabilityTheory.map_prodMk_compProd_comap"},"code":"/-- Transporting `μ ⊗ₘ η.comap f` along `f` in the first coordinate gives `μ.map f ⊗ₘ η`. -/\nlemma map_prodMk_compProd_comap (μ : Measure α) [SFinite μ] (η : Kernel β γ) [IsSFiniteKernel η]\n    {f : α → β} (hf : Measurable f) (hη : ∀ a, IsProbabilityMeasure (η (f a))) :\n    (μ ⊗ₘ η.comap f hf).map (fun p : α × γ ↦ (f p.1, p.2)) = μ.map f ⊗ₘ η","proof":":= by\n  have hκ : IsMarkovKernel (η.comap f hf) := ⟨fun a ↦ by rw [Kernel.comap_apply]; exact hη a⟩\n  have h := (hasCondDistrib_snd_compProd_comap μ η hf hη).map_eq\n  have hfst : (μ ⊗ₘ η.comap f hf).map (fun p : α × γ ↦ f p.1) = μ.map f := by\n    calc (μ ⊗ₘ η.comap f hf).map (fun p : α × γ ↦ f p.1)\n        = ((μ ⊗ₘ η.comap f hf).map Prod.fst).map f := (Measure.map_map hf measurable_fst).symm\n      _ = μ.map f := by\n        rw [show (μ ⊗ₘ η.comap f hf).map Prod.fst = (μ ⊗ₘ η.comap f hf).fst from rfl,\n          Measure.fst_compProd]\n  rwa [hfst] at h","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":113,"end":125,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L113-L125"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1519,"name":"ProbabilityTheory.hasCondDistrib_snd_compProd_comap","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"57c0f1067cf2a382","local":"ebca26fba36f6dfb","content":"53d5e12a4cd3ce6a"},"doc":"Under `μ ⊗ₘ η.comap f`, the second coordinate has conditional law `η` given `f` of the\nfirst coordinate, when `η` is a probability measure at every point of the range of `f`. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"γ","role":"type","type":"Type u_3"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"mγ","role":"instance","type":"MeasurableSpace γ"},{"explicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure α"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite μ"},{"explicit":true,"name":"η","role":"variable","type":"Kernel β γ"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel η"},{"explicit":false,"name":"f","role":"variable","type":"α → β"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"},{"explicit":true,"name":"hη","role":"instance","type":"∀ (a : α), MeasureTheory.IsProbabilityMeasure (η (f a))"}],"conclusion":"HasCondDistrib Prod.snd (fun p => f p.1) η (μ.compProd (η.comap f hf))","decl":"ProbabilityTheory.hasCondDistrib_snd_compProd_comap"},"code":"/-- Under `μ ⊗ₘ η.comap f`, the second coordinate has conditional law `η` given `f` of the\nfirst coordinate, when `η` is a probability measure at every point of the range of `f`. -/\nlemma hasCondDistrib_snd_compProd_comap (μ : Measure α) [SFinite μ]\n    (η : Kernel β γ) [IsSFiniteKernel η] {f : α → β} (hf : Measurable f)\n    (hη : ∀ a, IsProbabilityMeasure (η (f a))) :\n    HasCondDistrib Prod.snd (fun p : α × γ ↦ f p.1) η (μ ⊗ₘ η.comap f hf)","proof":":= by\n  have hκ : IsMarkovKernel (η.comap f hf) := ⟨fun a ↦ by rw [Kernel.comap_apply]; exact hη a⟩\n  have hfst : (μ ⊗ₘ η.comap f hf).map (fun p : α × γ ↦ f p.1) = μ.map f := by\n    calc (μ ⊗ₘ η.comap f hf).map (fun p : α × γ ↦ f p.1)\n        = ((μ ⊗ₘ η.comap f hf).map Prod.fst).map f := (Measure.map_map hf measurable_fst).symm\n      _ = μ.map f := by\n        rw [show (μ ⊗ₘ η.comap f hf).map Prod.fst = (μ ⊗ₘ η.comap f hf).fst from rfl,\n          Measure.fst_compProd]\n  refine ⟨by fun_prop, ?_⟩\n  rw [hfst]\n  ext s hs\n  rw [Measure.map_apply (by fun_prop) hs, Measure.compProd_apply (hs.preimage (by fun_prop)),\n    Measure.compProd_apply hs, lintegral_map (Kernel.measurable_kernel_prodMk_left hs) hf]\n  refine lintegral_congr fun a ↦ ?_\n  rw [Kernel.comap_apply]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":91,"end":111,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L91-L111"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1520,"name":"ProbabilityTheory.HasCondDistrib.prodMk_const_left","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"432ef828896d4b1c","local":"61384215846cf5b8","content":"b63c46b743fb4a0a"},"doc":"A conditional law given `X` is a conditional law given `(c, X)` for any constant `c`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"α","role":"type","type":"Type u_2"},{"explicit":false,"name":"β","role":"type","type":"Type u_3"},{"explicit":false,"name":"γ","role":"type","type":"Type u_4"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"mγ","role":"instance","type":"MeasurableSpace γ"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite P"},{"explicit":false,"name":"X","role":"variable","type":"Ω → α"},{"explicit":false,"name":"Y","role":"variable","type":"Ω → β"},{"explicit":false,"name":"κ","role":"variable","type":"Kernel α β"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel κ"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib Y X κ P"},{"explicit":true,"name":"c","role":"variable","type":"γ"}],"conclusion":"HasCondDistrib Y (fun ω => (c, X ω)) (Kernel.prodMkLeft γ κ) P","decl":"ProbabilityTheory.HasCondDistrib.prodMk_const_left"},"code":"/-- A conditional law given `X` is a conditional law given `(c, X)` for any constant `c`. -/\nlemma HasCondDistrib.prodMk_const_left (h : HasCondDistrib Y X κ P) (c : γ) :\n    HasCondDistrib Y (fun ω ↦ (c, X ω)) (κ.prodMkLeft γ) P","proof":":=\n  h.map_of_forall_map_eq (G := fun a ↦ (c, a)) (by fun_prop) (F := fun _ b ↦ b) measurable_snd _\n    fun a ↦ by simp [Kernel.prodMkLeft_apply]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":191,"end":195,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L191-L195"},"deps":[],"outside":[],"external":[["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.prodMkLeft","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1521,"name":"ProbabilityTheory.HasCondDistrib.comp_hasLaw","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"a168ccc59e052e49","local":"4688b8c1053caf67","content":"cb0064b47d29d5f8"},"doc":"A conditional distribution is transported along a map `g` carrying `P` to `P'`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"Ω'","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓧","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'"},{"explicit":false,"name":"m𝓧","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"m𝓩","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"P'","role":"variable","type":"MeasureTheory.Measure Ω'"},{"explicit":false,"name":"g","role":"variable","type":"Ω → Ω'"},{"explicit":false,"name":"X","role":"variable","type":"Ω' → 𝓧"},{"explicit":false,"name":"Z","role":"variable","type":"Ω' → 𝓩"},{"explicit":false,"name":"κ","role":"variable","type":"Kernel 𝓧 𝓩"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib Z X κ P'"},{"explicit":true,"name":"hg","role":"hypothesis","type":"HasLaw g P' P"}],"conclusion":"HasCondDistrib (Z ∘ g) (X ∘ g) κ P","decl":"ProbabilityTheory.HasCondDistrib.comp_hasLaw"},"code":"/-- A conditional distribution is transported along a map `g` carrying `P` to `P'`. -/\nlemma HasCondDistrib.comp_hasLaw {X : Ω' → 𝓧} {Z : Ω' → 𝓩}\n    {κ : Kernel 𝓧 𝓩} (h : HasCondDistrib Z X κ P') (hg : HasLaw g P' P) :\n    HasCondDistrib (Z ∘ g) (X ∘ g) κ P","proof":":= by\n  have h' : HasLaw ((fun ω ↦ (X ω, Z ω)) ∘ g) (P'.map X ⊗ₘ κ) P := HasLaw.comp h hg\n  have hX : P'.map X = P.map (X ∘ g) := by\n    rw [← hg.map_eq, AEMeasurable.map_map_of_aemeasurable (hg.map_eq ▸ h.aemeasurable_fst)\n      hg.aemeasurable]\n  rw [hX] at h'\n  exact h'","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":58,"end":67,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L58-L67"},"deps":[],"outside":[],"external":[["Function.comp","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.HasLaw","mathlib","structure"],["ProbabilityTheory.Kernel","mathlib","structure"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1522,"name":"ProbabilityTheory.Kernel.const_comap_eq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"e8acb3f5cbb4276a","local":"18a7cf61b1141050","content":"3a2e23ea46463698"},"doc":"","statement":{"binders":[{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓧","role":"type","type":"Type u_4"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_5"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"m𝓧","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"m𝓩","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":true,"name":"ν","role":"variable","type":"MeasureTheory.Measure β"},{"explicit":false,"name":"f","role":"variable","type":"𝓧 → 𝓩"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"}],"conclusion":"(const 𝓩 ν).comap f hf = const 𝓧 ν","decl":"ProbabilityTheory.Kernel.const_comap_eq"},"code":"lemma Kernel.const_comap_eq (ν : Measure β) {f : 𝓧 → 𝓩} (hf : Measurable f) :\n    (Kernel.const 𝓩 ν).comap f hf = Kernel.const 𝓧 ν","proof":":= by\n  ext a s _\n  simp [Kernel.comap_apply]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":45,"end":48,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L45-L48"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["ProbabilityTheory.Kernel.const","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1523,"name":"ProbabilityTheory.HasCondDistrib.measureReal_sub_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"e15821e9e01c4623","local":"8e5ddbf27abe0ca5","content":"585da73b1f71456a"},"doc":"If the conditional law of `W` given `Z` is `κ` and, for every `z` in the measurable set `G`,\nthe section of the measurable set `G'` at `z` has `κ z`-probability at least `1 - δ`, then\n`P((Z, W) ∈ G') ≥ P(Z ∈ G) - δ`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"m𝓩","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"W","role":"variable","type":"Ω → β"},{"explicit":false,"name":"Z","role":"variable","type":"Ω → 𝓩"},{"explicit":false,"name":"κ","role":"variable","type":"Kernel 𝓩 β"},{"explicit":false,"name":"G","role":"variable","type":"Set 𝓩"},{"explicit":false,"name":"G'","role":"variable","type":"Set (𝓩 × β)"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"","role":"instance","type":"IsMarkovKernel κ"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib W Z κ P"},{"explicit":true,"name":"hG","role":"hypothesis","type":"MeasurableSet G"},{"explicit":true,"name":"hG'","role":"hypothesis","type":"MeasurableSet G'"},{"explicit":true,"name":"hδ0","role":"hypothesis","type":"0 ≤ δ"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"∀ z ∈ G, 1 - δ ≤ (κ z).real (Prod.mk z ⁻¹' G')"}],"conclusion":"P.real (Z ⁻¹' G) - δ ≤ P.real ((fun ω => (Z ω, W ω)) ⁻¹' G')","decl":"ProbabilityTheory.HasCondDistrib.measureReal_sub_le"},"code":"/-- If the conditional law of `W` given `Z` is `κ` and, for every `z` in the measurable set `G`,\nthe section of the measurable set `G'` at `z` has `κ z`-probability at least `1 - δ`, then\n`P((Z, W) ∈ G') ≥ P(Z ∈ G) - δ`. -/\nlemma HasCondDistrib.measureReal_sub_le [IsProbabilityMeasure P] [IsMarkovKernel κ]\n    (h : HasCondDistrib W Z κ P) (hG : MeasurableSet G) (hG' : MeasurableSet G') (hδ0 : 0 ≤ δ)\n    (hδ : ∀ z ∈ G, 1 - δ ≤ (κ z).real (Prod.mk z ⁻¹' G')) :\n    P.real (Z ⁻¹' G) - δ ≤ P.real ((fun ω ↦ (Z ω, W ω)) ⁻¹' G')","proof":":= by\n  have h1 := h.measureReal_le_mul hG hG'.compl hδ0 fun z hz ↦ by\n    rw [Set.preimage_compl, measureReal_compl (measurable_prodMk_left hG'), probReal_univ]\n    linarith [hδ z hz]\n  have h2 : P.real (Z ⁻¹' G) ≤ P.real (Z ⁻¹' G ∩ (fun ω ↦ (Z ω, W ω)) ⁻¹' G') +\n      P.real (Z ⁻¹' G ∩ (fun ω ↦ (Z ω, W ω)) ⁻¹' G'ᶜ) := by\n    refine (measureReal_mono ?_).trans (measureReal_union_le _ _)\n    intro ω hω\n    by_cases hω' : (Z ω, W ω) ∈ G' <;> simp [hω]\n  have h3 : P.real (Z ⁻¹' G ∩ (fun ω ↦ (Z ω, W ω)) ⁻¹' G') ≤\n      P.real ((fun ω ↦ (Z ω, W ω)) ⁻¹' G') := measureReal_mono Set.inter_subset_right\n  have h4 : δ * P.real (Z ⁻¹' G) ≤ δ := by\n    calc δ * P.real (Z ⁻¹' G) ≤ δ * 1 := by gcongr; exact measureReal_le_one\n      _ = δ := mul_one δ\n  linarith","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":253,"end":273,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L253-L273"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["HSub.hSub","lean4","definition"],["LE.le","lean4","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["Membership.mem","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.IsMarkovKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Set","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.preimage","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1524,"name":"ProbabilityTheory.HasCondDistrib.const_comp_right","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"b9a120fd6e678742","local":"0c10b44d6722deaf","content":"372a60c5c3ac8b4a"},"doc":"A constant conditional law given `Z` is a constant conditional law given any measurable\nfunction of `Z`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓧","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"m𝓧","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"m𝓩","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"ν","role":"variable","type":"MeasureTheory.Measure β"},{"explicit":false,"name":"Y","role":"variable","type":"Ω → β"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite P"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite ν"},{"explicit":false,"name":"Z","role":"variable","type":"Ω → 𝓩"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib Y Z (Kernel.const 𝓩 ν) P"},{"explicit":false,"name":"f","role":"variable","type":"𝓩 → 𝓧"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"}],"conclusion":"HasCondDistrib Y (f ∘ Z) (Kernel.const 𝓧 ν) P","decl":"ProbabilityTheory.HasCondDistrib.const_comp_right"},"code":"/-- A constant conditional law given `Z` is a constant conditional law given any measurable\nfunction of `Z`. -/\nlemma HasCondDistrib.const_comp_right [SFinite P] [SFinite ν] {Z : Ω → 𝓩}\n    (h : HasCondDistrib Y Z (Kernel.const 𝓩 ν) P)\n    {f : 𝓩 → 𝓧} (hf : Measurable f) : HasCondDistrib Y (f ∘ Z) (Kernel.const 𝓧 ν) P","proof":":= by\n  refine HasCondDistrib.comp_right (hf := hf) ?_\n  rwa [Kernel.const_comap_eq]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":76,"end":82,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L76-L82"},"deps":[],"outside":[],"external":[["Function.comp","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.Kernel.const","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}},{"id":1525,"name":"ProbabilityTheory.HasCondDistrib.map_of_forall_map_eq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistrib","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"5f30f21b748f6a10","local":"512a4462d1715699","content":"57905969842fbb17"},"doc":"If `Y` has conditional law `κ` given `X`, then `F X Y` has conditional law `K` given `G X`\nas soon as `K (G a)` is the image of `κ a` by `F a` for every `a`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"α","role":"type","type":"Type u_2"},{"explicit":false,"name":"β","role":"type","type":"Type u_3"},{"explicit":false,"name":"γ","role":"type","type":"Type u_4"},{"explicit":false,"name":"δ","role":"type","type":"Type u_5"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"mγ","role":"instance","type":"MeasurableSpace γ"},{"explicit":false,"name":"mδ","role":"instance","type":"MeasurableSpace δ"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite P"},{"explicit":false,"name":"X","role":"variable","type":"Ω → α"},{"explicit":false,"name":"Y","role":"variable","type":"Ω → β"},{"explicit":false,"name":"κ","role":"variable","type":"Kernel α β"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel κ"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib Y X κ P"},{"explicit":false,"name":"G","role":"variable","type":"α → γ"},{"explicit":true,"name":"hG","role":"hypothesis","type":"Measurable G"},{"explicit":false,"name":"F","role":"variable","type":"α → β → δ"},{"explicit":true,"name":"hF","role":"hypothesis","type":"Measurable (Function.uncurry F)"},{"explicit":true,"name":"K","role":"variable","type":"Kernel γ δ"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel K"},{"explicit":true,"name":"hK","role":"hypothesis","type":"∀ (a : α), K (G a) = MeasureTheory.Measure.map (F a) (κ a)"}],"conclusion":"HasCondDistrib (fun ω => F (X ω) (Y ω)) (G ∘ X) K P","decl":"ProbabilityTheory.HasCondDistrib.map_of_forall_map_eq"},"code":"/-- If `Y` has conditional law `κ` given `X`, then `F X Y` has conditional law `K` given `G X`\nas soon as `K (G a)` is the image of `κ a` by `F a` for every `a`. -/\nlemma HasCondDistrib.map_of_forall_map_eq (h : HasCondDistrib Y X κ P) {G : α → γ}\n    (hG : Measurable G) {F : α → β → δ} (hF : Measurable (Function.uncurry F)) (K : Kernel γ δ)\n    [IsSFiniteKernel K] (hK : ∀ a, K (G a) = (κ a).map (F a)) :\n    HasCondDistrib (fun ω ↦ F (X ω) (Y ω)) (G ∘ X) K P","proof":":= by\n  refine ⟨(hG.comp_aemeasurable h.aemeasurable_fst).prodMk (hF.comp_aemeasurable h.aemeasurable),\n    ?_⟩\n  have hφ : Measurable fun p : α × β ↦ (G p.1, F p.1 p.2) := (hG.comp measurable_fst).prodMk hF\n  calc P.map (fun ω ↦ ((G ∘ X) ω, F (X ω) (Y ω)))\n      = (P.map (fun ω ↦ (X ω, Y ω))).map (fun p ↦ (G p.1, F p.1 p.2)) := by\n        rw [AEMeasurable.map_map_of_aemeasurable hφ.aemeasurable h.aemeasurable]\n        rfl\n    _ = (P.map X ⊗ₘ κ).map (fun p ↦ (G p.1, F p.1 p.2)) := by rw [h.map_eq]\n    _ = (P.map X).map G ⊗ₘ K := Measure.map_compProd_of_forall_map_eq _ _ hG hF K hK\n    _ = P.map (G ∘ X) ⊗ₘ K := by\n        rw [AEMeasurable.map_map_of_aemeasurable hG.aemeasurable h.aemeasurable_fst]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistrib.lean","start":173,"end":189,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistrib.lean#L173-L189"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["Function.comp","lean4","definition"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"844ec1de62aa3a7f3b165fd3d5f733064321509b","date":"2026-09-10"}}]