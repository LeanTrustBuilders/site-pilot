nvalues) (g := fun i ↦ (hA.1.eigenvalues i)⁻¹)\n    (fun i _ ↦ (hA.eigenvalues_pos i).le) (fun i _ ↦ (inv_pos.2 (hA.eigenvalues_pos i)).le)\n    fun i _ ↦ by simp [(hA.eigenvalues_pos i).ne']","source":{"path":"Maiti2026Power/Mathlib/Matrix/TraceInv.lean","start":33,"end":40,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Matrix/TraceInv.lean#L33-L40"},"deps":[],"outside":[],"external":[["DecidableEq","lean4","definition"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["Inv.inv","lean4","definition"],["LE.le","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.PosDef","mathlib","definition"],["Matrix.inv","mathlib","instance"],["Matrix.trace","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}}]