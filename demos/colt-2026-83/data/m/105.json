[{"id":1493,"name":"Matrix.PosDef.trace_inv_eq_sum_inv_eigenvalues","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Matrix.TraceInv","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"d9a57f7678ffd07d","local":"8769b4ecf40e6a53","content":"b9e9beaa149cff4e"},"doc":"The trace of the inverse of a positive definite real matrix is the sum of the inverses of its\neigenvalues. ","statement":{"binders":[{"explicit":false,"name":"n","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype n"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq n"},{"explicit":false,"name":"A","role":"variable","type":"Matrix n n ℝ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.PosDef"}],"conclusion":"A⁻¹.trace = ∑ i, (⋯.eigenvalues i)⁻¹","decl":"Matrix.PosDef.trace_inv_eq_sum_inv_eigenvalues"},"code":"/-- The trace of the inverse of a positive definite real matrix is the sum of the inverses of its\neigenvalues. -/\nlemma PosDef.trace_inv_eq_sum_inv_eigenvalues (hA : A.PosDef) :\n    A⁻¹.trace = ∑ i, (hA.1.eigenvalues i)⁻¹","proof":":= by\n  simpa using hA.1.trace_inv_sub_smul_one fun x hx ↦ (hA.pos_of_mem_spectrum hx).ne'","source":{"path":"Maiti2026Power/Mathlib/Matrix/TraceInv.lean","start":27,"end":31,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Matrix/TraceInv.lean#L27-L31"},"deps":[],"outside":[],"external":[["AddCommMonoid.toAddMonoid","mathlib","instance"],["And.left","lean4","theorem"],["DecidableEq","lean4","definition"],["Distrib.toMul","mathlib","instance"],["Eq","lean4","inductive"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Finsupp","mathlib","structure"],["Finsupp.instZero","mathlib","instance"],["Finsupp.sum","mathlib","definition"],["Fintype","mathlib","class"],["HMul.hMul","lean4","definition"],["Inv.inv","lean4","definition"],["InvolutiveStar.toStar","mathlib","instance"],["LT.lt","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.IsHermitian","mathlib","definition"],["Matrix.IsHermitian.eigenvalues","mathlib","definition"],["Matrix.PosDef","mathlib","definition"],["Matrix.inv","mathlib","instance"],["Matrix.trace","mathlib","definition"],["MulZeroClass.toZero","mathlib","instance"],["Ne","lean4","definition"],["NonAssocRing.toNonUnitalNonAssocRing","mathlib","instance"],["NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring","mathlib","instance"],["NonUnitalNonAssocSemiring.toAddCommMonoid","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLT","mathlib","instance"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instInv","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Ring.toNonAssocRing","mathlib","instance"],["Ring.toSemiring","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["Star.star","mathlib","definition"],["StarAddMonoid.toInvolutiveStar","mathlib","instance"],["StarRing.toStarAddMonoid","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instDistribOfSemiring","mathlib","instance"],["instHMul","lean4","instance"],["instMulZeroClassOfSemiring","mathlib","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1494,"name":"Matrix.PosDef.card_sq_div_trace_le_trace_inv","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Matrix.TraceInv","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"3c9b57d705f01f24","local":"53416f076cd94a0f","content":"f48f234484994a95"},"doc":"`tr A⁻¹ ≥ (card n)² / tr A` for a positive definite real matrix (with `0 / 0 = 0` when `n`\nis empty). ","statement":{"binders":[{"explicit":false,"name":"n","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype n"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq n"},{"explicit":false,"name":"A","role":"variable","type":"Matrix n n ℝ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.PosDef"}],"conclusion":"↑(Fintype.card n) ^ 2 / A.trace ≤ A⁻¹.trace","decl":"Matrix.PosDef.card_sq_div_trace_le_trace_inv"},"code":"/-- `tr A⁻¹ ≥ (card n)² / tr A` for a positive definite real matrix (with `0 / 0 = 0` when `n`\nis empty). -/\nlemma PosDef.card_sq_div_trace_le_trace_inv (hA : A.PosDef) :\n    (Fintype.card n : ℝ) ^ 2 / A.trace ≤ A⁻¹.trace","proof":":= by\n  rw [hA.trace_inv_eq_sum_inv_eigenvalues, hA.1.trace_eq_sum_eigenvalues]\n  simpa using Finset.sq_sum_div_le_sum_sq_div Finset.univ (fun _ ↦ (1 : ℝ))\n    fun i _ ↦ hA.eigenvalues_pos i","source":{"path":"Maiti2026Power/Mathlib/Matrix/TraceInv.lean","start":42,"end":48,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Matrix/TraceInv.lean#L42-L48"},"deps":[],"outside":[],"external":[["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HPow.hPow","lean4","definition"],["Inv.inv","lean4","definition"],["LE.le","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.PosDef","mathlib","definition"],["Matrix.inv","mathlib","instance"],["Matrix.trace","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["