[{"id":38,"name":"Learning.IdentAlg.IsRun.hasLaw_history_out_of_fixedDesign","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.FixedDesignLaw","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"487fa2f7832064f7","local":"c594963194af7e11","content":"1aa3c1d5e4c0f214"},"doc":"**Law of a fixed-design run** (blueprint `lem:fixed_design_law`, `def:bayes_prior`): the\npair (history of the `T` rounds, output) of a run of the fixed-budget algorithm `A` (budget `T`)\nwith the fixed design `x` in the linear Gaussian environment with reward vector `θ` has law\n`fixedDesignPairLaw A x θ`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"θ","role":"variable","type":"E"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableEq ↑𝒳"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_2"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ↑𝒳"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"out","role":"variable","type":"Ω → ↑𝒳"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":false,"name":"x","role":"variable","type":"ℕ → ↑𝒳"},{