eanMachineLearning.FixedDesignLaw","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"bec37a9bac8bf78a","local":"088da92280a514fb","content":"d8d31c729701577e"},"doc":"**The PAC property of a fixed-design algorithm, on its explicit law**: for every reward\nvector `θ`, the recommendation has simple regret at most `ε` with probability at least `1 - δ`\nunder `fixedDesignPairLaw A x θ`. ","statement":{"binders":[{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"E","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"SecondCountableTopology E"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":false,"name":"x","role":"variable","type":"ℕ → ↑𝒳"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hpac","role":"hypothesis","type":"IsPAC 𝒳 A ε δ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"hdes","role":"hypothesis","type":"A.alg = fixedDesignAlg x"},{"explicit":true,"name":"θ","role":"variable","type":"E"}],"conclusion":"1 - δ ≤ (fixedDesignPairLaw A (fun t => x ↑t) θ).real {p | simpleRegret 𝒳 θ ↑p.2 ≤ ε}","decl":"Learning.LinearBandit.IsPAC.le_measureReal_fixedDesignPairLaw"},"code":"/-- **The PAC property of a fixed-design algorithm, on its explicit law**: for every reward\nvector `θ`, the recommendation has simple regret at most `ε` with probability at least `1 - δ`\nunder `fixedDesignPairLaw A x θ`. -/\nlemma _root_.Learning.LinearBandit.IsPAC.le_measureReal_fixedDesignPairLaw\n    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [MeasurableSpace E]\n    [OpensMeasurableSpace E] [SecondCountableTopology E] {𝒳 : Set E} {A : IdentAlg Unit 𝒳 ℝ 𝒳}\n    {x : ℕ → 𝒳} {ε δ : ℝ} (hpac : IsPAC 𝒳 A ε δ) (hA : A.IsFixedBudget T)\n    (hdes : A.alg = fixedDesignAlg x) (θ : E) :\n    1 - δ ≤ (fixedDesignPairLaw A (fun t : Fin T ↦ x t) θ).real\n      {p | simpleRegret 𝒳 θ p.2 ≤ ε}","proof":":= by\n  have hrun := A.isRun_runMeasure (linearGaussianEnv 𝒳 θ)\n  have hlaw := hrun.hasLaw_history_out_of_fixedDesign hA hdes\n  have hpac' := hpac.le_measureReal_of_isRun hrun\n  have hmeas : MeasurableSet {p : Hist Unit 𝒳 ℝ T × 𝒳 | simpleRegret 𝒳 θ p.2 ≤ ε} := by\n    refine measurableSet_le ?_ measurable_const\n    exact (continuous_const.sub ((continuous_subtype_val.comp continuous_snd).inner\n      continuous_const)).measurable\n  rw [← hlaw.map_eq, Measure.real, Measure.map_apply_of_aemeasurable hlaw.aemeasurable hmeas]\n  exact hpac'","source":{"path":"Maiti2026Power/LeanMachineLearning/FixedDesignLaw.lean","start":125,"end":143,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/FixedDesignLaw.lean#L125-L143"},"deps":[42,86,93,95,101],"outside":[],"external":[["Eq","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learnin