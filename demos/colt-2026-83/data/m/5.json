"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"θ","role":"variable","type":"E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableEq ↑𝒳"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_2"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ↑𝒳"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"x","role":"variable","type":"ℕ → ↑𝒳"},{"explicit":true,"name":"h","role":"hypothesis","type":"IsAlgEnvSeq O X Y (fixedDesignAlg x) (LinearBandit.linearGaussianEnv 𝒳 θ) P"},{"explicit":true,"name":"T","role":"variable","type":"ℕ"}],"conclusion":"ProbabilityTheory.HasLaw (history O X Y T) (LinearBandit.fixedDesignHistLaw (fun t => x ↑t) θ) P","decl":"Learning.IsAlgEnvSeq.hasLaw_history_of_fixedDesign"},"code":"/-- Under a fixed-design run, the history of the first `T` rounds has law\n`fixedDesignHistLaw`. -/\nlemma _root_.Learning.IsAlgEnvSeq.hasLaw_history_of_fixedDesign\n    (h : IsAlgEnvSeq O X Y (fixedDesignAlg x) (linearGaussianEnv 𝒳 θ) P) (T : ℕ) :\n    HasLaw (history O X Y T) (fixedDesignHistLaw (fun t : Fin T ↦ x t) θ) P","proof":":= by\n  have hY := h.hasLaw_feedback_finVec_of_fixedDesign T\n  have hm : Measurable fun y : Fin T → ℝ ↦ fun t : Fin T ↦ ((), x t, y t) :=\n    Measurable.of_eval fun t ↦\n      measurable_const.prodMk (measurable_const.prodMk (measurable_pi_apply t))\n  have h1 : HasLaw (fun ω ↦ fun t : Fin T ↦ ((), x t, Y t ω))\n      (fixedDesignHistLaw (fun t : Fin T ↦ x t) θ) P := by\n    have := (⟨hm.aemeasurable, rfl⟩ :\n        HasLaw (fun y : Fin T → ℝ ↦ fun t : Fin T ↦ ((), x t, y t)) _ _)\n      |>.comp hY\n    have hμ : ((Measure.pi fun _ : Fin T ↦ gaussianReal 0 1).map\n        (fun η (i : Fin T) ↦ ⟪(x i : E), θ⟫ + η i)).map\n          (fun y : Fin T → ℝ ↦ fun t : Fin T ↦ ((), x t, y t)) =\n        fixedDesignHistLaw (fun t : Fin T ↦ x t) θ := by\n      rw [fixedDesignHistLaw, Measure.map_map hm (by fun_prop)]\n      rfl\n    rwa [hμ] at this\n  refine h1.congr ?_\n  filter_upwards [h.ae_action_eq_of_fixedDesign] with ω hω\n  funext t\n  simp [history, hω t]","source":{"path":"Maiti2026Power/LeanMachineLearning/FixedDesignLaw.lean","start":78,"end":102,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/FixedDesignLaw.lean#L78-L102"},"deps":[47,86,97],"outside":[],"external":[["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IsAlgEnvSeq","LeanMachineLearning","structure"],["Learning.Round","LeanMachineLearning","definition"],["Learning.detAlgorithm","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableEq","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.p