 κ j⟩","proof":":= by\n  rw [EuclideanSpace.inner_eq_star_dotProduct, star_trivial]\n  simp only [dotProduct, Fintype.sum_sigma]\n  refine sum_congr rfl fun j _ ↦ ?_\n  change ∑ l : Fin (d j), (if l = κ j then 10 * mtEps d ε j else 0) * y ⟨j, l⟩ = _\n  simp_rw [ite_mul, zero_mul]\n  simp","source":{"path":"Maiti2026Power/MXJ2026/MultitaskInstances.lean","start":88,"end":96,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/MultitaskInstances.lean#L88-L96"},"deps":[843,847],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace.toInner","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.seminormedAddCommGroup","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.normedAddCommGroup","mathlib","ins