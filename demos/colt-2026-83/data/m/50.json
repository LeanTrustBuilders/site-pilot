 d ε κ j","proof":":= by\n  ext i'\n  rw [mtParam0_apply, mtParam0_apply]\n  by_cases h : i'.1 = j\n  · simp [h]\n  · rw [ite_eq_right h, ite_eq_right h, Function.update_of_ne h]","source":{"path":"Maiti2026Power/MXJ2026/MultitaskInstances.lean","start":79,"end":86,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/MultitaskInstances.lean#L79-L86"},"deps":[841],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Function.update","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.sqrt","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Sigma.snd","lean4","definition"],["WithLp.toLp","mathlib","constructor"],["Zero.toOfNat0","lean4","instance"],["instDecidableEqFin","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["ite","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc9