- mtParam d ε κ⟫ = -(10 * mtEps d ε j * y ⟨j, κ j⟩)","proof":":= by\n  rw [EuclideanSpace.inner_eq_star_dotProduct, star_trivial]\n  simp only [dotProduct, Fintype.sum_sigma]\n  rw [← Finset.sum_erase_add _ _ (mem_univ j)]\n  have hzero : ∀ j' ∈ univ.erase j,\n      ∑ l : Fin (d j'), (mtParam0 d ε κ j - mtParam d ε κ) ⟨j', l⟩ * y ⟨j', l⟩ = 0 := by\n    intro j' hj'\n    refine sum_eq_zero fun l _ ↦ ?_\n    have h : (mtParam0 d ε κ j - mtParam d ε κ) ⟨j', l⟩ = 0 := by\n      change mtParam0 d ε κ j ⟨j', l⟩ - mtParam d ε κ ⟨j', l⟩ = 0\n      rw [mtParam0_apply, mtParam_apply, ite_eq_right (mem_erase.1 hj').1]\n      ring\n    rw [h, zero_mul]\n  rw [sum_eq_zero hzero, zero_add]\n  have hterm : ∀ l : Fin (d j), (mtParam0 d ε κ j - mtParam d ε κ) ⟨j, l⟩ =\n      if l = κ j then -(10 * mtEps d ε j) else 0 := by\n    intro l\n    change mtParam0 d ε κ j ⟨j, l⟩ - mtParam d ε κ ⟨j, l⟩ = _\n    rw [mtParam0_apply, mtParam_apply, ite_eq_left rfl]\n    split_ifs <;> ring\n  simp_rw [hterm, ite_mul, zero_mul]\n  simp","source":{"path":"Maiti2026Power/MXJ2026/MultitaskInstances.lean","start":98,"end":123,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/MultitaskInstances.lean#L98-L123"},"deps":[841,843,847],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathli