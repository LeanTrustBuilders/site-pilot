.mapOfConst Q G hG)","conclusionHead":"Eq","conclusionRefs":[[0,25,"MeasureTheory.Measure.map"],[36,52,"Prod.mk"],[57,61,"MeasureTheory.Measure.prod"],[65,66,"Eq"],[71,79,"MeasureTheory.Measure.compProd"],[81,98,"ProbabilityTheory.Kernel.mapOfConst"]],"decl":"ProbabilityTheory.Measure.prod_map_mapOfConst"},"code":"/-- The law of a map `(x, y) ↦ (x, G x y)` applied to `μ ⊗ Q`. -/\nlemma Measure.prod_map_mapOfConst {μ : Measure 𝓧} [SFinite μ] (Q : Measure 𝓨) [SFinite Q]\n    {G : 𝓧 → 𝓨 → 𝓩} (hG : Measurable (Function.uncurry G)) :\n    (μ.prod Q).map (fun p ↦ (p.1, G p.1 p.2)) = μ ⊗ₘ Kernel.mapOfConst Q G hG","proof":":= by\n  have hΦ : Measurable (fun p : 𝓧 × 𝓨 ↦ (p.1, G p.1 p.2)) := measurable_fst.prodMk hG\n  rw [← Measure.compProd_const, Measure.compProd_eq_comp_prod, Measure.compProd_eq_comp_prod,\n    ← Measure.deterministic_comp_eq_map hΦ, Measure.comp_assoc]\n  congr 1\n  ext x : 1\n  rw [Kernel.comp_apply, Kernel.prod_apply, Kernel.id_apply, Kernel.const_apply,\n    Measure.dirac_prod, Measure.deterministic_comp_eq_map hΦ, Kernel.prod_apply, Kernel.id_apply,\n    Kernel.mapOfConst_apply hG, Measure.dirac_prod, Measure.map_map hΦ measurable_prodMk_left]\n  have hGx : Measurable (G x) := hG.comp measurable_prodMk_left\n  rw [Measure.map_map measurable_prodMk_left hGx]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":81,"end":95,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L81-L95"},"deps":[1526],"outside":[],"external":[["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class