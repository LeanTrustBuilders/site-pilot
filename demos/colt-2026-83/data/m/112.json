":"MeasureTheory.Measure","implicit":true,"name":"R","role":"variable","type":"MeasureTheory.Measure 𝓩","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.SFinite","implicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q","typeRefs":[[0,21,"MeasureTheory.SFinite"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure R","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":true,"head":"ProbabilityTheory.HasCondDistrib","implicit":false,"name":"h","role":"hypothesis","type":"HasCondDistrib (fun ω => (Y ω, Z ω)) X (Kernel.const 𝓧 (Q.prod R)) P","typeRefs":[[0,14,"ProbabilityTheory.HasCondDistrib"],[25,35,"Prod.mk"],[40,52,"ProbabilityTheory.Kernel.const"],[58,62,"MeasureTheory.Measure.prod"]]}],"conclusion":"HasCondDistrib Z (fun ω => (X ω, Y ω)) (Kernel.const (𝓧 × 𝓨) R) P","conclusionHead":"ProbabilityTheory.HasCondDistrib","conclusionRefs":[[0,14,"ProbabilityTheory.HasCondDistrib"],[27,37,"Prod.mk"],[40,52,"ProbabilityTheory.Kernel.const"],[56,57,"Prod"]],"decl":"ProbabilityTheory.HasCondDistrib.snd_of_const_prod"},"code":"/-- If the conditional law of `(Y, Z)` given `X` is the constant `Q ⊗ R`, then the conditional\nlaw of `Z` given `(X, Y)` is the constant `R`. -/\nlemma HasCondDistrib.snd_of_const_prod [IsFiniteMeasure P] {X : Ω → 𝓧} {Y : Ω → 𝓨} {Z : Ω → 𝓩}\n    {Q : Measure 𝓨} {R : Measure 𝓩} [SFinite Q] [IsProbabilityMeasure R]\n    (h : HasCondDistrib (fun ω ↦ (Y ω, Z ω)) X (Kernel.const 𝓧 (Q.prod R)) P) :\n    HasCondDistrib Z (fun ω ↦ (X ω, Y ω)) (Kernel.const (𝓧 × 𝓨) R) P","proof":":= by\n  rw [Kernel.const_compProd_const] at h\n  exact h.of_compProd","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":115,"end":122,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribCons