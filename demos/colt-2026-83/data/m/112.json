it":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure Q"}],"conclusion":"IsMarkovKernel (mapOfConst Q G hG)","decl":"ProbabilityTheory.Kernel.instIsMarkovKernelMapOfConstOfIsProbabilityMeasure"},"code":"instance [IsProbabilityMeasure Q] : IsMarkovKernel (mapOfConst Q G hG)","proof":":= by\n  unfold mapOfConst\n  rw [Kernel.mapOfMeasurable_eq_map]\n  exact IsMarkovKernel.map _ hG","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":50,"end":53,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L50-L53"},"deps":[1526],"outside":[],"external":[["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["ProbabilityTheory.IsMarkovKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1530,"name":"ProbabilityTheory.Kernel.mapOfConst_apply","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"ff90c2d21c10bf32","local":"820850fe2653421b","content":"9b412117ad601f94"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"G","role":"variable","type":"𝓧 → 𝓨 → 𝓩"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q"},{"explicit":true,"name":"hG","role":"hypothesis","type":"Measurable (Function.uncurry G)"},{"explicit":true,"name":"x","role":"variable","type":"𝓧"}],"conclusion":"(mapOfConst Q G hG) x = MeasureTheory.Measure.map (G x) Q","decl":"ProbabilityTheory.Kernel.mapOfConst_apply"},"code":"lemma mapOfConst_apply [SFinite Q] (hG : Measurable (Function.uncurry G)) (x : 𝓧) :\n    mapOfConst Q G hG x = Q.map (G x)","proof":":= by\n  rw [mapOfConst, Kernel.mapOfMeasurable_eq_map, Kernel.map_apply _ hG, Kernel.prod_apply,\n    Kernel.id_apply, Kernel.const_apply, Measure.dirac_prod,\n    Measure.map_map hG measurable_prodMk_left]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":38,"end":43,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L38-L43"},"deps":[1526],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1531,"name":"ProbabilityTheory.HasCondDistrib.mapOfConst","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"bc2fac14a89eb5cc","local":"9ca1dab3b4d105e3","content":"7e13d031f9881d6c"},"doc":"If the conditional law of `Y` given `X` is the constant `Q`, then the conditional law of\n`G X Y` given `X` is `x ↦ Q.map (G x)`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"X","role":"variable","type":"Ω → 𝓧"},{"explicit":false,"name":"Y","role":"variable","type":"Ω → 𝓨"},{"explicit":false,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib Y X (Kernel.const 𝓧 Q) P"},{"explicit":false,"name":"G","role":"variable","type":"𝓧 → 𝓨 → 𝓩"},{"explicit":true,"name":"hG","role":"hypothesis","type":"Measurable (Function.uncurry G)"}],"conclusion":"HasCondDistrib (fun ω => G (X ω) (Y ω)) X (Kernel.mapOfConst Q G hG) P","decl":"ProbabilityTheory.HasCondDistrib.mapOfConst"},"code":"/-- If the conditional law of `Y` given `X` is the constant `Q`, then the conditional law of\n`G X Y` given `X` is `x ↦ Q.map (G x)`. -/\nlemma HasCondDistrib.mapOfConst [IsFiniteMeasure P] {X : Ω → 𝓧} {Y : Ω → 𝓨} {Q : Measure 𝓨}\n    [SFinite Q] (h : HasCondDistrib Y X (Kernel.const 𝓧 Q) P) {G : 𝓧 → 𝓨 → 𝓩}\n    (hG : Measurable (Function.uncurry G)) :\n    HasCondDistrib (fun ω ↦ G (X ω) (Y ω)) X (Kernel.mapOfConst Q G hG) P","proof":":= by\n  have hX := h.aemeasurable_fst\n  have hY := h.aemeasurable_snd\n  refine ⟨by fun_prop, ?_⟩\n  have h1 := h.map_eq\n  rw [Measure.compProd_const] at h1\n  calc P.map (fun ω ↦ (X ω, G (X ω) (Y ω)))\n      = (P.map (fun ω ↦ (X ω, Y ω))).map (fun p ↦ (p.1, G p.1 p.2)) := by\n        rw [AEMeasurable.map_map_of_aemeasurable (by fun_prop) (by fun_prop)]\n        rfl\n    _ = ((P.map X).prod Q).map (fun p ↦ (p.1, G p.1 p.2)) := by rw [h1]\n    _ = P.map X ⊗ₘ Kernel.mapOfConst Q G hG := Measure.prod_map_mapOfConst Q hG","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":97,"end":113,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L97-L113"},"deps":[1526],"outside":[],"external":[["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1532,"name":"ProbabilityTheory.HasCondDistrib.snd_of_const_prod","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"53162148ba934414","local":"e544d6da992386a3","content":"50e29dcd186ce728"},"doc":"If the conditional law of `(Y, Z)` given `X` is the constant `Q ⊗ R`, then the conditional\nlaw of `Z` given `(X, Y)` is the constant `R`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"X","role":"variable","type":"Ω → 𝓧"},{"explicit":false,"name":"Y","role":"variable","type":"Ω → 𝓨"},{"explicit":false,"name":"Z","role":"variable","type":"Ω → 𝓩"},{"explicit":false,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"R","role":"variable","type":"MeasureTheory.Measure 𝓩"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure R"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasCondDistrib (fun ω => (Y ω, Z ω)) X (Kernel.const 𝓧 (Q.prod R)) P"}],"conclusion":"HasCondDistrib Z (fun ω => (X ω, Y ω)) (Kernel.const (𝓧 × 𝓨) R) P","decl":"ProbabilityTheory.HasCondDistrib.snd_of_const_prod"},"code":"/-- If the conditional law of `(Y, Z)` given `X` is the constant `Q ⊗ R`, then the conditional\nlaw of `Z` given `(X, Y)` is the constant `R`. -/\nlemma HasCondDistrib.snd_of_const_prod [IsFiniteMeasure P] {X : Ω → 𝓧} {Y : Ω → 𝓨} {Z : Ω → 𝓩}\n    {Q : Measure 𝓨} {R : Measure 𝓩} [SFinite Q] [IsProbabilityMeasure R]\n    (h : HasCondDistrib (fun ω ↦ (Y ω, Z ω)) X (Kernel.const 𝓧 (Q.prod R)) P) :\n    HasCondDistrib Z (fun ω ↦ (X ω, Y ω)) (Kernel.const (𝓧 × 𝓨) R) P","proof":":= by\n  rw [Kernel.const_compProd_const] at h\n  exact h.of_compProd","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":115,"end":122,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L115-L122"},"deps":[],"outside":[],"external":[["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1533,"name":"ProbabilityTheory.Kernel.comap_mapOfConst","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"63b4512c73f6ce0f","local":"e149ec40a15f2835","content":"638af0409d004cc8"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"G","role":"variable","type":"𝓧 → 𝓨 → 𝓩"},{"explicit":false,"name":"hG","role":"hypothesis","type":"Measurable (Function.uncurry G)"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q"},{"explicit":false,"name":"𝓦","role":"type","type":"Type u_5"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓦"},{"explicit":false,"name":"f","role":"variable","type":"𝓦 → 𝓧"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable f"},{"explicit":true,"name":"hGf","role":"hypothesis","type":"Measurable (Function.uncurry fun w => G (f w))"}],"conclusion":"(mapOfConst Q G hG).comap f hf = mapOfConst Q (fun w => G (f w)) hGf","decl":"ProbabilityTheory.Kernel.comap_mapOfConst"},"code":"lemma comap_mapOfConst [SFinite Q] {𝓦 : Type*} [MeasurableSpace 𝓦] {f : 𝓦 → 𝓧}\n    (hf : Measurable f) (hGf : Measurable (Function.uncurry fun w ↦ G (f w))) :\n    (mapOfConst Q G hG).comap f hf = mapOfConst Q (fun w ↦ G (f w)) hGf","proof":":= by\n  ext w : 1\n  rw [Kernel.comap_apply, mapOfConst_apply hG, mapOfConst_apply hGf]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":55,"end":59,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L55-L59"},"deps":[1526],"outside":[],"external":[["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1534,"name":"ProbabilityTheory.HasLaw.hasCondDistrib_snd_const","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"1320ee8c8c3b913f","local":"c0b814e8dfe78b4a","content":"18d76c355291dad3"},"doc":"If `(X, Y) ~ Q ⊗ R` then the conditional law of `Y` given `X` is the constant kernel `R`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"X","role":"variable","type":"Ω → 𝓧"},{"explicit":false,"name":"Y","role":"variable","type":"Ω → 𝓨"},{"explicit":false,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓧"},{"explicit":false,"name":"R","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure R"},{"explicit":true,"name":"h","role":"hypothesis","type":"HasLaw (fun ω => (X ω, Y ω)) (Q.prod R) P"}],"conclusion":"HasCondDistrib Y X (Kernel.const 𝓧 R) P","decl":"ProbabilityTheory.HasLaw.hasCondDistrib_snd_const"},"code":"/-- If `(X, Y) ~ Q ⊗ R` then the conditional law of `Y` given `X` is the constant kernel `R`. -/\nlemma HasLaw.hasCondDistrib_snd_const [IsFiniteMeasure P] {X : Ω → 𝓧} {Y : Ω → 𝓨}\n    {Q : Measure 𝓧} {R : Measure 𝓨} [IsProbabilityMeasure R]\n    (h : HasLaw (fun ω ↦ (X ω, Y ω)) (Q.prod R) P) :\n    HasCondDistrib Y X (Kernel.const 𝓧 R) P","proof":":= by\n  unfold HasCondDistrib\n  rw [Measure.compProd_const]\n  have hX : P.map X = Q := by\n    rw [← Measure.fst_map_prodMk₀ h.aemeasurable.fst h.aemeasurable.snd, h.map_eq, Measure.fst_prod]\n  rw [hX]\n  exact h","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":69,"end":79,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L69-L79"},"deps":[],"outside":[],"external":[["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.prod","mathlib","definition"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.HasLaw","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1535,"name":"ProbabilityTheory.Kernel.const_compProd_const","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"82d4aec2e5f705a5","local":"30e1051c26309582","content":"2ce1ccc278d6bad0"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":true,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q"},{"explicit":true,"name":"R","role":"variable","type":"MeasureTheory.Measure 𝓩"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite R"}],"conclusion":"const 𝓧 (Q.prod R) = (const 𝓧 Q).compProd (const (𝓧 × 𝓨) R)","decl":"ProbabilityTheory.Kernel.const_compProd_const"},"code":"lemma const_compProd_const (Q : Measure 𝓨) [SFinite Q] (R : Measure 𝓩) [SFinite R] :\n    Kernel.const 𝓧 (Q.prod R) = Kernel.const 𝓧 Q ⊗ₖ Kernel.const (𝓧 × 𝓨) R","proof":":= by\n  ext x s hs\n  rw [Kernel.const_apply, Kernel.compProd_apply hs, Measure.prod_apply hs]\n  simp [Kernel.const_apply]","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":61,"end":65,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L61-L65"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.compProd","mathlib","definition"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}}]