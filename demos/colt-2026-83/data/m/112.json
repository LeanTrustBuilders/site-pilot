itional law of `Y` given `X` is the constant kernel `R`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓧","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓨","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P","typeRefs":[[0,29,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"Ω → 𝓧","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Y","role":"variable","type":"Ω → 𝓨","typeRefs":[]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓧","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"R","role":"variable","type":"MeasureTheory.Measure 𝓨","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure R","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":true,"head":"ProbabilityTheory.HasLaw","implicit":false,"