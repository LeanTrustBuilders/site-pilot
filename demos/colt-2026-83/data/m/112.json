"]],"decl":"ProbabilityTheory.Kernel.mapOfConst_apply"},"code":"lemma mapOfConst_apply [SFinite Q] (hG : Measurable (Function.uncurry G)) (x : 𝓧) :\n    mapOfConst Q G hG x = Q.map (G x)","proof":":= by\n  rw [mapOfConst, Kernel.mapOfMeasurable_eq_map, Kernel.map_apply _ hG, Kernel.prod_apply,\n    Kernel.id_apply, Kernel.const_apply, Measure.dirac_prod,\n    Measure.map_map hG measurable_prodMk_left]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":38,"end":43,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L38-L43"},"deps":[1526],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DFunLike.coe","Eq","Function.uncurry","Measurable","MeasurableSpace","MeasureTheory.Measure","MeasureTheory.Measure.map","MeasureTheory.SFinite","ProbabilityTheory.Kernel","ProbabilityTheory.Kernel.instFunLike","Prod","Prod.instMeasurableSpace"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","dat