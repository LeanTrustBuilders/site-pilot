","typeRefs":[]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.SFinite","implicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q","typeRefs":[[0,21,"MeasureTheory.SFinite"]]},{"explicit":true,"head":"ProbabilityTheory.HasCondDistrib","implicit":false,"name":"h","role":"hypothesis","type":"HasCondDistrib Y X (Kernel.const 𝓧 Q) P","typeRefs":[[0,14,"ProbabilityTheory.HasCondDistrib"],[20,32,"ProbabilityTheory.Kernel.const"]]},{"explicit":false,"implicit":true,"name":"G","role":"variable","type":"𝓧 → 𝓨 → 𝓩","typeRefs":[]},{"explicit":true,"head":"Measurable","implicit":false,"name":"hG","role":"hypothesis","type":"Measurable (Function.uncurry G)","typeRefs":[[0,10,"Measurable"],[12,28,"Function.uncurry"]]}],"conclusion":"HasCondDistrib (fun ω => G (X ω) (Y ω)) X (Kernel.mapOfConst Q G hG) P","conclusionHead":"ProbabilityTheory.HasCondDistrib","conclusionRefs":[[0,14,"ProbabilityTheory.HasCondDistrib"],[43,60,"ProbabilityTheory.Kernel.mapOfConst"]],"decl":"ProbabilityTheory.HasCondDistrib.mapOfConst"},"code":"/-- If the conditional law of `Y` given `X` is the constant `Q`, then the conditional law of\n`G X Y` given `X` is `x ↦ Q.map (G x)`. -/\nlemma HasCondDistrib.mapOfConst [IsFiniteMeasure P] {X : Ω → 𝓧} {Y : Ω → 𝓨} {Q : Measure 𝓨}\n    [SFinite Q] (h : HasCondDistrib Y X (Kernel.const 𝓧 Q) P) {G : 𝓧 → 𝓨 → 𝓩}\n    (hG : Measurable (Function.uncurry G)) :\n    HasCondDistrib (fun ω ↦ G (X ω) (Y ω)) X (Kernel.mapOfConst Q G hG) P","proof":":= by\n  have hX := h.aemeasurable_fst\n  have hY := h.aemeasurable_snd\n  refine ⟨by fun_prop, ?_⟩\n  have h1 := h.map_eq\n  rw [Measure.compProd_const] at h1\n  calc P.map (fun ω ↦ (X ω, G (X ω) (Y ω)))\n      = (P.map (fun ω ↦ (X ω, Y ω))).map (fun p ↦ (p.1, G p.1 p.2)) := by\n        rw [AEMeasurable.map_map_of_aemeasurable (by fun_prop) (by fun_prop)]\n        rfl\n    _ = ((P.map X).prod Q).map (fun p ↦ (p.1, G p.1 p.2)) := by rw [h1]\n    _ = P.map X ⊗ₘ Kernel.mapOfConst Q G hG := Measure.prod_map_mapOfConst Q hG","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":97,"end":113,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L97-L113"},"deps":[1526],"outside":[],"external":[["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Function.uncurry","Measurable","MeasurableSpace","MeasureTheory.IsFiniteMeasure","MeasureTheory.Measure","MeasureTheory.SFinite","ProbabilityTheory.HasCondDistrib","ProbabilityTheory.Kernel.const","Prod","Prod.instMeasurableSpace"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1532,"name":"ProbabilityTheory.HasCondDistrib.snd_of_const_prod","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"53162148ba934414","local":"e544d6da992386a3","content":"50e29dcd186ce728"}