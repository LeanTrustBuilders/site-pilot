[{"id":1526,"name":"ProbabilityTheory.Kernel.mapOfConst","kind":"Definition","keyword":"def","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"9f24c717942b4c26","local":"596efd875b1c9e32","content":"290d952d00bf0a98"},"doc":"The kernel `x ↦ Q.map (G x)`: the law of `G x e` for a fresh noise `e ~ Q`. ","statement":{"binders":[{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":true,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":true,"name":"G","role":"variable","type":"𝓧 → 𝓨 → 𝓩"},{"explicit":true,"name":"hG","role":"hypothesis","type":"Measurable (Function.uncurry G)"}],"conclusion":"Kernel 𝓧 𝓩","decl":"ProbabilityTheory.Kernel.mapOfConst","value":"(Kernel.id.prod (const 𝓧 Q)).mapOfMeasurable (Function.uncurry G) hG"},"code":"/-- The kernel `x ↦ Q.map (G x)`: the law of `G x e` for a fresh noise `e ~ Q`. -/\nnoncomputable def mapOfConst (Q : Measure 𝓨) (G : 𝓧 → 𝓨 → 𝓩)\n    (hG : Measurable (Function.uncurry G)) : Kernel 𝓧 𝓩 :=\n  (Kernel.id ×ₖ Kernel.const 𝓧 Q).mapOfMeasurable (Function.uncurry G) hG","proof":"","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":31,"end":34,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L31-L34"},"deps":[],"outside":[],"external":[["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[276,310,1527,1528,1529,1530,1531,1533],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1527,"name":"ProbabilityTheory.Measure.prod_map_mapOfConst","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"cc11539662386ec1","local":"222d761dac295af0","content":"0598ded21c2aa468"},"doc":"The law of a map `(x, y) ↦ (x, G x y)` applied to `μ ⊗ Q`. ","statement":{"binders":[{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite μ"},{"explicit":true,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite Q"},{"explicit":false,"name":"G","role":"variable","type":"𝓧 → 𝓨 → 𝓩"},{"explicit":true,"name":"hG","role":"hypothesis","type":"Measurable (Function.uncurry G)"}],"conclusion":"MeasureTheory.Measure.map (fun p => (p.1, G p.1 p.2)) (μ.prod Q) =\n  μ.compProd (Kernel.mapOfConst Q G hG)","decl":"ProbabilityTheory.Measure.prod_map_mapOfConst"},"code":"/-- The law of a map `(x, y) ↦ (x, G x y)` applied to `μ ⊗ Q`. -/\nlemma Measure.prod_map_mapOfConst {μ : Measure 𝓧} [SFinite μ] (Q : Measure 𝓨) [SFinite Q]\n    {G : 𝓧 → 𝓨 → 𝓩} (hG : Measurable (Function.uncurry G)) :\n    (μ.prod Q).map (fun p ↦ (p.1, G p.1 p.2)) = μ ⊗ₘ Kernel.mapOfConst Q G hG","proof":":= by\n  have hΦ : Measurable (fun p : 𝓧 × 𝓨 ↦ (p.1, G p.1 p.2)) := measurable_fst.prodMk hG\n  rw [← Measure.compProd_const, Measure.compProd_eq_comp_prod, Measure.compProd_eq_comp_prod,\n    ← Measure.deterministic_comp_eq_map hΦ, Measure.comp_assoc]\n  congr 1\n  ext x : 1\n  rw [Kernel.comp_apply, Kernel.prod_apply, Kernel.id_apply, Kernel.const_apply,\n    Measure.dirac_prod, Measure.deterministic_comp_eq_map hΦ, Kernel.prod_apply, Kernel.id_apply,\n    Kernel.mapOfConst_apply hG, Measure.dirac_prod, Measure.map_map hΦ measurable_prodMk_left]\n  have hGx : Measurable (G x) := hG.comp measurable_prodMk_left\n  rw [Measure.map_map measurable_prodMk_left hGx]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":81,"end":95,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/CondDistribConst.lean#L81-L95"},"deps":[1526],"outside":[],"external":[["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["ProbabilityTheory.Kernel.id","mathlib","definition"],["ProbabilityTheory.Kernel.mapOfMeasurable","mathlib","definition"],["ProbabilityTheory.Kernel.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1528,"name":"ProbabilityTheory.Kernel.instIsSFiniteKernelMapOfConst","kind":"Lemma","keyword":"instance","module":"Maiti2026Power.Mathlib.Probability.CondDistribConst","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"99487cda7ec81609","local":"61464442b2ec11c6","content":"8f34df51731cfc81"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓧","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓩","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓧"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓩"},{"explicit":false,"name":"Q","role":"variable","type":"MeasureTheory.Measure 𝓨"},{"explicit":false,"name":"G","role":"variable","type":"𝓧 → 𝓨 → 𝓩"},{"explicit":false,"name":"hG","role":"hypothesis","type":"Measurable (Function.uncurry G)"}],"conclusion":"IsSFiniteKernel (mapOfConst Q G hG)","decl":"ProbabilityTheory.Kernel.instIsSFiniteKernelMapOfConst"},"code":"instance : IsSFiniteKernel (mapOfConst Q G hG)","proof":":= by\n  unfold mapOfConst\n  rw [Kernel.mapOfMeasurable_eq_map]\n  infer_instance","source":{"path":"Maiti2026Power/Mathlib/Probability/CondDistribConst.lean","start":45,"end":48,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e