[{"id":1308,"name":"exists_separated_of_isotropic","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.IsotropicSeparated","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"49d6ec58e876e27f","local":"a507478ad7dc0671","content":"a7f955b46dec696f"},"doc":"Let `u` be a weighted family in isotropic position in a space of dimension `d`. Then for every\n`m`, there are `m` indices with positive weights whose points are pairwise at squared distance at\nleast `d + 1 - m`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"InnerProductSpace","implicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E","typeRefs":[[0,17,"InnerProductSpace"],[18,19,"Real"]]},{"explicit":false,"head":"FiniteDimensional","implicit":false,"name":"","role":"instance","type":"FiniteDimensional ℝ E","typeRefs":[[0,17,"FiniteDimensional"],[18,19,"Real"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":true,"name":"u","role":"variable","type":"ι → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"w","role":"variable","type":"ι → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"hw","role":"hypothesis","type":"∀ (i : ι), 0 ≤ w i","typeRefs":[[13,14,"LE.le"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hw1","role":"hypothesis","type":"∑ i, w i = 1","typeRefs":[[9,10,"Eq"]]},{"explicit":true,"implicit":false,"name":"hiso","role":"hypothesis","type":"∀ (v : E), ∑ i, w i * inner ℝ (u i) v ^ 2 = ‖v‖ ^ 2","typeRefs":[[20,21,"HMul.hMul"],[22,27,"Inner.inner"],[28,29,"Real"],[38,39,"HPow.hPow"],[42,43,"Eq"],[44,45,"Norm.norm"],[46,47,"Norm.norm"],[48,49,"HPow.hPow"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"m","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"∃ t,\n  (∀ (k : Fin m), 0 < w (t k)) ∧\n    ∀ (k l : Fin m), k ≠ l → ↑(Module.finrank ℝ E) + 1 - ↑m ≤ ‖u (t k) - u (t l)‖ ^ 2","conclusionHead":"Exists","conclusionRefs":[[15,18,"Fin"],[25,26,"LT.lt"],[36,37,"And"],[51,54,"Fin"],[61,62,"Ne"],[69,83,"Module.finrank"],[84,85,"Real"],[89,90,"HAdd.hAdd"],[93,94,"HSub.hSub"],[98,99,"LE.le"],[100,101,"Norm.norm"],[109,110,"HSub.hSub"],[118,119,"Norm.norm"],[120,121,"HPow.hPow"]],"decl":"exists_separated_of_isotropic"},"code":"/-- Let `u` be a weighted family in isotropic position in a space of dimension `d`. Then for every\n`m`, there are `m` indices with positive weights whose points are pairwise at squared distance at\nleast `d + 1 - m`. -/\nlemma exists_separated_of_isotropic {ι : Type*} [Fintype ι] {u : ι → E} {w : ι → ℝ}\n    (hw : ∀ i, 0 ≤ w i) (hw1 : ∑ i, w i = 1) (hiso : ∀ v, ∑ i, w i * ⟪u i, v⟫ ^ 2 = ‖v‖ ^ 2)\n    (m : ℕ) :\n    ∃ t : Fin m → ι, (∀ k, 0 < w (t k)) ∧\n      ∀ k l, k ≠ l → (finrank ℝ E : ℝ) + 1 - m ≤ ‖u (t k) - u (t l)‖ ^ 2","proof":":= by\n  induction m with\n  | zero => exact ⟨finZeroElim, fun k ↦ k.elim0, fun k ↦ k.elim0⟩\n  | succ m ih =>\n    obtain ⟨t, ht, htsep⟩ := ih\n    set V := Submodule.span ℝ (Set.range (u ∘ t))\n    have hVdim : (finrank ℝ V : ℝ) ≤ m := by\n      have h := finrank_range_le_card (R := ℝ) (u ∘ t)\n      simp only [Set.finrank, Fintype.card_fin] at h\n      exact_mod_cast h\n    obtain ⟨i, hi, hdist⟩ := exists_pos_weight_sq_dist_ge_of_isotropic hw hw1 hiso V\n    have hnew : ∀ k, (finrank ℝ E : ℝ) + 1 - (m + 1 : ℕ) ≤ ‖u i - u (t k)‖ ^ 2 := fun k ↦ by\n      refine le_trans ?_ (hdist _ (Submodule.subset_span ⟨k, rfl⟩))\n      push_cast\n      linarith\n    refine ⟨Fin.snoc t i, ?_, ?_⟩\n    · intro k\n      induction k using Fin.lastCases with\n      | last => simpa using hi\n      | cast k => simpa using ht k\n    · intro k l hkl\n      induction k using Fin.lastCases with\n      | last =>\n        induction l using Fin.lastCases with\n        | last => exact absurd rfl hkl\n        | cast l => simpa using hnew l\n      | cast k =>\n        induction l using Fin.lastCases with\n        | last => simpa [norm_sub_rev] using hnew k\n        | cast l =>\n          simp only [Fin.snoc_castSucc]\n          refine le_trans ?_ (htsep k l fun h ↦ hkl (by rw [h]))\n          push_cast\n          linarith","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/IsotropicSeparated.lean","start":79,"end":119,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/IsotropicSeparated.lean#L79-L119"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["And","lean4","structure"],["Eq","lean4","inductive"],["Exists","lean4","inductive"],["Fin","lean4","structure"],["FiniteDimensional","mathlib","definition"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Module.finrank","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Ne","lean4","definition"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedSpace.toModule","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivisionRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.normedField","mathlib","instance"],["Real.semiring","mathlib","instance"],["SubNegMonoid.toSub","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommGroup.toAddCommMonoid","AddCommGroup.toAddGroup","AddGroup.toSubNegMonoid","And","Eq","Exists","Fin","FiniteDimensional","Finset.sum","Finset.univ","Fintype","HAdd.hAdd","HMul.hMul","HPow.hPow","HSub.hSub","Inner.inner","InnerProductSpace","InnerProductSpace.toInner","InnerProductSpace.toNormedSpace","LE.le","LT.lt","Module.finrank","Monoid.toNPow","NPow.toPow","Nat","Nat.cast","Ne","Norm.norm","NormedAddCommGroup","NormedAddCommGroup.toAddCommGroup","NormedAddCommGroup.toNorm","NormedAddCommGroup.toSeminormedAddCommGroup","NormedSpace.toModule","OfNat.ofNat","One.toOfNat1","Real","Real.instAdd","Real.instAddCommMonoid","Real.instDivisionRing","Real.instLE","Real.instLT","Real.instMonoid","Real.instMul","Real.instNatCast","Real.instOne","Real.instRCLike","Real.instSub","Real.instZero","Real.normedField","Real.semiring","SubNegMonoid.toSub","Zero.toOfNat0","instHAdd","instHMul","instHPow","instHSub","instOfNatNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1309,"name":"sum_inner_sq_orthogonal_le_norm_sub_sq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.IsotropicSeparated","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"85b41e5cf0e04f25","local":"e3d71ecc71b8d3d0","content":"2a4831e8113fccfb"},"doc":"If `f` is an orthonormal basis of the orthogonal complement `Vᗮ` of a subspace `V`, then for\nevery `v ∈ V` and every `x`, the sum of the squared inner products of `x` against `f` is at most\n`‖x - v‖ ^ 2`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"InnerProductSpace","implicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E","typeRefs":[[0,17,"InnerProductSpace"],[18,19,"Real"]]},{"explicit":false,"head":"Submodule","implicit":true,"name":"V","role":"variable","type":"Submodule ℝ E","typeRefs":[[0,9,"Submodule"],[10,11,"Real"]]},{"explicit":false,"implicit":true,"name":"κ","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype κ","typeRefs":[[0,7,"Fintype"]]},{"explicit":true,"head":"OrthonormalBasis","implicit":false,"name":"f","role":"variable","type":"OrthonormalBasis κ ℝ ↥Vᗮ","typeRefs":[[0,16,"OrthonormalBasis"],[19,20,"Real"],[23,24,"Submodule.orthogonal"]]},{"explicit":true,"implicit":false,"name":"x","role":"variable","type":"E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"v","role":"variable","type":"E","typeRefs":[]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hv","role":"hypothesis","type":"v ∈ V","typeRefs":[[2,3,"Membership.mem"]]}],"conclusion":"∑ j, inner ℝ x ↑(f j) ^ 2 ≤ ‖x - v‖ ^ 2","conclusionHead":"LE.le","conclusionRefs":[[5,10,"Inner.inner"],[11,12,"Real"],[22,23,"HPow.hPow"],[26,27,"LE.le"],[28,29,"Norm.norm"],[31,32,"HSub.hSub"],[34,35,"Norm.norm"],[36,37,"HPow.hPow"]],"decl":"sum_inner_sq_orthogonal_le_norm_sub_sq"},"code":"/-- If `f` is an orthonormal basis of the orthogonal complement `Vᗮ` of a subspace `V`, then for\nevery `v ∈ V` and every `x`, the sum of the squared inner products of `x` against `f` is at most\n`‖x - v‖ ^ 2`. -/\nlemma sum_inner_sq_orthogonal_le_norm_sub_sq {V : Submodule ℝ E} {κ : Type*} [Fintype κ]\n    (f : OrthonormalBasis κ ℝ Vᗮ) (x : E) {v : E} (hv : v ∈ V) :\n    ∑ j, ⟪x, (f j : E)⟫ ^ 2 ≤ ‖x - v‖ ^ 2","proof":":= by\n  have horth : Orthonormal ℝ (fun j ↦ (f j : E)) := f.orthonormal.comp_linearIsometry Vᗮ.subtypeₗᵢ\n  have h := horth.sum_inner_products_le (x - v) (s := univ)\n  simp only [Real.norm_eq_abs, sq_abs, inner_sub_right,\n    Submodule.inner_left_of_mem_orthogonal hv (f _).2, sub_zero, real_inner_comm x] at h\n  exact h","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/IsotropicSeparated.lean","start":32,"end":42,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/IsotropicSeparated.lean#L32-L42"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DenselyNormedField.toNormedField","mathlib","instance"],["Field.toSemifield","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedField.toField","mathlib","instance"],["NormedSpace.toModule","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["OrthonormalBasis","mathlib","structure"],["OrthonormalBasis.instFunLike","mathlib","instance"],["RCLike.toDenselyNormedField","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.normedField","mathlib","instance"],["Real.semiring","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SetLike.instMembership","mathlib","instance"],["SubNegMonoid.toSub","mathlib","instance"],["Submodule","mathlib","structure"],["Submodule.innerProductSpace","mathlib","instance"],["Submodule.normedAddCommGroup","mathlib","instance"],["Submodule.orthogonal","mathlib","definition"],["Submodule.setLike","mathlib","instance"],["Subtype","lean4","structure"],["Subtype.val","lean4","definition"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommGroup.toAddCommMonoid","AddCommGroup.toAddGroup","AddGroup.toSubNegMonoid","CommSemiring.toSemiring","DFunLike.coe","DenselyNormedField.toNormedField","Field.toSemifield","Finset.sum","Finset.univ","Fintype","HPow.hPow","HSub.hSub","Inner.inner","InnerProductSpace","InnerProductSpace.toInner","InnerProductSpace.toNormedSpace","LE.le","Membership.mem","Monoid.toNPow","NPow.toPow","Nat","Norm.norm","NormedAddCommGroup","NormedAddCommGroup.toAddCommGroup","NormedAddCommGroup.toNorm","NormedAddCommGroup.toSeminormedAddCommGroup","NormedField.toField","NormedSpace.toModule","OfNat.ofNat","OrthonormalBasis","OrthonormalBasis.instFunLike","RCLike.toDenselyNormedField","Real","Real.instAddCommMonoid","Real.instLE","Real.instMonoid","Real.instRCLike","Real.instRing","Real.normedField","Real.semiring","Semifield.toCommSemiring","SetLike.instMembership","SubNegMonoid.toSub","Submodule","Submodule.innerProductSpace","Submodule.normedAddCommGroup","Submodule.orthogonal","Submodule.setLike","Subtype","Subtype.val","instHPow","instHSub","instOfNatNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1310,"name":"exists_pos_weight_sq_dist_ge_of_isotropic","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.IsotropicSeparated","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"965c053a1664eb11","local":"2b92612ef2f7692f","content":"4514267e065ed475"},"doc":"Let `u` be a weighted family in isotropic position. Then for every subspace `V` there is an\nindex `i` with positive weight such that `u i` is at squared distance at least\n`finrank ℝ E - finrank ℝ V` from `V`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"E","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"NormedAddCommGroup","implicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E","typeRefs":[[0,18,"NormedAddCommGroup"]]},{"explicit":false,"head":"InnerProductSpace","implicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E","typeRefs":[[0,17,"InnerProductSpace"],[18,19,"Real"]]},{"explicit":false,"head":"FiniteDimensional","implicit":false,"name":"","role":"instance","type":"FiniteDimensional ℝ E","typeRefs":[[0,17,"FiniteDimensional"],[18,19,"Real"]]},{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":true,"name":"u","role":"variable","type":"ι → E","typeRefs":[]},{"explicit":false,"implicit":true,"name":"w","role":"variable","type":"ι → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"hw","role":"hypothesis","type":"∀ (i : ι), 0 ≤ w i","typeRefs":[[13,14,"LE.le"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hw1","role":"hypothesis","type":"∑ i, w i = 1","typeRefs":[[9,10,"Eq"]]},{"explicit":true,"implicit":false,"name":"hiso","role":"hypothesis","type":"∀ (v : E), ∑ i, w i * inner ℝ (u i) v ^ 2 = ‖v‖ ^ 2","typeRefs":[[20,21,"HMul.hMul"],[22,27,"Inner.inner"],[28,29,"Real"],[38,39,"HPow.hPow"],[42,43,"Eq"],[44,45,"Norm.norm"],[46,47,"Norm.norm"],[48,49,"HPow.hPow"]]},{"explicit":true,"head":"Submodule","implicit":false,"name":"V","role":"variable","type":"Submodule ℝ E","typeRefs":[[0,9,"Submodule"],[10,11,"Real"]]}],"conclusion":"∃ i, 0 < w i ∧ ∀ v ∈ V, ↑(Module.finrank ℝ E) - ↑(Module.finrank ℝ ↥V) ≤ ‖u i - v‖ ^ 2","conclusionHead":"Exists","conclusionRefs":[[7,8,"LT.lt"],[13,14,"And"],[26,40,"Module.finrank"],[41,42,"Real"],[46,47,"HSub.hSub"],[50,64,"Module.finrank"],[65,66,"Real"],[71,72,"LE.le"],[73,74,"Norm.norm"],[78,79,"HSub.hSub"],[81,82,"Norm.norm"],[83,84,"HPow.hPow"]],"decl":"exists_pos_weight_sq_dist_ge_of_isotropic"},"code":"/-- Let `u` be a weighted family in isotropic position. Then for every subspace `V` there is an\nindex `i` with positive weight such that `u i` is at squared distance at least\n`finrank ℝ E - finrank ℝ V` from `V`. -/\nlemma exists_pos_weight_sq_dist_ge_of_isotropic {ι : Type*} [Fintype ι] {u : ι → E} {w : ι → ℝ}\n    (hw : ∀ i, 0 ≤ w i) (hw1 : ∑ i, w i = 1) (hiso : ∀ v, ∑ i, w i * ⟪u i, v⟫ ^ 2 = ‖v‖ ^ 2)\n    (V : Submodule ℝ E) :\n    ∃ i, 0 < w i ∧ ∀ v ∈ V, (finrank ℝ E : ℝ) - finrank ℝ V ≤ ‖u i - v‖ ^ 2","proof":":= by\n  set f := stdOrthonormalBasis ℝ Vᗮ\n  set D : ℝ := (finrank ℝ E : ℝ) - finrank ℝ V with hD\n  set S : ι → ℝ := fun i ↦ ∑ j, ⟪u i, (f j : E)⟫ ^ 2 with hS\n  have hD' : D = finrank ℝ Vᗮ := by\n    rw [hD, sub_eq_iff_eq_add, ← Nat.cast_add, add_comm, Submodule.finrank_add_finrank_orthogonal]\n  have hsum : ∑ i, w i * S i = D := by\n    simp only [hS, Finset.mul_sum]\n    rw [Finset.sum_comm]\n    simp only [hiso, Submodule.norm_coe, f.orthonormal.1, one_pow, sum_const, card_univ,\n      Fintype.card_fin, nsmul_eq_mul, mul_one, hD']\n  have hex : ∃ i, 0 < w i ∧ D ≤ S i := by\n    by_contra! h\n    obtain ⟨i₀, hi₀⟩ : ∃ i, 0 < w i := by\n      by_contra! h0\n      have : ∑ i, w i = 0 := sum_eq_zero fun i _ ↦ le_antisymm (h0 i) (hw i)\n      linarith\n    have hlt : ∑ i, w i * S i < ∑ i, w i * D := by\n      refine sum_lt_sum (fun i _ ↦ ?_) ⟨i₀, mem_univ _, mul_lt_mul_of_pos_left (h i₀ hi₀) hi₀⟩\n      rcases (hw i).eq_or_lt with h0 | h0\n      · simp [← h0]\n      · exact (mul_lt_mul_of_pos_left (h i h0) h0).le\n    rw [hsum, ← sum_mul, hw1, one_mul] at hlt\n    exact lt_irrefl _ hlt\n  obtain ⟨i, hi, hiS⟩ := hex\n  exact ⟨i, hi, fun v hv ↦ hiS.trans (sum_inner_sq_orthogonal_le_norm_sub_sq f (u i) hv)⟩","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/IsotropicSeparated.lean","start":46,"end":77,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/IsotropicSeparated.lean#L46-L77"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["And","lean4","structure"],["Eq","lean4","inductive"],["Exists","lean4","inductive"],["FiniteDimensional","mathlib","definition"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Membership.mem","lean4","definition"],["Module.finrank","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedSpace.toModule","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivisionRing","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.normedField","mathlib","instance"],["Real.semiring","mathlib","instance"],["SetLike.instMembership","m