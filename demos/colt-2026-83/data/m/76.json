it":false,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)","typeRefs":[[0,3,"Set"],[5,19,"EuclideanSpace"],[20,21,"Real"]]},{"explicit":true,"head":"IsCompact","implicit":false,"name":"h𝒳","role":"hypothesis","type":"IsCompact 𝒳","typeRefs":[[0,9,"IsCompact"]]},{"explicit":true,"head":"Set.Nonempty","implicit":false,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty","typeRefs":[[2,10,"Set.Nonempty"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hspan","role":"hypothesis","type":"Submodule.span ℝ 𝒳 = ⊤","typeRefs":[[0,14,"Submodule.span"],[15,16,"Real"],[19,20,"Eq"],[21,22,"Top.top"]]}],"conclusion":"gw 𝒳 ≤ ↑(Fintype.card ι)","conclusionHead":"LE.le","conclusionRefs":[[0,2,"Maiti2026Power.gw"],[5,6,"LE.le"],[9,21,"Fintype.card"]],"decl":"Maiti2026Power.gw_le_card"},"code":"/-- **Proposition 4 (i)**: the Gaussian width term of a spanning compact action set in `ℝ^d` is at\nmost `d`. -/\ntheorem gw_le_card (𝒳 : Set (EuclideanSpace ℝ ι)) (h𝒳 : IsCompact 𝒳) (hne : 𝒳.Nonempty)\n    (hspan : Submodule.span ℝ 𝒳 = ⊤) :\n    gw 𝒳 ≤ Fintype.card ι","proof":":= by\n  rcases isEmpty_or_nonempty ι with hι | hι\n  · simp [gw_of_isEmpty]\n  obtain ⟨R, hR⟩ : ∃ R, ∀ x ∈ 𝒳, ‖x‖ ≤ R := by\n    obtain ⟨r, hr⟩ := h𝒳.isBounded.subset_closedBall (0 : EuclideanSpace ℝ ι)\n    exact ⟨r, fun x hx ↦ mem_closedBall_zero_iff.1 (hr hx)⟩\n  obtain ⟨w, hw⟩ := exists_isGOptimalDesign h𝒳 hspan\n  exact (gw_le_gwMat hne hR hw.isDesign.designMatrix_mem_designSet hw.posDef).trans\n    (hw.gwMat_le_card subset_rfl hne hR)","source":{"path":"Maiti2026Power/MXJ2026/WidthBounds.lean","start":34,"end":46,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBounds.lean#L34-L46"},"deps":[1249],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.