],["Zero.toOfNat0","lean4","instance"],["convexHull","mathlib","definition"],["iInf","mathlib","definition"],["iSup","mathlib","definition"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instLENat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommGroup.toAddCommMonoid","AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","DecidableEq","DivInvMonoid.toDiv","ENNReal","ENNReal.instAddCommMonoidWithOne","Eq","EuclideanSpace","Fintype","Fintype.card","HDiv.hDiv","HMul.hMul","IsCompact","LE.le","Nat","Nat.cast","Nat.instAtLeastTwoHAddOfNat","Nat.instDiv","Nat.instNeZeroSucc","OfNat.ofNat","Pi.Function.module","Pi.addCommGroup","PiLp.innerProductSpace._proof_1","PiLp.topologicalSpace","PseudoMetricSpace.toUniformSpace","Real","Real.instAddCommGroup","Real.instDivInvMonoid","Real.instLE","Real.instMul","Real.instNatCast","Real.instRing","Real.log","Real.pseudoMetricSpace","Real.semiring","Real.sqrt","Ring.toSemiring","Semiring.toAddCommMonoid","Semiring.toModule","Set","Set.Nonempty","Submodule","Submodule.instTop","Submodule.span","Top.top","UniformSpace.toTopologicalSpace","WithLp.instAddCommGroup","WithLp.instModule","instHDiv","instHMul","instLENat","instOfNatAtLeastTwo","instOfNatNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1267,"name":"Maiti2026Power.widthSepDims","kind":"Definition","keyword":"def","module":"Maiti2026Power.MXJ2026.WidthBounds","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"7c4eefaaa7072c21","local":"e53ccb8b6a96d9a3","content":"1f84c131591ec01d"},"doc":"Block sizes of the multi-task set of Theorem 5: `m - 1` blocks of size `2` and one block of\nsize `m ^ 2`. ","statement":{"binders":[{"explicit":true,"head":"Nat","implicit":false,"name":"m","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"Fin","implicit":false,"name":"","role":"variable","type":"Fin m","typeRefs":[[0,3,"Fin"]]}],"conclusion":"ℕ","conclusionHead":"Nat","conclusionRefs":[[0,1,"Nat"]],"decl":"Maiti2026Power.widthSepDims","value":"if ↑a✝ + 1 < m then 2 else m ^ 2","valueRefs":[[0,2,"ite"],[7,8,"HAdd.hAdd"],[11,12,"LT.lt"],[15,19,"ite"],[22,26,"ite"],[29,30,"HPow.hPow"]]},"code":"/-- Block sizes of the multi-task set of Theorem 5: `m - 1` blocks of size `2` and one block of\nsize `m ^ 2`. -/\ndef widthSepDims (m : ℕ) : Fin m → ℕ := fun j ↦ if (j : ℕ) + 1 < m then 2 else m ^ 2","proof":"","source":{"path":"Maiti2026Power/MXJ2026/WidthBounds.lean","start":75,"end":77,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBounds.lean#L75-L77"},"deps":[],"outside":[],"external":[["Fin","lean4","structure"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["HPow.hPow","lean4","definition"],["LT.lt","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.decLt","lean4","instance"],["Nat.instMonoid","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instHPow","lean4","instance"],["instLTNat","lean4","instance"],["instOfNatNat","lean4","instance"],["ite","lean4","definition"]],"users":[1268],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Fin","Fin.val","HAdd.hAdd","HPow.hPow","LT.lt","Monoid.toNPow","NPow.toPow","Nat","Nat.decLt","Nat.instMonoid","OfNat.ofNat","instAddNat","instHAdd","instHPow","instLTNat","instOfNatNat","ite"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1268,"name":"Maiti2026Power.width_separation","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.WidthBounds","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"3f4dd1d9637fc8ae","local":"b26f0cb2ef3ccf45","content":"0c90df93d3918678"},"doc":"**Theorem 5** (Maiti, Xu, Jamieson 2026): for `m ≥ 2`, the multi-task set `𝒳` with `m - 1`\nblocks of size `2` and one block of size `m²` lives in dimension `d = m² + 2m - 2`, has\n`|𝒳| = 2^{m-1} m²` elements, spans a subspace of dimension `r = m² + m - 1 ∈ [d/2, d]`, and its\nintrinsic Gaussian width term satisfies `w_int(𝒳) ≤ 3 √(d log d)`, whereas\n`√(d log |𝒳|) ≥ 0.49 d^{3/4}` and `√(r log |𝒳|) ≥ 0.34 d^{3/4}`. ","statement":{"binders":[{"explicit":true,"head":"Nat","implicit":false,"name":"m","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hm","role":"hypothesis","type":"2 ≤ m","typeRefs":[[2,3,"LE.le"]]}],"conclusion":"Fintype.card ((j : Fin m) × Fin (widthSepDims m j)) = m ^ 2 + 2 * m - 2 ∧\n  (multitaskSet (widthSepDims m)).ncard = 2 ^ (m - 1) * m ^ 2 ∧\n    Module.finrank ℝ ↥(Submodule.span ℝ (multitaskSet (widthSepDims m))) = m ^ 2 + m - 1 ∧\n      ↑(m ^ 2 + 2 * m - 2) / 2 ≤ ↑(m ^ 2 + m - 1) ∧\n        intrinsicGw (multitaskSet (widthSepDims m)) ≤\n            3 * √(↑(m ^ 2 + 2 * m - 2) * Real.log ↑(m ^ 2 + 2 * m - 2)) ∧\n          0.49 * ↑(m ^ 2 + 2 * m - 2) ^ (3 / 4) ≤\n              √(↑(m ^ 2 + 2 * m - 2) * Real.log ↑(2 ^ (m - 1) * m ^ 2)) ∧\n            0.34 * ↑(m ^ 2 + 2 * m - 2) ^ (3 / 4) ≤\n              √(↑(m ^ 2 + m - 1) * Real.log ↑(2 ^ (m - 1) * m ^ 2))","conclusionHead":"And","conclusionRefs":[[0,12,"Fintype.card"],[19,22,"Fin"],[28,31,"Fin"],[33,45,"Maiti2026Power.widthSepDims"],[52,53,"Eq"],[56,57,"HPow.hPow"],[60,61,"HAdd.hAdd"],[64,65,"HMul.hMul"],[68,69,"HSub.hSub"],[72,73,"And"],[77,89,"Maiti2026Power.multitaskSet"],[91,103,"Maiti2026Power.widthSepDims"],[108,113,"Set.ncard"],[114,115,"Eq"],[118,119,"HPow.hPow"],[123,124,"HSub.hSub"],[128,129,"HMul.hMul"],[132,133,"HPow.hPow"],[136,137,"And"],[142,156,"Module.finrank"],[157,158,"Real"],[161,175,"Submodule.span"],[176,177,"Real"],[179,191,"Maiti2026Power.multitaskSet"],[193,205,"Maiti2026Power.widthSepDims"],[211,212,"Eq"],[215,216,"HPow.hPow"],[219,220,"HAdd.hAdd"],[223,224,"HSub.hSub"],[227,228,"And"],[239,240,"HPow.hPow"],[243,244,"HAdd.hAdd"],[247,248,"HMul.hMul"],[251,252,"HSub.hSub"],[256,257,"HDiv.hDiv"],[260,261,"LE.le"],[266,267,"HPow.hPow"],[270,271,"HAdd.hAdd"],[274,275,"HSub.hSub"],[279,280,"And"],[289,300,"Maiti2026Power.intrinsicGw"],[302,314,"Maiti2026Power.multitaskSet"],[316,328,"Maiti2026Power.widthSepDims"],[333,334,"LE.le"],[349,350,"HMul.hMul"],[351,352,"Real.sqrt"],[357,358,"HPow.hPow"],[361,362,"HAdd.hAdd"],[365,366,"HMul.hMul"],[369,370,"HSub.hSub"],[374,375,"HMul.hMul"],[376,384,"Real.log"],[389,390,"HPow.hPow"],[393,394,"HAdd.hAdd"],[397,398,"HMul.hMul"],[401,402,"HSub.hSub"],[407,408,"And"],[424,425,"HMul.hMul"],[430,431,"HPow.hPow"],[434,435,"HAdd.hAdd"],[438,439,"HMul.hMul"],[442,443,"HSub.hSub"],[447,448,"HPow.hPow"],[457,458,"LE.le"],[473,474,"Real.sqrt"],[479,480,"HPow.hPow"],[483,484,"HAdd.hAdd"],[487,488,"HMul.hMul"],[491,492,"HSub.hSub"],[496,497,"HMul.hMul"],[498,506,"Real.log"],[511,512,"HPow.hPow"],[516,517,"HSub.hSub"],[521,522,"HMul.hMul"],[525,526,"HPow.hPow"],[531,532,"And"],[550,551,"HMul.hMul"],[556,557,"HPow.hPow"],[560,561,"HAdd.hAdd"],[564,565,"HMul.hMul"],[568,569,"HSub.hSub"],[573,574,"HPow.hPow"],[583,584,"LE.le"],[599,600,"Real.sqrt"],[605,606,"HPow.hPow"],[609,610,"HAdd.hAdd"],[613,614,"HSub.hSub"],[618,619,"HMul.hMul"],[620,628,"Real.log"],[633,634,"HPow.hPow"],[638,639,"HSub.hSub"],[643,644,"HMul.hMul"],[647,648,"HPow.hPow"]],"decl":"Maiti2026Power.width_separation"},"code":"/-- **Theorem 5** (Maiti, Xu, Jamieson 2026): for `m ≥ 2`, the multi-task set `𝒳` with `m - 1`\nblocks of size `2` and one block of size `m²` lives in dimension `d = m² + 2m - 2`, has\n`|𝒳| = 2^{m-1} m²` elements, spans a subspace of dimension `r = m² + m - 1 ∈ [d/2, d]`, and its\nintrinsic Gaussian width term satisfies `w_int(𝒳) ≤ 3 √(d log d)`, whereas\n`√(d log |𝒳|) ≥ 0.49 d^{3/4}` and `√(r log |𝒳|) ≥ 0.34 d^{3/4}`. -/\ntheorem width_separation (m : ℕ) (hm : 2 ≤ m) :\n    Fintype.card (Σ j, Fin (widthSepDims m j)) = m ^ 2 + 2 * m - 2 ∧\n    (multitaskSet (widthSepDims m)).ncard = 2 ^ (m - 1) * m ^ 2 ∧\n    Module.finrank ℝ (Submodule.span ℝ (multitaskSet (widthSepDims m))) = m ^ 2 + m - 1 ∧\n    ((m ^ 2 + 2 * m - 2 : ℕ) : ℝ) / 2 ≤ (m ^ 2 + m - 1 : ℕ) ∧\n    intrinsicGw (multitaskSet (widthSepDims m)) ≤\n      3 * √((m ^ 2 + 2 * m - 2 : ℕ) * log (m ^ 2 + 2 * m - 2 : ℕ)) ∧\n    0.49 * ((m ^ 2 + 2 * m - 2 : ℕ) : ℝ) ^ (3 / 4 : ℝ) ≤\n      √((m ^ 2 + 2 * m - 2 : ℕ) * log (2 ^ (m - 1) * m ^ 2 : ℕ)) ∧\n    0.34 * ((m ^ 2 + 2 * m - 2 : ℕ) : ℝ) ^ (3 / 4 : ℝ) ≤\n      √((m ^ 2 + m - 1 : ℕ) * log (2 ^ (m - 1) * m ^ 2 : ℕ))","proof":":= by\n  obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩\n  have hn : 1 ≤ n := by omega\n  -- the block sizes\n  have hdims : ∀ j : Fin (n + 1), 0 < widthSepDims (n + 1) j := fun j ↦ by\n    unfold widthSepDims\n    split_ifs <;> positivity\n  have hcast : ∀ i : Fin n, widthSepDims (n + 1) i.castSucc = 2 := fun i ↦ by\n    simp [widthSepDims, i.is_lt]\n  have hlast : widthSepDims (n + 1) (Fin.last n) = (n + 1) ^ 2 := by\n    simp [widthSepDims]\n  -- the natural-number quantities\n  have hD : (n + 1) ^ 2 + 2 * (n + 1) - 2 = n ^ 2 + 4 * n + 1 := by\n    have : (n + 1) ^ 2 + 2 * (n + 1) = n ^ 2 + 4 * n + 1 + 2 := by ring\n    omega\n  have hRk : (n + 1) ^ 2 + (n + 1) - 1 = n ^ 2 + 3 * n + 1 := by\n    have : (n + 1) ^ 2 + (n + 1) = n ^ 2 + 3 * n + 1 + 1 := by ring\n    omega\n  have hcard : Fintype.card (Σ j, Fin (widthSepDims (n + 1) j)) =\n      (n + 1) ^ 2 + 2 * (n + 1) - 2 := by\n    rw [Fintype.card_sigma, Fin.sum_univ_castSucc, hD]\n    simp only [Fintype.card_fin, hcast, hlast, Finset.sum_const, Finset.card_univ, smul_eq_mul]\n    ring\n  have hncard : (multitaskSet (widthSepDims (n + 1))).ncard = 2 ^ (n + 1 - 1) * (n + 1) ^ 2 := by\n    rw [ncard_multitaskSet, Fin.prod_univ_castSucc]\n    simp only [hcast, hlast, Finset.prod_const, Finset.card_univ, Fintype.card_fin,\n      Nat.add_sub_cancel]\n  have hrank : Module.finrank ℝ (Submodule.span ℝ (multitaskSet (widthSepDims (n + 1)))) =\n      (n + 1) ^ 2 + (n + 1) - 1 := by\n    have h := finrank_span_multitaskSet_add hdims (by omega)\n    rw [hcard, hD] at h\n    rw [hRk]\n    omega\n  -- real casts\n  set D : ℕ := (n + 1) ^ 2 + 2 * (n + 1) - 2 with hD_def\n  set Rk : ℕ := (n + 1) ^ 2 + (n + 1) - 1 with hRk_def\n  set N : ℕ := 2 ^ (n + 1 - 1) * (n + 1) ^ 2 with hN_def\n  have hDR : (D : ℝ) = (n : ℝ) ^ 2 + 4 * n + 1 := by rw [hD]; push_cast; ring\n  have hRkR : (Rk : ℝ) = (n : ℝ) ^ 2 + 3 * n + 1 := by rw [hRk]; push_cast; ring\n  have hNR : (N : ℝ) = 2 ^ n * ((n : ℝ) + 1) ^ 2 := by\n    rw [hN_def, Nat.add_sub_cancel]; push_cast; ring\n  clear_value D Rk N\n  have hn0 : (0 : ℝ) ≤ n := by positivity\n  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn\n  have hDpos : (0 : ℝ) < D := by rw [hDR]; positivity\n  have hM2D : ((n : ℝ) + 1) ^ 2 ≤ D := by rw [hDR]; nlinarith\n  have hDM : (D : ℝ) ≤ ((n : ℝ) + 2) ^ 2 := by rw [hDR]; nlinarith\n  have hsqrtD : √(D : ℝ) ≤ (n : ℝ) + 2 :=\n    Real.sqrt_le_iff.2 ⟨by positivity, hDM⟩\n  -- logarithms\n  have hlog2 : 0.6931471803 < log 2 := Real.log_two_gt_d9\n  have hlogM : log 2 ≤ log ((n : ℝ) + 1) := Real.log_le_log two_pos (by linarith)\n  have hL0 : 0 < log ((n : ℝ) + 1) := by linarith\n  have hlogN : log (N : ℝ) = n * log 2 + 2 * log ((n : ℝ) + 1) := by\n    rw [hNR, Real.log_mul (by positivity) (by positivity), Real.log_pow, Real.log_pow]\n    push_cast\n    ring\n  have hlogD : log (((n : ℝ) + 1) ^ 2) ≤ log D :=\n    Real.log_le_log (by positivity) hM2D\n  -- (iii): `0.24 √D ≤ log N`\n  have hkey : 0.2401 * √(D : ℝ) ≤ log N := by\n    rw [hlogN]\n    have : 0.6931471803 * (n : ℝ) ≤ n * log 2 := by nlinarith\n    nlinarith\n  -- the intrinsic width bound\n  have hwidth : intrinsicGw (multitaskSet (widthSepDims (n + 1))) ≤\n      4 * ((n : ℝ) + 1) * √(log ((n : ℝ) + 1)) := by\n    refine (intrinsicGw_multitaskSet_le hdims).trans ?_\n    rw [Fin.sum_univ_castSucc]\n    simp only [hcast, hlast, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]\n    push_cast\n    have h1 : √(2 * 2 * log 2) ≤ 2 * √(log ((n : ℝ) + 1)) := by\n      rw [show (2 : ℝ) * 2 * log 2 = 2 ^ 2 * log 2 by ring, Real.sqrt_mul (by positivity),\n        Real.sqrt_sq (by norm_num)]\n      gcongr\n    have h2 : √(2 * ((n : ℝ) + 1) ^ 2 * log (((n : ℝ) + 1) ^ 2)) =\n        2 * ((n : ℝ) + 1) * √(log ((n : ℝ) + 1)) := by\n      rw [Real.log_pow, show (2 : ℝ) * ((n : ℝ) + 1) ^ 2 * (((2 : ℕ) : ℝ) * log ((n : ℝ) + 1)) =\n        (2 * ((n : ℝ) + 1)) ^ 2 * log ((n : ℝ) + 1) by push_cast; ring,\n        Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity)]\n    rw [h2]\n    have h3 : (n : ℝ) * √(2 * 2 * log 2) ≤ n * (2 * √(log ((n : ℝ) + 1))) :=\n      mul_le_mul_of_nonneg_left h1 hn0\n    nlinarith [Real.sqrt_nonneg (log ((n : ℝ) + 1))]\n  have hRHS : 4 * ((n : ℝ) + 1) * √(log ((n : ℝ) + 1)) ≤ 3 * √(D * log D) := by\n    have hsq2 : (1.4142 : ℝ) ≤ √2 := by\n      rw [Real.le_sqrt (by norm_num) (by norm_num)]\n      norm_num\n    have hlow : ((n : ℝ) + 1) ^ 2 * (2 * log ((n : ℝ) + 1)) ≤ D * log D := by\n      have := Real.log_pow ((n : ℝ) + 1) 2\n      push_cast at this\n      rw [← this]\n      exact mul_le_mul hM2D hlogD (by rw [this]; linarith) hDpos.le\n    calc 4 * ((n : ℝ) + 1) * √(log ((n : ℝ) + 1))\n        ≤ 3 * (((n : ℝ) + 1) * (√2 * √(log ((n : ℝ) + 1)))) := by\n          nlinarith [Real.sqrt_nonneg (log ((n : ℝ) + 1)),\n            mul_nonneg hn0 (Real.sqrt_nonneg (log ((n : ℝ) + 1)))]\n      _ = 3 * √(((n : ℝ) + 1) ^ 2 * (2 * log ((n : ℝ) + 1))) := by\n          rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity),\n            Real.sqrt_mul (by norm_num)]\n      _ ≤ 3 * √(D * log D) := by gcongr\n  -- the `3/4` powers\n  have h34 : ((D : ℝ) ^ (3 / 4 : ℝ)) ^ 2 = D * √D := by\n    rw [← Real.rpow_natCast, ← Real.rpow_mul hDpos.le, Real.sqrt_eq_rpow,\n      show (3 / 4 : ℝ) * ((2 : ℕ) : ℝ) = 1 + 1 / 2 by norm_num, Real.rpow_add hDpos, Real.rpow_one]\n  have hlogN0 : 0 ≤ log (N : ℝ) := by\n    rw [hlogN]\n    positivity\n  have hRk0 : (0 : ℝ) ≤ Rk := by positivity\n  refine ⟨hcard, hncard, hrank, ?_, hwidth.trans hRHS, ?_, ?_⟩\n  · rw [hDR, hRkR]\n    nlinarith\n  · rw [Real.le_sqrt (by positivity) (mul_nonneg hDpos.le hlogN0), mul_pow, h34]\n    have : (0.49 : ℝ) ^ 2 * (D * √D) = D * (0.2401 * √D) := by ring\n    rw [this]\n    exact mul_le_mul_of_nonneg_left hkey hDpos.le\n  · rw [Real.le_sqrt (by positivity) (mul_nonneg hRk0 hlogN0), mul_pow, h34]\n    have hRkD : (D : ℝ) / 2 ≤ Rk := by rw [hDR, hRkR]; nlinarith\n    calc (0.34 : ℝ) ^ 2 * (D * √D) = (D / 2) * (0.2312 * √D) := by ring\n      _ ≤ Rk * log N :=\n          mul_le_mul hRkD (by linarith [Real.sqrt_nonneg (D : ℝ)]) (by positivity) hRk0","source":{"path":"Maiti2026Power/MXJ2026/WidthBounds.lean","start":79,"end":214,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBounds.lean#L79-L214"},"deps":[1227,1243,1267],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["Bool.true","lean4","constructor"],["ChainCompletePartialOrder.instOfCompleteLattice","mathlib","instance"],["ChainCompletePartialOrder.toPartialOrder","mathlib","instance"],["ClosureOperator","mathlib","structure"],["ClosureOperator.instFunLike","mathlib","instance"],["CommSemiring.toSemiring","mathlib",