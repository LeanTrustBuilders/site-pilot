[{"id":1265,"name":"Maiti2026Power.gw_le_sqrt_log_ncard","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.WidthBounds","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"783ab1a08a1ae8eb","local":"8e55f16421466258","content":"25c45ca7730be3eb"},"doc":"**Proposition 4 (ii)**: the Gaussian width term of a finite spanning action set `𝒳 ⊆ ℝ^d` is\nat most `√(2 d log |𝒳|)`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"DecidableEq","implicit":false,"name":"","role":"instance","type":"DecidableEq ι","typeRefs":[[0,11,"DecidableEq"]]},{"explicit":true,"head":"Set","implicit":false,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)","typeRefs":[[0,3,"Set"],[5,19,"EuclideanSpace"],[20,21,"Real"]]},{"explicit":true,"head":"Set.Finite","implicit":false,"name":"hfin","role":"hypothesis","type":"𝒳.Finite","typeRefs":[[2,8,"Set.Finite"]]},{"explicit":true,"head":"Set.Nonempty","implicit":false,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty","typeRefs":[[2,10,"Set.Nonempty"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hspan","role":"hypothesis","type":"Submodule.span ℝ 𝒳 = ⊤","typeRefs":[[0,14,"Submodule.span"],[15,16,"Real"],[19,20,"Eq"],[21,22,"Top.top"]]}],"conclusion":"gw 𝒳 ≤ √(2 * ↑(Fintype.card ι) * Real.log ↑𝒳.ncard)","conclusionHead":"LE.le","conclusionRefs":[[0,2,"Maiti2026Power.gw"],[5,6,"LE.le"],[7,8,"Real.sqrt"],[11,12,"HMul.hMul"],[15,27,"Fintype.card"],[31,32,"HMul.hMul"],[33,41,"Real.log"],[45,50,"Set.ncard"]],"decl":"Maiti2026Power.gw_le_sqrt_log_ncard"},"code":"/-- **Proposition 4 (ii)**: the Gaussian width term of a finite spanning action set `𝒳 ⊆ ℝ^d` is\nat most `√(2 d log |𝒳|)`. -/\ntheorem gw_le_sqrt_log_ncard (𝒳 : Set (EuclideanSpace ℝ ι)) (hfin : 𝒳.Finite)\n    (hne : 𝒳.Nonempty) (hspan : Submodule.span ℝ 𝒳 = ⊤) :\n    gw 𝒳 ≤ √(2 * Fintype.card ι * log 𝒳.ncard)","proof":":= by\n  rcases isEmpty_or_nonempty ι with hι | hι\n  · simp [gw_of_isEmpty]\n  obtain ⟨R, hR⟩ : ∃ R, ∀ x ∈ 𝒳, ‖x‖ ≤ R := by\n    obtain ⟨r, hr⟩ := hfin.isCompact.isBounded.subset_closedBall (0 : EuclideanSpace ℝ ι)\n    exact ⟨r, fun x hx ↦ mem_closedBall_zero_iff.1 (hr hx)⟩\n  obtain ⟨w, hw⟩ := exists_isGOptimalDesign hfin.isCompact hspan\n  exact (gw_le_gwMat hne hR hw.isDesign.designMatrix_mem_designSet hw.posDef).trans\n    (hw.gwMat_le_sqrt_log_ncard subset_rfl hfin hne hR)","source":{"path":"Maiti2026Power/MXJ2026/WidthBounds.lean","start":48,"end":60,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthBounds.lean#L48-L60"},"deps":[1249],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["ChainCompletePartialOrder.instOfCompleteLattice","mathlib","instance"],["ChainCompletePartialOrder.toPartialOrder","mathlib","instance"],["ClosureOperator","mathlib","structure"],["ClosureOperator.instFunLike","mathlib","instance"],["CompleteAtomicBooleanAlgebra.toCompleteBooleanAlgebra","mathlib","instance"],["CompleteBooleanAlgebra.toCompleteLattice","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["HMul.hMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","m