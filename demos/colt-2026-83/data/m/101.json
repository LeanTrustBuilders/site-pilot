[{"id":1449,"name":"InformationTheory.klDiv_bernoulliMeasure","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"7aa7f316ac28a756","local":"10766bcd1dd46b0c","content":"6c83b679e4d01658"},"doc":"The Kullback-Leibler divergence between two Bernoulli measures `Ber(x, y, p)` and\n`Ber(x, y, q)` (Mathlib's `ProbabilityTheory.bernoulliMeasure`), for `x ≠ y`, is\nthe binary divergence `klBer p q`. ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"q","role":"variable","type":"↑unitInterval"}],"conclusion":"klDiv (ProbabilityTheory.bernoulliMeasure x y p) (ProbabilityTheory.bernoulliMeasure x y q) =\n  klBer ↑p ↑q","decl":"InformationTheory.klDiv_bernoulliMeasure"},"code":"/-- The Kullback-Leibler divergence between two Bernoulli measures `Ber(x, y, p)` and\n`Ber(x, y, q)` (Mathlib's `ProbabilityTheory.bernoulliMeasure`), for `x ≠ y`, is\nthe binary divergence `klBer p q`. -/\nlemma klDiv_bernoulliMeasure (hxy : x ≠ y) (p q : I) :\n    klDiv Ber(x, y, p) Ber(x, y, q) = klBer p q","proof":":= by\n  by_cases hq0 : q = 0\n  · subst hq0\n    by_cases hp0 : p = 0\n    · simp [hp0]\n    rw [klDiv_of_not_ac fun h ↦ hp0 (((bernoulliMeasure_absolutelyContinuous_iff hxy).1 h).1 rfl),\n      Icc.coe_zero, klBer_zero_right, ite_eq_right (coe_ne_zero.2 hp0)]\n  by_cases hq1 : q = 1\n  · subst hq1\n    by_cases hp1 : p = 1\n    · simp [hp1]\n    rw [klDiv_of_not_ac fun h ↦ hp1 (((bernoulliMeasure_absolutelyContinuous_iff hxy).1 h).2 rfl),\n      Icc.coe_one, klBer_one_right, ite_eq_right (coe_ne_one.2 hp1)]\n  rw [klDiv_bernoulliMeasure_eq_klBerReal hxy p hq0 hq1,\n    klBer_eq_ofReal (coe_ne_zero.2 hq0) (coe_ne_one.2 hq1)]","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":175,"end":193,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L175-L193"},"deps":[1447],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instTop","mathlib","instance"],["ENNReal.instZero","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["Membership.mem","lean4","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.decidableEq","mathlib","instance"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["Top.top","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["ite","lean4","definition"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1450,"name":"InformationTheory.sq_sub_le_klDiv","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"c83421aa1f1fa669","local":"b926fbf78e392be4","content":"e9c3e70e49c800b6"},"doc":"**Pinsker's inequality** for a single event: `2 (μ A - ν A)² ≤ KL(μ ‖ ν)`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"ν","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"A","role":"variable","type":"Set Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure ν"},{"explicit":true,"name":"hA","role":"hypothesis","type":"MeasurableSet A"}],"conclusion":"ENNReal.ofReal (2 * (μ.real A - ν.real A) ^ 2) ≤ klDiv μ ν","decl":"InformationTheory.sq_sub_le_klDiv"},"code":"/-- **Pinsker's inequality** for a single event: `2 (μ A - ν A)² ≤ KL(μ ‖ ν)`. -/\ntheorem sq_sub_le_klDiv [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]\n    (hA : MeasurableSet A) :\n    ENNReal.ofReal (2 * (μ.real A - ν.real A) ^ 2) ≤ klDiv μ ν","proof":":= by\n  classical\n  calc ENNReal.ofReal (2 * (μ.real A - ν.real A) ^ 2)\n  _ ≤ klDiv (μ.map (· ∈ A)) (ν.map (· ∈ A)) := by\n      rw [map_mem_eq_bernoulliMeasure hA, map_mem_eq_bernoulliMeasure hA]\n      exact ofReal_le_klDiv_bernoulliMeasure (by decide) ⟨μ.real A, _⟩ ⟨ν.real A, _⟩\n  _ ≤ klDiv μ ν := klDiv_map_le μ ν hA.mem","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":234,"end":243,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L234-L243"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["ENNReal.instLE","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["LE.le","lean4","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instSub","mathlib","instance"],["Set","mathlib","definition"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1451,"name":"InformationTheory.sq_sub_le_klBerReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"343f13a21eb6f6c3","local":"cc8e940fa1768ffe","content":"f40e7c995d3cf4fe"},"doc":"**Binary Pinsker inequality**: `2 * (p - q) ^ 2 ≤ klBerReal p q` for `p ∈ [0, 1]` and\n`q ∈ (0, 1)`. ","statement":{"binders":[{"explicit":false,"name":"p","role":"variable","type":"ℝ"},{"explicit":false,"name":"q","role":"variable","type":"ℝ"},{"explicit":true,"name":"hp","role":"hypothesis","type":"0 ≤ p"},{"explicit":true,"name":"hp1","role":"hypothesis","type":"p ≤ 1"},{"explicit":true,"name":"hq","role":"hypothesis","type":"0 < q"},{"explicit":true,"name":"hq1","role":"hypothesis","type":"q < 1"}],"conclusion":"2 * (p - q) ^ 2 ≤ klBerReal p q","decl":"InformationTheory.sq_sub_le_klBerReal"},"code":"/-- **Binary Pinsker inequality**: `2 * (p - q) ^ 2 ≤ klBerReal p q` for `p ∈ [0, 1]` and\n`q ∈ (0, 1)`. -/\nlemma sq_sub_le_klBerReal {p q : ℝ} (hp : 0 ≤ p) (hp1 : p ≤ 1) (hq : 0 < q) (hq1 : q < 1) :\n    2 * (p - q) ^ 2 ≤ klBerReal p q","proof":":= by\n  rcases le_or_gt p q with hpq | hpq\n  · exact sq_sub_le_klBerReal_of_le hp hpq hq1\n  · have := sq_sub_le_klBerReal_of_le (sub_nonneg.2 hp1) (sub_le_sub_left hpq.le 1) (by linarith)\n    rw [klBerReal_one_sub, sub_sub_sub_cancel_left] at this\n    linarith [this, show (p - q) ^ 2 = (q - p) ^ 2 by ring]","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":120,"end":128,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L120-L128"},"deps":[1434],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1452,"name":"InformationTheory.abs_sub_le_sqrt_klDiv","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"c90a3a80d8c365eb","local":"6220716a9b323779","content":"51c0bde9e80b548b"},"doc":"**Pinsker's inequality** for a single event, real form:\n`|μ A - ν A| ≤ √(KL(μ ‖ ν) / 2)`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"ν","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"A","role":"variable","type":"Set Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure ν"},{"explicit":true,"name":"hA","role":"hypothesis","type":"MeasurableSet A"},{"explicit":true,"name":"h","role":"hypothesis","type":"klDiv μ ν ≠ ⊤"}],"conclusion":"|μ.real A - ν.real A| ≤ √((klDiv μ ν).toReal / 2)","decl":"InformationTheory.abs_sub_le_sqrt_klDiv"},"code":"/-- **Pinsker's inequality** for a single event, real form:\n`|μ A - ν A| ≤ √(KL(μ ‖ ν) / 2)`. -/\nlemma abs_sub_le_sqrt_klDiv [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]\n    (hA : MeasurableSet A) (h : klDiv μ ν ≠ ∞) :","proof":"|μ.real A - ν.real A| ≤ √((klDiv μ ν).toReal / 2) := by\n  have := sq_sub_le_klDiv (μ := μ) (ν := ν) hA\n  rw [ENNReal.ofReal_le_iff_le_toReal h] at this\n  rw [← Real.sqrt_sq_eq_abs]\n  exact Real.sqrt_le_sqrt (by linarith)","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":245,"end":253,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L245-L253"},"deps":[],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instTop","mathlib","instance"],["ENNReal.toReal","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HSub.hSub","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["LE.le","lean4","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instAddGroup","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.sqrt","mathlib","definition"],["Set","mathlib","definition"],["Top.top","mathlib","definition"],["abs","mathlib","definition"],["instHDiv","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1453,"name":"InformationTheory.sq_sub_le_klBer","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"0b5014832253fa21","local":"f264d6379b6c0bd8","content":"58093277a9eef641"},"doc":"**Binary Pinsker inequality**: `2 * (p - q) ^ 2 ≤ klBer p q` for `p, q ∈ [0, 1]`. ","statement":{"binders":[{"explicit":false,"name":"p","role":"variable","type":"ℝ"},{"explicit":false,"name":"q","role":"variable","type":"ℝ"},{"explicit":true,"name":"hp","role":"hypothesis","type":"0 ≤ p"},{"explicit":true,"name":"hp1","role":"hypothesis","type":"p ≤ 1"},{"explicit":true,"name":"hq","role":"hypothesis","type":"0 ≤ q"},{"explicit":true,"name":"hq1","role":"hypothesis","type":"q ≤ 1"}],"conclusion":"ENNReal.ofReal (2 * (p - q) ^ 2) ≤ klBer p q","decl":"InformationTheory.sq_sub_le_klBer"},"code":"/-- **Binary Pinsker inequality**: `2 * (p - q) ^ 2 ≤ klBer p q` for `p, q ∈ [0, 1]`. -/\nlemma sq_sub_le_klBer {p q : ℝ} (hp : 0 ≤ p) (hp1 : p ≤ 1) (hq : 0 ≤ q) (hq1 : q ≤ 1) :\n    ENNReal.ofReal (2 * (p - q) ^ 2) ≤ klBer p q","proof":":= by\n  rcases hq.eq_or_lt with rfl | hq0\n  · rcases eq_or_ne p 0 with rfl | hp0\n    · simp\n    · simp [klBer_zero_right, hp0]\n  rcases hq1.eq_or_lt with rfl | hq1\n  · rcases eq_or_ne p 1 with rfl | hp1\n    · simp\n    · simp [klBer_one_right, hp1]\n  rw [klBer_eq_ofReal hq0.ne' hq1.ne]\n  exact ENNReal.ofReal_le_ofReal (sq_sub_le_klBerReal hp hp1 hq0 hq1)","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":130,"end":142,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L130-L142"},"deps":[1447],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instLE","mathlib","instance"],["ENNReal.instTop","mathlib","instance"],["ENNReal.instZero","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["LE.le","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.decidableEq","mathlib","instance"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Top.top","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["ite","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1454,"name":"ProbabilityTheory.rnDeriv_bernoulliMeasure","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"e1606ef1f4043937","local":"f4a781f77655e200","content":"e70a0a811718586e"},"doc":"The Radon–Nikodym derivative of `Ber(x, y, p)` with respect to `Ber(x, y, q)`. ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":false,"name":"q","role":"variable","type":"↑unitInterval"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq X"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"hq","role":"hypothesis","type":"q ≠ 0"},{"explicit":true,"name":"hq1","role":"hypothesis","type":"q ≠ 1"}],"conclusion":"(bernoulliMeasure x y p).rnDeriv (bernoulliMeasure x y q) =ᵐ[bernoulliMeasure x y q] fun z =>\n  if z = x then ENNReal.ofReal (↑p / ↑q) else ENNReal.ofReal ((1 - ↑p) / (1 - ↑q))","decl":"ProbabilityTheory.rnDeriv_bernoulliMeasure"},"code":"/-- The Radon–Nikodym derivative of `Ber(x, y, p)` with respect to `Ber(x, y, q)`. -/\nlemma rnDeriv_bernoulliMeasure [DecidableEq X] (hxy : x ≠ y) (p : I) (hq : q ≠ 0) (hq1 : q ≠ 1) :\n    Ber(x, y, p).rnDeriv Ber(x, y, q) =ᵐ[Ber(x, y, q)]\n      fun z ↦ if z = x then ENNReal.ofReal (p / q) else ENNReal.ofReal ((1 - p) / (1 - q))","proof":":= by\n  rw [bernoulliMeasure_eq_withDensity hxy p hq hq1]\n  exact Measure.rnDeriv_withDensity _\n    (Measurable.ite (measurableSet_singleton x) measurable_const measurable_const)","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":47,"end":53,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L47-L53"},"deps":[],"outside":[],"external":[["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["Filter.EventuallyEq","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HSub.hSub","lean4","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.Measure.instOuterMeasureClass","mathlib","instance"],["MeasureTheory.Measure.rnDeriv","mathlib","definition"],["MeasureTheory.ae","mathlib","definition"],["Membership.mem","lean4","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instIsOrderedRing","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Icc.instOne","mathlib","instance"],["Set.Icc.instZero","mathlib","instance"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHSub","lean4","instance"],["ite","lean4","definition"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1455,"name":"InformationTheory.klDiv_bernoulliMeasure_eq_klBerReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"87e088b6b4889e2b","local":"666a5a48c88e642d","content":"f285572f0744e8a5"},"doc":"The Kullback-Leibler divergence between two Bernoulli measures `Ber(x, y, p)` and\n`Ber(x, y, q)` (Mathlib's `ProbabilityTheory.bernoulliMeasure`), for `x ≠ y` and `q ∉ {0, 1}`, is\nthe binary divergence `klBerReal p q`. ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":false,"name":"q","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"hq","role":"hypothesis","type":"q ≠ 0"},{"explicit":true,"name":"hq1","role":"hypothesis","type":"q ≠ 1"}],"conclusion":"klDiv (ProbabilityTheory.bernoulliMeasure x y p) (ProbabilityTheory.bernoulliMeasure x y q) =\n  ENNReal.ofReal (klBerReal ↑p ↑q)","decl":"InformationTheory.klDiv_bernoulliMeasure_eq_klBerReal"},"code":"/-- The Kullback-Leibler divergence between two Bernoulli measures `Ber(x, y, p)` and\n`Ber(x, y, q)` (Mathlib's `ProbabilityTheory.bernoulliMeasure`), for `x ≠ y` and `q ∉ {0, 1}`, is\nthe binary divergence `klBerReal p q`. -/\nlemma klDiv_bernoulliMeasure_eq_klBerReal (hxy : x ≠ y) (p : I) {q : I} (hq : q ≠ 0)\n    (hq1 : q ≠ 1) :\n    klDiv Ber(x, y, p) Ber(x, y, q) = ENNReal.ofReal (klBerReal p q)","proof":":= by\n  classical\n  have hq0 : (0 : ℝ) < q := coe_pos.2 (unitInterval.pos_iff_ne_zero.2 hq)\n  have hq1' : (0 : ℝ) < 1 - q := sub_pos.2 (coe_lt_one.2 (unitInterval.lt_one_iff_ne_one.2 hq1))\n  have hq0' : (q : ℝ) ≠ 0 := hq0.ne'\n  have hq1'' : (1 : ℝ) - q ≠ 0 := hq1'.ne'\n  have hp0 : (0 : ℝ) ≤ p := p.2.1\n  have hp1 : (0 : ℝ) ≤ 1 - p := sub_nonneg.2 p.2.2\n  rw [klDiv_eq_lintegral_klFun_of_ac (bernoulliMeasure_absolutelyContinuous hxy p hq hq1),\n    lintegral_congr_ae ((rnDeriv_bernoulliMeasure hxy p hq hq1).mono fun z hz ↦ by rw [hz]),\n    lintegral_bernoulliMeasure]\n  simp only [ite_true, ite_eq_right hxy.symm, ENNReal.toReal_ofReal (div_nonneg hp0 hq0.le),\n    ENNReal.toReal_ofReal (div_nonneg hp1 hq1'.le)]\n  rw [← ENNReal.ofReal_mul hq0.le, ← ENNReal.ofReal_mul hq1'.le, ← ENNReal.ofReal_add\n      (mul_nonneg hq0.le (klFun_nonneg (div_nonneg hp0 hq0.le)))\n      (mul_nonneg hq1'.le (klFun_nonneg (div_nonneg hp1 hq1'.le)))]\n  congr 1\n  simp only [klFun, klBerReal]\n  field","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":150,"end":173,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L150-L173"},"deps":[1434],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["Membership.mem","lean4","definition"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instIsOrderedRing","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.log","mathlib","definition"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Icc.instOne","mathlib","instance"],["Set.Icc.instZero","mathlib","instance"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1456,"name":"InformationTheory.sq_sub_le_klBerReal_of_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"b62631de42e35607","local":"5cdb9a16e46da52b","content":"c4232ad83760d0e7"},"doc":"Binary Pinsker inequality when `p ≤ q`. ","statement":{"binders":[{"explicit":false,"name":"p","role":"variable","type":"ℝ"},{"explicit":false,"name":"q","role":"variable","type":"ℝ"},{"explicit":true,"name":"hp","role":"hypothesis","type":"0 ≤ p"},{"explicit":true,"name":"hpq","role":"hypothesis","type":"p ≤ q"},{"explicit":true,"name":"hq1","role":"hypothesis","type":"q < 1"}],"conclusion":"2 * (p - q) ^ 2 ≤ klBerReal p q","decl":"InformationTheory.sq_sub_le_klBerReal_of_le"},"code":"/-- Binary Pinsker inequality when `p ≤ q`. -/\nlemma sq_sub_le_klBerReal_of_le {p q : ℝ} (hp : 0 ≤ p) (hpq : p ≤ q) (hq1 : q < 1) :\n    2 * (p - q) ^ 2 ≤ klBerReal p q","proof":":= by\n  rcases (hp.trans hpq).eq_or_lt with rfl | hq0\n  · obtain rfl : p = 0 := le_antisymm hpq hp\n    simp\n  have hmono : MonotoneOn (klBerRealGap p) (Ico p 1) := by\n    refine monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ico p 1) (continuousOn_klBerRealGap hp)\n      (f' := fun q ↦ (q - p) * (1 - 2 * q) ^ 2 / (q * (1 - q))) (fun x hx ↦ ?_) fun x hx ↦ ?_\n    · rw [interior_Ico] at hx ⊢\n      exact (hasDerivAt_klBerRealGap (hp.trans_lt hx.1).ne' hx.2.ne).hasDerivWithinAt\n    · rw [interior_Ico] at hx\n      exact div_nonneg (mul_nonneg (sub_nonneg.2 hx.1.le) (sq_nonneg _))\n        (mul_pos (hp.trans_lt hx.1) (sub_pos.2 hx.2)).le\n  have h := hmono ⟨le_rfl, hpq.trans_lt hq1⟩ ⟨hpq, hq1⟩ hpq\n  rw [klBerRealGap_self] at h\n  unfold klBerRealGap at h\n  rw [klBerReal_eq_of_ne hq0.ne' hq1.ne]\n  linarith","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":100,"end":118,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L100-L118"},"deps":[1434],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1457,"name":"InformationTheory.ofReal_le_klDiv_bernoulliMeasure","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"1d8b820151062965","local":"3fee1d6c417fdaa7","content":"c86428715989fe77"},"doc":"Bernoulli Pinsker inequality in `ℝ≥0∞`, for all parameters in `[0, 1]`:\n`2 (p - q) ^ 2 ≤ KL(Ber(x, y, p) ‖ Ber(x, y, q))` (the divergence is infinite when `q ∈ {0, 1}`\nand `p ≠ q`). ","statement":{"binders":[{"explicit":false,"name":"X","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace X"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass X"},{"explicit":false,"name":"x","role":"variable","type":"X"},{"explicit":false,"name":"y","role":"variable","type":"X"},{"explicit":true,"name":"hxy","role":"hypothesis","type":"x ≠ y"},{"explicit":true,"name":"p","role":"variable","type":"↑unitInterval"},{"explicit":true,"name":"q","role":"variable","type":"↑unitInterval"}],"conclusion":"ENNReal.ofReal (2 * (↑p - ↑q) ^ 2) ≤\n  klDiv (ProbabilityTheory.bernoulliMeasure x y p) (ProbabilityTheory.bernoulliMeasure x y q)","decl":"InformationTheory.ofReal_le_klDiv_bernoulliMeasure"},"code":"/-- Bernoulli Pinsker inequality in `ℝ≥0∞`, for all parameters in `[0, 1]`:\n`2 (p - q) ^ 2 ≤ KL(Ber(x, y, p) ‖ Ber(x, y, q))` (the divergence is infinite when `q ∈ {0, 1}`\nand `p ≠ q`). -/\nlemma ofReal_le_klDiv_bernoulliMeasure (hxy : x ≠ y) (p q : I) :\n    ENNReal.ofReal (2 * (p - q) ^ 2) ≤ klDiv Ber(x, y, p) Ber(x, y, q)","proof":":=\n  (sq_sub_le_klBer p.2.1 p.2.2 q.2.1 q.2.2).trans_eq (klDiv_bernoulliMeasure hxy p q).symm","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":195,"end":200,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L195-L200"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["ENNReal.instLE","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["LE.le","lean4","definition"],["MeasurableSingletonClass","mathlib","class"],["MeasurableSpace","mathlib","class"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Real","mathlib","structure"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instSub","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}},{"id":1458,"name":"InformationTheory.map_mem_eq_bernoulliMeasure","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.Pinsker","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"2b4867f27c124112","local":"72d85862640f04c3","content":"b5b606d1dfd3d5bc"},"doc":"The pushforward of a probability measure by the `Prop`-valued membership map `ω ↦ ω ∈ A` is\nthe Bernoulli measure `Ber(True, False, μ.real A)`.\n\nTODO: Mathlib's `hasLaw_indicator_one_bernoulliMeasure` (more recent than the pinned revision)\nstates the same for the indicator of `A`; use it once available. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"A","role":"variable","type":"Set Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"MeasurableSet A"}],"conclusion":"MeasureTheory.Measure.map (fun x => x ∈ A) μ =\n  ProbabilityTheory.bernoulliMeasure True False ⟨μ.real A, ⋯⟩","decl":"InformationTheory.map_mem_eq_bernoulliMeasure"},"code":"/-- The pushforward of a probability measure by the `Prop`-valued membership map `ω ↦ ω ∈ A` is\nthe Bernoulli measure `Ber(True, False, μ.real A)`.\n\nTODO: Mathlib's `hasLaw_indicator_one_bernoulliMeasure` (more recent than the pinned revision)\nstates the same for the indicator of `A`; use it once available. -/\nlemma map_mem_eq_bernoulliMeasure [IsProbabilityMeasure μ] (hA : MeasurableSet A) :\n    μ.map (· ∈ A) =\n      Ber(True, False, ⟨μ.real A, measureReal_nonneg, measureReal_le_one⟩)","proof":":= by\n  refine Measure.ext_of_singleton fun b ↦ ?_\n  rw [Measure.map_apply hA.mem (measurableSet_singleton b)]\n  by_cases hb : b\n  · simp only [hb, preimage_singleton_true, ofPred_mem_eq, MeasurableSpace.measurableSet_top,\n      mem_singleton_iff, eq_iff_iff, iff_true, not_false_eq_true,\n      bernoulliMeasure_apply_of_mem_of_notMem]\n    rw [coe_toNNReal_eq_ofReal]\n    dsimp only\n    rw [measureReal_def, ENNReal.ofReal_toReal (measure_ne_top _ _)]\n  · simp only [hb, preimage_singleton_false, MeasurableSpace.measurableSet_top, mem_singleton_iff,\n      eq_iff_iff, iff_false, not_true_eq_false, not_false_eq_true,\n      bernoulliMeasure_apply_of_notMem_of_mem]\n    change μ Aᶜ = _\n    rw [coe_toNNReal_eq_ofReal, coe_symm_eq]\n    dsimp only\n    rw [← probReal_univ (μ := μ), ← measureReal_compl hA, measureReal_def,\n      ENNReal.ofReal_toReal (measure_ne_top _ _)]","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean","start":208,"end":232,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/Pinsker.lean#L208-L232"},"deps":[],"outside":[],"external":[["And.intro","lean4","constructor"],["Eq","lean4","inductive"],["False","lean4","inductive"],["LE.le","lean4","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.real","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["MeasureTheory.measureReal_le_one","mathlib","theorem"],["MeasureTheory.measureReal_nonneg","mathlib","theorem"],["Membership.mem","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Preorder.toLE","mathlib","instance"],["ProbabilityTheory.bernoulliMeasure","mathlib","definition"],["Prop.instMeasurableSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instZero","mathlib","instance"],["Set","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.mk","lean4","constructor"],["True","lean4","inductive"],["Zero.toOfNat0","lean4","instance"],["unitInterval","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"0082077e98442c7192d1244bc9b8ddae1db1ccfa","date":"2026-09-10"}}]