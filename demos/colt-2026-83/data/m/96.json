f_ne"},"code":"lemma Equiv.piSplitAt_symm_apply_of_ne (i : ι) (a : β i) (r : ∀ j : {j // j ≠ i}, β j) {j : ι}\n    (hj : j ≠ i) :\n    (Equiv.piSplitAt i β).symm (a, r) j = r ⟨j, hj⟩","proof":":= by\n  simp [hj]","source":{"path":"Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean","start":30,"end":33,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean#L30-L33"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["Eq","lean4","inductive"],["Equiv","mathlib","structure"],["Equiv.instEquivLike","mathlib","instance"],["Equiv.piSplitAt","mathlib","definition"],["Equiv.symm","mathlib","definition"],["EquivLike.toFunLike","mathlib","instance"],["Ne","lean4","definition"],["Prod","lean4","structure"],["Prod.mk","lean4","constructor"],["Subtype","lean4","structure"],["Subtype.mk","lean4","constructor"],["Subtype.val","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DFunLike.coe","DecidableEq","Eq","Equiv","Equiv.instEquivLike","Equiv.piSplitAt","Equiv.symm","EquivLike.toFunLike","Ne","Prod","Prod.mk","Subtype","Subtype.mk","Subtype.val"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1424,"name":"Fintype.card_pi_eq_mul_card_pi_subtype","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Data.Fintype.PiSplitAt","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"c3cdba2383926d9a","local":"ff7ecf7d0783c9d9","content":"c62c64382cff0cf8"},"doc":"","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"DecidableEq","implicit":false,"name":"","role":"instance","type":"DecidableEq ι","typeRefs":[[0,11,"DecidableEq"]]},{"explicit":false,"implicit":true,"name":"β","role":"type","type":"ι → Type u_2","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"(i : ι) → Fintype (β i)","typeRefs":[[10,17,"Fintype"]]},{"explicit":true,"implicit":false,"name":"i","role":"variable","type":"ι","typeRefs":[]}],"conclusion":"card ((j : ι) → β j) = card (β i) * card ((j : { j // j ≠ i }) → β ↑j)","conclusionHead":"Eq","conclusionRefs":[[0,4,"Fintype.card"],[21,22,"Eq"],[23,27,"Fintype.card"],[34,35,"HMul.hMul"],[36,40,"Fintype.card"],[51,53,"Subtype"],[56,57,"Ne"]],"decl":"Fintype.card_pi_eq_mul_card_pi_subtype"},"code":"lemma Fintype.card_pi_eq_mul_card_pi_subtype (i : ι) :\n    Fintype.card (∀ j, β j) = Fintype.card (β i) * Fintype.card (∀ j : {j // j ≠ i}, β j)","proof":":= by\n  rw [Fintype.card_congr (Equiv.piSplitAt i β), Fintype.card_prod]","source":{"path":"Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean","start":63,"end":65,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean#L63-L65"},"deps":[],"outside":[],"external":[["DecidableEq","lean4","definition"],["Eq","lean4","inductive"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["HMul.hMul","lean4","definition"],["Nat","lean4","inductive"],["Ne","lean4","definition"],["Pi.instFintype","mathlib","instance"],["Subtype","lean4","structure"],["Subtype.fintype","mathlib","instance"],["Subtype.instDecidableEq","lean4","instance"],["Subtype.val","lean4","definition"],["instDecidableNot","lean4","instance"],["instHMul","lean4","instance"],["instMulNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["DecidableEq","Eq","Fintype","Fintype.card","HMul.hMul","Nat","Ne","Pi.instFintype","Subtype","Subtype.fintype","Subtype.instDecidableEq","Subtype.val","instDecidableNot","instHMul","instMulNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1425,"name":"Fintype.sum_sum_update","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Data.Fintype.PiSplitAt","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"26b7961b73d6ab7a","local":"4573dfc939958dde","content":"1a0442f3019998af"},"doc":"Summing a function of a dependent product over all values of its `i`-th coordinate multiplies\nthe total sum by the cardinality of `β i`: the map `(κ, a) ↦ (update κ i a, κ i)` is an\ninvolution of `(∀ j, β j) × β i`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"DecidableEq","implicit":false,"name":"","role":"instance","type":"DecidableEq ι","typeRefs":[[0,11,"DecidableEq"]]},{"explicit":false,"implicit":true,"name":"β","role":"type","type":"ι → Type u_2","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"(i : ι) → Fintype (β i)","typeRefs":[[10,17,"Fintype"]]},{"explicit":false,"implicit":true,"name":"R","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"NonAssocSemiring","implicit":false,"name":"","role":"instance","type":"NonAssocSemiring R","typeRefs":[[0,16,"NonAssocSemiring"]]},{"explicit":true,"implicit":false,"name":"i","role":"variable","type":"ι","typeRefs":[]},{"explicit":true,"implicit":false,"name":"F","role":"variable","type":"((j : ι) → β j) → R","typeRefs":[]}],"conclusion":"∑ κ, ∑ a, F (Function.update κ i a) = ↑(card (β i)) * ∑ κ, F κ","conclusionHead":"Eq","conclusionRefs":[[13,28,"Function.update"],[36,37,"Eq"],[40,44,"Fintype.card"],[52,53,"HMul.hMul"]],"decl":"Fintype.sum_sum_update"},"code":"/-- Summing a function of a dependent product over all values of its `i`-th coordinate multiplies\nthe total sum by the cardinality of `β i`: the map `(κ, a) ↦ (update κ i a, κ i)` is an\ninvolution of `(∀ j, β j) × β i`. -/\nlemma Fintype.sum_sum_update {R : Type*} [NonAssocSemiring R] (i : ι) (F : (∀ j, β j) → R) :\n    ∑ κ : ∀ j, β j, ∑ a : β i, F (Function.update κ i a) =\n      Fintype.card (β i) * ∑ κ : ∀ j, β j, F κ","proof":":= by\n  have hΦ : Function.Involutive\n      (fun p : (∀ j, β j) × β i ↦ (Function.update p.1 i p.2, p.1 i)) := by\n    rintro ⟨κ, a⟩\n    simp [Function.update_idem, Function.update_eq_self]\n  calc ∑ κ : ∀ j, β j, ∑ a : β i, F (Function.update κ i a)\n      = ∑ p : (∀ j, β j) × β i, F (Function.update p.1 i p.2) :=\n        (Fintype.sum_prod_type fun p : (∀ j, β j) × β i ↦ F (Function.update p.1 i p.2)).symm\n    _ = ∑ p : (∀ j, β j) × β i, F p.1 :=\n        Fintype.sum_bijective _ hΦ.bijective _ _ fun _ ↦ rfl\n    _ = Fintype.card (β i) * ∑ κ : ∀ j, β j, F κ := by\n        rw [Fintype.sum_prod_type, Finset.mul_sum]\n        refine Finset.sum_congr rfl fun κ _ ↦ ?_\n        change ∑ _y : β i, F κ = _\n        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]","source":{"path":"Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean","start":42,"end":61,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean#L42-L61"},"deps":[],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DecidableEq","lean4","definition"],["Distrib.toMul","mathlib","instance"],["Eq","lean4","inductive"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["Function.update","mathlib","definition"],["HMul.hMul","lean4","definition"],["Nat.cast","lean4","definition"],["NonAssocSemiring","mathlib","class"],["NonAssocSemiring.toAddCommMonoidWithOne","mathlib","instance"],["NonAssocSemiring.toNonUnitalNonAssocSemiring","mathlib","instance"],["NonUnitalNonAssocSemiring.toAddCommMonoid","mathlib","instance"],["NonUnitalNonAssocSemiring.toDistrib","mathlib","instance"],["Pi.instFintype","mathlib","instance"],["instHMul","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","DecidableEq","Distrib.toMul","Eq","Finset.sum","Finset.univ","Fintype","Fintype.card","Function.update","HMul.hMul","Nat.cast","NonAssocSemiring","NonAssocSemiring.toAddCommMonoidWithOne","NonAssocSemiring.toNonUnitalNonAssocSemiring","NonUnitalNonAssocSemiring.toAddCommMonoid","NonUnitalNonAssocSemiring.toDistrib","Pi.instFintype","instHMul"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}}]