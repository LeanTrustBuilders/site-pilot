, β j|`. -/\nlemma Fintype.sum_ite_apply_eq {R : Type*} [Semiring R] (i : ι) [DecidableEq (β i)] (k : β i) :\n    (∑ κ : ∀ j, β j, if k = κ i then (1 : R) else 0) =\n      Fintype.card (∀ j : {j // j ≠ i}, β j)","proof":":= by\n  rw [Fintype.sum_pi_piSplitAt i]\n  simp only [Equiv.piSplitAt_symm_apply_self, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,\n    mul_ite, mul_one, mul_zero]\n  simp","source":{"path":"Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean","start":67,"end":74,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Data/Fintype/PiSplitAt.lean#L67-L74"},"deps":[],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["AddMonoidWithOne.toOne","mathlib","instance"],["DecidableEq","lean4","definition"],["Eq","lean4","inductive"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["Fintype.card","mathlib","definition"],["MulZeroClass.toZero","mathlib","instance"],["Nat.cast","lean4","definition"],["Ne","lean4","definition"],["NonAssocSemiring.toAddCommMonoidWithOne","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Pi.instFintype","mathlib","instance"],["Semiring","mathlib","class"],["Semiring.toAddCommMonoid","mathlib","instance"],["Semiring.toNonAssocSemiring","mathlib","instance"],["Subtype","lean4","structure"],["Subtype.fintype","mathlib","instance"],["Subtype.instDecidableEq","lean4","instance"],["Subtype.val","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["instDecidableNot","lean4","instance"],["instMulZeroClassOfSemiring","mathlib","instance"],["ite","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommM