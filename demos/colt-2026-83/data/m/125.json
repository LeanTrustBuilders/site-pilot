[{"id":1677,"name":"MeasureTheory.Measure.pi_prod_map_split","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.InfinitePiWindow","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"cbfd2f210881ba3a","local":"6da3c963a828566c","content":"134ab28375d24d92"},"doc":"A product of `J` copies of `μ ⊗ ν` is the product of the `J`-fold products of `μ` and `ν`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"X","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace X","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"Measure X","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"J","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype J","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":true,"name":"Y","role":"type","type":"Type u_4","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace Y","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"ν","role":"variable","type":"Measure Y","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure ν","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]}],"conclusion":"map (fun v => (fun p => (v p).1, fun p => (v p).2)) (Measure.pi fun x => μ.prod ν) =\n  (Measure.pi fun x => μ).prod (Measure.pi fun x => ν)","conclusionHead":"Eq","conclusionRefs":[[0,3,"MeasureTheory.Measure.map"],[14,50,"Prod.mk"],[53,63,"MeasureTheory.Measure.pi"],[75,79,"MeasureTheory.Measure.prod"],[83,84,"Eq"],[88,98,"MeasureTheory.Measure.pi"],[111,115,"MeasureTheory.Measure.prod"],[117,127,"MeasureTheory.Measure.pi"]],"decl":"MeasureTheory.Measure.pi_prod_map_split"},"code":"/-- A product of `J` copies of `μ ⊗ ν` is the product of the `J`-fold products of `μ` and `ν`. -/\nlemma pi_prod_map_split {J : Type*} [Fintype J] {Y : Type*} [MeasurableSpace Y] (ν : Measure Y)\n    [IsProbabilityMeasure ν] :\n    (Measure.pi fun _ : J ↦ μ.prod ν).map (fun v ↦ (fun p ↦ (v p).1, fun p ↦ (v p).2))\n      = (Measure.pi fun _ : J ↦ μ).prod (Measure.pi fun _ : J ↦ ν)","proof":":=\n  (measurePreserving_arrowProdEquivProdArrow X Y J (fun _ ↦ μ) (fun _ ↦ ν)).map_eq","source":{"path":"Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean","start":53,"end":58,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean#L53-L58"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Fintype","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.pi","mathlib","definition"],["MeasureTheory.Measure.prod","mathlib","definition"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Eq","Fintype","MeasurableSpace","MeasurableSpace.pi","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.map","MeasureTheory.Measure.pi","MeasureTheory.Measure.prod","Prod","Prod.fst","Prod.instMeasurableSpace","Prod.mk","Prod.snd"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1678,"name":"MeasureTheory.Measure.pi_sigma_map_curry","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.InfinitePiWindow","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"e3cf71e77ffe2d5f","local":"8bc7647f9788030b","content":"440fa434be9d4e11"},"doc":"Currying a product indexed by a sigma type. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"X","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace X","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"Measure X","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"K","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype K","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":true,"name":"s","role":"type","type":"K → Type u_4","typeRefs":[]},{"explicit":false,"implicit":false,"name":"","role":"instance","type":"(k : K) → Fintype (s k)","typeRefs":[[10,17,"Fintype"]]}],"conclusion":"map Sigma.curry (Measure.pi fun x => μ) = Measure.pi fun k => Measure.pi fun x => μ","conclusionHead":"Eq","conclusionRefs":[[0,3,"MeasureTheory.Measure.map"],[4,15,"Sigma.curry"],[17,27,"MeasureTheory.Measure.pi"],[40,41,"Eq"],[42,52,"MeasureTheory.Measure.pi"],[62,72,"MeasureTheory.Measure.pi"]],"decl":"MeasureTheory.Measure.pi_sigma_map_curry"},"code":"/-- Currying a product indexed by a sigma type. -/\nlemma pi_sigma_map_curry {K : Type*} [Fintype K] {s : K → Type*} [∀ k, Fintype (s k)] :\n    (Measure.pi fun _ : (k : K) × s k ↦ μ).map Sigma.curry\n      = Measure.pi fun k : K ↦ Measure.pi fun _ : s k ↦ μ","proof":":= by\n  have h := infinitePi_map_piCurry (κ := s) (X := fun (k : K) (_ : s k) ↦ X)\n    (μ := fun (k : K) (_ : s k) ↦ μ)\n  rw [MeasurableEquiv.coe_piCurry, infinitePi_eq_pi] at h\n  rw [h]\n  simp_rw [infinitePi_eq_pi]","source":{"path":"Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean","start":60,"end":68,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean#L60-L68"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Fintype","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.pi","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.curry","mathlib","definition"],["Sigma.instFintype","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Eq","Fintype","MeasurableSpace","MeasurableSpace.pi","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.map","MeasureTheory.Measure.pi","Sigma","Sigma.curry","Sigma.instFintype"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1679,"name":"ProbabilityTheory.indepFun_prefix_window","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.InfinitePiWindow","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"44af32f6b10984b7","local":"99d6c8b223a26b8a","content":"30f3fe55c8d02d09"},"doc":"The first `T` coordinates of an i.i.d. sequence are independent of any finite family of\ncoordinates of index at least `T`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"X","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace X","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure X","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure μ","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"Nat","implicit":true,"name":"T","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":false,"implicit":true,"name":"J","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"Finite","implicit":false,"name":"","role":"instance","type":"Finite J","typeRefs":[[0,6,"Finite"]]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"J → ℕ","typeRefs":[[4,5,"Nat"]]},{"explicit":true,"implicit":false,"name":"hf","role":"hypothesis","type":"∀ (p : J), T ≤ f p","typeRefs":[[13,14,"LE.le"]]}],"conclusion":"IndepFun (fun ω t => ω ↑t) (fun ω p => ω (f p)) (MeasureTheory.Measure.infinitePi fun x => μ)","conclusionHead":"ProbabilityTheory.IndepFun","conclusionRefs":[[0,8,"ProbabilityTheory.IndepFun"],[49,81,"MeasureTheory.Measure.infinitePi"]],"decl":"ProbabilityTheory.indepFun_prefix_window"},"code":"/-- The first `T` coordinates of an i.i.d. sequence are independent of any finite family of\ncoordinates of index at least `T`. -/\nlemma indepFun_prefix_window {T : ℕ} {J : Type*} [Finite J] {f : J → ℕ} (hf : ∀ p, T ≤ f p) :\n    IndepFun (fun ω (t : Fin T) ↦ ω t) (fun ω (p : J) ↦ ω (f p))\n      (Measure.infinitePi fun _ : ℕ ↦ μ)","proof":":= by\n  classical\n  have := Fintype.ofFinite J\n  have hind := iIndepFun_infinitePi (P := fun _ : ℕ ↦ μ) (X := fun _ ↦ id) fun _ ↦ measurable_id\n  have hdisj : Disjoint (Finset.range T) (Finset.univ.image f) := by\n    rw [Finset.disjoint_left]\n    intro x hx hx'\n    obtain ⟨p, _, rfl⟩ := Finset.mem_image.1 hx'\n    exact absurd (Finset.mem_range.1 hx) (not_lt.2 (hf p))\n  have h := hind.indepFun_finset (Finset.range T) (Finset.univ.image f) hdisj\n    (fun i ↦ measurable_pi_apply i)\n  exact h.comp (Measurable.of_eval fun (t : Fin T) ↦\n      measurable_pi_apply (⟨(t : ℕ), Finset.mem_range.2 t.2⟩ : Finset.range T))\n    (Measurable.of_eval fun p ↦\n      measurable_pi_apply ⟨f p, Finset.mem_image_of_mem f (Finset.mem_univ p)⟩)","source":{"path":"Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean","start":96,"end":114,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean#L96-L114"},"deps":[],"outside":[],"external":[["Fin","lean4","structure"],["Fin.val","lean4","definition"],["Finite","mathlib","class"],["LE.le","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.infinitePi","mathlib","definition"],["Nat","lean4","inductive"],["ProbabilityTheory.IndepFun","mathlib","definition"],["instLENat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Fin","Fin.val","Finite","LE.le","MeasurableSpace","MeasurableSpace.pi","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.infinitePi","Nat","ProbabilityTheory.IndepFun","instLENat"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1680,"name":"MeasureTheory.Measure.infinitePi_map_eval_comp","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.InfinitePiWindow","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"f4f8724d15464ab3","local":"aece852d7229e02d","content":"12834e96ea8819f1"},"doc":"The joint law of finitely many distinct coordinates of an i.i.d. family is the finite product\nof the common law. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"X","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace X","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"Measure X","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"J","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype J","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"J → ι","typeRefs":[]},{"explicit":true,"head":"Function.Injective","implicit":false,"name":"hf","role":"hypothesis","type":"Function.Injective f","typeRefs":[[0,18,"Function.Injective"]]}],"conclusion":"map (fun ω p => ω (f p)) (infinitePi fun x => μ) = Measure.pi fun x => μ","conclusionHead":"Eq","conclusionRefs":[[0,3,"MeasureTheory.Measure.map"],[26,36,"MeasureTheory.Measure.infinitePi"],[49,50,"Eq"],[51,61,"MeasureTheory.Measure.pi"]],"decl":"MeasureTheory.Measure.infinitePi_map_eval_comp"},"code":"/-- The joint law of finitely many distinct coordinates of an i.i.d. family is the finite product\nof the common law. -/\nlemma infinitePi_map_eval_comp {J : Type*} [Fintype J] {f : J → ι} (hf : Function.Injective f) :\n    (infinitePi fun _ : ι ↦ μ).map (fun ω (p : J) ↦ ω (f p)) = Measure.pi fun _ : J ↦ μ","proof":":= by\n  classical\n  set I : Set ι := Set.range f with hI\n  have : Fintype I := Set.fintypeRange f\n  let e : J ≃ I := Equiv.ofInjective f hf\n  have h1 : (infinitePi fun _ : ι ↦ μ).map I.domRestrict = infinitePi fun _ : I ↦ μ :=\n    infinitePi_map_restrict' (μ := fun _ ↦ μ)\n  rw [infinitePi_eq_pi (μ := fun _ : I ↦ μ)] at h1\n  have h2 := (measurePreserving_piCongrLeft (μ := fun _ : I ↦ μ) e).symm.map_eq\n  have h3 : (fun (ω : ι → X) (p : J) ↦ ω (f p))\n      = (MeasurableEquiv.piCongrLeft (π := fun _ : I ↦ X) e).symm\n        ∘ (I.domRestrict : (ι → X) → (I → X)) := by\n    funext ω p\n    simp [MeasurableEquiv.piCongrLeft, Equiv.piCongrLeft_symm_apply, e, Set.domRestrict]\n    rfl\n  have hm : Measurable (I.domRestrict : (ι → X) → (I → X)) :=\n    Measurable.of_eval fun i ↦ measurable_pi_apply _\n  rw [h3, ← Measure.map_map (MeasurableEquiv.measurable _) hm, h1, h2]","source":{"path":"Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean","start":31,"end":51,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean#L31-L51"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Fintype","mathlib","class"],["Function.Injective","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.infinitePi","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.pi","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Eq","Fintype","Function.Injective","MeasurableSpace","MeasurableSpace.pi","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.infinitePi","MeasureTheory.Measure.map","MeasureTheory.Measure.pi"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1681,"name":"MeasureTheory.Measure.infinitePi_map_eval_comp'","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.Mathlib.Probability.InfinitePiWindow","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"8b8f12659b0a9e58","local":"80f3f1ed9ca4ad02","content":"7931c278c06dfe79"},"doc":"The coordinates of an i.i.d. sequence indexed by an injective family of indices form an\ni.i.d. sequence with the same law (version for an arbitrary nonempty index type). ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"X","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":false,"name":"","role":"instance","type":"MeasurableSpace X","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Measure","implicit":false,"name":"μ","role":"variable","type":"Measure X","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"J","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty J","typeRefs":[[0,8,"Nonempty"]]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"J → ι","typeRefs":[]},{"explicit":true,"head":"Function.Injective","implicit":false,"name":"hf","role":"hypothesis","type":"Function.Injective f","typeRefs":[[0,18,"Function.Injective"]]}],"conclusion":"map (fun ω p => ω (f p)) (infinitePi fun x => μ) = infinitePi fun x => μ","conclusionHead":"Eq","conclusionRefs":[[0,3,"MeasureTheory.Measure.map"],[26,36,"MeasureTheory.Measure.infinitePi"],[49,50,"Eq"],[51,61,"MeasureTheory.Measure.infinitePi"]],"decl":"MeasureTheory.Measure.infinitePi_map_eval_comp'"},"code":"/-- The coordinates of an i.i.d. sequence indexed by an injective family of indices form an\ni.i.d. sequence with the same law (version for an arbitrary nonempty index type). -/\ntheorem infinitePi_map_eval_comp' {J : Type*} [Nonempty J] {f : J → ι} (hf : Function.Injective f) :\n    (infinitePi fun _ : ι ↦ μ).map (fun ω (p : J) ↦ ω (f p)) = infinitePi fun _ : J ↦ μ","proof":":= by\n  have hm : Measurable fun ω : ι → X ↦ fun p : J ↦ ω (f p) :=\n    Measurable.of_eval fun p ↦ measurable_pi_apply _\n  refine Measure.eq_infinitePi _ fun s t ht ↦ ?_\n  rw [Measure.map_apply hm (MeasurableSet.pi s.countable_toSet fun i _ ↦ ht i)]\n  have hpre : (fun ω : ι → X ↦ fun p : J ↦ ω (f p)) ⁻¹' ((s : Set J).pi t)\n      = ((s.map ⟨f, hf⟩ : Finset ι) : Set ι).pi fun i ↦ t (Function.invFun f i) := by\n    ext ω\n    simp only [Set.mem_preimage, Set.mem_pi, Finset.coe_map, Function.Embedding.coeFn_mk,\n      Set.mem_image, Finset.mem_coe, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂,\n      Function.leftInverse_invFun hf _]\n  rw [hpre]\n  refine (Measure.infinitePi_pi (μ := fun _ : ι ↦ μ) (s := s.map ⟨f, hf⟩)\n    (t := fun i ↦ t (Function.invFun f i)) fun i _ ↦ ht _).trans ?_\n  rw [Finset.prod_map]\n  simp [Function.leftInverse_invFun hf _]","source":{"path":"Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean","start":70,"end":88,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/InfinitePiWindow.lean#L70-L88"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Function.Injective","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.infinitePi","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["Nonempty","lean4","class"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Eq","Function.Injective","MeasurableSpace","MeasurableSpace.pi","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.infinitePi","MeasureTheory.Measure.map","Nonempty"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}}]