[{"id":1212,"name":"Maiti2026Power.blockBallSet_le_budget_of_isFixedDesign_of_isPAC","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.Separation","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"ea57b87b7d2d760d","local":"6144373ab9b31649","content":"6daa05ecc589098e"},"doc":"**Theorem 7, non-adaptive lower bound**: a fixed-design (non-adaptive) identification\nalgorithm which is `(ε, δ)`-PAC on the block-ball set of `ℝ^{kd}`, with `ε ∈ (0, 1]` and\n`δ ≤ 1/10`, has budget `T ≥ k d² / (210 ε²)`. ","statement":{"binders":[{"explicit":true,"name":"k","role":"variable","type":"ℕ"},{"explicit":true,"name":"d","role":"variable","type":"ℕ"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hε","role":"hypothesis","type":"ε ∈ Set.Ioc 0 1"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"δ ∈ Set.Ioc 0 (1 / 10)"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":true,"name":"A","role":"variable","type":"Learning.IdentAlg Unit ↑(blockBallSet k d) ℝ ↑(blockBallSet k d)"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"hdes","role":"hypothesis","type":"A.IsFixedDesign"},{"explicit":true,"name":"hpac","role":"hypothesis","type":"Learning.LinearBandit.IsPAC (blockBallSet k d) A ε δ"}],"conclusion":"↑k * ↑d ^ 2 / (210 * ε ^ 2) ≤ ↑T","decl":"Maiti2026Power.blockBallSet_le_budget_of_isFixedDesign_of_isPAC"},"code":"/-- **Theorem 7, non-adaptive lower bound**: a fixed-design (non-adaptive) identification\nalgorithm which is `(ε, δ)`-PAC on the block-ball set of `ℝ^{kd}`, with `ε ∈ (0, 1]` and\n`δ ≤ 1/10`, has budget `T ≥ k d² / (210 ε²)`. -/\ntheorem blockBallSet_le_budget_of_isFixedDesign_of_isPAC (k d : ℕ) {ε δ : ℝ}\n    (hε : ε ∈ Set.Ioc 0 1) (hδ : δ ∈ Set.Ioc 0 (1 / 10)) {T : ℕ}\n    (A : IdentAlg Unit (blockBallSet k d) ℝ (blockBallSet k d)) (hA : A.IsFixedBudget T)\n    (hdes : A.IsFixedDesign)\n    (hpac : IsPAC (blockBallSet k d) A ε δ) :\n    k * (d : ℝ) ^ 2 / (210 * ε ^ 2) ≤ T","proof":":= by\n  rcases Nat.eq_zero_or_pos k with rfl | hk\n  · simp\n  rcases Nat.eq_zero_or_pos d with rfl | hd\n  · simp\n  have hε0 : 0 < ε := hε.1\n  obtain ⟨x, hx⟩ := hdes\n  -- pigeonhole: some block receives at most `T / k` rounds\n  obtain ⟨i, hi⟩ := exists_mul_card_blockRounds_le hk x T\n  -- the transported algorithm on the unit ball of `ℝ^d` is PAC\n  have hpac' := isPAC_fixedDesignTransport_blockProjBall hA hx hpac i\n  -- its design matrix is positive definite\n  set M := ∑ t : Fin T, outerSelf (blockDesign i x t : EuclideanSpace ℝ (Fin d)) with hM_def\n  have hS : M.PosDef :=\n    posDef_of_isFixedDesign_of_isPAC_of_zero_mem isCompact_unitBall span_unitBall\n      zero_mem_unitBall hε0 (hδ.2.trans_lt (by norm_num)) _ isFixedBudget_fixedDesignTransport\n      alg_fixedDesignTransport hpac'\n  -- the Bayesian step and the width of the unit ball\n  have hw := gwMat_le_of_isFixedDesign_of_isPAC isCompact_unitBall unitBall_nonempty hε0.le hδ _\n    isFixedBudget_fixedDesignTransport alg_fixedDesignTransport hpac' hS\n  have hlow := le_gwMat_unitBall hS\n  -- the trace of the design matrix is at most the number of rounds in block `i`\n  have htr : M.trace ≤ (blockRounds i x T).card := trace_sum_outerSelf_blockDesign_le i x\n  have htr0 : 0 < M.trace := by\n    have : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩\n    exact hS.trace_pos\n  have hcard : (0 : ℝ) < (blockRounds i x T).card := htr0.trans_le htr\n  -- arithmetic\n  set n : ℝ := ((blockRounds i x T).card : ℝ) with hn_def\n  set w := gwMat (unitBall (Fin d)) M with hw_def\n  have h1 : √(2 / π) * d / √n ≤ w := by\n    refine le_trans ?_ hlow\n    rw [Fintype.card_fin]\n    gcongr\n  have h2 : 0.12 * (√(2 / π) * d) ≤ ε * √n := by\n    have hn : 0 < √n := Real.sqrt_pos.2 hcard\n    rw [div_le_iff₀ hn] at h1\n    calc 0.12 * (√(2 / π) * d) ≤ 0.12 * (w * √n) := by gcongr\n      _ = (0.12 * w) * √n := by ring\n      _ ≤ ε * √n := by gcongr\n  have h3 : (0.12 * (√(2 / π) * d)) ^ 2 ≤ (ε * √n) ^ 2 := pow_le_pow_left₀ (by positivity) h2 2\n  simp only [mul_pow] at h3\n  rw [Real.sq_sqrt (by positivity), Real.sq_sqrt hcard.le] at h3\n  have hπ4 : 1 / 2 ≤ 2 / π := by\n    rw [div_le_div_iff₀ (by norm_num) Real.pi_pos]\n    have := Real.pi_le_four\n    linarith\n  have h4 : (d : ℝ) ^ 2 ≤ 210 * ε ^ 2 * n := by\n    have hd2 : 0 ≤ (d : ℝ) ^ 2 := sq_nonneg _\n    have h5 := mul_le_mul_of_nonneg_right hπ4 hd2\n    have h6 : 0 ≤ ε ^ 2 * n := by positivity\n    norm_num at h3\n    linarith\n  have h5 : (k : ℝ) * n ≤ T := by\n    rw [hn_def]\n    exact_mod_cast hi\n  rw [div_le_iff₀ (by positivity)]\n  calc (k : ℝ) * d ^ 2 ≤ k * (210 * ε ^ 2 * n) := by gcongr\n    _ = 210 * ε ^ 2 * (k * n) := by ring\n    _ ≤ 210 * ε ^ 2 * T := by gcongr\n    _ = T * (210 * ε ^ 2) := by ring","source":{"path":"Maiti2026Power/MXJ2026/Separation.lean","start":68,"end":136,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/Separation.lean#L68-L136"},"deps":[84,93,95,1222],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["BorelSpace.opensMeasurable","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.IdentAlg.alg","LeanMachineLearning","definition"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.detAlgorithm","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["PUnit.instMeasurableSpace","mathlib","instance"],["PiLp.borelSpace","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.instNorm","mathlib","instance"],["PiLp.normedAddCommGroup","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["Prod","lean4","structure"],["Prod.mk","lean4","constructor"],["PseudoEMetricSpace.toUniformSpace","mathlib","instance"],["PseudoMetricSpace.toPseudoEMetricSpace","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.borelSpace","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.norm","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Ioc","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"],["WithLp.measurableSpace","mathlib","instance"],["WithLp.ofLp","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["fact_one_le_two_ennreal","mathlib","instance"],["iSup","mathlib","definition"],["instCountableFin","mathlib","instance"],["instCountableProd","mathlib","instance"],["instFintypeProd","mathlib","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instSecondCountableTopologyReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":1213,"name":"Maiti2026Power.blockBallSet_le_budget_of_isPAC","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.Separation","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"4573c8af6bdc59a1","local":"4651725bd2c0f21b","content":"b11b86176df437bc"},"doc":"**Theorem 7, adaptive lower bound** (from Theorem 2): an identification algorithm which is\n`(ε, δ)`-PAC on the block-ball set of `ℝ^{kd}`, `kd ≥ 2`, with `δ < 1/16`, has budget\n`T ≥ kd log(1/δ) / (20000 ε²)`. ","statement":{"binders":[{"explicit":true,"name":"k","role":"variable","type":"ℕ"},{"explicit":true,"name":"d","role":"variable","type":"ℕ"},{"explicit":true,"name":"hkd","role":"hypothesis","type":"2 ≤ k * d"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hε","role":"hypothesis","type":"0 < ε"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"δ ∈ Set.Ioo 0 (1 / 16)"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":true,"name":"A","role":"variable","type":"Learning.IdentAlg Unit ↑(blockBallSet k d) ℝ ↑(blockBallSet k d)"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"hpac","role":"hypothesis","type":"Learning.LinearBandit.IsPAC (blockBallSet k d) A ε δ"}],"conclusion":"↑k * ↑d * Real.log (1 / δ) / (20000 * ε ^ 2) ≤ ↑T","decl":"Maiti2026Power.blockBallSet_le_budget_of_isPAC"},"code":"/-- **Theorem 7, adaptive lower bound** (from Theorem 2): an identification algorithm which is\n`(ε, δ)`-PAC on the block-ball set of `ℝ^{kd}`, `kd ≥ 2`, with `δ < 1/16`, has budget\n`T ≥ kd log(1/δ) / (20000 ε²)`. -/\ntheorem blockBallSet_le_budget_of_isPAC (k d : ℕ) (hkd : 2 ≤ k * d) {ε δ : ℝ} (hε : 0 < ε)\n    (hδ : δ ∈ Set.Ioo 0 (1 / 16)) {T : ℕ}\n    (A : IdentAlg Unit (blockBallSet k d) ℝ (blockBallSet k d)) (hA : A.IsFixedBudget T)\n    (hpac : IsPAC (blockBallSet k d) A ε δ) :\n    k * d * log (1 / δ) / (20000 * ε ^ 2) ≤ T","proof":":= by\n  have hcard : Fintype.card (Fin k × Fin d) = k * d := by simp [Fintype.card_prod]\n  have := le_budget_of_isPAC (blockBallSet k d) isCompact_blockBallSet span_blockBallSet\n    (hcard ▸ hkd) hε hδ A hA hpac\n  rw [hcard] at this\n  push_cast at this\n  exact this","source":{"path":"Maiti2026Power/MXJ2026/Separation.lean","start":138,"end":151,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/Separation.lean#L138-L151"},"deps":[93,95,1222],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["BorelSpace.opensMeasurable","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["PUnit.instMeasurableSpace","mathlib","instance"],["PiLp.borelSpace","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.instNorm","mathlib","instance"],["PiLp.normedAddCommGroup","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["Prod","lean4","structure"],["Prod.mk","lean4","constructor"],["PseudoEMetricSpace.toUniformSpace","mathlib","instance"],["PseudoMetricSpace.toPseudoEMetricSpace","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.borelSpace","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.log","mathlib","definition"],["Real.measurableSpace","mathlib","instance"],["Real.norm","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Ioo","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"],["WithLp.measurableSpace","mathlib","instance"],["WithLp.ofLp","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["fact_one_le_two_ennreal","mathlib","instance"],["iSup","mathlib","definition"],["instCountableFin","mathlib","instance"],["instCountableProd","mathlib","instance"],["instFintypeProd","mathlib","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instLENat","lean4","instance"],["instMulNat","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instSecondCountableTopologyReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":1214,"name":"Maiti2026Power.exists_isPAC_blockBallSet","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.MXJ2026.Separation","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"96d3ca9962ad0b06","local":"905463271d6fad3f","content":"76ff7bcc06f70172"},"doc":"**Theorem 7, adaptive upper bound**: for `k ≥ 1`, `ε ∈ (0, 1]` and `δ ∈ (0, 1)`, there is an\n(adaptive) `(ε, δ)`-PAC identification algorithm on the block-ball set of `ℝ^{kd}` with budget\n`T ≤ 2·10⁶ (kd log(8k/δ) + d²) / ε²`. ","statement":{"binders":[{"explicit":true,"name":"k","role":"variable","type":"ℕ"},{"explicit":true,"name":"d","role":"variable","type":"ℕ"},{"explicit":true,"name":"hk","role":"hypothesis","type":"1 ≤ k"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hε","role":"hypothesis","type":"ε ∈ Set.Ioc 0 1"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"δ ∈ Set.Ioo 0 1"}],"conclusion":"∃ T,\n  ↑T ≤ 2000000 * (↑k * ↑d * Real.log (8 * ↑k / δ) + ↑d ^ 2) / ε ^ 2 ∧\n    ∃ A, A.IsFixedBudget T ∧ Learning.LinearBandit.IsPAC (blockBallSet k d) A ε δ","decl":"Maiti2026Power.exists_isPAC_blockBallSet"},"code":"/-- **Theorem 7, adaptive upper bound**: for `k ≥ 1`, `ε ∈ (0, 1]` and `δ ∈ (0, 1)`, there is an\n(adaptive) `(ε, δ)`-PAC identification algorithm on the block-ball set of `ℝ^{kd}` with budget\n`T ≤ 2·10⁶ (kd log(8k/δ) + d²) / ε²`. -/\ntheorem exists_isPAC_blockBallSet (k d : ℕ) (hk : 1 ≤ k) {ε δ : ℝ} (hε : ε ∈ Set.Ioc 0 1)\n    (hδ : δ ∈ Set.Ioo 0 1) :\n    ∃ T : ℕ, (T : ℝ) ≤ 2000000 * (k * d * log (8 * k / δ) + (d : ℝ) ^ 2) / ε ^ 2 ∧\n      ∃ A : IdentAlg Unit (blockBallSet k d) ℝ (blockBallSet k d), A.IsFixedBudget T ∧\n        IsPAC (blockBallSet k d) A ε δ","proof":":= by\n  classical\n  have : Nonempty (blockBallSet k d) := (blockBallSet_nonempty ⟨0, hk⟩).to_subtype\n  let Q : BlockParam := ⟨k, hk, ε, δ, hε, hδ⟩\n  have hbad : ∀ θ : EuclideanSpace ℝ (Fin k × Fin d),\n      MeasurableSet {x : blockBallSet k d | ε < simpleRegret (blockBallSet k d) θ x} := fun θ ↦\n    measurableSet_lt measurable_const (measurable_simpleRegret _ θ)\n  rcases Nat.eq_zero_or_pos d with rfl | hd\n  · -- degenerate case `d = 0`: every reward vector is `0` and every recommendation is optimal\n    refine ⟨0, by simp, IdentAlg.fixedBudget (Q.alg 0).toAlgorithm 0\n      (Kernel.deterministic (fun _ ↦ Q.zeroBB 0) measurable_const),\n      IdentAlg.isFixedBudget_fixedBudget _ _ _, ?_⟩\n    refine SeededAlg.linearBandit_isPAC_fixedBudget_deterministic (Q.alg 0) measurable_const hbad\n      fun θ ↦ ?_\n    have hθ : θ = 0 := by\n      ext p\n      exact isEmptyElim p\n    have hempty : {ω : ℕ → (Fin 0 → Bool) × ℝ |\n        ε < simpleRegret (blockBallSet k 0) θ (Q.zeroBB 0)} = ∅ :=\n      Set.eq_empty_of_forall_notMem fun ω hω ↦\n        absurd (show ε < simpleRegret (blockBallSet k 0) θ (Q.zeroBB 0) from hω)\n          (not_lt.2 (by simp [simpleRegret, hθ, hε.1.le]))\n    rw [hempty, measureReal_empty]\n    exact hδ.1.le\n  · refine ⟨Q.T d, Q.T_le hd, IdentAlg.fixedBudget (Q.alg d).toAlgorithm (Q.T d)\n      (Kernel.deterministic (Q.output d) Q.measurable_output),\n      IdentAlg.isFixedBudget_fixedBudget _ _ _, ?_⟩\n    exact SeededAlg.linearBandit_isPAC_fixedBudget_deterministic (Q.alg d) Q.measurable_output\n      hbad fun θ ↦ measureReal_lt_le_of_one_sub_le_measureReal_le\n        ((measurable_simpleRegret _ θ).comp (Q.measurable_output.comp\n          (SeededAlg.measurable_seedFinHist (by fun_prop) _)))\n        (Q.one_sub_le_seedMeasure_real_output hd θ)","source":{"path":"Maiti2026Power/MXJ2026/Separation.lean","start":153,"end":191,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/Separation.lean#L153-L191"},"deps":[93,95,1222],"outside":[],"external":[["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["BorelSpace.opensMeasurable","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","math