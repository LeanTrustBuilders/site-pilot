false,"name":"","role":"instance","type":"DecidableEq ι","typeRefs":[[0,11,"DecidableEq"]]},{"explicit":false,"head":"Set","implicit":true,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)","typeRefs":[[0,3,"Set"],[5,19,"EuclideanSpace"],[20,21,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"R","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Set.Nonempty","implicit":false,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty","typeRefs":[[2,10,"Set.Nonempty"]]},{"explicit":true,"implicit":false,"name":"hR","role":"hypothesis","type":"∀ x ∈ 𝒳, ‖x‖ ≤ R","typeRefs":[[9,10,"Norm.norm"],[11,12,"Norm.norm"],[13,14,"LE.le"]]},{"explicit":false,"head":"Nat","implicit":true,"name":"T","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hT","role":"hypothesis","type":"0 < T","typeRefs":[[2,3,"LT.lt"]]},{"explicit":false,"implicit":true,"name":"x","role":"variable","type":"Fin T → EuclideanSpace ℝ ι","typeRefs":[[0,3,"Fin"],[8,22,"EuclideanSpace"],[23,24,"Real"]]},{"explicit":true,"implicit":false,"name":"hx","role":"hypothesis","type":"∀ (t : Fin T), x t ∈ 𝒳","typeRefs":[[7,10,"Fin"],[19,20,"Membership.mem"]]},{"explicit":true,"head":"Matrix.PosDef","implicit":false,"name":"hS","role":"hypothesis","type":"(∑ t, outerSelf (x t)).PosDef","typeRefs":[[6,15,"Maiti2026Power.outerSelf"],[23,29,"Matrix.PosDef"]]}],"conclusion":"gw 𝒳 ≤ √↑T * gwMat 𝒳 (∑ t, outerSelf (x t))","conclusionHead":"LE.le","conclusionRefs":[[0,2,"Maiti2026Power.gw"],[5,6,"LE.le"],[7,8,"Real.sqrt"],[11,12,"HMul.hMul"],[13,18,"Maiti2026Power.gwMat"],[27,36,"Maiti2026Power.outerSelf"]],"decl":"Maiti2026Power.gw_le_sqrt_mul_gwMat_sum"},"code":"/-- The width of an empirical design of `T` points of `𝒳` is at least `gw 𝒳 / √T`. -/\nlemma gw_le_sqrt_mul_gwMat_sum (hne : 𝒳.Nonempty) (hR : ∀ x ∈ 𝒳, ‖x‖ ≤ R) {T : ℕ} (hT : 0 < T)\n    {x : Fin T → EuclideanSpace ℝ ι} (hx : ∀ t, x t ∈ 𝒳) (hS : (∑ t, outerSelf (x t)).PosDef) :\n    gw 𝒳 ≤ √T * gwMat 𝒳 (∑ t, outerSelf (x t))","proof":":= by\n  have hTpos : (0 : ℝ) < T := by exact_mod_cast hT\n  set A := (T : ℝ)⁻¹ • ∑ t, outerSelf (x t) with hA\n  have hAmem : A ∈ designSet 𝒳 := inv_smul_sum_outerSelf_mem_designSet hT hx\n  have hApd : A.PosDef := hS.smul (inv_pos.2 hTpos)\n  have hSA : ∑ t, outerSelf (x t) = (T : ℝ) • A := by\n    rw [hA, smul_smul, mul_inv_cancel₀ hTpos.ne', one_smul]\n  rw [hSA, gwMat_smul hne hR hApd hTpos, ← mul_assoc,\n    mul_inv_cancel₀ (Real.sqrt_pos.2 hTpos).ne', one_mul]\n  exact gw_le_gwMat hne hR hAmem hApd","source":{"path":"Maiti2026Power/MXJ2026/WidthDesign.lean","start":33,"end":45,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthDesign.lean#L33-L45"},"deps":[1083,1249,1254],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["ChainCompletePartialOrder.instOfCompleteLattice","mathlib","instance"],["ChainCompletePartialOrder.toPartialOrder","mathlib","instance"],["ClosureOperator","mathlib","structure"],["ClosureOperator.instFunLike","mathlib","instance"],["CompleteAtomicBooleanAlgebra.toCompleteBooleanAlgebra","mathlib","instance"],["CompleteBooleanAlgebra.toCompleteLattice","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["EuclideanSpace","mathlib","definition"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HMul.hMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instanc