.toNonUnitalNormedCommRing","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["NormedField.toField","mathlib","instance"],["NormedField.toNormedCommRing","mathlib","instance"],["NormedSpace.toIsBoundedSMul","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PartialOrder.toPreorder","mathlib","instance"],["Pi.Function.module","mathlib","instance"],["Pi.addCommGroup","mathlib","instance"],["Pi.distribMulAction","mathlib","instance"],["PiLp.completeSpace","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.instIsBoundedSMul","mathlib","instance"],["PiLp.instNorm","mathlib","instance"],["PiLp.instPseudoMetricSpace","mathlib","instance"],["PiLp.normedAddCommGroup","mathlib","instance"],["PiLp.seminormedAddCommGroup","mathlib","instance"],["PiLp.topologicalSpace","mathlib","instance"],["PiLp.uniformSpace","mathlib","instance"],["ProbabilityTheory.multivariateGaussian","mathlib","definition"],["PseudoEMetricSpace.toUniformSpace","mathlib","instance"],["PseudoMetricSpace.toPseudoEMetricSpace","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.innerProductSpace","mathlib","instance"],["RCLike.toCompleteSpace","mathlib","instance"],["RCLike.toDenselyNormedField","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["RCLike.toStarRing","mathlib","instance"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instInfSet","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.norm","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.semiring","mathlib","instance"],["Ring.toAddCommGroup","mathlib","instance"],["Ring.toSemiring","mathlib","instance"],["RingHom.id","mathlib","definition"],["SMulZeroClass.toSMul","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SemigroupAction.toSMul","mathlib","instance"],["SeminormedAddCommGroup.toIsTopologicalAddGroup","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["SeminormedCommRing.toSeminormedRing","mathlib","instance"],["SeminormedRing.toPseudoMetricSpace","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["Semiring.toMonoid","mathlib","instance"],["Semiring.toNonAssocSemiring","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Nonempty","mathlib","definition"],["Set.image","mathlib","definition"],["Set.instCompleteAtomicBooleanAlgebra","mathlib","instance"],["Set.instMembership","mathlib","instance"],["StarAddMonoid.toInvolutiveStar","mathlib","instance"],["StarAlgEquiv","mathlib","structure"],["StarAlgEquiv.instFunLike","mathlib","instance"],["StarRing.toStarAddMonoid","mathlib","instance"],["SubNegMonoid.toAddMonoid","mathlib","instance"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["Subtype","lean4","structure"],["Subtype.val","lean4","definition"],["UniformContinuousConstSMul.instContinuousConstSMul","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.instDistribMulAction","mathlib","instance"],["WithLp.instModule","mathlib","instance"],["WithLp.instSMulCommClass","mathlib","instance"],["WithLp.measurableSpace","mathlib","instance"],["WithLp.ofLp","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["convexHull","mathlib","definition"],["fact_one_le_two_ennreal","mathlib","instance"],["iInf","mathlib","definition"],["iSup","mathlib","definition"],["instDistribOfSemiring","mathlib","instance"],["instMulZeroClassOfSemiring","mathlib","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instSMulOfMul","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1271,"name":"Maiti2026Power.gw_le_sqrt_mul_gwMat_sum","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.WidthDesign","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"2e559dd1226f4859","local":"adc732cea3b8159e","content":"7519a884db5f93e3"},"doc":"The width of an empirical design of `T` points of `𝒳` is at least `gw 𝒳 / √T`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":true,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ 𝒳, ‖x‖ ≤ R"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":true,"name":"hT","role":"hypothesis","type":"0 < T"},{"explicit":false,"name":"x","role":"variable","type":"Fin T → EuclideanSpace ℝ ι"},{"explicit":true,"name":"hx","role":"hypothesis","type":"∀ (t : Fin T), x t ∈ 𝒳"},{"explicit":true,"name":"hS","role":"hypothesis","type":"(∑ t, outerSelf (x t)).PosDef"}],"conclusion":"gw 𝒳 ≤ √↑T * gwMat 𝒳 (∑ t, outerSelf (x t))","decl":"Maiti2026Power.gw_le_sqrt_mul_gwMat_sum"},"code":"/-- The width of an empirical design of `T` points of `𝒳` is at least `gw 𝒳 / √T`. -/\nlemma gw_le_sqrt_mul_gwMat_sum (hne : 𝒳.Nonempty) (hR : ∀ x ∈ 𝒳, ‖x‖ ≤ R) {T : ℕ} (hT : 0 < T)\n    {x : Fin T → EuclideanSpace ℝ ι} (hx : ∀ t, x t ∈ 𝒳) (hS : (∑ t, outerSelf (x t)).PosDef) :\n    gw 𝒳 ≤ √T * gwMat 𝒳 (∑ t, outerSelf (x t))","proof":":= by\n  have hTpos : (0 : ℝ) < T := by exact_mod_cast hT\n  set A := (T : ℝ)⁻¹ • ∑ t, outerSelf (x t) with hA\n  have hAmem : A ∈ designSet 𝒳 := inv_smul_sum_outerSelf_mem_designSet hT hx\n  have hApd : A.PosDef := hS.smul (inv_pos.2 hTpos)\n  have hSA : ∑ t, outerSelf (x t) = (T : ℝ) • A := by\n    rw [hA, smul_smul, mul_inv_cancel₀ hTpos.ne', one_smul]\n  rw [hSA, gwMat_smul hne hR hApd hTpos, ← mul_assoc,\n    mul_inv_cancel₀ (Real.sqrt_pos.2 hTpos).ne', one_mul]\n  exact gw_le_gwMat hne hR hAmem hApd","source":{"path":"Maiti2026Power/MXJ2026/WidthDesign.lean","start":33,"end":45,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthDesign.lean#L33-L45"},"deps":[1083,1249,1254],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["ChainCompletePartialOrder.instOfCompleteLattice","mathlib","instance"],["ChainCompletePartialOrder.toPartialOrder","mathlib","instance"],["ClosureOperator","mathlib","structure"],["ClosureOperator.instFunLike","mathlib","instance"],["CompleteAtomicBooleanAlgebra.toCompleteBooleanAlgebra","mathlib","instance"],["CompleteBooleanAlgebra.toCompleteLattice","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["EuclideanSpace","mathlib","definition"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HMul.hMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["Inv.inv","lean4","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.PosDef","mathlib","definition"],["Matrix.addCommMonoid","mathlib","instance"],["Matrix.inv","mathlib","instance"],["Matrix.module","mathlib","instance"],["Matrix.vecMulVec","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.integral","mathlib","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["NegZeroClass.toZero","mathlib","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PartialOrder.toPreorder","mathlib","instance"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.instNorm","mathlib","instance"],["PiLp.normedAddCommGroup","mathlib","instance"],["ProbabilityTheory.multivariateGaussian","mathlib","definition"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.commRing","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instInfSet","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","ma