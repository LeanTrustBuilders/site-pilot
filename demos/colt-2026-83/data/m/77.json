[{"id":1270,"name":"Maiti2026Power.gw_image","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.WidthDesign","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"02fa4a49c78b9e78","local":"4440983a368b9a0c","content":"efc7474373b436a5"},"doc":"Invariance of the Gaussian width term under invertible linear maps:\n`gw (M '' 𝒳) = gw 𝒳` (for a set admitting a positive definite design matrix, e.g. a spanning\nset). ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":true,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ 𝒳, ‖x‖ ≤ R"},{"explicit":true,"name":"hex","role":"hypothesis","type":"∃ A ∈ designSet 𝒳, A.PosDef"},{"explicit":false,"name":"M","role":"variable","type":"Matrix ι ι ℝ"},{"explicit":true,"name":"hM","role":"hypothesis","type":"IsUnit M"}],"conclusion":"gw (⇑(Matrix.toEuclideanCLM M) '' 𝒳) = gw 𝒳","decl":"Maiti2026Power.gw_image"},"code":"/-- Invariance of the Gaussian width term under invertible linear maps:\n`gw (M '' 𝒳) = gw 𝒳` (for a set admitting a positive definite design matrix, e.g. a spanning\nset). -/\nlemma gw_image (hne : 𝒳.Nonempty) (hR : ∀ x ∈ 𝒳, ‖x‖ ≤ R) (hex : ∃ A ∈ designSet 𝒳, A.PosDef)\n    {M : Matrix ι ι ℝ} (hM : IsUnit M) :\n    gw (Matrix.toEuclideanCLM (𝕜 := ℝ) M '' 𝒳) = gw 𝒳","proof":":= by\n  set L := Matrix.toEuclideanCLM (𝕜 := ℝ) M with hL\n  have hdet : IsUnit M.det := (Matrix.isUnit_iff_isUnit_det M).1 hM\n  have hne' : (L '' 𝒳).Nonempty := hne.image L\n  have hR' : ∀ y ∈ L '' 𝒳, ‖y‖ ≤ ‖L‖ * R := by\n    rintro _ ⟨x, hx, rfl⟩\n    exact (L.le_opNorm x).trans (mul_le_mul_of_nonneg_left (hR x hx) (norm_nonneg _))\n  have himg : designSet (L '' 𝒳) = (fun A ↦ M * A * Mᵀ) '' designSet 𝒳 :=\n    designSet_image_toEuclideanCLM M\n  have hpd : ∀ {A : Matrix ι ι ℝ}, A.PosDef → (M * A * Mᵀ).PosDef := fun hA ↦ by\n    simpa [Matrix.conjTranspose_eq_transpose_of_trivial] using\n      hA.mul_mul_conjTranspose_same (Matrix.vecMul_injective_iff_isUnit.2 hM)\n  have hpd' : ∀ {A : Matrix ι ι ℝ}, (M * A * Mᵀ).PosDef → A.PosDef := fun {A} hB ↦ by\n    have hMinv : IsUnit M⁻¹ := Matrix.isUnit_nonsing_inv_iff.2 hM\n    have h := hB.mul_mul_conjTranspose_same (Matrix.vecMul_injective_iff_isUnit.2 hMinv)\n    rw [Matrix.conjTranspose_eq_transpose_of_trivial, ← Matrix.mul_assoc, ← Matrix.mul_assoc,\n      Matrix.nonsing_inv_mul _ hdet, one_mul, Matrix.mul_assoc, ← Matrix.transpose_mul,\n      Matrix.nonsing_inv_mul _ hdet, Matrix.transpose_one, mul_one] at h\n    exact h\n  refine le_antisymm ?_ ?_\n  · refine le_gw hex fun A hA hApd ↦ ?_\n    rw [← gwMat_image hne hR hApd hdet]\n    exact gw_le_gwMat hne' hR' (by rw [himg]; exact ⟨A, hA, rfl⟩) (hpd hApd)\n  · obtain ⟨A₀, hA₀, hA₀'⟩ := hex\n    refine le_gw ⟨M * A₀ * Mᵀ, by rw [himg]; exact ⟨A₀, hA₀, rfl⟩, hpd hA₀'⟩ fun B hB hBpd ↦ ?_\n    rw [himg] at hB\n    obtain ⟨A, hA, rfl⟩ := hB\n    rw [gwMat_image hne hR (hpd' hBpd) hdet]\n    exact gw_le_gwMat hne hR hA (hpd' hBpd)","source":{"path":"Maiti2026Power/MXJ2026/WidthDesign.lean","start":47,"end":80,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/WidthDesign.lean#L47-L80"},"deps":[1249,1258],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoid.toAddMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib",