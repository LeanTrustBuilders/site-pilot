4,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/IdentAlg.lean#L120-L124"},"deps":[93],"outside":[],"external":[["ENat","mathlib","definition"],["Eq","lean4","inductive"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.IdentAlg.stoppingTime","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["Nat","lean4","inductive"],["Ne","lean4","definition"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Top.top","mathlib","definition"],["instTopENat","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":88,"name":"Learning.IdentAlg.fixedBudget","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.IdentAlg","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"73ab6884f98274f1","local":"7fcd11175b444c0c","content":"07ea4de162b75a21"},"doc":"The fixed-budget identification algorithm with sampling rule `alg`, budget `T` and output\nkernel `ρ` on histories of length `T` (the output rule on histories of other lengths, never used,\nis an arbitrary constant). ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"","role":"instance","type":"Nonempty 𝓓"},{"explicit":true,"name":"alg","role":"variable","type":"Algorithm 𝓞 𝓐 𝓨"},{"explicit":true,"name":"T","role":"variable","type":"ℕ"},{"explicit":true,"name":"ρ","role":"variable","type":"ProbabilityTheory.Kernel (Hist 𝓞 𝓐 𝓨 T) 𝓓"},{"explicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel ρ"}],"conclusion":"IdentAlg 𝓞 𝓐 𝓨 𝓓","decl":"Learning.IdentAlg.fixedBudget","value":"{ alg := alg, stopSet := {h | h.fst = T}, measurableSet_stopSet := ⋯,\n  output :=\n    ProbabilityTheory.Kernel.sigma fun n =>\n      if h : n = T then ρ.comap (fun x i => x (Fin.cast ⋯ i)) ⋯\n      else\n        ProbabilityTheory.Kernel.const (Hist 𝓞 𝓐 𝓨 n)\n          (MeasureTheory.Measure.dirac (Classical.arbitrary 𝓓)),\n  isMarkovKernel_output := ⋯ }"},"code":"/-- The fixed-budget identification algorithm with sampling rule `alg`, budget `T` and output\nkernel `ρ` on histories of length `T` (the output rule on histories of other lengths, never used,\nis an arbitrary constant). -/\nnoncomputable def fixedBudget [Nonempty 𝓓] (alg : Algorithm 𝓞 𝓐 𝓨) (T : ℕ)\n    (ρ : Kernel (Hist 𝓞 𝓐 𝓨 T) 𝓓) [IsMarkovKernel ρ] : IdentAlg 𝓞 𝓐 𝓨 𝓓 where\n  alg := alg\n  stopSet := {h | h.1 = T}\n  measurableSet_stopSet := measurable_sigma_fst (measurableSet_singleton T)\n  output := Kernel.sigma fun n ↦\n    if h : n = T then ρ.comap (fun (x : Hist 𝓞 𝓐 𝓨 n) i ↦ x (Fin.cast h.symm i)) (by fun_prop)\n    else Kernel.const _ (Measure.dirac (Classical.arbitrary 𝓓))\n  isMarkovKernel_output := by\n    have : ∀ n, IsMarkovKernel (if h : n = T then\n        ρ.comap (fun (x : Hist 𝓞 𝓐 𝓨 n) i ↦ x (Fin.cast h.symm i)) (by fun_prop)\n        else Kernel.const _ (Measure.dirac (Classical.arbitrary 𝓓))) := fun n ↦ by\n      by_cases h : n = T <;> simp only [h, ↓reduceDIte] <;> i