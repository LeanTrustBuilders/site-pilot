,"isProp":true,"hashes":{"meaning":"aa714621001e768f","local":"cbc9a0a5fa57929b","content":"5e741c97f4e2b486"},"doc":"The stopping time of a fixed-budget algorithm with budget `T` is `T`. ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_5"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → 𝓞"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"ω","role":"variable","type":"Ω"}],"conclusion":"A.stoppingTime O X Y ω = ↑T","decl":"Learning.IdentAlg.IsFixedBudget.stoppingTime_eq"},"code":"/-- The stopping time of a fixed-budget algorithm with budget `T` is `T`. -/\nlemma IsFixedBudget.stoppingTime_eq (hA : A.IsFixedBudget T) (ω : Ω) :\n    A.stoppingTime O X Y ω = T","proof":":= by\n  refine hittingAfter_sigmaHistory_eq_coe_iff.2 ⟨?_, fun j hj hjS ↦ ?_⟩\n  · rw [hA]\n    rfl\n  · rw [hA] at hjS\n    exact hj.ne hjS","source":{"path":"Maiti2026Power/LeanMachineLearning/IdentAlg.lean","start":105,"end":112,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/IdentAlg.lean#L105-L112"},"deps":[93]