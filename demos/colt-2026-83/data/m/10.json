n"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Sigma.mk","lean4","constructor"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":93,"name":"Learning.IdentAlg.IsFixedBudget","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.IdentAlg","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"e05b16da024f78f3","local":"05099c9d1cdc1e3f","content":"a9dc3c308193aa5a"},"doc":"`A` is a *fixed-budget* algorithm with budget `T` if its stopping rule is \"stop after exactly\n`T` rounds\". ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":true,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓"},{"explicit":true,"name":"T","role":"variable","type":"ℕ"}],"conclusion":"Prop","decl":"Learning.IdentAlg.IsFixedBudget","value":"A.stopSet = {h | h.fst = T}"},"code":"/-- `A` is a *fixed-budget* algorithm with budget `T` if its stopping rule is \"stop after exactly\n`T` rounds\". -/\ndef IsFixedBudget (A : IdentAlg 𝓞 𝓐 𝓨 𝓓) (T : ℕ) : Prop := A.stopSet = {h | h.1 = T}","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/IdentAlg.lean","start":60,"end":62,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/IdentAlg.lean#L60-L62"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["Nat","lean4","inductive"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"]],"users":[1,4,33,34,35,36,37,38,45,61,65,83,87,89,90,91,92,94,211,250,255,351,352,353,354,355,356,358,419,588,643,644,645,646,647,648,651,652,702,715,716,718,719,721,722,723,724,1039,1212,1213,1214,1215,1236],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":94,"name":"Learning.IdentAlg.IsRun.map_out_eq_of_isFixedBudget_zero","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.IdentAlg","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"146d8e1b0b03d1c2","local":"5c4849507d68a98a","content":"31917888dffd506c"},"doc":"For a run of a fixed-budget algorithm with budget `0`, the law of the output is the output\nrule applied to the empty history. ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_5"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → 𝓞"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"env","role":"variable","type":"Environment 𝓞 𝓐 𝓨"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget 0"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun env O X Y out P"}],"conclusion":"MeasureTheory.Measure.map out P = A.output ⟨0, Fin.elim0⟩","decl":"Learning.IdentAlg.IsRun.map_out_eq_of_isFixedBudget_zero"},"code":"/-- For a run of a fixed-budget algorithm with budget `0`, the law of the output is the output\nrule applied to the empty history. -/\nlemma IsRun.map_out_eq_of_isFixedBudget_zero (hA : A.IsFixedBudget 0)\n    (h : A.IsRun env O X Y out P) :\n    P.map out = A.output ⟨0, Fin.elim0⟩","proof":":= by\n  have hout : AEMeasurable out P := h.hasCondDistrib_output.aemeasurable_snd\n  have hsh : A.stoppedHist O X Y = fun _ ↦ (⟨0, Fin.elim0⟩ : Σ n, Hist 𝓞 𝓐 𝓨 n) := by\n    funext ω\n    rw [hA.stoppedHist_eq]\n    congr\n    exact Subsingleton.elim _ _\n  have hjoint := h.hasCondDistrib_output.map_eq\n  rw [hsh, Measure.map_const, measure_univ, one_smul] at hjoint\n  calc P.map out\n      = (P.map fun ω ↦ ((⟨0, Fin.elim0⟩ : Σ n, Hist 𝓞 𝓐 𝓨 n), out ω)).map Prod.snd := by\n        rw [AEMeasurable.map_map_of_aemeasurable measurable_snd.aemeasurable\n          (aemeasurable_const.prodMk hout)]\n        rfl\n    _ = (Measure.dirac (⟨0, Fin.elim0⟩ : Σ n, Hist 𝓞 𝓐 𝓨 n) ⊗ₘ A.output).map Prod.snd := by\n        rw [hjoint]\n    _ = A.output ⟨0, Fin.elim0⟩ := by\n        ext s hs\n        rw [Measure.map_apply measurable_snd hs, Measure.compProd_apply (measurable_snd hs),\n          lintegral_dirac' _ (Kernel.measurable_kernel_prodMk_left (measurable_snd hs))]\n        rfl","source":{"path":"Maiti2026Power/LeanMachineLearning/IdentAlg.lean","start":152,"end":176,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/IdentAlg.lean#L152-L176"},"deps":[93],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["Fin","lean4","structure"],["Fin.elim0","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.IdentAlg.output","LeanMachineLearning","definition"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.instFunLike","mathlib","instance"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Sigma.instMeasurableSpace","mathlib","instance"],["Sigma.mk","lean4","constructor"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}}]