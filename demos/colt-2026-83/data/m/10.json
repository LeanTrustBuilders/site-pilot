c":"For a fixed-budget algorithm whose output rule on histories of length `T` is the\ndeterministic map `g` of the history, the output of a run is `g` of the history of the first `T`\nrounds, almost surely. ","statement":{"binders":[{"explicit":false,"name":"𝓞","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓞","role":"instance","type":"MeasurableSpace 𝓞"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_5"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → 𝓞"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"env","role":"variable","type":"Environment 𝓞 𝓐 𝓨"},{"explicit":false,"name":"","role":"instance","type":"MeasurableEq 𝓓"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun env O X Y out P"},{"explicit":false,"name":"g","role":"variable","type":"Hist 𝓞 𝓐 𝓨 T → 𝓓"},{"explicit":true,"name":"hg","role":"hypothesis","type":"Measurable g"},{"explicit":true,"name":"hout","role":"hypothesis","type":"A.output.comap (Sigma.mk T) ⋯ = ProbabilityTheory.Kernel.deterministic g hg"}],"conclusion":"out =ᵐ[P] fun ω => g (history O X Y T ω)","decl":"Learning.IdentAlg.IsRun.output_ae_eq_of_output_eq_deterministic"},"code":"/-- For a fixed-budget algorithm whose output rule on histories of length `T` is the\ndeterministic map `g` of the history, the output of a run is `g` of the history of the first `T`\nrounds, almost surely. -/\nlemma IsRun.output_ae_eq_of_output_eq_deterministic [MeasurableEq 𝓓] (hA : A.IsFixedBudget T)\n    (h : A.IsRun env O X Y out P) {g : Hist 𝓞 𝓐 𝓨 T → 𝓓} (hg : Measurable g)\n    (hout : A.output.comap (Sigma.mk T) (measurable_sigma_mk T) = Kernel.deterministic g hg) :\n    out =ᵐ[P] fun ω ↦ g (history O X Y T ω)","proof":":= by\n  have h1 := h.hasCondDistrib_output_history hA\n  rw [hout] at h1\n  exact ae_eq_of_hasCondDistrib_deterministic hg (h.isAlgEnvSeq.measurable_history T).aemeasurable\n    h.hasCondDistrib_output.aemeasurable_snd h1","source":{"path":"Maiti2026Power/LeanMachineLearning/IdentAlg.lean","start":140,"end":150,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/IdentAlg.lean#L140-L150"},"deps":[93],"outside":[],"external":[["Eq","lean4","inductive"],["Filter.EventuallyEq","mathlib","definition"],["Fin","lean4","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.IdentAlg.output","LeanMachineLearning","definition"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["Measurable","mathlib","definition"],["MeasurableEq","mathlib","class"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Meas