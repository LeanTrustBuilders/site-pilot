ype","type":"Type u_5"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg 𝓞 𝓐 𝓨 𝓓"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → 𝓞"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"env","role":"variable","type":"Environment 𝓞 𝓐 𝓨"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun env O X Y out P"}],"conclusion":"ProbabilityTheory.HasCondDistrib out (history O X Y T) (A.output.comap (Sigma.mk T) ⋯) P","decl":"Learning.IdentAlg.IsRun.hasCondDistrib_output_history"},"code":"/-- **The output of a run of a fixed-budget algorithm has conditional law\n`A.output.comap (Sigma.mk T) _`, the output rule on histories of length `T`, given the history of\nthe first `T` rounds.** -/\nlemma IsRun.hasCondDistrib_output_history (hA : A.IsFixedBudget T)\n    (h : A.IsRun env O X Y out P) :\n    HasCondDistrib out (history O X Y T) (A.output.comap (Sigma.mk T) (measurable_sigma_mk T))\n      P","proof":":= by\n  have h1 := h.hasCondDistrib_output\n  rw [show A.stoppedHist O X Y = Sigma.mk T ∘ history O X Y T from\n    funext hA.stoppedHist_eq] at h1\n  exact h1.of_measurableEmbedding_comp_right (measurableEmbedding_sigma_mk T)","source":{"path":"Maiti2026Power/LeanMachineLearning/IdentAlg.lean","start":128,"end":138,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/IdentAlg.lean#L128-L138"},"deps":[93],"out