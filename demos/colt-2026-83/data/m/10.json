𝓨","role":"type","type":"Type u_3"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":true,"name":"A","role":"variable","type":"IdentAlg Unit 𝓐 𝓨 𝓓"}],"conclusion":"Prop","decl":"Learning.IdentAlg.IsFixedDesign","value":"∃ x, A.alg = fixedDesignAlg x"},"code":"/-- An identification algorithm without observations is a *fixed-design* (non-adaptive)\nalgorithm if its sampling rule plays a fixed sequence of actions; its output rule is\narbitrary. -/\ndef IsFixedDesign (A : IdentAlg Unit 𝓐 𝓨 𝓓) : Prop := ∃ x : ℕ → 𝓐, A.alg = fixedDesignAlg x","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/IdentAlg.lean","start":64,"end":67,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/IdentAlg.lean#L64-L67"},"deps":[86],"outside":[],"external":[["Eq","lean4","inductive"],["Exists","lean4","inductive"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.alg","LeanMachineLearning","definition"],["Learning.detAlgorithm","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["Nat","lean4","inductive"],["PUnit.instMeasurableSpace","mathlib","instance"],["Prod","lean4","structure"],["Unit","lean4","definition"]],"users":[63,589,721,1212,1236],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":85,"name":"Learning.IdentAlg.output_fixedBudget","kind":"Lemma","keyword":"lemma","