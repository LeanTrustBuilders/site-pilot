nment with reward vector `θ` has simple regret at most `ε` with probability at least\n`1 - δ`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_2"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ↑𝒳"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"out","role":"variable","type":"Ω → ↑𝒳"},{"explicit":true,"name":"hpac","role":"hypothesis","type":"IsPAC 𝒳 A ε δ"},{"explicit":false,"name":"θ","role":"variable","type":"E"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P"}],"conclusion":"1 - δ ≤ P.real {ω | simpleRegret 𝒳 θ ↑(out ω) ≤ ε}","decl":"Learning.LinearBandit.IsPAC.le_measureReal_of_isRun"},"code":"/-- For an `(ε, δ)`-PAC algorithm, the recommendation of any run in the linear Gaussian\nenvironment with reward vector `θ` has simple regret at most `ε` with probability at least\n`1 - δ`. -/\nlemma IsPAC.le_measureReal_of_isRun (hpac : IsPAC 𝒳 A ε δ) {θ : E}\n    (h : A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P) :\n    1 - δ ≤ P.real {ω | simpleRegret 𝒳 θ (out ω) ≤ ε}","proof":":= by\n  have hmeas : MeasurableSet {x : 𝒳 | simpleRegret 𝒳 θ x ≤ ε} :=\n    measurableSet_le (measurable_simpleRegret 𝒳 θ) measurable_const\n  have h1 := hpac.measureReal_bad_of_isRun\n    (measurableSet_lt measurable_const (measurable_simpleRegret 𝒳 θ)) h\n  rw [h.hasLaw_output.measureReal_eq hmeas]\n  rw [h.hasLaw_output.measureReal_eq (measurableSet_lt measurable_const\n    (measurable_simpleRegret 𝒳 θ)), show {x : 𝒳 | ε < simpleRegret 𝒳 θ x} =\n      {x : 𝒳 | simpleRegret 𝒳 θ x ≤ ε}ᶜ by ext; simp, measureReal_compl hmeas, probReal_univ]\n    at h1\n  linarith","source":{"path":"Maiti2026Power/LeanMachineLearning/LinearBandit.lean","start":92,"end":107,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L92-L107"},"deps":[95,97,101],"outside":[],"external":[["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Membership.mem","lean4","definition"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["Nat","lean4","inductiv