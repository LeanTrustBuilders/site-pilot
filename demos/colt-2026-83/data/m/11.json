","start":48,"end":54,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L48-L54"},"deps":[],"outside":[],"external":[["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["MeasurableSpace","mathlib","class"],["Membership.mem","lean4","definition"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instRCLike","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"]],"users":[15,74,96,97,601],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":101,"name":"Learning.LinearBandit.simpleRegret","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.LinearBandit","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"6d655b1a0816b88c","local":"c2fe185acbb5ba4e","content":"f97fbf756af00015"},"doc":"Simple regret of the arm `x` for the reward vector `θ` on the action set `𝒳`:\n`sup_{y ∈ 𝒳} ⟪y, θ⟫ - ⟪x, θ⟫`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":true,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":true,"name":"θ","role":"variable","type":"E"},{"explicit":true,"name":"x","role":"variable","type":"E"}],"conclusion":"ℝ","decl":"Learning.LinearBandit.simpleRegret","value":"(⨆ y, inner ℝ (↑y) θ) - inner ℝ x θ"},"code":"/-- Simple regret of the arm `x` for the reward vector `θ` on the action set `𝒳`:\n`sup_{y ∈ 𝒳} ⟪y, θ⟫ - ⟪x, θ⟫`. -/\nnoncomputable def simpleRegret (𝒳 : Set E) (θ x : E) : ℝ :=\n  (⨆ y : 𝒳, ⟪(y : E), θ⟫) - ⟪x, θ⟫","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/LinearBandit.lean","start":70,"end":73,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L70-L73"},"deps":[],"outside":[],"external":[["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["Membership.mem","lean4","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Real","mathlib","structure"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["iSup","mathlib","definition"],["instHSub","lean4","instance"]],"users":[45,65,95,98,99,102,231,350,355,356,359,379,405,419,428,495,540,541,571,582,584,660,665,666,668,676,686,689,708,712,1216,1218,1220,1221,1233],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":102,"name":"Learning.LinearBandit.isPAC_of_forall_isRun","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.LinearBandit","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"4d889edda1288826","local":"1ff44552d8e26353","content":"4c2083f77e7e3866"},"doc":"**PAC from a bound on every run**: `A` is `(ε, δ)`-PAC on `𝒳` as soon as, for every reward\nvector `θ` and every run of `A` in the linear Gaussian environment with reward vector `θ` on a\nprobability space in the universe of `E` (the universe of the canonical run\n`IdentAlg.runMeasure`), the recommendation has simple regret at most `ε` with probability at\nleast `1 - δ`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ ↑𝒳"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"h","role":"hypothesis","type":"∀ (θ : E) {Ω : Type u} {_mΩ : MeasurableSpace Ω} (P : MeasureTheory.Measure Ω)\n  [inst : MeasureTheory.IsProbabilityMeasure P] (O : ℕ → Ω → Unit) (X : ℕ → Ω → ↑𝒳) (Y : ℕ → Ω → ℝ)\n  (out : Ω → ↑𝒳),\n  A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P → 1 - δ ≤ P.real {ω | simpleRegret 𝒳 θ ↑(out ω) ≤ ε}"}],"conclusion":"IsPAC 𝒳 A ε δ","decl":"Learning.LinearBandit.isPAC_of_forall_isRun"},"code":"/-- **PAC from a bound on every run**: `A` is `(ε, δ)`-PAC on `𝒳` as soon as, for every reward\nvector `θ` and every run of `A` in the linear Gaussian environment with reward vector `θ` on a\nprobability space in the universe of `E` (the universe of the canonical run\n`IdentAlg.runMeasure`), the recommendation has simple regret at most `ε` with probability at\nleast `1 - δ`. -/\nlemma isPAC_of_forall_isRun {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [MeasurableSpace E] [OpensMeasurableSpace E] {𝒳 : Set E} {A : IdentAlg Unit 𝒳 ℝ 𝒳} {ε δ : ℝ}\n    (h : ∀ θ : E, ∀ {Ω : Type u} {_mΩ : MeasurableSpace Ω} (P : Measure Ω)\n      [IsProbabilityMeasure P] (O : ℕ → Ω → Unit) (X : ℕ → Ω → 𝒳) (Y : ℕ → Ω → ℝ) (out : Ω → 𝒳),\n      A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P →\n        1 - δ ≤ P.real {ω | simpleRegret 𝒳 θ (out ω) ≤ ε}) :\n    IsPAC 𝒳 A ε δ","proof":":= by\n  refine IdentAlg.IsPAC.of_forall_isRun\n    (fun θ ↦ measurableSet_lt measurable_const (measurable_simpleRegret 𝒳 θ))\n    fun θ Ω _ P _ O X Y out hrun ↦ ?_\n  have hmeas : MeasurableSet {x : 𝒳 | simpleRegret 𝒳 θ x ≤ ε} :=\n    measurableSet_le (measurable_simpleRegret 𝒳 θ) measurable_const\n  have h1 := h θ P O X Y out hrun\n  rw [hrun.hasLaw_output.measureReal_eq hmeas] at h1\n  rw [hrun.hasLaw_output.measureReal_eq (measurableSet_lt measurable_const\n    (measurable_simpleRegret 𝒳 θ)), show {x : 𝒳 | ε < simpleRegret 𝒳 θ x} =\n      {x : 𝒳 | simpleRegret 𝒳 θ x ≤ ε}ᶜ by ext; simp, measureReal_compl hmeas, probReal_univ]\n  linarith","source":{"path":"Maiti2026Power/LeanMachineLearning/LinearBandit.lean","start":109,"end":131,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/LinearBandit.lean#L109-L131"},"deps":[95,97,101],"outside":[],"external":[["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Membership.mem","lean4","definition"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["Nat","lean4","inductive"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.ofPred","mathlib","definition"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"],["iSup","mathlib","definition"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}}]