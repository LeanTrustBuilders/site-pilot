 𝒳} ⟪x - x', v⟫ = supportFn 𝒳 v + supportFn 𝒳 (-v)`. -/\nnoncomputable def diffSup (𝒳 : Set E) (v : E) : ℝ := supportFn 𝒳 v + supportFn 𝒳 (-v)","proof":"","source":{"path":"Maiti2026Power/MXJ2026/DifferenceProcess.lean","start":48,"end":50,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/DifferenceProcess.lean#L48-L50"},"deps":[1345],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["Membership.mem","lean4","definition"],["Neg.neg","lean4","definition"],["NegZeroClass.toNeg","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["Subtype.val","lean4","definition"],["iSup","mathlib","definition"],["instHAdd","lean4","instance"]],"users":[429,581,585,586,587,1216,1219],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":584,"name":"Maiti2026Power.simpleRegret_le_supportFn_add_supportFn","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.DifferenceProcess","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"3c22ebb0805ffc95","local":"abb965c4ca223e8c","content":"8cd4dec544c05b76"},"doc":"**The simple regret is controlled by the difference process**\n(blueprint `lem:regret_le_difference_process`): if `x ∈ 𝒳` is a `γ`-approximate maximizer of\n`⟪·, θ'⟫` on the bounded set `𝒳`, then\n`r(x, θ) ≤ sup_{y ∈ 𝒳} ⟪y, θ - θ'⟫ + sup_{y ∈ 𝒳} ⟪y, θ' - θ⟫ + γ`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":true,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ 𝒳, ‖x‖ ≤ R"},{"explicit":false,"name":"θ","role":"variable","type":"E"},{"explicit":false,"name":"θ'","role":"variable","type":"E"},{"explicit":false,"name":"x","role":"variable","type":"E"},{"explicit":true,"name":"hx","role":"hypothesis","type":"x ∈ 𝒳"},{"explicit":false,"name":"γ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hrec","role":"hypothesis","type":"supportFn 𝒳 θ' - γ ≤ inner ℝ x θ'"}],"conclusion":"Learning.LinearBandit.simpleRegret 𝒳 θ x ≤ supportFn 𝒳 (θ - θ') + supportFn 𝒳 (θ' - θ) + γ","decl":"Maiti2026Power.simpleRegret_le_supportFn_add_supportFn"},"code":"/-- **The simple regret is controlled by the difference process**\n(blueprint `lem:regret_le_difference_process`): if `x ∈ 𝒳` is a `γ`-approximate maximizer of\n`⟪·, θ'⟫` on the bounded set `𝒳`, then\n`r(x, θ) ≤ sup_{y ∈ 𝒳} ⟪y, θ - θ'⟫ + sup_{y ∈ 𝒳} ⟪y, θ' - θ⟫ + γ`. -/\nlemma simpleRegret_le_supportFn_add_supportFn (hne : 𝒳.Nonempty) (hR : ∀ x ∈ 𝒳, ‖x‖ ≤ R)\n    {θ θ' x : E} (hx : x ∈ 𝒳) {γ : ℝ} (hrec : supportFn 𝒳 θ' - γ ≤ ⟪x, θ'⟫) :\n    simpleRegret 𝒳 θ x ≤ supportFn 𝒳 (θ - θ') + supportFn 𝒳 (θ' - θ) + γ","proof":":= by\n  have h1 : supportFn 𝒳 θ ≤ supportFn 𝒳 (θ - θ') + supportFn 𝒳 θ' := by\n    have := supportFn_add_le hne hR (θ - θ') θ'\n    rwa [sub_add_cancel] at this\n  have h2 : ⟪x, θ' - θ⟫ ≤ supportFn 𝒳 (θ' - θ) := inner_le_supportFn hR hx _\n  rw [simpleRegret_eq_supportFn_sub]\n  rw [inner_sub_right] at h2\n  linarith","source":{"path":"Maiti2026Power/MXJ2026/DifferenceProcess.lean","start":33,"end":46,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/DifferenceProcess.lean#L33-L46"},"deps":[101,1345],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Nonempty","mathlib","definition"],["Set.instMembership","mathlib","instance"],["SubNegMonoid.toSub","mathlib","instance"],["Subtype.val","lean4","definition"],["iSup","mathlib","definition"],["instHAdd","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90