ace.toTopologicalSpace","mathlib","instance"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.measurableSpace","mathlib","instance"],["WithLp.ofLp","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["dotProduct","mathlib","definition"],["fact_one_le_two_ennreal","mathlib","instance"],["iSup","mathlib","definition"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":582,"name":"Maiti2026Power.simpleRegret_eq_supportFn_sub","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.DifferenceProcess","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"84e9c74457b1d578","local":"42a07c654fe1b291","content":"864cf9dc2626f41d"},"doc":"","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":true,"name":"θ","role":"variable","type":"E"},{"explicit":true,"name":"x","role":"variable","type":"E"}],"conclusion":"Learning.LinearBandit.simpleRegret 𝒳 θ x = supportFn 𝒳 θ - inner ℝ x θ","decl":"Maiti2026Power.simpleRegret_eq_supportFn_sub"},"code":"lemma simpleRegret_eq_supportFn_sub (θ x : E) :\n    simpleRegret 𝒳 θ x = supportFn 𝒳 θ - ⟪x, θ⟫","proof":":= rfl","source":{"path":"Maiti2026Power/MXJ2026/DifferenceProcess.lean","start":30,"end":31,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296