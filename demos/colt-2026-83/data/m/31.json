eroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["iSup","mathlib","definition"],["instHAdd","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":587,"name":"Maiti2026Power.integral_diffSup_multivariateGaussian","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.DifferenceProcess","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"eca35b2fa0acdb77","local":"a54ed24ad0ce1492","content":"7bc7852b80fc9db6"},"doc":"The mean of the difference process under `N(0, Σ⁻¹)` is `2 gwMat 𝒳 Σ`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":true,"name":"hne","role":"hypothesis","type":"𝒳.Nonempty"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ 𝒳, ‖x‖ ≤ R"},{"explicit":false,"name":"S","role":"variable","type":"Matrix ι ι ℝ"},{"explicit":true,"name":"hS","role":"hypothesis","type":"S.PosSemidef"}],"conclusion":"∫ (v : EuclideanSpace ℝ ι), diffSup 𝒳 v ∂ProbabilityTheory.multivariateGaussian 0 S =\n  2 * ProbabilityTheory.gaussianWidth 𝒳 (ProbabilityTheory.multivariateGaussian 0 S)","decl":"Maiti2026Power.integral_diffSup_multivariateGaussian"},"code":"/-- The mean of the difference process under `N(0, Σ⁻¹)` is `2 gwMat 𝒳 Σ`. -/\nlemma integral_diffSup_multivariateGaussian (hne : 𝒳.Nonempty) (hR : ∀ x ∈ 𝒳, ‖x‖ ≤ R)\n    {S : Matrix ι ι ℝ} (hS : S.PosSemidef) :\n    ∫ v, diffSup 𝒳 v ∂multivariateGaussian 0 S =\n      2 * gaussianWidth 𝒳 (multivariateGaussian 0 S)","proof":":= by\n  have hnorm : Integrable (fun ξ : EuclideanSpace ℝ ι ↦ ‖ξ‖) (multivariateGaussian 0 S) :=\n    IsGaussian.integrable_id.norm\n  have h1 : Integrable (supportFn 𝒳) (multivariateGaussian 0 S) := integrable_supportFn hne hR hnorm\n  have h2 : Integrable (fun v ↦ supportFn 𝒳 (-v)) (multivariateGaussian 0 S) := by\n    have := (integrable_map_measure (continuous_supportFn hne hR).aestronglyMeasurable\n      continuous_neg.measurable.aemeasurable).1 (by rwa [multivariateGaussian_zero_map_neg hS])\n    exact this\n  simp_rw [diffSup]\n  rw [integral_add h1 h2, two_mul, gaussianWidth]\n  congr 1\n  rw [← multivariateGaussian_zero_map_neg hS, integral_map continuous_neg.measurable.aemeasurable\n    (continuous_supportFn hne hR).aestronglyMeasurable]\n  rw [multivariateGaussian_zero_map_neg hS]","source":{"path":"Maiti2026Power/MXJ2026/DifferenceProcess.lean","start":71,"end":88,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/DifferenceProcess.lean#L71-L88"},"deps":[583,1664],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DecidableEq","lean4","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fintype","mathlib","class"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["Matri