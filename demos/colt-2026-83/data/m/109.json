n":"⨆ i, b + c * f i = b + c * ⨆ i, f i","conclusionHead":"Eq","conclusionRefs":[[7,8,"HAdd.hAdd"],[11,12,"HMul.hMul"],[17,18,"Eq"],[21,22,"HAdd.hAdd"],[25,26,"HMul.hMul"]],"decl":"ciSup_const_add_const_mul"},"code":"/-- `⨆ i, (b + c * f i) = b + c * ⨆ i, f i` for `c ≥ 0` over a finite nonempty index set. -/\nlemma ciSup_const_add_const_mul [Finite ι] [Nonempty ι] (b : ℝ) {c : ℝ} (hc : 0 ≤ c)\n    (f : ι → ℝ) :\n    ⨆ i, (b + c * f i) = b + c * ⨆ i, f i","proof":":= by\n  obtain ⟨i₀, hi₀⟩ := Finite.exists_max f\n  have hsup : ⨆ i, f i = f i₀ :=\n    le_antisymm (ciSup_le hi₀) (le_ciSup (Finite.bddAbove_range f) i₀)\n  rw [hsup]\n  refine le_antisymm (ciSup_le fun i ↦ by gcongr; exact hi₀ i) ?_\n  exact le_ciSup (Finite.bddAbove_range fun i ↦ b + c * f i) i₀","source":{"path":"Maiti2026Power/Mathlib/Order/CiSupFinite.lean","start":49,"end":58,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Order/CiSupFinite.lean#L49-L58"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Finite","mathlib","class"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["LE.le","lean4","definition"],["Nonempty","lean4","class"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.instZero","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["iSup","mathlib","definition"],["instHAdd","lean4","instance"],["instHMul","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Eq","Finite","HAdd.hAdd","HMul.hMul","LE.le","Nonempty","OfNat.ofNat","Real","Real.instAdd","Real.instLE","Real.instMul","Real.instSupSet","Real.instZero","Zero.toOfNat0","iSup","instHAdd","instHMul"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1507,"name":"abs_le_sum_abs_iSup","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Order.CiSupFinite","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"060dc72086c5b70b","local":"d3bb7f0c44508a7a","content":"4af645b17c59f6df"},"doc":"","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty ι","typeRefs":[[0,8,"Nonempty"]]},{"explicit":true,"implicit":false,"name":"f","role":"variable","type":"ι → ℝ","typeRefs":[[4,5,"Real"]]}],"conclusion":"|⨆ i, f i| ≤ ∑ i, |f i|","conclusionHead":"LE.le","conclusionRefs":[[0,1,"abs"],[9,10,"abs"],[11,12,"LE.le"],[18,19,"abs"],[22,23,"abs"]],"decl":"abs_le_sum_abs_iSup"},"code":"lemma abs_le_sum_abs_iSup [Fintype ι] [Nonempty ι] (f : ι → ℝ) : |⨆ i, f i| ≤ ∑ i, |f i|","proof":":= by\n  refine abs_le.2 ⟨?_, ciSup_le fun i ↦ (le_abs_self _).trans (Finset.single_le_sum\n    (f := fun i ↦ |f i|) (fun i _ ↦ abs_nonneg _) (Finset.mem_univ i))⟩\n  obtain ⟨i⟩ := ‹Nonempty ι›\n  refine (neg_le.2 ?_).trans (le_ciSup (Finite.bddAbove_range f) i)\n  exact (neg_le_abs _).trans (Finset.single_le_sum (f := fun i ↦ |f i|)\n    (fun i _ ↦ abs_nonneg _) (Finset.mem_univ i))","source":{"path":"Maiti2026Power/Mathlib/Order/CiSupFinite.lean","start":32,"end":38,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Order/CiSupFinite.lean#L32-L38"},"deps":[],"outside":[],"external":[["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["LE.le","lean4","definition"],["Nonempty","lean4","class"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.lattice","mathlib","instance"],["abs","mathlib","definition"],["iSup","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Finset.sum","Finset.univ","Fintype","LE.le","Nonempty","Real","Real.instAddCommMonoid","Real.instAddGroup","Real.instLE","Real.instSupSet","Real.lattice","abs","iSup"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}}]