[{"id":1688,"name":"ProbabilityTheory.compProd_prod_eq_map_compProd_compProd_const","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Kernel.PriorAverage","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"21dfc32d54888b5f","local":"eb9db296ae713242","content":"71d97b01f0083dea"},"doc":"The joint law `(π.prod ν) ⊗ₘ κ` is the composition-product of `π` with the kernel\n`θ ↦ ν ⊗ₘ κ.comap (Prod.mk θ) _`, up to reassociation of the product. ","statement":{"binders":[{"explicit":false,"name":"Θ","role":"type","type":"Type u_1"},{"explicit":false,"name":"B","role":"type","type":"Type u_2"},{"explicit":false,"name":"O","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΘ","role":"instance","type":"MeasurableSpace Θ"},{"explicit":false,"name":"mB","role":"instance","type":"MeasurableSpace B"},{"explicit":false,"name":"mO","role":"instance","type":"MeasurableSpace O"},{"explicit":true,"name":"π","role":"variable","type":"MeasureTheory.Measure Θ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite π"},{"explicit":true,"name":"ν","role":"variable","type":"MeasureTheory.Measure B"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite ν"},{"explicit":true,"name":"κ","role":"variable","type":"Kernel (Θ × B) O"}],"conclusion":"(π.prod ν).compProd κ =\n  MeasureTheory.Measure.map (⇑MeasurableEquiv.prodAssoc.symm)\n    (π.compProd ((Kernel.const Θ ν).compProd κ))","decl":"ProbabilityTheory.compProd_prod_eq_map_compProd_compProd_const"},"code":"/-- The joint law `(π.prod ν) ⊗ₘ κ` is the composition-product of `π` with the kernel\n`θ ↦ ν ⊗ₘ κ.comap (Prod.mk θ) _`, up to reassociation of the product. -/\nlemma compProd_prod_eq_map_compProd_compProd_const (π : Measure Θ) [SFinite π] (ν : Measure B)\n    [SFinite ν] (κ : Kernel (Θ × B) O) :\n    (π.prod ν) ⊗ₘ κ =\n      (π ⊗ₘ (Kernel.const Θ ν ⊗ₖ κ)).map MeasurableEquiv.prodAssoc.symm","proof":":= by\n  rw [Measure.compProd_assoc, Measure.compProd_const]","source":{"path":"Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean","start":64,"end":70,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean#L64-L70"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["Eq","lean4","inductive"],["EquivLike.toFunLike","mathlib","instance"],["MeasurableEquiv","mathlib","structure"],["MeasurableEquiv.instEquivLike","mathlib","instance"],["MeasurableEquiv.prodAssoc","mathlib","definition"],["MeasurableEquiv.symm","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.compProd","mathlib","definition"],["ProbabilityTheory.Kernel.const","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1689,"name":"ProbabilityTheory.integral_le_add_mul_integral_of_measureReal_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Kernel.PriorAverage","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"836f3530a24279fb","local":"8b8074d69fe9e22a","content":"9f86668abf86de4e"},"doc":"**Expected loss of a PAC procedure under a prior.** If for every parameter `θ`, a nonnegative\nloss `r θ o` bounded by `Z θ` exceeds `ε` with probability at most `δ` under the law of `(b, o)`\ngiven `θ`, then its expectation under the joint law `(π.prod ν) ⊗ₘ κ` is at most\n`ε + δ * ∫ θ, Z θ ∂π`. ","statement":{"binders":[{"explicit":false,"name":"Θ","role":"type","type":"Type u_1"},{"explicit":false,"name":"B","role":"type","type":"Type u_2"},{"explicit":false,"name":"O","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΘ","role":"instance","type":"MeasurableSpace Θ"},{"explicit":false,"name":"mB","role":"instance","type":"MeasurableSpace B"},{"explicit":false,"name":"mO","role":"instance","type":"MeasurableSpace O"},{"explicit":true,"name":"π","role":"variable","type":"MeasureTheory.Measure Θ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure π"},{"explicit":true,"name":"ν","role":"variable","type":"MeasureTheory.Measure B"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure ν"},{"explicit":true,"name":"κ","role":"variable","type":"Kernel (Θ × B) O"},{"explicit":false,"name":"","role":"instance","type":"IsMarkovKernel κ"},{"explicit":false,"name":"r","role":"variable","type":"Θ → O → ℝ"},{"explicit":true,"name":"hr","role":"hypothesis","type":"Measurable (Function.uncurry r)"},{"explicit":false,"name":"Z","role":"variable","type":"Θ → ℝ"},{"explicit":true,"name":"hZ","role":"hypothesis","type":"MeasureTheory.Integrable Z π"},{"explicit":true,"name":"hr0","role":"hypothesis","type":"∀ (θ : Θ) (o : O), 0 ≤ r θ o"},{"explicit":true,"name":"hrZ","role":"hypothesis","type":"∀ (θ : Θ) (o : O), r θ o ≤ Z θ"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hε","role":"hypothesis","type":"0 ≤ ε"},{"explicit":true,"name":"hδ","role":"hypothesis","type":"∀ (θ : Θ), (ν.compProd (κ.comap (Prod.mk θ) ⋯)).real {q | ε < r θ q.2} ≤ δ"}],"conclusion":"∫ (p : (Θ × B) × O), r p.1.1 p.2 ∂(π.prod ν).compProd κ ≤ ε + δ * ∫ (θ : Θ), Z θ ∂π","decl":"ProbabilityTheory.integral_le_add_mul_integral_of_measureReal_le"},"code":"/-- **Expected loss of a PAC procedure under a prior.** If for every parameter `θ`, a nonnegative\nloss `r θ o` bounded by `Z θ` exceeds `ε` with probability at most `δ` under the law of `(b, o)`\ngiven `θ`, then its expectation under the joint law `(π.prod ν) ⊗ₘ κ` is at most\n`ε + δ * ∫ θ, Z θ ∂π`. -/\nlemma integral_le_add_mul_integral_of_measureReal_le (π : Measure Θ) [IsProbabilityMeasure π]\n    (ν : Measure B) [IsProbabilityMeasure ν] (κ : Kernel (Θ × B) O) [IsMarkovKernel κ]\n    {r : Θ → O → ℝ} (hr : Measurable (Function.uncurry r)) {Z : Θ → ℝ} (hZ : Integrable Z π)\n    (hr0 : ∀ θ o, 0 ≤ r θ o) (hrZ : ∀ θ o, r θ o ≤ Z θ) {ε δ : ℝ} (hε : 0 ≤ ε)\n    (hδ : ∀ θ, (ν ⊗ₘ κ.comap (Prod.mk θ) measurable_prodMk_left).real {q | ε < r θ q.2} ≤ δ) :\n    ∫ p, r p.1.1 p.2 ∂((π.prod ν) ⊗ₘ κ) ≤ ε + δ * ∫ θ, Z θ ∂π","proof":":= by\n  -- the output space is nonempty, hence `Z` is nonnegative\n  have hO : Nonempty O := by\n    obtain ⟨θ⟩ := nonempty_of_isProbabilityMeasure π\n    obtain ⟨b⟩ := nonempty_of_isProbabilityMeasure ν\n    exact nonempty_of_isProbabilityMeasure (κ (θ, b))\n  have hZ0 θ : 0 ≤ Z θ := (hr0 θ (Classical.arbitrary O)).trans (hrZ θ _)\n  -- measurability of the sets `{ε < r θ q.2}`\n  have hs θ : MeasurableSet {q : B × O | ε < r θ q.2} :=\n    measurableSet_lt measurable_const (hr.comp (measurable_const.prodMk measurable_snd))\n  have hS : MeasurableSet {p : (Θ × B) × O | ε < r p.1.1 p.2} :=\n    measurableSet_lt measurable_const (hr.comp (measurable_fst.fst.prodMk measurable_snd))\n  -- the dominating function `G`\n  set G : (Θ × B) × O → ℝ :=\n    fun p ↦ ε + Z p.1.1 * {p : (Θ × B) × O | ε < r p.1.1 p.2}.indicator 1 p with hG\n  have hG_int : Integrable G ((π.prod ν) ⊗ₘ κ) := by\n    refine (integrable_const _).add ?_\n    refine (integrable_fst_fst_compProd_prod π ν κ hZ).mul_bdd (c := 1)\n      ((measurable_const.indicator hS).aestronglyMeasurable) (ae_of_all _ fun p ↦ ?_)\n    rw [Set.indicator_apply]\n    split_ifs <;> simp\n  have hrG : ∀ p, r p.1.1 p.2 ≤ G p := by\n    intro p\n    simp only [hG, Set.indicator_apply, Set.mem_ofPred_eq, Pi.one_apply]\n    split_ifs with h\n    · rw [mul_one]\n      exact (hrZ _ _).trans (le_add_of_nonneg_left hε)\n    · rw [mul_zero, add_zero]\n      exact not_lt.mp h\n  have hr_int : Integrable (fun p ↦ r p.1.1 p.2) ((π.prod ν) ⊗ₘ κ) := by\n    refine (integrable_fst_fst_compProd_prod π ν κ hZ).mono' ?_ (ae_of_all _ fun p ↦ ?_)\n    · exact (hr.comp (measurable_fst.fst.prodMk measurable_snd)).aestronglyMeasurable\n    · rw [Real.norm_of_nonneg (hr0 _ _)]\n      exact hrZ _ _\n  -- for each `θ`, the conditional integral of `G` is `ε + Z θ * P(ε < r θ o)`\n  have hG_cond θ : ∫ q, G ((θ, q.1), q.2) ∂(ν ⊗ₘ κ.comap (Prod.mk θ) measurable_prodMk_left)\n      = ε + Z θ * (ν ⊗ₘ κ.comap (Prod.mk θ) measurable_prodMk_left).real {q | ε < r θ q.2} := by\n    have : (fun q : B × O ↦ G ((θ, q.1), q.2))\n        = fun q ↦ ε + Z θ * {q : B × O | ε < r θ q.2}.indicator 1 q := by\n      ext q\n      simp only [hG, Set.indicator_apply, Set.mem_ofPred_eq, Pi.one_apply]\n    rw [this,\n      integral_add (integrable_const _) (((integrable_const _).indicator (hs θ)).const_mul _),\n      integral_const_mul, integral_indicator_one (hs θ)]\n    simp\n  calc ∫ p, r p.1.1 p.2 ∂((π.prod ν) ⊗ₘ κ)\n      ≤ ∫ p, G p ∂((π.prod ν) ⊗ₘ κ) := integral_mono hr_int hG_int hrG\n    _ = ∫ θ, ∫ q, G ((θ, q.1), q.2) ∂(ν ⊗ₘ κ.comap (Prod.mk θ) measurable_prodMk_left) ∂π :=\n        integral_compProd_prod_eq_integral_compProd_comap π ν κ hG_int\n    _ ≤ ∫ θ, (ε + Z θ * δ) ∂π := by\n        refine integral_mono_of_nonneg (ae_of_all _ fun θ ↦ ?_)\n          ((integrable_const _).add (hZ.mul_const _)) (ae_of_all _ fun θ ↦ ?_)\n        · simp only [Pi.zero_apply]\n          rw [hG_cond]\n          have := hZ0 θ\n          positivity\n        · simp only\n          rw [hG_cond]\n          exact add_le_add_right (mul_le_mul_of_nonneg_left (hδ θ) (hZ0 θ)) ε\n    _ = ε + δ * ∫ θ, Z θ ∂π := by\n        rw [integral_add (integrable_const _) (hZ.mul_const _), integral_mul_const, integral_const]\n        simp [mul_comm]","source":{"path":"Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean","start":86,"end":156,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean#L86-L156"},"deps":[],"outside":[],"external":[["Function.uncurry","lean4","definition"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.Measure.real","mathlib","definition"],["MeasureTheory.integral","mathlib","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.IsMarkovKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Prod.snd","lean4","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["Set.ofPred","mathlib","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHMul","lean4","instance"],["measurable_prodMk_left","mathlib","theorem"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1690,"name":"ProbabilityTheory.integrable_fst_fst_compProd_prod","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Kernel.PriorAverage","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"5a98df63d7b291ab","local":"36f8925548cd11a6","content":"23e444149aadb52b"},"doc":"A function of `θ` integrable for the prior is integrable for the joint law. ","statement":{"binders":[{"explicit":false,"name":"Θ","role":"type","type":"Type u_1"},{"explicit":false,"name":"B","role":"type","type":"Type u_2"},{"explicit":false,"name":"O","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΘ","role":"instance","type":"MeasurableSpace Θ"},{"explicit":false,"name":"mB","role":"instance","type":"MeasurableSpace B"},{"explicit":false,"name":"mO","role":"instance","type":"MeasurableSpace O"},{"explicit":true,"name":"π","role":"variable","type":"MeasureTheory.Measure Θ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite π"},{"explicit":true,"name":"ν","role":"variable","type":"MeasureTheory.Measure B"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure ν"},{"explicit":true,"name":"κ","role":"variable","type":"Kernel (Θ × B) O"},{"explicit":false,"name":"","role":"instance","type":"IsMarkovKernel κ"},{"explicit":false,"name":"f","role":"variable","type":"Θ → ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"MeasureTheory.Integrable f π"}],"conclusion":"MeasureTheory.Integrable (fun p => f p.1.1) ((π.prod ν).compProd κ)","decl":"ProbabilityTheory.integrable_fst_fst_compProd_prod"},"code":"/-- A function of `θ` integrable for the prior is integrable for the joint law. -/\nlemma integrable_fst_fst_compProd_prod (π : Measure Θ) [SFinite π] (ν : Measure B)\n    [IsProbabilityMeasure ν] (κ : Kernel (Θ × B) O) [IsMarkovKernel κ] {f : Θ → ℝ}\n    (hf : Integrable f π) :\n    Integrable (fun p ↦ f p.1.1) ((π.prod ν) ⊗ₘ κ)","proof":":= by\n  have h := map_fst_fst_compProd_prod π ν κ\n  rw [← h] at hf\n  exact hf.comp_measurable (by fun_prop)","source":{"path":"Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean","start":46,"end":53,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean#L46-L53"},"deps":[],"outside":[],"external":[["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["ProbabilityTheory.IsMarkovKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.normedCommRing","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["SeminormedAddCommGroup.toSeminormedAddGroup","mathlib","instance"],["SeminormedAddGroup.toContinuousENorm","mathlib","instance"],["SeminormedCommRing.toNonUnitalSeminormedCommRing","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1691,"name":"ProbabilityTheory.integral_fst_fst_compProd_prod","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.Kernel.PriorAverage","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"79b7ee61be9d5dcf","local":"c39fc590eeb44d18","content":"d9d82c431e152ffb"},"doc":"Integrating a function of `θ` against the joint law is integrating it against the prior. ","statement":{"binders":[{"explicit":false,"name":"Θ","role":"type","type":"Type u_1"},{"explicit":false,"name":"B","role":"type","type":"Type u_2"},{"explicit":false,"name":"O","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΘ","role":"instance","type":"MeasurableSpace Θ"},{"explicit":false,"name":"mB","role":"instance","type":"MeasurableSpace B"},{"explicit":false,"name":"mO","role":"instance","type":"MeasurableSpace O"},{"explicit":true,"name":"π","role":"variable","type":"MeasureTheory.Measure Θ"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.SFinite π"},{"explicit":true,"name":"ν","role":"variable","type":"MeasureTheory.Measure B"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure ν"},{"explicit":true,"name":"κ","role":"variable","type":"Kernel (Θ × B) O"},{"explicit":false,"name":"","role":"instance","type":"IsMarkovKernel κ"},{"explicit":false,"name":"f","role":"variable","type":"Θ → ℝ"},{"explicit":true,"name":"hf","role":"hypothesis","type":"MeasureTheory.Integrable f π"}],"conclusion":"∫ (p : (Θ × B) × O), f p.1.1 ∂(π.prod ν).compProd κ = ∫ (θ : Θ), f θ ∂π","decl":"ProbabilityTheory.integral_fst_fst_compProd_prod"},"code":"/-- Integrating a function of `θ` against the joint law is integrating it against the prior. -/\nlemma integral_fst_fst_compProd_prod (π : Measure Θ) [SFinite π] (ν : Measure B)\n    [IsProbabilityMeasure ν] (κ : Kernel (Θ × B) O) [IsMarkovKernel κ] {f : Θ → ℝ}\n    (hf : Integrable f π) :\n    ∫ p, f p.1.1 ∂((π.prod ν) ⊗ₘ κ) = ∫ θ, f θ ∂π","proof":":= by\n  have h := map_fst_fst_compProd_prod π ν κ\n  conv_rhs => rw [← h]\n  rw [integral_map (by fun_prop) (by rw [h]; exact hf.aestronglyMeasurable)]","source":{"path":"Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean","start":55,"end":62,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Kernel/PriorAverage.lean#L55-L62"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Integrable","mathlib","definition"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.prod","mathlib","definition"],["MeasureTheory.SFinite","mathlib","class"],["MeasureTheory.integral","mathlib","definition"],["NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing","mathlib","instance"],["NonUnitalSeminormedRing.toSeminormedAddCommGroup","mathlib","instance"],["NormedAddCommGroup