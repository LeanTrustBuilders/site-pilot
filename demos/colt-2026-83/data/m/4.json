map_history_le_of_sq_le h.isAlgEnvSeq h'.isAlgEnvSeq hC T)","source":{"path":"Maiti2026Power/LeanMachineLearning/FixedBudget.lean","start":83,"end":91,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/FixedBudget.lean#L83-L91"},"deps":[93,97],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instLE","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","