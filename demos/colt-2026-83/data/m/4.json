ityMeasure P"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P'"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ↑𝒳"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"O'","role":"variable","type":"ℕ → Ω' → Unit"},{"explicit":false,"name":"X'","role":"variable","type":"ℕ → Ω' → ↑𝒳"},{"explicit":false,"name":"Y'","role":"variable","type":"ℕ → Ω' → ℝ"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"out'","role":"variable","type":"Ω' → 𝓓"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ 𝒳, ‖x‖ ≤ R"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P"},{"explicit":true,"name":"h'","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P'"}],"conclusion":"InformationTheory.klDiv (MeasureTheory.Measure.map out P) (MeasureTheory.Measure.map out' P') ≤\n  ENNReal.ofReal (↑T * (R ^ 2 * ‖θ - θ'‖ ^ 2 / 2))","decl":"Learning.LinearBandit.IsRun.klDiv_map_out_le"},"code":"/-- For two runs of a fixed-budget algorithm with budget `T` in the linear Gaussian environments\nwith reward vectors `θ` and `θ'` on an action set contained in the ball of radius `R`, the\ndivergence between the laws of the outputs is at most `T R ^ 2 ‖θ - θ'‖ ^ 2 / 2`. -/\nlemma IsRun.klDiv_map_out_le (hR : ∀ x ∈ 𝒳, ‖x‖ ≤ R) (hA : A.IsFixedBudget T)\n    (h : A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P)\n    (h' : A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P') :\n    klDiv (P.map out) (P'.map out') ≤ ENNReal.ofReal (T * (R ^ 2 * ‖θ - θ'‖ ^ 2 / 2))","proof":":=\n  IsRun.klDiv_map_out_le_of_sq_le (fun x hx ↦ inner_sq_le hR ⟨x, hx⟩ (θ - θ')) hA h h'","source":{"path":"Maiti2026Power/LeanMachineLearning/FixedBudget.lean","start":93,"end":100,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/FixedBudget.lean#L93-L100"},"deps":[93,97],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instLE","mathlib","instance"],["ENNReal.ofReal","mathlib","definition"],["Eq","lean4","inductive"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["NNReal","mathlib","definition"],["NNReal.instOne","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.cast","lean4","definition"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["OpensMeasurableSpace","mathlib","class"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.mk","mathlib","constructor"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["SubNegMonoid.toSub","mathlib","instance"],["Subtype.instMeasurableSpace","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Unit","lean4","definition"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":34,"name":"Learning.LinearBandit.IsRun.exp_neg_le_measureReal_add_of_sq_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.FixedBudget","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"21bffc0b1991c046","local":"5af0f713117afaea","content":"f511c26b7c80e0da"},"doc":"**Bretagnolle–Huber for the outputs of a fixed-budget algorithm**: in the setting of\n`IsRun.klDiv_map_out_le_of_sq_le`, for every measurable set `B` of outputs,\n`P (out ∈ B) + P' (out' ∉ B) ≥ (1/2) exp (-T C / 2)`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace E"},{"explicit":false,"name":"","role":"instance","type":"OpensMeasurableSpace E"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"𝒳","role":"variable","type":"Set E"},{"explicit":false,"name":"θ","role":"variable","type":"E"},{"explicit":false,"name":"θ'","role":"variable","type":"E"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit ↑𝒳 ℝ 𝓓"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_3"},{"explicit":false,"name":"Ω'","role":"type","type":"Type u_4"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"P'","role":"variable","type":"MeasureTheory.Measure Ω'"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P'"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → ↑𝒳"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":false,"name":"O'","role":"variable","type":"ℕ → Ω' → Unit"},{"explicit":false,"name":"X'","role":"variable","type":"ℕ → Ω' → ↑𝒳"},{"explicit":false,"name":"Y'","role":"variable","type":"ℕ → Ω' → ℝ"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"out'","role":"variable","type":"Ω' → 𝓓"},{"explicit":false,"name":"C","role":"variable","type":"ℝ"},{"explicit":true,"name":"hC","role":"hypothesis","type":"∀ x ∈ 𝒳, inner ℝ x (θ - θ') ^ 2 ≤ C"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"h","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P"},{"explicit":true,"name":"h'","role":"hypothesis","type":"A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P'"},{"explicit":false,"name":"B","role":"variable","type":"Set 𝓓"},{"explicit":true,"name":"hB","role":"hypothesis","type":"MeasurableSet B"}],"conclusion":"1 / 2 * Real.exp (-(↑T * (C / 2))) ≤ P.real (out ⁻¹' B) + P'.real (out' ⁻¹' Bᶜ)","decl":"Learning.LinearBandit.IsRun.exp_neg_le_measureReal_add_of_sq_le"},"code":"/-- **Bretagnolle–Huber for the outputs of a fixed-budget algorithm**: in the setting of\n`IsRun.klDiv_map_out_le_of_sq_le`, for every measurable set `B` of outputs,\n`P (out ∈ B) + P' (out' ∉ B) ≥ (1/2) exp (-T C / 2)`. -/\nlemma IsRun.exp_neg_le_measureReal_add_of_sq_le {C : ℝ} (hC : ∀ x ∈ 𝒳, ⟪x, θ - θ'⟫ ^ 2 ≤ C)\n    (hA : A.IsFixedBudget T) (h : A.IsRun (linearGaussianEnv 𝒳 θ) O X Y out P)\n    (h' : A.IsRun (linearGaussianEnv 𝒳 θ') O' X' Y' out' P') {B : Set 𝓓} (hB : MeasurableSet B) :\n    (1 / 2) * Real.exp (-(T * (C / 2))) ≤ P.real (out ⁻¹' B) + P'.real (out' ⁻¹' Bᶜ)","proof":":= by\n  have hout : AEMeasurable out P := h.hasCondDistrib_output.aemeasurable_snd\n  have hout' : AEMeasurable out' P' := h'.hasCondDistrib_output.aemeasurable_snd\n  have hkl := IsRun.klDiv_map_out_le_of_sq_le hC hA h h'\n  have hne : klDiv (P.map out) (P'.map out') ≠ ∞ := ne_top_of_le_ne_top ENNReal.ofReal_ne_top hkl\n  have : IsProbabilityMeasure (P.map out) := inferInstance\n  have : IsProbabilityMeasure (P'.map out') := inferInstance\n  have hC0 : 0 ≤ C := by\n    obtain ⟨ω⟩ := Measure.nonempty_of_neZero P\n    exact (sq_nonneg _).trans (hC _ (X 0 ω).2)\n  calc (1 / 2) * Real.exp (-(T * (C / 2)))\n      ≤ (1 / 2) * Real.exp (-(klDiv (P.map out) (P'.map out')).toReal) := by\n        gcongr\n        exact ENNReal.toReal_le_of_le_ofReal (by positivity) hkl\n    _ ≤ (P.map out).real B + (P'.map out').real Bᶜ := by\n        rw [one_div_mul_eq_div]\n        exact bretagnolle_huber hB hne\n    _ = P.real (out ⁻¹' B) + P'.real (out' ⁻¹' Bᶜ) := by\n        rw [map_measureReal_apply_of_aemeasurable hout hB,\n          map_measureReal_apply_of_aemeasurable hout' hB.compl]","source":{"path":"Maiti2026Power/LeanMachineLearning/FixedBudget.lean","start":102,"end":127,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/FixedBudget.lean#L102-L127"},"deps":[93,97],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["Compl.compl","mathlib","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsRun","LeanMachineLearning","structure"],["Learning.IdentAlg.stopSet","LeanMachineLearning","d