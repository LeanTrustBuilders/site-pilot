","Real.partialOrder","Real.pseudoMetricSpace","Real.semiring","Ring.toSemiring","Semiring.toAddCommMonoid","Semiring.toModule","Set","Set.instMembership","Submodule","Submodule.instTop","Submodule.span","Top.top","UniformSpace.toTopologicalSpace","WithLp.instAddCommGroup","WithLp.instModule","Zero.toOfNat0","fact_one_le_two_ennreal","instHAdd","instHMul","instOfNatAtLeastTwo","instOfNatNat","instStarRingReal"],"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1219,"name":"Maiti2026Power.diffSup_pos_of_inner_eq_zero","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.SingularDesign","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"cf090f69576d02f4","local":"155f3814c635411c","content":"cf7187b37542ea24"},"doc":"On a spanning compact set, a nonzero direction `v` which is orthogonal to some point of `𝒳`\n(for instance to a design point, or to `0 ∈ 𝒳`) is not constant on `𝒳`: `diffSup 𝒳 v > 0`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"Set","implicit":true,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)","typeRefs":[[0,3,"Set"],[5,19,"EuclideanSpace"],[20,21,"Real"]]},{"explicit":true,"head":"IsCompact","implicit":false,"name":"h𝒳","role":"hypothesis","type":"IsCompact 𝒳","typeRefs":[[0,9,"IsCompact"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hspan","role":"hypothesis","type":"Submodule.span ℝ 𝒳 = ⊤","typeRefs":[[0,14,"Submodule.span"],[15,16,"Real"],[19,20,"Eq"],[21,22,"Top.top"]]},{"explicit":false,"head":"EuclideanSpace","implicit":true,"name":"v","role":"variable","type":"EuclideanSpace ℝ ι","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hv","role":"hypothesis","type":"v ≠ 0","typeRefs":[[2,3,"Ne"]]},{"explicit":true,"head":"Exists","implicit":false,"name":"h0","role":"hypothesis","type":"∃ y ∈ 𝒳, inner ℝ y v = 0","typeRefs":[[9,14,"Inner.inner"],[15,16,"Real"],[21,22,"Eq"]]}],"conclusion":"0 < diffSup 𝒳 v","conclusionHead":"LT.lt","conclusionRefs":[[2,3,"LT.lt"],[4,11,"Maiti2026Power.diffSup"]],"decl":"Maiti2026Power.diffSup_pos_of_inner_eq_zero"},"code":"/-- On a spanning compact set, a nonzero direction `v` which is orthogonal to some point of `𝒳`\n(for instance to a design point, or to `0 ∈ 𝒳`) is not constant on `𝒳`: `diffSup 𝒳 v > 0`. -/\nlemma diffSup_pos_of_inner_eq_zero (h𝒳 : IsCompact 𝒳) (hspan : Submodule.span ℝ 𝒳 = ⊤)\n    {v : EuclideanSpace ℝ ι} (hv : v ≠ 0) (h0 : ∃ y ∈ 𝒳, ⟪y, v⟫ = 0) :\n    0 < diffSup 𝒳 v","proof":":= by\n  obtain ⟨R, hR⟩ : ∃ R, ∀ y ∈ 𝒳, ‖y‖ ≤ R := by\n    obtain ⟨r, hr⟩ := h𝒳.isBounded.subset_closedBall (0 : EuclideanSpace ℝ ι)\n    exact ⟨r, fun y hy ↦ mem_closedBall_zero_iff.1 (hr hy)⟩\n  obtain ⟨y₀, hy₀, h0⟩ := h0\n  by_contra hle\n  rw [not_lt, diffSup] at hle\n  have h1 : 0 ≤ supportFn 𝒳 v := by\n    have := inner_le_supportFn hR hy₀ v\n    rwa [h0] at this\n  have h2 : 0 ≤ supportFn 𝒳 (-v) := by\n    have := inner_le_supportFn hR hy₀ (-v)\n    rwa [inner_neg_right, h0, neg_zero] at this\n  have h3 : ∀ y ∈ 𝒳, ⟪v, y⟫ = 0 := fun y hy ↦ by\n    have hy1 := inner_le_supportFn hR hy v\n    have hy2 := inner_le_supportFn hR hy (-v)\n    rw [inner_neg_right] at hy2\n    rw [real_inner_comm]\n    linarith\n  have hsub : Submodule.span ℝ 𝒳 ≤ (ℝ ∙ v)ᗮ := by\n    rw [Submodule.span_le]\n    exact fun y hy ↦ Submodule.mem_orthogonal_singleton_iff_inner_right.2 (h3 y hy)\n  have hvmem : v ∈ (ℝ ∙ v)ᗮ := hsub (hspan ▸ Submodule.mem_top)\n  exact hv (inner_self_eq_zero.1 (Submodule.mem_orthogonal_singleton_iff_inner_right.1 hvmem))","source":{"path":"Maiti2026Power/MXJ2026/SingularDesign.lean","start":52,"end":79,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9