 = ⊤","typeRefs":[[0,14,"Submodule.span"],[15,16,"Real"],[19,20,"Eq"],[21,22,"Top.top"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"h0","role":"hypothesis","type":"0 ∈ 𝒳","typeRefs":[[2,3,"Membership.mem"]]},{"explicit":false,"implicit":true,"name":"x","role":"variable","type":"Fin T → EuclideanSpace ℝ ι","typeRefs":[[0,3,"Fin"],[8,22,"EuclideanSpace"],[23,24,"Real"]]},{"explicit":true,"head":"Not","implicit":false,"name":"hS","role":"hypothesis","type":"¬(∑ t, outerSelf (x t)).PosDef","typeRefs":[[0,1,"Not"],[7,16,"Maiti2026Power.outerSelf"],[24,30,"Matrix.PosDef"]]},{"explicit":false,"head":"Real","implicit":true,"name":"ε","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hε","role":"hypothesis","type":"0 < ε","typeRefs":[[2,3,"LT.lt"]]}],"conclusion":"∃ θ θ',\n  (∀ (t : Fin T), inner ℝ (x t) θ = 0) ∧\n    (∀ (t : Fin T), inner ℝ (x t) θ' = 0) ∧\n      ∀ (y : EuclideanSpace ℝ ι),\n        Learning.LinearBandit.simpleRegret 𝒳 θ y + Learning.LinearBandit.simpleRegret 𝒳 θ' y = 4 * ε","conclusionHead":"Exists","conclusionRefs":[[18,21,"Fin"],[26,31,"Inner.inner"],[32,33,"Real"],[42,43,"Eq"],[47,48,"And"],[61,64,"Fin"],[69,74,"Inner.inner"],[75,76,"Real"],[86,87,"Eq"],[91,92,"And"],[106,120,"EuclideanSpace"],[121,122,"Real"],[135,169,"Learning.LinearBandit.simpleRegret"],[176,177,"HAdd.hAdd"],[178,212,"Learning.LinearBandit.simpleRegret"],[220,221,"Eq"],[224,225,"HMul.hMul"]],"decl":"Maiti2026Power.exists_singular_instances_of_zero_mem"},"code":"/-- **Singular designs fail**, for a design of any length (possibly `0`) on a set containing\n`0`. -/\nlemma exists_singular_instances_of_zero_mem (h𝒳 : IsCompact 𝒳)\n    (hspan : Submodule.span ℝ 𝒳 = ⊤) (h0 : (0 : EuclideanSpace ℝ ι) ∈ 𝒳)\n    {x : Fin T → EuclideanSpace ℝ ι} (hS : ¬ (∑ t, outerSelf (x t)).PosDef) {ε : ℝ}\n    (hε : 0 < ε) :\n    ∃ θ θ' : EuclideanSpace ℝ ι, (∀ t, ⟪x t, θ⟫ = 0) ∧ (∀ t, ⟪x t, θ'⟫ = 0) ∧\n      ∀ y, simpleRegret 𝒳 θ y + simpleRegret 𝒳 θ' y = 4 * ε","proof":":=\n  exists_singular_instances_of_forall h𝒳 hspan hS (fun v _ ↦ ⟨0, h0, inner_zero_left v⟩) hε","source":{"path":"Maiti2026Power/MXJ2026/SingularDesign.lean","start":115,"end":123,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/SingularDesign.lean#L115-L123"},"deps":[101,1083],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["IsCompact","mathlib","definition"],["LT.lt","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.PosDef","mathlib","definition"],["Matrix.addCommMonoid","mathlib","instance"],["Matrix.vecMulVec","mathlib","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["NegZeroClass.toZero","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Not","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Pi.Function.module","mathlib","instance"],["Pi.addCommGroup","mathlib","instance"],["PiLp.inne