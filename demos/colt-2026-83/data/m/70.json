l","instHAdd","instHMul","instHSMul","instOfNatAtLeastTwo","instSMulOfMul"],"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1217,"name":"Maiti2026Power.exists_ne_zero_inner_eq_zero_of_not_posDef","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.SingularDesign","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"05257a601e9a18d9","local":"d89df564a226cede","content":"caa93c7712b2e476"},"doc":"A direction invisible to a singular design: if `∑ t, outerSelf (x t)` is not positive\ndefinite, some `v ≠ 0` is orthogonal to all `x t`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"Nat","implicit":true,"name":"T","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":false,"implicit":true,"name":"x","role":"variable","type":"Fin T → EuclideanSpace ℝ ι","typeRefs":[[0,3,"Fin"],[8,22,"EuclideanSpace"],[23,24,"Real"]]},{"explicit":true,"head":"Not","implicit":false,"name":"h","role":"hypothesis","type":"¬(∑ t, outerSelf (x t)).PosDef","typeRefs":[[0,1,"Not"],[7,16,"Maiti2026Power.outerSelf"],[24,30,"Matrix.PosDef"]]}],"conclusion":"∃ v, v ≠ 0 ∧ ∀ (t : Fin T), inner ℝ (x t) v = 0","conclusionHead":"Exists","conclusionRefs":[[7,8,"Ne"],[11,12,"And"],[20,23,"Fin"],[28,33,"Inner.inner"],[34,35,"Real"],[44,45,"Eq"]],"decl":"Maiti2026Power.exists_ne_zero_inner_eq_zero_of_not_posDef"},"code":"/-- A direction invisible to a singular design: if `∑ t, outerSelf (x t)` is not positive\ndefinite, some `v ≠ 0` is orthogonal to all `x t`. -/\nlemma exists_ne_zero_inner_eq_zero_of_not_posDef {x : Fin T → EuclideanSpace ℝ ι}\n    (h : ¬ (∑ t, outerSelf (x t)).PosDef) :\n    ∃ v : EuclideanSpace ℝ ι, v ≠ 0 ∧ ∀ t, ⟪x t, v⟫ = 0","proof":":= by\n  have hpsd := posSemidef_sum_outerSelf Finset.univ x\n  have key (u : EuclideanSpace ℝ ι) :\n      WithLp.ofLp u ⬝ᵥ (∑ t, outerSelf (x t)) *ᵥ WithLp.ofLp u = ∑ t, ⟪u, x t⟫ ^ 2 := by\n    simp only [Matrix.sum_mulVec, dotProduct_sum, dotProduct_outerSelf_mulVec]\n  rw [Matrix.posDef_iff_dotProduct_mulVec] at h\n  push Not at h\n  obtain ⟨v, hv, hle⟩ := h hpsd.1\n  rw [star_trivial] at hle\n  have hsum : ∑ t, ⟪WithLp.toLp 2 v, x t⟫ ^ 2 ≤ 0 := (key (WithLp.toLp 2 v)).symm.trans_le hle\n  refine ⟨WithLp.toLp 2 v, fun h0 ↦ hv (by simpa using congrArg WithLp.ofLp h0), fun t ↦ ?_⟩\n  rw [real_inner_comm]\n  exact (pow_eq_zero_iff two_ne_zero).1\n    ((Finset.sum_eq_zero_iff_of_nonneg fun t _ ↦ sq_nonneg _).1\n      (le_antisymm hsum (Finset.sum_nonneg fun t _ ↦ sq_nonneg _)) t (Finset.mem_univ _))","source":{"path":"Maiti2026Power/MXJ2026/SingularDesign.lean","start":32,"end":50,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/SingularDesign.lean#L32-L50"},"deps":[1083],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["Inner.inner","mathlib","definition"],["InnerProductSpace.toInner","mathlib","instance"],["Matrix","mathlib","definition"],["Matrix.PosDef","mathlib","definition"],["Matrix.addCommMonoid","mathlib","instance"],["Matrix.vecMulVec","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Ne","lean4","definition"],["NegZeroClass.toZero","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Not","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.seminormedAddCommGroup","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.ofLp","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["fact_one_le_two_ennreal","mathlib","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddCommGroup.toDivisionAddCommMonoid","AddCommMonoidWithOne.toAddMonoidWithOne","AddMonoidWithOne.toNatCast","And","ENNReal","ENNReal.instAddCommMonoidWithOne","Eq","EuclideanSpace","Exists","Fin","Fin.fintype","Finset.sum","Finset.univ","Fintype","Inner.inner","InnerProductSpace.toInner","Matrix","Matrix.PosDef","Matrix.addCommMonoid","Nat","Nat.instAtLeastTwoHAddOfNat","Nat.instNeZeroSucc","Ne","NegZeroClass.toZero","NormedAddCommGroup.toSeminormedAddCommGroup","Not","OfNat.ofNat","Pi.addCommGroup","PiLp.innerProductSpace","PiLp.innerProductSpace._proof_1","PiLp.seminormedAddCommGroup","RCLike.toInnerProductSpaceReal","Real","Real.instAddCommGroup","Real.instAddCommMonoid","Real.instRCLike","Real.instRing","Real.instZero","Real.normedAddCommGroup","Real.partialOrder","SubNegZeroMonoid.toNegZeroClass","SubtractionCommMonoid.toSubtractionMonoid","SubtractionMonoid.toSubNegZeroMonoid","WithLp.instAddCommGroup","Zero.toOfNat0","fact_one_le_two_ennreal","instOfNatAtLeastTwo","instOfNatNat","instStarRingReal"],"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1218,"name":"Maiti2026Power.exists_singular_instances_of_forall","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.SingularDesign","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"54acdfec74777a11","local":"2610b1ddc199a905","content":"9953b3c6eb2b5981"},"doc":"**Singular designs fail** (geometric part, blueprint `lem:singular_design_fails`): for a\nsingular design on a spanning compact set such that every direction orthogonal to the design is\northogonal to some point of `𝒳`, and `ε > 0`, there are two reward vectors `θ θ'` giving the same\nobservation means `⟪x t, θ⟫ = ⟪x t, θ'⟫` (in fact `0`) and whose simple regrets sum to `4 ε` at\nevery arm. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"Set","implicit":true,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)","typeRefs":[[0,3,"Set"],[5,19,"EuclideanSpace"],[20,21,"Real"]]},{"explicit":false,"head":"Nat","implicit":true,"name":"T","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"IsCompact","implicit":false,"name":"h𝒳","role":"hypothesis","type":"IsCompact 𝒳","typeRefs":[[0,9,"IsCompact"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hspan","role":"hypothesis","type":"Submodule.span ℝ 𝒳 = ⊤","typeRefs":[[0,14,"Submodule.span"],[15,16,"Real"],[19,20,"Eq"],[21,22,"Top.top"]]},{"explicit":false,"implicit":true,"name":"x","role":"variable","type":"Fin T → EuclideanSpace ℝ ι","typeRefs":[[0,3,"Fin"],[8,22,"EuclideanSpace"],[23,24,"Real"]]},{"explicit":true,"head":"Not","implicit":false,"name":"hS","role":"hypothesis","type":"¬(∑ t, outerSelf (x t)).PosDef","typeRefs":[[0,1,"Not"],[7,16,"Maiti2026Power.outerSelf"],[24,30,"Matrix.PosDef"]]},{"explicit":true,"implicit":false,"name":"h0","role":"hypothesis","type":"∀ (v : EuclideanSpace ℝ ι), (∀ (t : Fin T), inner ℝ (x t) v = 0) → ∃ y ∈ 𝒳, inner ℝ y v = 0","typeRefs":[[7,21,"EuclideanSpace"],[22,23,"Real"],[36,39,"Fin"],[44,49,"Inner.inner"],[50,51,"Real"],[60,61,"Eq"],[76,81,"Inner.inner"],[82,83,"Real"],[88,89,"Eq"]]},{"explicit":false,"head":"Real","implicit":true,"name":"ε","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hε","role":"hypothesis","type":"0 < ε","typeRefs":[[2,3,"LT.lt"]]}],"conclusion":"∃ θ θ',\n  (∀ (t : Fin T), inner ℝ (x t) θ = 0) ∧\n    (∀ (t : Fin T), inner ℝ (x t) θ' = 0) ∧\n      ∀ (y : EuclideanSpace ℝ ι),\n        Learning.LinearBandit.simpleRegret 𝒳 θ y + Learning.LinearBandit.simpleRegret 𝒳 θ' y = 4 * ε","conclusionHead":"Exists","conclusionRefs":[[18,21,"Fin"],[26,31,"Inner.inner"],[32,33,"Real"],[42,43,"Eq"],[47,48,"And"],[61,64,"Fin"],[69,74,"Inner.inner"],[75,76,"Real"],[86,87,"Eq"],[91,92,"And"],[106,120,"EuclideanSpace"],[121,122,"Real"],[135,169,"Learning.LinearBandit.simpleRegret"],[176,177,"HAdd.hAdd"],[178,212,"Learning.LinearBandit.simpleRegret"],[220,221,"Eq"],[224,225,"HMul.hMul"]],"decl":"Maiti2026Power.exists_singular_instances_of_forall"},"code":"/-- **Singular designs fail** (geometric part, blueprint `lem:singular_design_fails`): for a\nsingular design on a spanning compact set such that every direction orthogonal to the design is\northogonal to some point of `𝒳`, and `ε > 0`, there are two reward vectors `θ θ'` giving the same\nobservation means `⟪x t, θ⟫ = ⟪x t, θ'⟫` (in fact `0`) and whose simple regrets sum to `4 ε` at\nevery arm. -/\nlemma exists_singular_instances_of_forall (h𝒳 : IsCompact 𝒳) (hspan : Submodule.span ℝ 𝒳 = ⊤)\n    {x : Fin T → EuclideanSpace ℝ ι} (hS : ¬ (∑ t, outerSelf (x t)).PosDef)\n    (h0 : ∀ v : EuclideanSpace ℝ ι, (∀ t, ⟪x t, v⟫ = 0) → ∃ y ∈ 𝒳, ⟪y, v⟫ = 0) {ε : ℝ}\n    (hε : 0 < ε) :\n    ∃ θ θ' : EuclideanSpace ℝ ι, (∀ t, ⟪x t, θ⟫ = 0) ∧ (∀ t, ⟪x t, θ'⟫ = 0) ∧\n      ∀ y, simpleRegret 𝒳 θ y + simpleRegret 𝒳 θ' y = 4 * ε","proof":":= by\n  obtain ⟨v, hv, hv0⟩ := exists_ne_zero_inner_eq_zero_of_not_posDef hS\n  have hD := diffSup_pos_of_inner_eq_zero h𝒳 hspan hv (h0 v hv0)\n  have hα : 0 ≤ 4 * ε / diffSup 𝒳 v := by positivity\n  refine ⟨(4 * ε / diffSup 𝒳 v) • v, -((4 * ε / diffSup 𝒳 v) • v),\n    fun t ↦ by simp [inner_smul_right, hv0], fun t ↦ by simp [inner_smul_right, hv0], fun y ↦ ?_⟩\n  rw [simpleRegret_smul_add_simpleRegret_neg_smul hα, div_mul_cancel₀ _ hD.ne']","source":{"path":"Maiti2026Power/MXJ2026/SingularDesign.lean","start":89,"end":105,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/SingularDesign.lean#L89-L105"},"deps":[101,1083],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["And","lean4","structure"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Exists","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HAdd.hAdd","lean4","definitio