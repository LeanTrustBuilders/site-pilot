[{"id":1216,"name":"Maiti2026Power.simpleRegret_smul_add_simpleRegret_neg_smul","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.MXJ2026.SingularDesign","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"f3469de5ab54f4b2","local":"4f0357a8c22fd828","content":"6ccccf7a44cf5588"},"doc":"The two instances `±α v` have simple regrets summing to `α diffSup 𝒳 v` at every arm. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype ι","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"Set","implicit":true,"name":"𝒳","role":"variable","type":"Set (EuclideanSpace ℝ ι)","typeRefs":[[0,3,"Set"],[5,19,"EuclideanSpace"],[20,21,"Real"]]},{"explicit":false,"head":"Real","implicit":true,"name":"α","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"LE.le","implicit":false,"name":"hα","role":"hypothesis","type":"0 ≤ α","typeRefs":[[2,3,"LE.le"]]},{"explicit":true,"head":"EuclideanSpace","implicit":false,"name":"v","role":"variable","type":"EuclideanSpace ℝ ι","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"]]},{"explicit":true,"head":"EuclideanSpace","implicit":false,"name":"y","role":"variable","type":"EuclideanSpace ℝ ι","typeRefs":[[0,14,"EuclideanSpace"],[15,16,"Real"]]}],"conclusion":"Learning.LinearBandit.simpleRegret 𝒳 (α • v) y + Learning.LinearBandit.simpleRegret 𝒳 (-(α • v)) y =\n  α * diffSup 𝒳 v","conclusionHead":"Eq","conclusionRefs":[[0,34,"Learning.LinearBandit.simpleRegret"],[40,41,"HSMul.hSMul"],[47,48,"HAdd.hAdd"],[49,83,"Learning.LinearBandit.simpleRegret"],[87,88,"Neg.neg"],[91,92,"HSMul.hSMul"],[99,100,"Eq"],[105,106,"HMul.hMul"],[107,114,"Maiti2026Power.diffSup"]],"decl":"Maiti2026Power.simpleRegret_smul_add_simpleRegret_neg_smul"},"code":"/-- The two instances `±α v` have simple regrets summing to `α diffSup 𝒳 v` at every arm. -/\nlemma simpleRegret_smul_add_simpleRegret_neg_smul {α : ℝ} (hα : 0 ≤ α)\n    (v y : EuclideanSpace ℝ ι) :\n    simpleRegret 𝒳 (α • v) y + simpleRegret 𝒳 (-(α • v)) y = α * diffSup 𝒳 v","proof":":= by\n  simp only [simpleRegret_eq_supportFn_sub, ← smul_neg, supportFn_smul _ hα, inner_smul_right,\n    inner_neg_right, diffSup]\n  ring","source":{"path":"Maiti2026Power/MXJ2026/SingularDesign.lean","start":81,"end":87,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/SingularDesign.lean#L81-L87"},"deps":[101,583],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fintype","mathlib","class"],["Function.hasSMul","mathlib","instance"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["HSMul.hSMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Neg.neg","lean4","definition"],["NegZeroClass.toNeg","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toAddCommGroup","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.normedAddCommGroup","mathlib","instance"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instAddCommGroup","mathlib","instance"],["Real.