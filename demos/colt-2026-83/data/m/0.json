[{"id":0,"name":"Learning.Algorithm.AgreeUntil.mono","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.AlgorithmPrefix","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"34f6332a4f986917","local":"e5f491ab6e47f2f5","content":"ced1f076750b68a0"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"alg","role":"variable","type":"Algorithm Unit 𝓐 𝓨"},{"explicit":false,"name":"alg'","role":"variable","type":"Algorithm Unit 𝓐 𝓨"},{"explicit":false,"name":"N","role":"variable","type":"ℕ"},{"explicit":true,"name":"h","role":"hypothesis","type":"alg.AgreeUntil alg' N"},{"explicit":false,"name":"N'","role":"variable","type":"ℕ"},{"explicit":true,"name":"hN","role":"hypothesis","type":"N' ≤ N"}],"conclusion":"alg.AgreeUntil alg' N'","decl":"Learning.Algorithm.AgreeUntil.mono"},"code":"lemma mono (h : alg.AgreeUntil alg' N) {N' : ℕ} (hN : N' ≤ N) : alg.AgreeUntil alg' N'","proof":":=\n  ⟨fun n hn ↦ h.policy_eq n (hn.trans_le hN)⟩","source":{"path":"Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean","start":54,"end":55,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean#L54-L55"},"deps":[3],"outside":[],"external":[["Eq","lean4","inductive"],["Fin","lean4","structure"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Algorithm.policy","LeanMachineLearning","definition"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Nat","lean4","inductive"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Unit","lean4","definition"],["instLENat","lean4","instance"],["instLTNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":1,"name":"Learning.IdentAlg.map_history_out_eq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.AlgorithmPrefix","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"6de5d2a33ec82609","local":"61efd6f54a580bf8","content":"35162d142970087a"},"doc":"If `A` has budget `T`, `(O, X, Y)` is an algorithm-environment sequence for `A.alg` until\ntime `T` and `out` has conditional law `A.output.comap (Sigma.mk T) _` (the output rule on\nhistories of length `T`) given the history of the first `T` rounds, then (history, output) has\nthe same law as under the canonical run of `A` (`runMeasure`). ","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"env","role":"variable","type":"Environment Unit 𝓐 𝓨"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit 𝓐 𝓨 𝓓"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"h","role":"hypothesis","type":"IsAlgEnvSeqUntil O X Y A.alg env P T"},{"explicit":true,"name":"hout","role":"hypothesis","type":"ProbabilityTheory.HasCondDistrib out (history O X Y T) (A.output.comap (Sigma.mk T) ⋯) P"}],"conclusion":"MeasureTheory.Measure.map (fun ω => (history O X Y T ω, out ω)) P =\n  MeasureTheory.Measure.map (fun ω => (history IT.obs IT.action IT.feedback T ω.1, ω.2))\n    (A.runMeasure env)","decl":"Learning.IdentAlg.map_history_out_eq"},"code":"/-- If `A` has budget `T`, `(O, X, Y)` is an algorithm-environment sequence for `A.alg` until\ntime `T` and `out` has conditional law `A.output.comap (Sigma.mk T) _` (the output rule on\nhistories of length `T`) given the history of the first `T` rounds, then (history, output) has\nthe same law as under the canonical run of `A` (`runMeasure`). -/\nlemma map_history_out_eq [IsProbabilityMeasure P] (hA : A.IsFixedBudget T)\n    (h : IsAlgEnvSeqUntil O X Y A.alg env P T)\n    (hout : HasCondDistrib out (history O X Y T)\n      (A.output.comap (Sigma.mk T) (measurable_sigma_mk T)) P) :\n    P.map (fun ω ↦ (history O X Y T ω, out ω)) =\n      (A.runMeasure env).map (fun ω ↦ (history IT.obs IT.action IT.feedback T ω.1, ω.2))","proof":":= by\n  have h1 : (A.runMeasure env).map (fun ω ↦ history IT.obs IT.action IT.feedback T ω.1) =\n      ((A.runMeasure env).map Prod.fst).map (history IT.obs IT.action IT.feedback T) :=\n    (Measure.map_map (measurable_history_traj T) measurable_fst).symm\n  calc P.map (fun ω ↦ (history O X Y T ω, out ω))\n      = P.map (history O X Y T) ⊗ₘ A.output.comap (Sigma.mk T) (measurable_sigma_mk T) :=\n        hout.map_eq\n    _ = (A.runMeasure env).map (fun ω ↦ history IT.obs IT.action IT.feedback T ω.1) ⊗ₘ\n          A.output.comap (Sigma.mk T) (measurable_sigma_mk T) := by\n        rw [h.map_history, h1,\n          show (A.runMeasure env).map Prod.fst = trajMeasure A.alg env from\n            Measure.fst_compProd _ _]\n        rfl\n    _ = (A.runMeasure env).map (fun ω ↦ (history IT.obs IT.action IT.feedback T ω.1, ω.2)) :=\n        ((A.isRun_runMeasure env).hasCondDistrib_output_history hA).map_eq.symm","source":{"path":"Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean","start":80,"end":103,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean#L80-L103"},"deps":[93,270],"outside":[],"external":[["Eq","lean4","inductive"],["Fin","lean4","structure"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IT.action","LeanMachineLearning","definition"],["Learning.IT.feedback","LeanMachineLearning","definition"],["Learning.IT.obs","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.alg","LeanMachineLearning","definition"],["Learning.IdentAlg.output","LeanMachineLearning","definition"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.IdentAlg.stoppedHist","LeanMachineLearning","definition"],["Learning.IsAlgEnvSeqUntil","LeanMachineLearning","structure"],["Learning.Round","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["Learning.trajMeasure","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.compProd","mathlib","definition"],["MeasureTheory.Measure.map","mathlib","definition"],["Nat","lean4","inductive"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.HasCondDistrib","mathlib","definition"],["ProbabilityTheory.Kernel.comap","mathlib","definition"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Prod.snd","lean4","definition"],["Set","mathlib","definition"],["Set.ofPred","mathlib","definition"],["Sigma","lean4","structure"],["Sigma.fst","lean4","definition"],["Sigma.instMeasurableSpace","mathlib","instance"],["Sigma.mk","lean4","constructor"],["Unit","lean4","definition"],["measurable_sigma_mk","LeanMachineLearning","theorem"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":2,"name":"Learning.IsAlgEnvSeqUntil.of_agreeUntil","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.AlgorithmPrefix","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"ca7afa4fc03adf26","local":"dc6af99819e3b2bb","content":"c0260496a02b82a1"},"doc":"An algorithm-environment sequence until time `N` for `alg` is one for every algorithm agreeing\nwith `alg` until time `N`. ","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"alg","role":"variable","type":"Algorithm Unit 𝓐 𝓨"},{"explicit":false,"name":"alg'","role":"variable","type":"Algorithm Unit 𝓐 𝓨"},{"explicit":false,"name":"env","role":"variable","type":"Environment Unit 𝓐 𝓨"},{"explicit":false,"name":"N","role":"variable","type":"ℕ"},{"explicit":true,"name":"h","role":"hypothesis","type":"IsAlgEnvSeqUntil O X Y alg env P N"},{"explicit":true,"name":"hagree","role":"hypothesis","type":"alg.AgreeUntil alg' N"}],"conclusion":"IsAlgEnvSeqUntil O X Y alg' env P N","decl":"Learning.IsAlgEnvSeqUntil.of_agreeUntil"},"code":"/-- An algorithm-environment sequence until time `N` for `alg` is one for every algorithm agreeing\nwith `alg` until time `N`. -/\nlemma IsAlgEnvSeqUntil.of_agreeUntil (h : IsAlgEnvSeqUntil O X Y alg env P N)\n    (hagree : alg.AgreeUntil alg' N) : IsAlgEnvSeqUntil O X Y alg' env P N","proof":"where\n  measurable_obs := h.measurable_obs\n  measurable_action := h.measurable_action\n  measurable_feedback := h.measurable_feedback\n  hasCondDistrib_obs := h.hasCondDistrib_obs\n  hasCondDistrib_action n hn := hagree.policy_eq n hn ▸ h.hasCondDistrib_action n hn\n  hasCondDistrib_feedback n hn := h.hasCondDistrib_feedback n hn","source":{"path":"Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean","start":59,"end":68,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean#L59-L68"},"deps":[3],"outside":[],"external":[["Eq","lean4","inductive"],["Fin","lean4","structure"],["LT.lt","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Algorithm.policy","LeanMachineLearning","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IsAlgEnvSeqUntil","LeanMachineLearning","structure"],["Learning.Round","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["Nat","lean4","inductive"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Unit","lean4","definition"],["instLTNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":3,"name":"Learning.Algorithm.AgreeUntil","kind":"Structure","keyword":"structure","module":"Maiti2026Power.LeanMachineLearning.AlgorithmPrefix","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"c4cda61c18671967","local":"0552b7e2e3e70be9","content":"025a8e6e81714262"},"doc":"Two algorithms agree until time `N` if they have the same policies at times `n < N` (they\nchoose the actions `a_0, …, a_{N-1}` in the same way). ","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":true,"name":"alg","role":"variable","type":"Algorithm Unit 𝓐 𝓨"},{"explicit":true,"name":"alg'","role":"variable","type":"Algorithm Unit 𝓐 𝓨"},{"explicit":true,"name":"N","role":"variable","type":"ℕ"}],"conclusion":"Prop","decl":"Learning.Algorithm.AgreeUntil","fields":[{"name":"policy_eq","type":"∀ n < N, alg.policy n = alg'.policy n"}]},"code":"/-- Two algorithms agree until time `N` if they have the same policies at times `n < N` (they\nchoose the actions `a_0, …, a_{N-1}` in the same way). -/\nstructure Algorithm.AgreeUntil (alg alg' : Algorithm Unit 𝓐 𝓨) (N : ℕ) : Prop where\n  /-- The policies coincide at times `n < N`. -/\n  policy_eq : ∀ n < N, alg.policy n = alg'.policy n","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean","start":41,"end":45,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean#L41-L45"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["Fin","lean4","structure"],["LT.lt","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Algorithm.policy","LeanMachineLearning","definition"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Nat","lean4","inductive"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Unit","lean4","definition"],["instLTNat","lean4","instance"]],"users":[0,2,5,6,7,254],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":4,"name":"Learning.IdentAlg.IsPAC.measureReal_bad_of_isAlgEnvSeqUntil","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.AlgorithmPrefix","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"130dbc7566ed50f6","local":"a81fb70be9e32dd0","content":"300e490f3fcd27d9"},"doc":"**Transfer of a PAC guarantee to a partial run.** If `A` is PAC at level `δ` with budget\n`T`, `(O, X, Y)` is an algorithm-environment sequence for `A.alg` until time `T` in `env θ` and\n`out` has conditional law `A.output.comap (Sigma.mk T) _` (the output rule on histories of\nlength `T`) given the history of the first `T` rounds, then `out` is `bad θ` with probability at\nmost `δ`. ","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_3"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure P"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"𝓓","role":"type","type":"Type u_4"},{"explicit":false,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓"},{"explicit":false,"name":"A","role":"variable","type":"IdentAlg Unit 𝓐 𝓨 𝓓"},{"explicit":false,"name":"T","role":"variable","type":"ℕ"},{"explicit":false,"name":"out","role":"variable","type":"Ω → 𝓓"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"Θ","role":"type","type":"Type u_5"},{"explicit":false,"name":"env","role":"variable","type":"Θ → Environment Unit 𝓐 𝓨"},{"explicit":false,"name":"bad","role":"type","type":"Θ → 𝓓 → Prop"},{"explicit":false,"name":"δ","role":"variable","type":"ℝ"},{"explicit":true,"name":"hpac","role":"hypothesis","type":"A.IsPAC env bad δ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsFixedBudget T"},{"explicit":true,"name":"θ","role":"variable","type":"Θ"},{"explicit":true,"name":"h","role":"hypothesis","type":"IsAlgEnvSeqUntil O X Y A.alg (env θ) P T"},{"explicit":true,"name":"hout","role":"hypothesis","type":"ProbabilityTheory.HasCondDistrib out (history O X Y T) (A.output.comap (Sigma.mk T) ⋯) P"},{"explicit":true,"name":"hbad","role":"hypothesis","type":"MeasurableSet {d | bad θ d}"}],"conclusion":"P.real {ω | bad θ (out ω)} ≤ δ","decl":"Learning.IdentAlg.IsPAC.measureReal_bad_of_isAlgEnvSeqUntil"},"code":"/-- **Transfer of a PAC guarantee to a partial run.** If `A` is PAC at level `δ` with budget\n`T`, `(O, X, Y)` is an algorithm-environment sequence for `A.alg` until time `T` in `env θ` and\n`out` has conditional law `A.output.comap (Sigma.mk T) _` (the output rule on histories of\nlength `T`) given the history of the first `T` rounds, then `out` is `bad θ` with probability at\nmost `δ`. -/\nlemma IsPAC.measureReal_bad_of_isAlgEnvSeqUntil [IsProbabilityMeasure P] {Θ : Type*}\n    {env : Θ → Environment Unit 𝓐 𝓨} {bad : Θ → 𝓓 → Prop} {δ : ℝ}\n    (hpac : A.IsPAC env bad δ) (hA : A.IsFixedBudget T) (θ : Θ)\n    (h : IsAlgEnvSeqUntil O X Y A.alg (env θ) P T)\n    (hout : HasCondDistrib out (history O X Y T)\n      (A.output.comap (Sigma.mk T) (measurable_sigma_mk T)) P)\n    (hbad : MeasurableSet {d | bad θ d}) :\n    P.real {ω | bad θ (out ω)} ≤ δ","proof":":= by\n  have hp := hpac.measureReal_bad_of_isRun hbad (A.isRun_runMeasure (env θ))\n  have hmap := map_history_out_eq hA h hout\n  have hg : Measurable fun ω : (ℕ → Round Unit 𝓐 𝓨) × 𝓓 ↦\n      (history IT.obs IT.action IT.feedback T ω.1, ω.2) :=\n    ((measurable_history_traj T).comp measurable_fst).prodMk measurable_snd\n  have hf : AEMeasurable (fun ω ↦ (history O X Y T ω, out ω)) P := hout.aemeasurable\n  calc P.real {ω | bad θ (out ω)}\n      = (P.map (fun ω ↦ (history O X Y T ω, out ω))).real (Prod.snd ⁻¹' {d | bad θ d}) := by\n        rw [measureReal_def, measureReal_def,\n          Measure.map_apply_of_aemeasurable hf (measurable_snd hbad)]\n        rfl\n    _ = ((A.runMeasure (env θ)).map\n          (fun ω ↦ (history IT.obs IT.action IT.feedback T ω.1, ω.2))).real\n          (Prod.snd ⁻¹' {d | bad θ d}) := by\n        rw [hmap]\n    _ = (A.runMeasure (env θ)).real {ω | bad θ ω.2} := by\n        rw [measureReal_def, measureReal_def, Measure.map_apply hg (measurable_snd hbad)]\n        rfl\n    _ ≤ δ := hp","source":{"path":"Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean","start":105,"end":136,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/AlgorithmPrefix.lean#L105-L136"},"deps":[93],"outside":[],"external":[["Eq","lean4","inductive"],["Fin","lean4","structure"],["LE.le","lean4","definition"],["Learning.Environment","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IdentAlg","LeanMachineLearning","structure"],["Learning.IdentAlg.IsPAC","LeanMachineLearning","definition"],["Learning.IdentAlg.alg","LeanMachineLearning","definition"],["Learning.IdentAlg.output","LeanMachineLearning","definition"],["Learning.IdentAlg.stopSet","LeanMachineLearning","definition"],["Learning.IsAlgEnvSeqUntil","LeanMachineLearning","structure"],["Learning.Round","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["MeasurableSet","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.real","mathlib","definition"],["Nat