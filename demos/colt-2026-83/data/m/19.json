Refs":[[0,24,"ProbabilityTheory.Kernel"]]},{"explicit":false,"head":"ProbabilityTheory.Kernel","implicit":true,"name":"κ'","role":"variable","type":"ProbabilityTheory.Kernel 𝓐 𝓨","typeRefs":[[0,24,"ProbabilityTheory.Kernel"]]},{"explicit":false,"head":"ProbabilityTheory.IsMarkovKernel","implicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel κ","typeRefs":[[0,32,"ProbabilityTheory.IsMarkovKernel"]]},{"explicit":false,"head":"ProbabilityTheory.IsMarkovKernel","implicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel κ'","typeRefs":[[0,32,"ProbabilityTheory.IsMarkovKernel"]]},{"explicit":true,"head":"Learning.IdentAlg.IsRun","implicit":false,"name":"h","role":"hypothesis","type":"A.IsRun (stationaryEnv κ) O X Y out P","typeRefs":[[2,7,"Learning.IdentAlg.IsRun"],[9,22,"Learning.stationaryEnv"]]},{"explicit":true,"head":"Learning.IdentAlg.IsRun","implicit":false,"name":"h'","role":"hypothesis","type":"A.IsRun (stationaryEnv κ') O' X' Y' out' P'","typeRefs":[[2,7,"Learning.IdentAlg.IsRun"],[9,22,"Learning.stationaryEnv"]]},{"explicit":true,"head":"Filter.Eventually","implicit":false,"name":"hτ","role":"hypothesis","type":"∀ᵐ (ω : Ω) ∂P, A.stoppingTime O X Y ω ≠ ⊤","typeRefs":[[0,2,"Filter.Eventually"],[11,12,"Filter.Eventually"],[17,29,"Learning.IdentAlg.stoppingTime"],[38,39,"Ne"],[40,41,"Top.top"]]},{"explicit":true,"head":"Filter.Eventually","implicit":false,"name":"hτ'","role":"hypothesis","type":"∀ᵐ (ω : Ω') ∂P', A.stoppingTime O' X' Y' ω ≠ ⊤","typeRefs":[[0,2,"Filter.Eventually"],[12,13,"Filter.Eventually"],[19,31,"Learning.IdentAlg.stoppingTime"],[43,44,"Ne"],[45,46,"Top.top"]]}],"conclusion":"InformationTheory.klDiv (MeasureTheory.Measure.map out P) (MeasureTheory.Measure.map out' P') ≤\n  ∑' (t : ℕ),\n    InformationTheory.klDiv\n      ((MeasureTheory.Measure.map (X t) (P.restrict {ω | ↑t < A.stoppingTime O X Y ω})).compProd κ)\n      ((MeasureTheory.Measure.map (X t) (P.restrict {ω | ↑t < A.stoppingTime O X Y ω})).compProd κ')","conclusionHead":"LE.le","conclusionRefs":[[0,23,"InformationTheory.klDiv"],[25,50,"MeasureTheory.Measure.map"],[59,84,"MeasureTheory.Measure.map"],[94,95,"LE.le"],[98,100,"tsum"],[106,107,"Nat"],[114,137,"InformationTheory.klDiv"],[146,171,"MeasureTheory.Measure.map"],[181,189,"MeasureTheory.Measure.restrict"],[193,194,"Set.ofPred"],[198,199,"LT.lt"],[202,214,"Learning.IdentAlg.stoppingTime"],[226,234,"MeasureTheory.Measure.compProd"],[246,271,"MeasureTheory.Measure.map"],[281,289,"MeasureTheory.Measure.restrict"],[293,294,"Set.ofPred"],[298,299,"LT.lt"],[302,314,"Learning.IdentAlg.stoppingTime"],[326,334,"MeasureTheory.Measure.compProd"]],"decl":"Learning.IdentAlg.IsRun.klDiv_map_out_le_tsum_compProd"},"code":"/-- **Change of measure at a stopping time**, composition-product form: for two runs of the same\nidentification algorithm in two stationary environments with reward kernels `κ` and `κ'`, with\nalmost surely finite stopping times, the divergence between the laws of the outputs is at most\nthe series over the rounds `t` of the conditional divergences of the reward kernels given the\nplayed action, on the event that the algorithm has not stopped after `t` rounds. -/\nlemma IsRun.klDiv_map_out_le_tsum_compProd (h : A.IsRun (stationaryEnv κ) O X Y out P)\n    (h' : A.IsRun (stationaryEnv κ') O' X' Y' out' P') (hτ : ∀ᵐ ω ∂P, A.stoppingTime O X Y ω ≠ ⊤)\n    (hτ' : ∀ᵐ ω ∂P', A.stoppingTime O' X' Y' ω ≠ ⊤) :\n    klDiv (P.map out) (P'.map out') ≤\n      ∑' t : ℕ, klDiv ((P.restrict {ω | (t : ℕ∞) < A.stoppingTime O X Y ω}).map (X t) ⊗ₘ κ)\n        ((P.restrict {ω | (t : ℕ∞) < A.stoppingTime O X Y ω}).map (X t) ⊗ₘ κ')","proof":":=\n  (h.klDiv_map_out_le_stoppedHist h').trans_eq\n    (h.isAlgEnvSeq.klDiv_map_stoppedValue_sigmaHistory_compProd h'.isAlgEnvSeq\n      A.measurableSet_stopSet hτ hτ')","source":{"path":"Maiti2026Power/LeanMachineLearning/RunDivergence.lean","start":71,"end":84,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3