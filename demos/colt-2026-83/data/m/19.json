babilityTheory.IsMarkovKernel","implicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel κ","typeRefs":[[0,32,"ProbabilityTheory.IsMarkovKernel"]]},{"explicit":false,"head":"ProbabilityTheory.IsMarkovKernel","implicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel κ'","typeRefs":[[0,32,"ProbabilityTheory.IsMarkovKernel"]]},{"explicit":false,"head":"MeasurableSpace.CountablyGenerated","implicit":false,"name":"","role":"instance","type":"MeasurableSpace.CountablyGenerated 𝓨","typeRefs":[[0,34,"MeasurableSpace.CountablyGenerated"]]},{"explicit":true,"head":"Learning.IdentAlg.IsRun","implicit":false,"name":"h","role":"hypothesis","type":"A.IsRun (stationaryEnv κ) O X Y out P","typeRefs":[[2,7,"Learning.IdentAlg.IsRun"],[9,22,"Learning.stationaryEnv"]]},{"explicit":true,"head":"Learning.IdentAlg.IsRun","implicit":false,"name":"h'","role":"hypothesis","type":"A.IsRun (stationaryEnv κ') O' X' Y' out' P'","typeRefs":[[2,7,"Learning.IdentAlg.IsRun"],[9,22,"Learning.stationaryEnv"]]},{"explicit":true,"head":"Filter.Eventually","implicit":false,"name":"hτ","role":"hypothesis","type":"∀ᵐ (ω : Ω) ∂P, A.stoppingTime O X Y ω ≠ ⊤","typeRefs":[[0,2,"Filter.Eventually"],[11,12,"Filter.Eventually"],[17,29,"Learning.IdentAlg.stoppingTime"],[38,39,"Ne"],[40,41,"Top.top"]]},{"explicit":true,"head":"Filter.Eventually","implicit":false,"name":"hτ'","role":"hypothesis","type":"∀ᵐ (ω : Ω') ∂P', A.stoppingTime O' X' Y' ω ≠ ⊤","typeRefs":[[0,2,"Filter.Eventually"],[12,13,"Filter.Eventually"],[19,31,"Learning.IdentAlg.stoppingTime"],[43,44,"Ne"],[45,46,"Top.top"]]}],"conclusion":"InformationTheory.klDiv (MeasureTheory.Measure.map out P) (MeasureTheory.Measure.map out' P') ≤\n  ∫⁻ (ω : Ω),\n    ∑ t ∈ Finset.range (A.stoppingTime O X Y ω).toNat,\n      InformationTheory.klDiv (κ (X t ω)) (κ' (X t ω)) ∂P","conclusionHead":"LE.le","conclusionRefs":[[0,23,"InformationTheory.klDiv"],[25,50,"MeasureTheory.Measure.map"],[59,84,"MeasureTheory.Measure.map"],[94,95,"LE.le"],[98,100,"MeasureTheory.lintegral"],[120,132,"Finset.range"],[136,148,"Learning.IdentAlg.stoppingTime"],[158,163,"ENat.toNat"],[171,194,"InformationTheory.klDiv"],[220,221,"MeasureTheory.lintegral"]],"decl":"Learning.IdentAlg.IsRun.klDiv_map_out_le_lintegral"},"code":"/-- **Change of measure at a stopping time**, integral form: for two runs of the same\nidentification algorithm in two stationary environments with reward kernels `κ` and `κ'`, with\nalmost surely finite stopping times, the divergence between the laws of the outputs is at most\nthe expected sum, along the first run, of the divergences of the reward kernels at the actions\nplayed before stopping. -/\nlemma IsRun.klDiv_map_out_le_lintegral [MeasurableSpace.CountablyGenerated 𝓨]\n    (h : A.IsRun (stationaryEnv κ) O X Y out P) (h' : A.IsRun (stationaryEnv κ') O' X' Y' out' P')\n    (hτ : ∀ᵐ ω ∂P, A.stoppingTime O X Y ω ≠ ⊤) (hτ' : ∀ᵐ ω ∂P', A.stoppingTime O' X' Y' ω ≠ ⊤) :\n    klDiv (P.map out) (P'.map out') ≤\n      ∫⁻ ω, ∑ t ∈ range (A.stoppingTime O X Y ω).toNat, klDiv (κ (X t ω)) (κ' (X t ω)) ∂P","proof":":=\n  (h.klDiv_map_out_le_stoppedHist h').trans_eq\n    (h.isAlgEnvSeq.klDiv_map_stoppedValue_sigmaHistory h'.isAlgEnvSeq A.measurableSet_stopSet\n      hτ hτ')","source":{"path":"Maiti2026Power/LeanMachineLearning/RunDivergence.lean","start":86,"end":98,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/RunDivergence.lean#L86-L98"},"deps":[],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoid","mathlib","instance"],["ENNReal.instLE","mathlib","instance"],["ENat","mathlib","definition"],["ENat.toNat","mathlib","definition"],["Filter.Eventually","mathlib","definition"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["InformationTheory.klDiv","mathlib","definition"],["LE.le","lean4","definiti