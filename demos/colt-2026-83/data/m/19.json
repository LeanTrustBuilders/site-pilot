[{"id":272,"name":"Learning.IdentAlg.IsRun.klDiv_map_out_le_tsum_compProd","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.RunDivergence","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"a2db6bb3a9f3efa3","local":"9456b576c3b231a2","content":"afbbfe3f7fc70cc7"},"doc":"**Change of measure at a stopping time**, composition-product form: for two runs of the same\nidentification algorithm in two stationary environments with reward kernels `κ` and `κ'`, with\nalmost surely finite stopping times, the divergence between the laws of the outputs is at most\nthe series over the rounds `t` of the conditional divergences of the reward kernels given the\nplayed action, on the event that the algorithm has not stopped after `t` rounds. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"𝓐","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓨","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓓","role":"type","type":"Type u_3","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓨","role":"instance","type":"MeasurableSpace 𝓨","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓓","role":"instance","type":"MeasurableSpace 𝓓","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_4","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω'","role":"type","type":"Type u_5","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'","