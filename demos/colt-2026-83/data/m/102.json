":false,"name":"","role":"instance","type":"DecidableEq n"},{"explicit":false,"name":"B","role":"variable","type":"Matrix n n ℝ"},{"explicit":false,"name":"l","role":"variable","type":"ℝ"},{"explicit":true,"name":"hB","role":"hypothesis","type":"B.IsHermitian"},{"explicit":true,"name":"hl","role":"hypothesis","type":"∀ x ∈ spectrum ℝ B, x ≠ l"}],"conclusion":"(B - l • 1)⁻¹.trace = ∑ i, (hB.eigenvalues i - l)⁻¹","decl":"Matrix.IsHermitian.trace_inv_sub_smul_one"},"code":"/-- `tr (B - l • 1)⁻¹ = ∑ i, (λ i - l)⁻¹` for a symmetric matrix `B` with eigenvalues `λ i` and\n`l` outside its spectrum. -/\nlemma IsHermitian.trace_inv_sub_smul_one (hB : B.IsHermitian)\n    (hl : ∀ x ∈ spectrum ℝ B, x ≠ l) :\n    (B - l • 1)⁻¹.trace = ∑ i, (hB.eigenvalues i - l)⁻¹","proof":":= by\n  rw [hB.inv_sub_smul_one_eq_cfc hl, hB.trace_cfc_real]","source":{"path":"Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean","start":122,"end":127,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean#L122-L127"},"deps":[],"outside":[],"external":[["AddCommMonoid.toAddMonoid","mathlib","instance"],["Algebra.id","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["DecidableEq","lean4","definition"],["Eq","lean4","inductive"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HSMul.hSMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Inv.inv","lean4","definition"],["InvolutiveStar.toStar","mathlib","instance"],["Matrix","mathlib","definition"],["Matrix.IsHermitian","mathlib","definition"],["Matrix.IsHermitian.eigenvalues","mathlib","definition"],["Matrix.instAlgebra","mathlib","instance"],["Matrix.instRing","mathlib","instance"],["Matrix.inv","mathlib","instance"],["Matrix.one","mathlib","instance"],["Matrix.smul","mathlib","instance"],["Matrix.sub","mathlib","instance"],["Matrix.trace","mathlib","definition"],["Membership