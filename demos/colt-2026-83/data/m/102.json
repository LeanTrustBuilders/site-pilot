/\nlemma IsHermitian.trace_cfc (hA : A.IsHermitian) (f : ℝ → ℝ) :\n    (cfc f A).trace = ∑ i, (f (hA.eigenvalues i) : 𝕜)","proof":":= by\n  rw [hA.cfc_eq, IsHermitian.cfc, Unitary.conjStarAlgAut_apply, trace_mul_cycle,\n    Unitary.coe_star_mul_self, one_mul, trace_diagonal]\n  rfl","source":{"path":"Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean","start":49,"end":54,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean#L49-L54"},"deps":[],"outside":[],"external":[["AddCommMonoid.toAddMonoid","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["DecidableEq","lean4","definition"],["DenselyNormedField.toNormedField","mathlib","instance"],["DivisionRing.toRing","mathlib","instance"],["Eq","lean4","inductive"],["Field.toCommRing","mathlib","instance"],["Field.toDivisionRing","mathlib","instance"],["Field.toSemifield","mathlib","instance"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["InvolutiveStar.toStar","mathlib","instance"],["IsSelfAdjoint","mathlib","definition"],["IsTopologicalRing.toIsTopologicalSemiring","mathlib","instance"],["Matrix","mathlib","definition"],["Matrix.IsHermitian","mathlib","definition"],["Matrix.IsHermitian.eigenvalues","mathlib","definition"],["Matrix.IsHermitian.instContinuousFunctionalCalculus","mathlib","instance"],["Matrix.instAlgebra","mathlib","instance"],["Matrix.instRing","mathlib","instance"],["Matrix.instStar","mathlib","instance"],["Matrix.instStarRing","mathlib","instance"],["Matrix.trace","mathlib","definition"],["MetricSpace.toPseudoMetricSpace","mathlib","instance"],["NonUnitalCommRing.toNonUnitalNonAssocCommRing","mathlib","instance"],["NonUnitalNonAssocCommRing.toNonUnitalNonAssocRing","mathlib","instance"],["NonUnitalNonAssocRing.toNonUnitalNonAssocSemiring","mathlib","instance"],["NonUnitalNonAssocSe