[{"id":1459,"name":"Matrix.continuousOn_spectrum_real","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Matrix.HermitianCFC","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"3fe56825a8ee0c8c","local":"1b075ad1034f14f4","content":"2cce3c744f9211b9"},"doc":"Every real function is continuous on the (finite) spectrum of a matrix. ","statement":{"binders":[{"explicit":false,"name":"𝕜","role":"type","type":"Type u_1"},{"explicit":false,"name":"n","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"RCLike 𝕜"},{"explicit":false,"name":"","role":"instance","type":"Fintype n"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq n"},{"explicit":true,"name":"A","role":"variable","type":"Matrix n n 𝕜"},{"explicit":true,"name":"f","role":"variable","type":"ℝ → ℝ"}],"conclusion":"ContinuousOn f (spectrum ℝ A)","decl":"Matrix.continuousOn_spectrum_real"},"code":"/-- Every real function is continuous on the (finite) spectrum of a matrix. -/\nlemma continuousOn_spectrum_real (A : Matrix n n 𝕜) (f : ℝ → ℝ) :\n    ContinuousOn f (spectrum ℝ A)","proof":":=\n  A.finite_real_spectrum.continuousOn f","source":{"path":"Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean","start":56,"end":59,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean#L56-L59"},"deps":[],"outside":[],"external":[["ContinuousOn","mathlib","definition"],["DecidableEq","lean4","definition"],["DenselyNormedField.toNormedField","mathlib","instance"],["DivisionRing.toRing","mathlib","instance"],["Field.toDivisionRing","mathlib","instance"],["Fintype","mathlib","class"],["Matrix","mathlib","definition"],["Matrix.instAlgebra","mathlib","instance"],["Matrix.instRing","mathlib","instance"],["NormedAlgebra.toAlgebra","mathlib","instance"],["NormedCommRing.toSeminormedCommRing","mathlib","instance"],["NormedField.toField","mathlib","instance"],["NormedField.toNor