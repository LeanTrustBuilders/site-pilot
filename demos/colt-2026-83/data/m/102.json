 every `x` in the spectrum of the Hermitian\nmatrix `A`. ","statement":{"binders":[{"explicit":false,"name":"𝕜","role":"type","type":"Type u_1"},{"explicit":false,"name":"n","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"RCLike 𝕜"},{"explicit":false,"name":"","role":"instance","type":"Fintype n"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq n"},{"explicit":false,"name":"A","role":"variable","type":"Matrix n n 𝕜"},{"explicit":false,"name":"l","role":"variable","type":"ℝ"},{"explicit":true,"name":"hA","role":"hypothesis","type":"A.IsHermitian"}],"conclusion":"(A - l • 1).PosDef ↔ ∀ x ∈ spectrum ℝ A, l < x","decl":"Matrix.IsHermitian.posDef_sub_smul_one_iff"},"code":"/-- `A - l • 1` is positive definite iff `l < x` for every `x` in the spectrum of the Hermitian\nmatrix `A`. -/\nlemma IsHermitian.posDef_sub_smul_one_iff (hA : A.IsHermitian) :\n    (A - l • 1).PosDef ↔ ∀ x ∈ spectrum ℝ A, l < x","proof":":= by\n  constructor\n  · intro h x hx\n    have hx' : x - l ∈ spectrum ℝ (A - l • 1) := by\n      rw [hA.sub_smul_one_eq_cfc, cfc_map_spectrum _ A hA.isSelfAdjoint\n        (continuousOn_spectrum_real _ _)]\n      exact ⟨x, hx, rfl⟩\n    exact sub_pos.1 (h.pos_of_mem_spectrum hx')\n  · intro h\n    refine (hA.posSemidef_sub_smul_one_iff.2 fun x hx ↦ (h x hx).le).posDef_iff_isUnit.2 ?_\n    rw [hA.sub_smul_one_eq_cfc, isUnit_cfc_iff _ A (continuousOn_spectrum_real _ _)]\n    exact fun x hx ↦ sub_ne_zero.2 (h x hx).ne'","source":{"path":"Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean","start":95,"end":109,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Matrix/HermitianCFC.lean#L95-L109"},"deps":[],"outside":[],"external":[["AddCommMonoid.toAddMonoid","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddGroupWithOne.toAddGroup","mathlib","instance"],["AddGroupWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoi