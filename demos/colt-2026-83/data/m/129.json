[{"id":1699,"name":"MeasureTheory.Measure.ext_of_mgf_id_eq","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.Mathlib.Probability.Moments.ExtOfMGF","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"93a0c5b7b1bb4880","local":"113f1269d1235d3f","content":"d5e2750c5c9f78ab"},"doc":"**Moment generating functions determine distributions**, for two measures on `ℝ`. ","statement":{"binders":[{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"Measure ℝ","typeRefs":[[0,7,"MeasureTheory.Measure"],[8,9,"Real"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ'","role":"variable","type":"Measure ℝ","typeRefs":[[0,7,"MeasureTheory.Measure"],[8,9,"Real"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"IsFiniteMeasure μ'","typeRefs":[[0,15,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"h0","role":"hypothesis","type":"0 ∈ interior (ProbabilityTheory.integrableExpSet id μ)","typeRefs":[[2,3,"Membership.mem"],[4,12,"interior"],[14,48,"ProbabilityTheory.integrableExpSet"],[49,51,"id"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"h","role":"hypothesis","type":"ProbabilityTheory.mgf id μ = ProbabilityTheory.mgf id μ'","typeRefs":[[0,21,"ProbabilityTheory.mgf"],[22,24,"id"],[27,28,"Eq"],[29,50,"ProbabilityTheory.mgf"],[51,53,"id"]]}],"conclusion":"μ = μ'","conclusionHead":"Eq","conclusionRefs":[[2,3,"Eq"]],"decl":"MeasureTheory.Measure.ext_of_mgf_id_eq"},"code":"/-- **Moment generating functions determine distributions**, for two measures on `ℝ`. -/\ntheorem _root_.MeasureTheory.Measure.ext_of_mgf_id_eq {μ μ' : Measure ℝ} [IsProbabilityMeasure μ]\n    [IsFiniteMeasure μ'] (h0 : 0 ∈ interior (integrableExpSet id μ))\n    (h : mgf id μ = mgf id μ') :\n    μ = μ'","proof":":= by\n  simpa using Measure.ext_of_mgf_eq aemeasurable_id aemeasurable_id h0 h","source":{"path":"Maiti2026Power/Mathlib/Probability/Moments/ExtOfMGF.lean","start":95,"end":100,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Moments/ExtOfMGF.lean#L95-L100"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["Membership.mem","lean4","definition"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.integrableExpSet","mathlib","definition"],["ProbabilityTheory.mgf","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instZero","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.instMembership","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["id","lean4","definition"],["interior","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["Eq","MeasureTheory.IsFiniteMeasure","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","Membership.mem","OfNat.ofNat","ProbabilityTheory.integrableExpSet","ProbabilityTheory.mgf","PseudoMetricSpace.toUniformSpace","Real","Real.instZero","Real.measurableSpace","Real.pseudoMetricSpace","Set","Set.instMembership","UniformSpace.toTopologicalSpace","Zero.toOfNat0","id","interior"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1700,"name":"MeasureTheory.Measure.ext_of_eqOn_mgf","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.Mathlib.Probability.Moments.ExtOfMGF","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"83899ef12808f802","local":"255573df1fb9b3f2","content":"3e1af4ee6c1c84d5"},"doc":"**Moment generating functions determine distributions**, local form: if the moment generating\nfunctions of `X` and `Y` are finite in a neighbourhood of `0` and agree near `0`, then `X` and `Y`\nhave the same law. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω'","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"Measure Ω","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ'","role":"variable","type":"Measure Ω'","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"Ω → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":false,"implicit":true,"name":"Y","role":"variable","type":"Ω' → ℝ","typeRefs":[[5,6,"Real"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"IsFiniteMeasure μ'","typeRefs":[[0,15,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":true,"head":"AEMeasurable","implicit":false,"name":"hX","role":"hypothesis","type":"AEMeasurable X μ","typeRefs":[[0,12,"AEMeasurable"]]},{"explicit":true,"head":"AEMeasurable","implicit":false,"name":"hY","role":"hypothesis","type":"AEMeasurable Y μ'","typeRefs":[[0,12,"AEMeasurable"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hX0","role":"hypothesis","type":"0 ∈ interior (ProbabilityTheory.integrableExpSet X μ)","typeRefs":[[2,3,"Membership.mem"],[4,12,"interior"],[14,48,"ProbabilityTheory.integrableExpSet"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hY0","role":"hypothesis","type":"0 ∈ interior (ProbabilityTheory.integrableExpSet Y μ')","typeRefs":[[2,3,"Membership.mem"],[4,12,"interior"],[14,48,"ProbabilityTheory.integrableExpSet"]]},{"explicit":true,"head":"Filter.EventuallyEq","implicit":false,"name":"h","role":"hypothesis","type":"ProbabilityTheory.mgf X μ =ᶠ[nhds 0] ProbabilityTheory.mgf Y μ'","typeRefs":[[0,21,"ProbabilityTheory.mgf"],[26,29,"Filter.EventuallyEq"],[29,33,"nhds"],[37,58,"ProbabilityTheory.mgf"]]}],"conclusion":"map X μ = map Y μ'","conclusionHead":"Eq","conclusionRefs":[[0,3,"MeasureTheory.Measure.map"],[8,9,"Eq"],[10,13,"MeasureTheory.Measure.map"]],"decl":"MeasureTheory.Measure.ext_of_eqOn_mgf"},"code":"/-- **Moment generating functions determine distributions**, local form: if the moment generating\nfunctions of `X` and `Y` are finite in a neighbourhood of `0` and agree near `0`, then `X` and `Y`\nhave the same law. -/\ntheorem _root_.MeasureTheory.Measure.ext_of_eqOn_mgf [IsProbabilityMeasure μ] [IsFiniteMeasure μ']\n    (hX : AEMeasurable X μ) (hY : AEMeasurable Y μ')\n    (hX0 : 0 ∈ interior (integrableExpSet X μ)) (hY0 : 0 ∈ interior (integrableExpSet Y μ'))\n    (h : mgf X μ =ᶠ[nhds 0] mgf Y μ') :\n    μ.map X = μ'.map Y","proof":":= by\n  have : IsProbabilityMeasure (μ.map X) := inferInstance\n  have : IsFiniteMeasure (μ'.map Y) := by\n    constructor\n    rw [Measure.map_apply_of_aemeasurable hY MeasurableSet.univ]\n    exact measure_lt_top _ _\n  -- the common vertical strip on which both `complexMGF` are analytic\n  set S : Set ℝ := interior (integrableExpSet X μ) ∩ interior (integrableExpSet Y μ') with hS\n  set T : Set ℂ := {z : ℂ | z.re ∈ S} with hT\n  have hS0 : (0 : ℝ) ∈ S := ⟨hX0, hY0⟩\n  have hSconv : Convex ℝ S :=\n    convex_integrableExpSet.interior.inter convex_integrableExpSet.interior\n  have hTconn : IsPreconnected T := (hSconv.linear_preimage Complex.reLm).isPreconnected\n  have hXan : AnalyticOnNhd ℂ (complexMGF X μ) T :=\n    analyticOnNhd_complexMGF.mono fun z hz ↦ hz.1\n  have hYan : AnalyticOnNhd ℂ (complexMGF Y μ') T :=\n    analyticOnNhd_complexMGF.mono fun z hz ↦ hz.2\n  -- the two functions agree frequently near `0`, along the real axis\n  have hfreq : ∃ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, complexMGF X μ z = complexMGF Y μ' z := by\n    have hreal : ∃ᶠ x : ℝ in nhdsWithin 0 {(0 : ℝ)}ᶜ, complexMGF X μ x = complexMGF Y μ' x := by\n      refine Filter.Eventually.frequently ?_\n      filter_upwards [h.filter_mono nhdsWithin_le_nhds] with x hx\n      rw [complexMGF_ofReal, complexMGF_ofReal, hx]\n    rw [Filter.frequently_iff_seq_forall] at hreal ⊢\n    obtain ⟨xs, hx_tendsto, hx_eq⟩ := hreal\n    refine ⟨fun n ↦ xs n, ?_, fun n ↦ by simp [hx_eq n]⟩\n    rw [tendsto_nhdsWithin_iff] at hx_tendsto ⊢\n    refine ⟨?_, by simpa using hx_tendsto.2⟩\n    have := (Complex.continuous_ofReal.tendsto (0 : ℝ)).comp hx_tendsto.1\n    simpa [Function.comp_def] using this\n  have hEqOn : Set.EqOn (complexMGF X μ) (complexMGF Y μ') T :=\n    hXan.eqOn_of_preconnected_of_frequently_eq hYan hTconn (z₀ := 0) (by simp [hT, hS0]) hfreq\n  refine Measure.ext_of_charFun (funext fun t ↦ ?_)\n  rw [← complexMGF_mul_I hX, ← complexMGF_mul_I hY]\n  exact hEqOn (by simp [hT, hS0])","source":{"path":"Maiti2026Power/Mathlib/Probability/Moments/ExtOfMGF.lean","start":42,"end":83,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Moments/ExtOfMGF.lean#L42-L83"},"deps":[],"outside":[],"external":[["AEMeasurable","mathlib","definition"],["Eq","lean4","inductive"],["Filter.EventuallyEq","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["Membership.mem","lean4","definition"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.integrableExpSet","mathlib","definition"],["ProbabilityTheory.mgf","mathlib","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instZero","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.instMembership","mathlib","instance"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["interior","mathlib","definition"],["nhds","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AEMeasurable","Eq","Filter.EventuallyEq","MeasurableSpace","MeasureTheory.IsFiniteMeasure","MeasureTheory.IsProbabilityMeasure","MeasureTheory.Measure","MeasureTheory.Measure.map","Membership.mem","OfNat.ofNat","ProbabilityTheory.integrableExpSet","ProbabilityTheory.mgf","PseudoMetricSpace.toUniformSpace","Real","Real.instZero","Real.measurableSpace","Real.pseudoMetricSpace","Set","Set.instMembership","UniformSpace.toTopologicalSpace","Zero.toOfNat0","interior","nhds"],"provenance":null,"edited":{"commit":"a186fa77a556d263c25357c09c05e183335de320","date":"2026-09-10"}},{"id":1701,"name":"MeasureTheory.Measure.ext_of_mgf_eq","kind":"Theorem","keyword":"theorem","module":"Maiti2026Power.Mathlib.Probability.Moments.ExtOfMGF","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"f7a463f185ed6d1f","local":"8c3c1d5d9d9eef31","content":"a307f37fa2c9a9f8"},"doc":"**Moment generating functions determine distributions**: if two random variables have the same\nmoment generating function, and it is finite in a neighbourhood of `0`, then they have the same\nlaw. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"Ω'","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ'","role":"instance","type":"MeasurableSpace Ω'","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"Measure Ω","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ'","role":"variable","type":"Measure Ω'","typeRefs":[[0,7,"MeasureTheory.Measure"]]},{"explicit":false,"implicit":true,"name":"X","role":"variable","type":"Ω → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":false,"implicit":true,"name":"Y","role":"variable","type":"Ω' → ℝ","typeRefs":[[5,6,"Real"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"IsProbabilityMeasure μ","typeRefs":[[0,20,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"IsFiniteMeasure μ'","typeRefs":[[0,15,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":true,"head":"AEMeasurable","implicit":false,"name":"hX","role":"hypothesis","type":"AEMeasurable X μ","typeRefs":[[0,12,"AEMeasurable"]]},{"explicit":true,"head":"AEMeasurable","implicit":false,"name":"hY","role":"hypothesis","type":"AEMeasurable Y μ'","typeRefs":[[0,12,"AEMeasurable"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"h0","role":"hypothesis","type":"0 ∈ interior (ProbabilityTheory.integrableExpSet X μ)","typeRefs":[[2,3,"Membership.mem"],[4,12,"interior"],[14,48,"ProbabilityTheory.integrableExpSet"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"h","role":"hypothesis","type":"ProbabilityTheory.mgf X μ = ProbabilityTheory.mgf Y μ'","typeRefs":[[0,21,"ProbabilityTheory.mgf"],[26,27,"Eq"],[28,49,"ProbabilityTheory.mgf"]]}],"conclusion":"map X μ = map Y μ'","conclusionHead":"Eq","conclusionRefs":[[0,3,"MeasureTheory.Measure.map"],[8,9,"Eq"],[10,13,"MeasureTheory.Measure.map"]],"decl":"MeasureTheory.Measure.ext_of_mgf_eq"},"code":"/-- **Moment generating functions determine distributions**: if two random variables have the same\nmoment generating function, and it is finite in a neighbourhood of `0`, then they have the same\nlaw. -/\ntheorem _root_.MeasureTheory.Measure.ext_of_mgf_eq [IsProbabilityMeasure μ] [IsFiniteMeasure μ']\n    (hX : AEMeasurable X μ) (hY : AEMeasurable Y μ')\n    (h0 : 0 ∈ interior (integrableExpSet X μ)) (h : mgf X μ = mgf Y μ') :\n    μ.map X = μ'.map Y","proof":":=\n  Measure.ext_of_eqOn_mgf hX hY h0 (by rwa [← integrableExpSet_eq_of_mgf h])\n    (Filter.Eventually.of_forall fun x ↦ congrFun h x)","source":{"path":"Maiti2026Power/Mathlib/Probability/Moments/ExtOfMGF.lean","start":85,"end":93,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/Moments/ExtOfMGF.lean#L85-L93"},"deps":[],"outside":[],"external":[["AEMeasurable","mathlib","definition"],["Eq","lean4","inductive"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition