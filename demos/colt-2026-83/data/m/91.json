[{"id":1362,"name":"partialSupInner_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"6c9e40c7264cfde0","local":"793aa800b9e7a4c6","content":"e19bb67b82a999a5"},"doc":"","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":false,"name":"n","role":"variable","type":"ℕ"},{"explicit":false,"name":"v","role":"variable","type":"E"},{"explicit":false,"name":"c","role":"variable","type":"ℝ"},{"explicit":true,"name":"h","role":"hypothesis","type":"∀ (i : Fin (n + 1)), inner ℝ (q ↑i) v ≤ c"}],"conclusion":"partialSupInner q n v ≤ c","decl":"partialSupInner_le"},"code":"lemma partialSupInner_le {q : ℕ → E} {n : ℕ} {v : E} {c : ℝ} (h : ∀ i : Fin (n + 1), ⟪q i, v⟫ ≤ c) :\n    partialSupInner q n v ≤ c","proof":":= by\n  unfold partialSupInner\n  exact ciSup_le h","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":42,"end":45,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L42-L45"},"deps":[1366],"outside":[],"external":[["Fin","lean4","structure"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Nat","lean4","inductive"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["iSup","mathlib","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1363,"name":"partialSupInner_le_supportFn","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"27b0274b78e3ba88","local":"343f906284dd4eff","content":"e44bcf5fa8747c7c"},"doc":"","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"K","role":"variable","type":"Set E"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":false,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":true,"name":"hq","role":"hypothesis","type":"∀ (n : ℕ), q n ∈ K"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ K, ‖x‖ ≤ R"},{"explicit":true,"name":"n","role":"variable","type":"ℕ"},{"explicit":true,"name":"v","role":"variable","type":"E"}],"conclusion":"partialSupInner q n v ≤ supportFn K v","decl":"partialSupInner_le_supportFn"},"code":"lemma partialSupInner_le_supportFn {q : ℕ → E} (hq : ∀ n, q n ∈ K) (hR : ∀ x ∈ K, ‖x‖ ≤ R)\n    (n : ℕ) (v : E) : partialSupInner q n v ≤ supportFn K v","proof":":=\n  partialSupInner_le fun i ↦ inner_le_supportFn hR (hq i) v","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":59,"end":61,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L59-L61"},"deps":[1345,1366],"outside":[],"external":[["Fin","lean4","structure"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["iSup","mathlib","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1364,"name":"exists_forall_supportFn_eq_iSup","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"3c4be40b4baa383e","local":"b9d693469f6d51ec","content":"43df2f2a66988924"},"doc":"**The support function of a compact set is a supremum over a dense sequence**\n(blueprint `lem:sup_countable_dense`): for a nonempty compact `K` in a separable space there is\na sequence `q` of points of `K` with `supportFn K v = ⨆ n, ⟪q n, v⟫` for every `v`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"K","role":"variable","type":"Set E"},{"explicit":false,"name":"","role":"instance","type":"SecondCountableTopology E"},{"explicit":true,"name":"hK","role":"hypothesis","type":"IsCompact K"},{"explicit":true,"name":"hne","role":"hypothesis","type":"K.Nonempty"}],"conclusion":"∃ q, (∀ (n : ℕ), q n ∈ K) ∧ ∀ (v : E), supportFn K v = ⨆ n, inner ℝ (q n) v","decl":"exists_forall_supportFn_eq_iSup"},"code":"/-- **The support function of a compact set is a supremum over a dense sequence**\n(blueprint `lem:sup_countable_dense`): for a nonempty compact `K` in a separable space there is\na sequence `q` of points of `K` with `supportFn K v = ⨆ n, ⟪q n, v⟫` for every `v`. -/\nlemma exists_forall_supportFn_eq_iSup [SecondCountableTopology E] (hK : IsCompact K)\n    (hne : K.Nonempty) :\n    ∃ q : ℕ → E, (∀ n, q n ∈ K) ∧ ∀ v, supportFn K v = ⨆ n, ⟪q n, v⟫","proof":":= by\n  obtain ⟨R, hR⟩ : ∃ R, ∀ x ∈ K, ‖x‖ ≤ R := by\n    obtain ⟨r, hr⟩ := hK.isBounded.subset_closedBall (0 : E)\n    exact ⟨r, fun x hx ↦ mem_closedBall_zero_iff.1 (hr hx)⟩\n  have : Nonempty K := hne.to_subtype\n  obtain ⟨q, hq⟩ := TopologicalSpace.exists_dense_seq K\n  refine ⟨fun n ↦ (q n : E), fun n ↦ (q n).2, fun v ↦ le_antisymm ?_ ?_⟩\n  · obtain ⟨x, hx, hxv⟩ := exists_supportFn_eq_inner hK hne v\n    rw [hxv]\n    refine le_of_forall_pos_le_add fun ε hε ↦ ?_\n    obtain ⟨n, hn⟩ := Metric.denseRange_iff.1 hq ⟨x, hx⟩ (ε / (1 + ‖v‖)) (by positivity)\n    rw [Subtype.dist_eq, dist_eq_norm] at hn\n    have h1 : ⟪x, v⟫ - ⟪(q n : E), v⟫ ≤ ε := by\n      calc ⟪x, v⟫ - ⟪(q n : E), v⟫ = ⟪x - q n, v⟫ := (inner_sub_left _ _ _).symm\n        _ ≤ ‖x - q n‖ * ‖v‖ := real_inner_le_norm _ _\n        _ ≤ ε / (1 + ‖v‖) * ‖v‖ := by gcongr\n        _ ≤ ε := by\n            rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]\n            nlinarith [norm_nonneg v]\n    calc ⟪x, v⟫ ≤ ⟪(q n : E), v⟫ + ε := by linarith\n      _ ≤ (⨆ n, ⟪(q n : E), v⟫) + ε := by\n          gcongr\n          exact le_ciSup (bddAbove_range_inner_seq (fun n ↦ (q n).2) hR v) n\n  · exact ciSup_le fun n ↦ inner_le_supportFn hR (q n).2 v","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":63,"end":91,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L63-L91"},"deps":[1345],"outside":[],"external":[["And","lean4","structure"],["Eq","lean4","inductive"],["Exists","lean4","inductive"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["IsCompact","mathlib","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["SecondCountableTopology","mathlib","class"],["SeminormedAddCommGroup.toPseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.Nonempty","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["iSup","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1365,"name":"inner_le_partialSupInner","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"0a8b5b07f1486622","local":"49fbd9b8e47d9ae6","content":"5a362e33df6fd265"},"doc":"","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":true,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":false,"name":"n","role":"variable","type":"ℕ"},{"explicit":true,"name":"i","role":"variable","type":"Fin (n + 1)"},{"explicit":true,"name":"v","role":"variable","type":"E"}],"conclusion":"inner ℝ (q ↑i) v ≤ partialSupInner q n v","decl":"inner_le_partialSupInner"},"code":"lemma inner_le_partialSupInner (q : ℕ → E) {n : ℕ} (i : Fin (n + 1)) (v : E) :\n    ⟪q i, v⟫ ≤ partialSupInner q n v","proof":":= by\n  unfold partialSupInner\n  exact le_ciSup (Finite.bddAbove_range fun i : Fin (n + 1) ↦ ⟪q i, v⟫) i","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":37,"end":40,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L37-L40"},"deps":[1366],"outside":[],"external":[["Fin","lean4","structure"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Nat","lean4","inductive"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["iSup","mathlib","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1366,"name":"partialSupInner","kind":"Definition","keyword":"def","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"ea569fbd472ea169","local":"9002b9dce6e758df","content":"6e1373729eadf51c"},"doc":"The partial maxima `max_{i ≤ n} ⟪q i, v⟫` of the linear forms of a sequence `q`. ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":true,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":true,"name":"n","role":"variable","type":"ℕ"},{"explicit":true,"name":"v","role":"variable","type":"E"}],"conclusion":"ℝ","decl":"partialSupInner","value":"⨆ i, inner ℝ (q ↑i) v"},"code":"/-- The partial maxima `max_{i ≤ n} ⟪q i, v⟫` of the linear forms of a sequence `q`. -/\nnoncomputable def partialSupInner (q : ℕ → E) (n : ℕ) (v : E) : ℝ := ⨆ i : Fin (n + 1), ⟪q i, v⟫","proof":"","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":28,"end":29,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L28-L29"},"deps":[],"outside":[],"external":[["Fin","lean4","structure"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["Nat","lean4","inductive"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["iSup","mathlib","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[1362,1363,1365,1368,1369,1370],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1367,"name":"bddAbove_range_inner_seq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"c0294295091d5e6f","local":"951b2ac4d0ea3e7a","content":"b540278c707dcc14"},"doc":"","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"K","role":"variable","type":"Set E"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":false,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":true,"name":"hq","role":"hypothesis","type":"∀ (n : ℕ), q n ∈ K"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ K, ‖x‖ ≤ R"},{"explicit":true,"name":"v","role":"variable","type":"E"}],"conclusion":"BddAbove (Set.range fun n => inner ℝ (q n) v)","decl":"bddAbove_range_inner_seq"},"code":"lemma bddAbove_range_inner_seq {q : ℕ → E} (hq : ∀ n, q n ∈ K) (hR : ∀ x ∈ K, ‖x‖ ≤ R)\n    (v : E) : BddAbove (Set.range fun n ↦ ⟪q n, v⟫)","proof":":=\n  ⟨R * ‖v‖, by\n    rintro _ ⟨n, rfl⟩\n    exact (real_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_right (hR _ (hq n)) (norm_nonneg _))⟩","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":31,"end":35,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L31-L35"},"deps":[],"outside":[],"external":[["BddAbove","mathlib","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Set","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Set.range","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1368,"name":"monotone_partialSupInner","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"d9e05220da45e6d2","local":"58f71911c616c2e9","content":"fe8115630116efdc"},"doc":"","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":true,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":true,"name":"v","role":"variable","type":"E"}],"conclusion":"Monotone fun n => partialSupInner q n v","decl":"monotone_partialSupInner"},"code":"lemma monotone_partialSupInner (q : ℕ → E) (v : E) : Monotone fun n ↦ partialSupInner q n v","proof":":=\n  monotone_nat_of_le_succ fun n ↦ partialSupInner_le fun i ↦\n    (inner_le_partialSupInner q (Fin.castSucc i) v).trans_eq' (by simp)","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":47,"end":49,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L47-L49"},"deps":[1366],"outside":[],"external":[["Fin","lean4","structure"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["Monotone","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instPreorder","mathlib","instance"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instPreorder","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["iSup","mathlib","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1369,"name":"tendsto_partialSupInner","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"fa13b3bb86f1087d","local":"3cc1fcaa1a039981","content":"ea5e2ff5e1aa62c7"},"doc":"The partial maxima `max_{i ≤ n} ⟪q i, v⟫` converge to `supportFn K v` when `q` is dense in\nthe compact set `K` (in the sense of `exists_forall_supportFn_eq_iSup`). ","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"K","role":"variable","type":"Set E"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":false,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":true,"name":"hq","role":"hypothesis","type":"∀ (n : ℕ), q n ∈ K"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ K, ‖x‖ ≤ R"},{"explicit":true,"name":"hsup","role":"hypothesis","type":"∀ (v : E), supportFn K v = ⨆ n, inner ℝ (q n) v"},{"explicit":true,"name":"v","role":"variable","type":"E"}],"conclusion":"Filter.Tendsto (fun n => partialSupInner q n v) Filter.atTop (nhds (supportFn K v))","decl":"tendsto_partialSupInner"},"code":"/-- The partial maxima `max_{i ≤ n} ⟪q i, v⟫` converge to `supportFn K v` when `q` is dense in\nthe compact set `K` (in the sense of `exists_forall_supportFn_eq_iSup`). -/\nlemma tendsto_partialSupInner {q : ℕ → E} (hq : ∀ n, q n ∈ K) (hR : ∀ x ∈ K, ‖x‖ ≤ R)\n    (hsup : ∀ v, supportFn K v = ⨆ n, ⟪q n, v⟫) (v : E) :\n    Tendsto (fun n ↦ partialSupInner q n v) atTop (𝓝 (supportFn K v))","proof":":= by\n  have hbdd : BddAbove (Set.range fun n ↦ partialSupInner q n v) :=\n    ⟨supportFn K v, by\n      rintro _ ⟨n, rfl⟩\n      exact partialSupInner_le_supportFn hq hR n v⟩\n  have heq : (⨆ n, partialSupInner q n v) = supportFn K v := by\n    refine le_antisymm (ciSup_le fun n ↦ partialSupInner_le_supportFn hq hR n v) ?_\n    rw [hsup v]\n    refine ciSup_le fun n ↦ ?_\n    calc ⟪q n, v⟫ = ⟪q (Fin.last n : Fin (n + 1)), v⟫ := by simp\n      _ ≤ partialSupInner q n v := inner_le_partialSupInner q _ v\n      _ ≤ ⨆ n, partialSupInner q n v := le_ciSup hbdd n\n  rw [← heq]\n  exact tendsto_atTop_ciSup (monotone_partialSupInner q v) hbdd","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":93,"end":110,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L93-L110"},"deps":[1345,1366],"outside":[],"external":[["Eq","lean4","inductive"],["Filter.Tendsto","mathlib","definition"],["Filter.atTop","mathlib","definition"],["Fin","lean4","structure"],["Fin.val","lean4","definition"],["HAdd.hAdd","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace","mathlib","class"],["InnerProductSpace.toInner","mathlib","instance"],["LE.le","lean4","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Nat.instPreorder","mathlib","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup","mathlib","class"],["NormedAddCommGroup.toNorm","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["PseudoMetricSpace.toUniformSpace","mathlib","instance"],["Real","mathlib","structure"],["Real.instLE","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instSupSet","mathlib","instance"],["Real.pseudoMetricSpace","mathlib","instance"],["Set","mathlib","definition"],["Set.Elem","mathlib","definition"],["Set.instMembership","mathlib","instance"],["Subtype.val","lean4","definition"],["UniformSpace.toTopologicalSpace","mathlib","instance"],["iSup","mathlib","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"],["nhds","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"4331bcfc997cd6c327fd20f1a82d742694479612","date":"2026-09-07"}},{"id":1370,"name":"abs_partialSupInner_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Analysis.InnerProductSpace.SupportFnDense","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"08b62d44a59ca7cf","local":"f9ff7a74fa508af4","content":"952a9540279b53d0"},"doc":"","statement":{"binders":[{"explicit":false,"name":"E","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"NormedAddCommGroup E"},{"explicit":false,"name":"","role":"instance","type":"InnerProductSpace ℝ E"},{"explicit":false,"name":"K","role":"variable","type":"Set E"},{"explicit":false,"name":"R","role":"variable","type":"ℝ"},{"explicit":false,"name":"q","role":"variable","type":"ℕ → E"},{"explicit":true,"name":"hq","role":"hypothesis","type":"∀ (n : ℕ), q n ∈ K"},{"explicit":true,"name":"hR","role":"hypothesis","type":"∀ x ∈ K, ‖x‖ ≤ R"},{"explicit":true,"name":"n","role":"variable","type":"ℕ"},{"explicit":true,"name":"v","role":"variable","type":"E"}],"conclusion":"|partialSupInner q n v| ≤ R * ‖v‖","decl":"abs_partialSupInner_le"},"code":"lemma abs_partialSupInner_le {q : ℕ → E} (hq : ∀ n, q n ∈ K) (hR : ∀ x ∈ K, ‖x‖ ≤ R) (n : ℕ)\n    (v : E) : |partialSupInner q n v| ≤ R * ‖v‖","proof":":= by\n  have hb : ∀ i : Fin (n + 1), |⟪q i, v⟫| ≤ R * ‖v‖ := fun i ↦\n    (abs_real_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_right (hR _ (hq i)) (norm_nonneg _))\n  refine abs_le.2 ⟨?_, partialSupInner_le fun i ↦ (le_abs_self _).trans (hb i)⟩\n  calc -(R * ‖v‖) ≤ ⟪q (0 : Fin (n + 1)), v⟫ := neg_le.2 ((neg_le_abs _).trans (hb 0))\n    _ ≤ partialSupInner q n v := inner_le_partialSupInner q 0 v","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean","start":51,"end":57,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/SupportFnDense.lean#L51-L57"},"dep