[{"id":1448,"name":"InformationTheory.klDiv_map_of_leftInverse","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.InformationTheory.KLMap","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"908547e98ce6103f","local":"ae56047d7380da24","content":"600255050dff07e5"},"doc":"The Kullback–Leibler divergence is invariant under a measurable map with a measurable left\ninverse. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"α","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"β","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mα","role":"instance","type":"MeasurableSpace α","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mβ","role":"instance","type":"MeasurableSpace β","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"μ","role":"variable","type":"MeasureTheory.Measure α","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"ν","role":"variable","type":"MeasureTheory.Measure α","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure μ","typeRefs":[[0,29,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":false,"head":"MeasureTheory.IsFiniteMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsFiniteMeasure ν","typeRefs":[[0,29,"MeasureTheory.IsFiniteMeasure"]]},{"explicit":false,"implicit":true,"name":"f","role":"variable","type":"α → β","typeRefs":[]},{"explicit":false,"implicit":true,"name":"g","role":"variable","type":"β → α","typeRefs":[]},{"explicit":true,"head":"Measurable","implicit":false,"name":"hf","role":"hypothesis","type":"Measurable f","typeRefs":[[0,10,"Measurable"]]},{"explicit":true,"head":"Measurable","implicit":false,"name":"hg","role":"hypothesis","type":"Measurable g","typeRefs":[[0,10,"Measurable"]]},{"explicit":true,"head":"Function.LeftInverse","implicit":false,"name":"hgf","role":"hypothesis","type":"Function.LeftInverse g f","typeRefs":[[0,20,"Function.LeftInverse"]]}],"conclusion":"klDiv (MeasureTheory.Measure.map f μ) (MeasureTheory.Measure.map f ν) = klDiv μ ν","conclusionHead":"Eq","conclusionRefs":[[0,5,"InformationTheory.klDiv"],[7,32,"MeasureTheory.Measure.map"],[39,64,"MeasureTheory.Measure.map"],[70,71,"Eq"],[72,77,"InformationTheory.klDiv"]],"decl":"InformationTheory.klDiv_map_of_leftInverse"},"code":"/-- The Kullback–Leibler divergence is invariant under a measurable map with a measurable left\ninverse. -/\nlemma klDiv_map_of_leftInverse {f : α → β} {g : β → α} (hf : Measurable f) (hg : Measurable g)\n    (hgf : Function.LeftInverse g f) :\n    klDiv (μ.map f) (ν.map f) = klDiv μ ν","proof":":= by\n  refine le_antisymm (klDiv_map_le μ ν hf) ?_\n  have h := klDiv_map_le (μ.map f) (ν.map f) hg\n  rwa [Measure.map_map hg hf, Measure.map_map hg hf, hgf.comp_eq_id, Measure.map_id,\n    Measure.map_id] at h","source":{"path":"Maiti2026Power/Mathlib/InformationTheory/KLMap.lean","start":27,"end":35,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/InformationTheory/KLMap.lean#L27-L35"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["Eq","lean4","inductive"],["Function.LeftInverse","lean4","definition"],["InformationTheory.klDiv","mathlib","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.IsFiniteMeasure","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],