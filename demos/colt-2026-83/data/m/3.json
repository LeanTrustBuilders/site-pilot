[{"id":26,"name":"ProbabilityTheory.Kernel.prodMkLeft_withDensity","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.EnvDensity","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"5adc9ef1b02d8eb1","local":"76f6746009bf70b3","content":"f2aca7cb803cd3f5"},"doc":"`prodMkLeft` of a kernel with a density. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":true,"name":"γ","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace γ"},{"explicit":true,"name":"κ","role":"variable","type":"Kernel α β"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel κ"},{"explicit":false,"name":"ρ","role":"variable","type":"α → β → ENNReal"},{"explicit":true,"name":"hρ","role":"hypothesis","type":"Measurable (Function.uncurry ρ)"}],"conclusion":"prodMkLeft γ (κ.withDensity ρ) = (prodMkLeft γ κ).withDensity fun p b => ρ p.2 b","decl":"ProbabilityTheory.Kernel.prodMkLeft_withDensity"},"code":"/-- `prodMkLeft` of a kernel with a density. -/\nlemma prodMkLeft_withDensity (γ : Type*) [MeasurableSpace γ] (κ : Kernel α β)\n    [IsSFiniteKernel κ] {ρ : α → β → ℝ≥0∞} (hρ : Measurable (Function.uncurry ρ)) :\n    (κ.withDensity ρ).prodMkLeft γ = (κ.prodMkLeft γ).withDensity (fun p b ↦ ρ p.2 b)","proof":":= by\n  have hρ' : Measurable (Function.uncurry fun (p : γ × α) b ↦ ρ p.2 b) :=\n    hρ.comp (measurable_fst.snd.prodMk measurable_snd)\n  ext p s hs\n  rw [prodMkLeft_apply', Kernel.withDensity_apply' _ hρ, Kernel.withDensity_apply' _ hρ',\n    prodMkLeft_apply]","source":{"path":"Maiti2026Power/LeanMachineLearning/EnvDensity.lean","start":55,"end":63,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/EnvDensity.lean#L55-L63"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["ENNReal.measurableSpace","mathlib","instance"],["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.IsSFiniteKernel.prodMkLeft","mathlib","instance"],["ProbabilityTheory.Kernel.prodMkLeft","mathlib","definition"],["ProbabilityTheory.Kernel.withDensity","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":27,"name":"ProbabilityTheory.Kernel.compProd_withDensity_right","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.EnvDensity","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"16d4d9c99d552761","local":"2c09bacbe2000b64","content":"75c0c82f0b8cab09"},"doc":"**A composition-product of kernels with a density on the right factor**:\n`κ ⊗ₖ (η.withDensity f) = (κ ⊗ₖ η).withDensity (fun a (b, c) ↦ f (a, b) c)`. ","statement":{"binders":[{"explicit":false,"name":"α","role":"type","type":"Type u_1"},{"explicit":false,"name":"β","role":"type","type":"Type u_2"},{"explicit":false,"name":"γ","role":"type","type":"Type u_3"},{"explicit":false,"name":"mα","role":"instance","type":"MeasurableSpace α"},{"explicit":false,"name":"mβ","role":"instance","type":"MeasurableSpace β"},{"explicit":false,"name":"mγ","role":"instance","type":"MeasurableSpace γ"},{"explicit":true,"name":"κ","role":"variable","type":"Kernel α β"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel κ"},{"explicit":true,"name":"η","role":"variable","type":"Kernel (α × β) γ"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel η"},{"explicit":false,"name":"f","role":"variable","type":"α × β → γ → ENNReal"},{"explicit":true,"name":"hf","role":"hypothesis","type":"Measurable (Function.uncurry f)"},{"explicit":false,"name":"","role":"instance","type":"IsSFiniteKernel (η.withDensity f)"}],"conclusion":"κ.compProd (η.withDensity f) = (κ.compProd η).withDensity fun a p => f (a, p.1) p.2","decl":"ProbabilityTheory.Kernel.compProd_withDensity_right"},"code":"/-- **A composition-product of kernels with a density on the right factor**:\n`κ ⊗ₖ (η.withDensity f) = (κ ⊗ₖ η).withDensity (fun a (b, c) ↦ f (a, b) c)`. -/\nlemma compProd_withDensity_right (κ : Kernel α β) [IsSFiniteKernel κ] (η : Kernel (α × β) γ)\n    [IsSFiniteKernel η] {f : α × β → γ → ℝ≥0∞} (hf : Measurable (Function.uncurry f))\n    [IsSFiniteKernel (η.withDensity f)] :\n    κ ⊗ₖ η.withDensity f = (κ ⊗ₖ η).withDensity (fun a p ↦ f (a, p.1) p.2)","proof":":= by\n  have hg : Measurable (Function.uncurry fun a (p : β × γ) ↦ f (a, p.1) p.2) := by\n    change Measurable fun q : α × (β × γ) ↦ Function.uncurry f ((q.1, q.2.1), q.2.2)\n    exact hf.comp (by fun_prop)\n  ext a s hs\n  have hind : Measurable (s.indicator fun p : β × γ ↦ f (a, p.1) p.2) :=\n    (hg.comp measurable_prodMk_left).indicator hs\n  rw [Kernel.compProd_apply hs, Kernel.withDensity_apply' _ hg a s, ← lintegral_indicator hs,\n    Kernel.lintegral_compProd _ _ _ hind]\n  congr with b\n  rw [Kernel.withDensity_apply' _ hf, ← lintegral_indicator (measurable_prodMk_left hs)]\n  rfl","source":{"path":"Maiti2026Power/LeanMachineLearning/EnvDensity.lean","start":37,"end":53,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/EnvDensity.lean#L37-L53"},"deps":[],"outside":[],"external":[["ENNReal","mathlib","definition"],["ENNReal.measurableSpace","mathlib","instance"],["Eq","lean4","inductive"],["Function.uncurry","lean4","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["ProbabilityTheory.IsSFiniteKernel","mathlib","class"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.IsSFiniteKernel.compProd","mathlib","instance"],["ProbabilityTheory.Kernel.compProd","mathlib","definition"],["ProbabilityTheory.Kernel.withDensity","mathlib","definition"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.instMeasurableSpace","mathlib","instance"],["Prod.mk","lean4","constructor"],["Prod.snd","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":28,"name":"Learning.envDensity_snoc","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.EnvDensity","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"fb10579eb70f93b8","local":"220eaf88ea652f8b","content":"6eb46cb5d6ccce66"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":true,"name":"ρ","role":"variable","type":"𝓐 → 𝓨 → ENNReal"},{"explicit":false,"name":"n","role":"variable","type":"ℕ"},{"explicit":true,"name":"h","role":"variable","type":"Hist Unit 𝓐 𝓨 n"},{"explicit":true,"name":"p","role":"variable","type":"Round Unit 𝓐 𝓨"}],"conclusion":"envDensity ρ (n + 1) (Fin.snoc h p) = envDensity ρ n h * ρ p.action p.feedback","decl":"Learning.envDensity_snoc"},"code":"lemma envDensity_snoc (ρ : 𝓐 → 𝓨 → ℝ≥0∞) {n : ℕ} (h : Hist Unit 𝓐 𝓨 n) (p : Round Unit 𝓐 𝓨) :\n    envDensity ρ (n + 1) (Fin.snoc h p) = envDensity ρ n h * ρ p.action p.feedback","proof":":= by\n  simp [envDensity, Fin.prod_univ_castSucc]","source":{"path":"Maiti2026Power/LeanMachineLearning/EnvDensity.lean","start":87,"end":89,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/EnvDensity.lean#L87-L89"},"deps":[29],"outside":[],"external":[["CommSemiring.toCommMonoid","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instCommSemiring","mathlib","instance"],["Eq","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Fin.snoc","mathlib","definition"],["Finset.prod","mathlib","definition"],["Finset.univ","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["HMul.hMul","lean4","definition"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["Learning.Round.action","LeanMachineLearning","definition"],["Learning.Round.feedback","LeanMachineLearning","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["Unit","lean4","definition"],["instAddNat","lean4","instance"],["instDistribOfSemiring","mathlib","instance"],["instHAdd","lean4","instance"],["instHMul","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":29,"name":"Learning.envDensity","kind":"Definition","keyword":"def","module":"Maiti2026Power.LeanMachineLearning.EnvDensity","package":"Maiti2026Power","isProp":false,"hashes":{"meaning":"92be81f10128d986","local":"c7227f0e25bba8e5","content":"d165aebd4dcac87d"},"doc":"The product of the one-step densities `ρ (x t) (y t)` along a history of length `n`. ","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":true,"name":"ρ","role":"variable","type":"𝓐 → 𝓨 → ENNReal"},{"explicit":true,"name":"n","role":"variable","type":"ℕ"},{"explicit":true,"name":"h","role":"variable","type":"Hist Unit 𝓐 𝓨 n"}],"conclusion":"ENNReal","decl":"Learning.envDensity","value":"∏ t, ρ (h t).action (h t).feedback"},"code":"/-- The product of the one-step densities `ρ (x t) (y t)` along a history of length `n`. -/\nnoncomputable def envDensity (ρ : 𝓐 → 𝓨 → ℝ≥0∞) (n : ℕ) (h : Hist Unit 𝓐 𝓨 n) : ℝ≥0∞ :=\n  ∏ t, ρ (h t).action (h t).feedback","proof":"","source":{"path":"Maiti2026Power/LeanMachineLearning/EnvDensity.lean","start":71,"end":73,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/EnvDensity.lean#L71-L73"},"deps":[],"outside":[],"external":[["CommSemiring.toCommMonoid","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instCommSemiring","mathlib","instance"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.prod","mathlib","definition"],["Finset.univ","mathlib","definition"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.Round.action","LeanMachineLearning","definition"],["Learning.Round.feedback","LeanMachineLearning","definition"],["Nat","lean4","inductive"],["Unit","lean4","definition"]],"users":[28,30,31,32,600],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":30,"name":"Learning.measurable_envDensity","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.EnvDensity","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"bb3ddfa5e00780cf","local":"e31cf13b4133778c","content":"6a05fbbd2dcd5132"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"ρ","role":"variable","type":"𝓐 → 𝓨 → ENNReal"},{"explicit":true,"name":"hρ","role":"hypothesis","type":"Measurable (Function.uncurry ρ)"},{"explicit":true,"name":"n","role":"variable","type":"ℕ"}],"conclusion":"Measurable (envDensity ρ n)","decl":"Learning.measurable_envDensity"},"code":"@[fun_prop]\nlemma measurable_envDensity (hρ : Measurable (Function.uncurry ρ)) (n : ℕ) :\n    Measurable (envDensity ρ n)","proof":":=\n  Finset.measurable_prod _ fun t _ ↦ hρ.comp (measurable_pi_apply t).snd","source":{"path":"Maiti2026Power/LeanMachineLearning/EnvDensity.lean","start":77,"end":80,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/EnvDensity.lean#L77-L80"},"deps":[29],"outside":[],"external":[["CommSemiring.toCommMonoid","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.measurableSpace","mathlib","instance"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.prod","mathlib","definition"],["Finset.univ","mathlib","definition"],["Function.uncurry","lean4","definition"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.Round","LeanMachineLearning","definition"],["Learning.Round.action","LeanMachineLearning","definition"],["Learning.Round.feedback","LeanMachineLearning","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["Nat","lean4","inductive"],["PUnit.instMeasurableSpace","mathlib","instance"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Unit","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":31,"name":"Learning.envDensity_zero","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.EnvDensity","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"4a38d6efc93229c8","local":"e2b5262f0544ee42","content":"8cd1b6294554552e"},"doc":"","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":true,"name":"ρ","role":"variable","type":"𝓐 → 𝓨 → ENNReal"},{"explicit":true,"name":"h","role":"variable","type":"Hist Unit 𝓐 𝓨 0"}],"conclusion":"envDensity ρ 0 h = 1","decl":"Learning.envDensity_zero"},"code":"lemma envDensity_zero (ρ : 𝓐 → 𝓨 → ℝ≥0∞) (h : Hist Unit 𝓐 𝓨 0) : envDensity ρ 0 h = 1","proof":":= by\n  simp [envDensity]","source":{"path":"Maiti2026Power/LeanMachineLearning/EnvDensity.lean","start":83,"end":84,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/EnvDensity.lean#L83-L84"},"deps":[29],"outside":[],"external":[["CommSemiring.toCommMonoid","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.instOne","mathlib","instance"],["Eq","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.prod","mathlib","definition"],["Finset.univ","mathlib","definition"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.Round.action","LeanMachineLearning","definition"],["Learning.Round.feedback","LeanMachineLearning","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Unit","lean4","definition"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}},{"id":32,"name":"Learning.IsAlgEnvSeq.map_history_eq_withDensity_env","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.LeanMachineLearning.EnvDensity","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"46ad725677495815","local":"42713fde8ad5ce8f","content":"a9543706356ec9f7"},"doc":"**Environment likelihood ratio** (blueprint `lem:env_likelihood_ratio`): if\n`κ = κ₀.withDensity ρ`, then for any algorithm the law of the history of the first `n` rounds\nunder the stationary environment with kernel `κ` is the law under the environment with kernel\n`κ₀`, with density `envDensity ρ n = ∏ t < n, ρ (x t) (y t)`. ","statement":{"binders":[{"explicit":false,"name":"𝓐","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓨","role":"type","type":"Type u_2"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace 𝓨"},{"explicit":false,"name":"ρ","role":"variable","type":"𝓐 → 𝓨 → ENNReal"},{"explicit":false,"name":"Ω","role":"type","type":"Type u_3"},{"explicit":false,"name":"Ω₀","role":"type","type":"Type u_4"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSpace Ω₀"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"P₀","role":"variable","type":"MeasureTheory.Measure Ω₀"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P₀"},{"explicit":false,"name":"O","role":"variable","type":"ℕ → Ω → Unit"},{"explicit":false,"name":"X","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → 𝓨"},{"explicit":false,"name":"O₀","role":"variable","type":"ℕ → Ω₀ → Unit"},{"explicit":false,"name":"X₀","role":"variable","type":"ℕ → Ω₀ → 𝓐"},{"explicit":false,"name":"Y₀","role":"variable","type":"ℕ → Ω₀ → 𝓨"},{"explicit":false,"name":"alg","role":"variable","type":"Algorithm Unit 𝓐 𝓨"},{"explicit":false,"name":"κ₀","role":"variable","type":"ProbabilityTheory.Kernel 𝓐 𝓨"},{"explicit":false,"name":"κ","role":"variable","type":"ProbabilityTheory.Kernel 𝓐 𝓨"},{"explicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel κ₀"},{"explicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel κ"},{"explicit":true,"name":"hρ","role":"hypothesis","type":"Measurable (Function.uncurry ρ)"},{"explicit":true,"name":"hκ","role":"hypothesis","type":"κ = κ₀.withDensity ρ"},{"explicit":true,"name":"h","role":"hypothesis","type":"IsAlgEnvSeq O X Y alg (stationaryEnv κ) P"},{"explicit":true,"name":"h₀","role":"hypothesis","type":"IsAlgEnvSeq O₀ X₀ Y₀ alg (stationaryEnv κ₀) P₀"},{"explicit":true,"name":"n","role":"variable","type":"ℕ"}],"conclusion":"MeasureTheory.Measure.map (history O X Y n) P =\n  (MeasureTheory.Measure.map (history O₀ X₀ Y₀ n) P₀).withDensity (envDensity ρ n)","decl":"Learning.IsAlgEnvSeq.map_history_eq_withDensity_env"},"code":"/-- **Environment likelihood ratio** (blueprint `lem:env_likelihood_ratio`): if\n`κ = κ₀.withDensity ρ`, then for any algorithm the law of the history of the first `n` rounds\nunder the stationary environment with kernel `κ` is the law under the environment with kernel\n`κ₀`, with density `envDensity ρ n = ∏ t < n, ρ (x t) (y t)`. -/\nlemma IsAlgEnvSeq.map_history_eq_withDensity_env (hρ : Measurable (Function.uncurry ρ))\n    (hκ : κ = κ₀.withDensity ρ) (h : IsAlgEnvSeq O X Y alg (stationaryEnv κ) P)\n    (h₀ : IsAlgEnvSeq O₀ X₀ Y₀ alg (stationaryEnv κ₀) P₀) (n : ℕ) :\n    P.map (history O X Y n) = (P₀.map (history O₀ X₀ Y₀ n)).withDensity (envDensity ρ n)","proof":":= by\n  induction n with\n  | zero =>\n    rw [(hasLaw_history_zero O X Y).map_eq, (hasLaw_history_zero O₀ X₀ Y₀).map_eq,\n      show envDensity ρ 0 = 1 from funext (envDensity_zero ρ), withDensity_one]\n  | succ n ih =>\n    have hs : stepKernel alg (stationaryEnv κ) n =\n        (stepKernel alg (stationaryEnv κ₀) n).withDensity fun _ p ↦ ρ p.action p.feedback := by\n      have hρ' : Measurable\n          (Function.uncurry fun (p : (Hist Unit 𝓐 𝓨 n × Unit) × 𝓐) b ↦ ρ p.2 b) :=\n        hρ.comp (measurable_fst.snd.prodMk measurable_snd)\n      have hρ'' : Measurable\n          (Function.uncurry fun (_ : Hist Unit 𝓐 𝓨 n × Unit) (p : 𝓐 × 𝓨) ↦ ρ p.1 p.2) :=\n        hρ.comp (measurable_snd.fst.prodMk measurable_snd.snd)\n      have i1 : IsSFiniteKernel ((κ₀.prodMkLeft (Hist Unit 𝓐 𝓨 n × Unit)).withDensity\n          fun p b ↦ ρ p.2 b) := by\n        rw [← Kernel.prodMkLeft_withDensity _ _ hρ, ← hκ]\n        infer_instance\n      have h1 : stepKernel alg (stationaryEnv κ) n =\n          Kernel.const _ (Measure.dirac ()) ⊗ₖ (alg.policy n ⊗ₖ\n            (κ₀.prodMkLeft (Hist Unit 𝓐 𝓨 n × Unit)).withDensity fun p b ↦ ρ p.2 b) := by\n        rw [stepKernel_def, obs_stationaryEnv, feedback_stationaryEnv, hκ,\n          Kernel.prodMkLeft_withDensity _ _ hρ]\n      have h2 : alg.policy n ⊗ₖ\n            (κ₀.prodMkLeft (Hist Unit 𝓐 𝓨 n × Unit)).withDensity (fun p b ↦ ρ p.2 b) =\n          (alg.policy n ⊗ₖ κ₀.prodMkLeft (Hist Unit 𝓐 𝓨 n × Unit)).withDensity\n            fun _ p ↦ ρ p.1 p.2 :=\n        Kernel.compProd_withDensity_right _ _ hρ'\n      have i2 : IsSFiniteKernel\n          ((alg.policy n ⊗ₖ κ₀.prodMkLeft (Hist Unit 𝓐 𝓨 n × Unit)).withDensity\n            fun _ p ↦ ρ p.1 p.2) := by\n        rw [← h2]\n        infer_instance\n      rw [h1, h2, Kernel.compProd_withDensity_right _ _ hρ'']\n      rfl\n    have : IsMarkovKernel ((stepKernel alg (stationaryEnv κ₀) n).withDensity\n        fun _ p ↦ ρ p.action p.feedback) := by\n      rw [← hs]\n      infer_instance\n    rw [h.map_history_succ, h₀.map_history_succ, ih, hs,\n      Measure.withDensity_compProd_withDensity (by fun_prop) (by fun_prop),\n      map_equiv_withDensity (by fun_prop)]\n    congr 1\n    funext q\n    obtain ⟨h', p, rfl⟩ : ∃ h' p,\n        q = (MeasurableEquiv.finSuccProd (Round Unit 𝓐 𝓨) n).symm (h', p) :=\n      ⟨_, _, (MeasurableEquiv.symm_apply_apply _ q).symm⟩\n    have hq : (MeasurableEquiv.finSuccProd (Round Unit 𝓐 𝓨) n) (Fin.snoc h' p) = (h', p) := by\n      simp\n    simp only [Function.comp_apply, MeasurableEquiv.symm_symm,\n      MeasurableEquiv.finSuccProd_symm_apply, hq, envDensity_snoc]","source":{"path":"Maiti2026Power/LeanMachineLearning/EnvDensity.lean","start":99,"end":156,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/LeanMachineLearning/EnvDensity.lean#L99-L156"},"deps":[29],"outside":[],"external":[["CommSemiring.toCommMonoid","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instCommSemiring","mathlib","instance"],["ENNReal.measurableSpace","mathlib","instance"],["Eq","lean4","inductive"],["Fin","lean4","structure"],["Fin.fintype","mathlib","instance"],["Finset.prod","mathlib","definition"],["Finset.univ","mathlib","definition"],["Function.uncurry","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Hist","LeanMachineLearning","definition"],["Learning.IsAlgEnvSeq","LeanMachineLearning","structure"],["Learning.Round","LeanMachineLearning","definition"],["Learning.Round.action","LeanMachineLearning","definition"],["Learning.Round.feedback","LeanMachineLearning","definition"],["Learning.history","LeanMachineLearning","definition"],["Learning.stationaryEnv","LeanMachineLearning","definition"],["Measurable","mathlib","definition"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.IsProbabilityMeasure","mathlib","class"],["MeasureTheory.IsZeroOrProbabilityMeasure.toIsFiniteMeasure","mathlib","instance"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.map","mathlib","definition"],["MeasureTheory.Measure.withDensity","mathlib","definition"],["MeasureTheory.instIsZeroOrProbabilityMeasureOfIsProbabilityMeasure","mathlib","instance"],["Nat","lean4","inductive"],["PUnit.instMeasurableSpace","mathlib","instance"],["ProbabilityTheory.IsMarkovKernel","mathlib","class"],["ProbabilityTheory.IsMarkovKernel.IsZeroOrMarkovKernel","mathlib","instance"],["ProbabilityTheory.IsZeroOrMarkovKernel.isFiniteKernel","mathlib","instance"],["ProbabilityTheory.Kernel","mathlib","structure"],["ProbabilityTheory.Kernel.IsFiniteKernel.isSFiniteKernel","mathlib","instance"],["ProbabilityTheory.Kernel.withDensity","mathlib","definition"],["Prod","lean4","structure"],["Prod.instMeasurableSpace","mathlib","instance"],["Unit","lean4","definition"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"f1a92e33571fde49fce6355928bb1a73476e5a39","date":"2026-09-13"}}]