[{"id":1282,"name":"Finset.sum_mul_sub_mul_eq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Algebra.Order.BigOperators.Covariance","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"43c2d0922d4ff9f9","local":"2f7e26e95fb12027","content":"6e757688e7b84dcb"},"doc":"The weighted covariance is the weighted sum of the centered products. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"R","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"CommRing","implicit":false,"name":"","role":"instance","type":"CommRing R","typeRefs":[[0,8,"CommRing"]]},{"explicit":false,"head":"Finset","implicit":true,"name":"s","role":"variable","type":"Finset ι","typeRefs":[[0,6,"Finset"]]},{"explicit":false,"implicit":true,"name":"p","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":false,"implicit":true,"name":"a","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":false,"implicit":true,"name":"b","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":true,"head":"Eq","implicit":false,"name":"hp1","role":"hypothesis","type":"∑ i ∈ s, p i = 1","typeRefs":[[13,14,"Eq"]]}],"conclusion":"∑ i ∈ s, p i * (a i * b i) - (∑ i ∈ s, p i * a i) * ∑ i ∈ s, p i * b i =\n  ∑ i ∈ s, p i * ((a i - ∑ j ∈ s, p j * a j) * (b i - ∑ j ∈ s, p j * b j))","conclusionHead":"Eq","conclusionRefs":[[13,14,"HMul.hMul"],[20,21,"HMul.hMul"],[27,28,"HSub.hSub"],[43,44,"HMul.hMul"],[50,51,"HMul.hMul"],[65,66,"HMul.hMul"],[71,72,"Eq"],[88,89,"HMul.hMul"],[96,97,"HSub.hSub"],[111,112,"HMul.hMul"],[118,119,"HMul.hMul"],[125,126,"HSub.hSub"],[140,141,"HMul.hMul"]],"decl":"Finset.sum_mul_sub_mul_eq"},"code":"/-- The weighted covariance is the weighted sum of the centered products. -/\nlemma sum_mul_sub_mul_eq (hp1 : ∑ i ∈ s, p i = 1) :\n    ∑ i ∈ s, p i * (a i * b i) - (∑ i ∈ s, p i * a i) * (∑ i ∈ s, p i * b i)\n      = ∑ i ∈ s, p i * ((a i - ∑ j ∈ s, p j * a j) * (b i - ∑ j ∈ s, p j * b j))","proof":":= by\n  have : ∀ i, p i * ((a i - ∑ j ∈ s, p j * a j) * (b i - ∑ j ∈ s, p j * b j))\n      = p i * (a i * b i) - (∑ j ∈ s, p j * b j) * (p i * a i) - (∑ j ∈ s, p j * a j) * (p i * b i)\n        + (∑ j ∈ s, p j * a j) * (∑ j ∈ s, p j * b j) * p i :=\n    fun i ↦ by ring\n  simp_rw [this]\n  rw [sum_add_distrib, sum_sub_distrib, sum_sub_distrib, ← mul_sum, ← mul_sum, ← mul_sum, hp1]\n  ring","source":{"path":"Maiti2026Power/Mathlib/Algebra/Order/BigOperators/Covariance.lean","start":48,"end":58,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Algebra/Order/BigOperators/Covariance.lean#L48-L58"},"deps":[],"outside":[],"external":[["AddGroup.toSubNegMonoid","mathlib","instance"],["AddGroupWithOne.toAddGroup","mathlib","instance"],["AddGroupWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toOne","mathlib","instance"],["CommRing","mathlib","class"],["CommRing.toCommSemiring","mathlib","instance"],["CommRing.toRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["Eq","lean4","inductive"],["Finset","mathlib","structure"],["Finset.sum","mathlib","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Ring.toAddGroupWithOne","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["SubNegMonoid.toSub","mathlib","instance"],["instDistribOfSemiring","mathlib","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddGroup.toSubNegMonoid","AddGroupWithOne.toAddGroup","AddGroupWithOne.toAddMonoidWithOne","AddMonoidWithOne.toOne","CommRing","CommRing.toCommSemiring","CommRing.toRing","CommSemiring.toSemiring","Distrib.toMul","Eq","Finset","Finset.sum","HMul.hMul","HSub.hSub","OfNat.ofNat","One.toOfNat1","Ring.toAddGroupWithOne","Semiring.toAddCommMonoid","SubNegMonoid.toSub","instDistribOfSemiring","instHMul","instHSub"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1283,"name":"Finset.sum_mul_sq_sub_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Algebra.Order.BigOperators.Covariance","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"9a29329d014e1ea5","local":"bfb7170a07cc2fcd","content":"edea2b48217762a7"},"doc":"The weighted centered second moment of a family bounded by `C` is at most `C ^ 2`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"R","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"CommRing","implicit":false,"name":"","role":"instance","type":"CommRing R","typeRefs":[[0,8,"CommRing"]]},{"explicit":false,"head":"LinearOrder","implicit":false,"name":"","role":"instance","type":"LinearOrder R","typeRefs":[[0,11,"LinearOrder"]]},{"explicit":false,"head":"IsStrictOrderedRing","implicit":false,"name":"","role":"instance","type":"IsStrictOrderedRing R","typeRefs":[[0,19,"IsStrictOrderedRing"]]},{"explicit":false,"head":"Finset","implicit":true,"name":"s","role":"variable","type":"Finset ι","typeRefs":[[0,6,"Finset"]]},{"explicit":false,"implicit":true,"name":"p","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":true,"implicit":false,"name":"hp","role":"hypothesis","type":"∀ i ∈ s, 0 ≤ p i","typeRefs":[[11,12,"LE.le"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hp1","role":"hypothesis","type":"∑ i ∈ s, p i = 1","typeRefs":[[13,14,"Eq"]]},{"explicit":false,"implicit":true,"name":"c","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":false,"implicit":true,"name":"C","role":"variable","type":"R","typeRefs":[]},{"explicit":true,"implicit":false,"name":"hc","role":"hypothesis","type":"∀ i ∈ s, |c i| ≤ C","typeRefs":[[9,10,"abs"],[13,14,"abs"],[15,16,"LE.le"]]}],"conclusion":"∑ i ∈ s, p i * (c i - ∑ j ∈ s, p j * c j) ^ 2 ≤ C ^ 2","conclusionHead":"LE.le","conclusionRefs":[[13,14,"HMul.hMul"],[20,21,"HSub.hSub"],[35,36,"HMul.hMul"],[42,43,"HPow.hPow"],[46,47,"LE.le"],[50,51,"HPow.hPow"]],"decl":"Finset.sum_mul_sq_sub_le"},"code":"/-- The weighted centered second moment of a family bounded by `C` is at most `C ^ 2`. -/\nlemma sum_mul_sq_sub_le (hp : ∀ i ∈ s, 0 ≤ p i) (hp1 : ∑ i ∈ s, p i = 1) {c : ι → R} {C : R}\n    (hc : ∀ i ∈ s, |c i| ≤ C) :\n    ∑ i ∈ s, p i * (c i - ∑ j ∈ s, p j * c j) ^ 2 ≤ C ^ 2","proof":":= by\n  have h1 : ∑ i ∈ s, p i * (c i - ∑ j ∈ s, p j * c j) ^ 2\n      = ∑ i ∈ s, p i * c i ^ 2 - (∑ j ∈ s, p j * c j) ^ 2 := by\n    have : ∀ i, p i * (c i - ∑ j ∈ s, p j * c j) ^ 2\n        = p i * c i ^ 2 - (2 * ∑ j ∈ s, p j * c j) * (p i * c i) + (∑ j ∈ s, p j * c j) ^ 2 * p i :=\n      fun i ↦ by ring\n    simp_rw [this]\n    rw [sum_add_distrib, sum_sub_distrib, ← mul_sum, ← mul_sum, hp1]\n    ring\n  calc ∑ i ∈ s, p i * (c i - ∑ j ∈ s, p j * c j) ^ 2\n      ≤ ∑ i ∈ s, p i * c i ^ 2 := by rw [h1]; exact sub_le_self _ (sq_nonneg _)\n    _ ≤ ∑ i ∈ s, p i * C ^ 2 := sum_le_sum fun i hi ↦ mul_le_mul_of_nonneg_left\n        (sq_le_sq' (abs_le.1 (hc i hi)).1 (abs_le.1 (hc i hi)).2) (hp i hi)\n    _ = C ^ 2 := by rw [← sum_mul, hp1, one_mul]","source":{"path":"Maiti2026Power/Mathlib/Algebra/Order/BigOperators/Covariance.lean","start":29,"end":45,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Algebra/Order/BigOperators/Covariance.lean#L29-L45"},"deps":[],"outside":[],"external":[["AddGroup.toSubNegMonoid","mathlib","instance"],["AddGroupWithOne.toAddGroup","mathlib","instance"],["AddGroupWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toOne","mathlib","instance"],["CommRing","mathlib","class"],["CommRing.toCommSemiring","mathlib","instance"],["CommRing.toRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["DistribLattice.toLattice","mathlib","instance"],["Eq","lean4","inductive"],["Finset","mathlib","structure"],["Finset.instSetLike","mathlib","instance"],["Finset.sum","mathlib","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["HSub.hSub","lean4","definition"],["IsStrictOrderedRing","mathlib","class"],["LE.le","lean4","definition"],["Lattice.toSemilatticeInf","mathlib","instance"],["LinearOrder","mathlib","class"],["Membership.mem","lean4","definition"],["Monoid.toNPow","mathlib","instance"],["MulZeroClass.toZero","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLE","mathlib","instance"],["Ring.toAddGroupWithOne","mathlib","instance"],["SemilatticeInf.toPartialOrder","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["Semiring.toMonoid","mathlib","instance"],["SetLike.instMembership","mathlib","instance"],["SubNegMonoid.toSub","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["abs","mathlib","definition"],["instDistribLatticeOfLinearOrder","mathlib","instance"],["instDistribOfSemiring","mathlib","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instHSub","lean4","instance"],["instMulZeroClassOfSemiring","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddGroup.toSubNegMonoid","AddGroupWithOne.toAddGroup","AddGroupWithOne.toAddMonoidWithOne","AddMonoidWithOne.toOne","CommRing","CommRing.toCommSemiring","CommRing.toRing","CommSemiring.toSemiring","Distrib.toMul","DistribLattice.toLattice","Eq","Finset","Finset.instSetLike","Finset.sum","HMul.hMul","HPow.hPow","HSub.hSub","IsStrictOrderedRing","LE.le","Lattice.toSemilatticeInf","LinearOrder","Membership.mem","Monoid.toNPow","MulZeroClass.toZero","NPow.toPow","Nat","OfNat.ofNat","One.toOfNat1","PartialOrder.toPreorder","Preorder.toLE","Ring.toAddGroupWithOne","SemilatticeInf.toPartialOrder","Semiring.toAddCommMonoid","Semiring.toMonoid","SetLike.instMembership","SubNegMonoid.toSub","Zero.toOfNat0","abs","instDistribLatticeOfLinearOrder","instDistribOfSemiring","instHMul","instHPow","instHSub","instMulZeroClassOfSemiring","instOfNatNat"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1284,"name":"Finset.abs_sum_mul_sub_mul_le","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Algebra.Order.BigOperators.Covariance","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"6ba2ee48f20414fd","local":"b04a77b677d7a561","content":"d4d7d8395612dc49"},"doc":"**Bound on a weighted covariance**: if `p` is a probability vector on `s` and `|a i| ≤ A`,\n`|b i| ≤ B` on `s`, then\n`|∑ i ∈ s, p i * (a i * b i) - (∑ i ∈ s, p i * a i) * ∑ i ∈ s, p i * b i| ≤ A * B`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"ι","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"R","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"CommRing","implicit":false,"name":"","role":"instance","type":"CommRing R","typeRefs":[[0,8,"CommRing"]]},{"explicit":false,"head":"LinearOrder","implicit":false,"name":"","role":"instance","type":"LinearOrder R","typeRefs":[[0,11,"LinearOrder"]]},{"explicit":false,"head":"IsStrictOrderedRing","implicit":false,"name":"","role":"instance","type":"IsStrictOrderedRing R","typeRefs":[[0,19,"IsStrictOrderedRing"]]},{"explicit":false,"head":"Finset","implicit":true,"name":"s","role":"variable","type":"Finset ι","typeRefs":[[0,6,"Finset"]]},{"explicit":false,"implicit":true,"name":"p","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":false,"implicit":true,"name":"a","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":false,"implicit":true,"name":"b","role":"variable","type":"ι → R","typeRefs":[]},{"explicit":false,"implicit":true,"name":"A","role":"variable","type":"R","typeRefs":[]},{"explicit":false,"implicit":true,"name":"B","role":"variable","type":"R","typeRefs":[]},{"explicit":true,"implicit":false,"name":"hp","role":"hypothesis","type":"∀ i ∈ s, 0 ≤ p i","typeRefs":[[11,12,"LE.le"]]},{"explicit":true,"head":"Eq","implicit":false,"name":"hp1","role":"hypothesis","type":"∑ i ∈ s, p i = 1","typeRefs":[[13,14,"Eq"]]},{"explicit":true,"implicit":false,"name":"ha","role":"hypothesis","type":"∀ i ∈ s, |a i| ≤ A","typeRefs":[[9,10,"abs"],[13,14,"abs"],[15,16,"LE.le"]]},{"explicit":true,"implicit":false,"name":"hb","role":"hypothesis","type":"∀ i ∈ s, |b i| ≤ B","typeRefs":[[9,10,"abs"],[13,14,"abs"],[15,16,"LE.le"]]}],"conclusion":"|∑ i ∈ s, p i * (a i * b i) - (∑ i ∈ s, p i * a i) * ∑ i ∈ s, p i * b i| ≤ A * B","conclusionHead":"LE.le","conclusionRefs":[[0,1,"abs"],[14,15,"HMul.hMul"],[21,22,"HMul.hMul"],[28,29,"HSub.hSub"],[44,45,"HMul.hMul"],[51,52,"HMul.hMul"],[66,67,"HMul.hMul"],[71,72,"abs"],[73,74,"LE.le"],[77,78,"HMul.hMul"]],"decl":"Finset.abs_sum_mul_sub_mul_le"},"code":"/-- **Bound on a weighted covariance**: if `p` is a probability vector on `s` and `|a i| ≤ A`,\n`|b i| ≤ B` on `s`, then\n`|∑ i ∈ s, p i * (a i * b i) - (∑ i ∈ s, p i * a i) * ∑ i ∈ s, p i * b i| ≤ A * B`. -/\nlemma abs_sum_mul_sub_mul_le (hp : ∀ i ∈ s, 0 ≤ p i) (hp1 : ∑ i ∈ s, p i = 1)\n    (ha : ∀ i ∈ s, |a i| ≤ A) (hb : ∀ i ∈ s, |b i| ≤ B) :","proof":"|∑ i ∈ s, p i * (a i * b i) - (∑ i ∈ s, p i * a i) * (∑ i ∈ s, p i * b i)| ≤ A * B := by\n  obtain ⟨i₀, hi₀⟩ := nonempty_of_sum_ne_zero (hp1.trans_ne one_ne_zero)\n  have hA : 0 ≤ A := (abs_nonneg _).trans (ha i₀ hi₀)\n  have hB : 0 ≤ B := (abs_nonneg _).trans (hb i₀ hi₀)\n  rw [sum_mul_sub_mul_eq hp1]\n  refine abs_le_of_sq_le_sq ?_ (mul_nonneg hA hB)\n  rw [mul_pow]\n  refine (sum_sq_le_sum_mul_sum_of_sq_le_mul s\n    (f := fun i ↦ p i * (a i - ∑ j ∈ s, p j * a j) ^ 2)\n    (g := fun i ↦ p i * (b i - ∑ j ∈ s, p j * b j) ^ 2)\n    (fun i hi ↦ mul_nonneg (hp i hi) (sq_nonneg _))\n    (fun i hi ↦ mul_nonneg (hp i hi) (sq_nonneg _)) fun i _ ↦ le_of_eq (by ring)).trans ?_\n  exact mul_le_mul (sum_mul_sq_sub_le hp hp1 ha) (sum_mul_sq_sub_le hp hp1 hb)\n    (sum_nonneg fun i hi ↦ mul_nonneg (hp i hi) (sq_nonneg _)) (sq_nonneg _)","source":{"path":"Maiti2026Power/Mathlib/Algebra/Order/BigOperators/Covariance.lean","start":60,"end":78,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Algebra/Order/BigOperators/Covariance.lean#L60-L78"},"deps":[],"outside":[],"external":[["AddGroup.toSubNegMonoid","mathlib","instance"],["AddGroupWithOne.toAddGroup","mathlib","instance"],["AddGroupWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toOne","mathlib","instance"],["CommRing","mathlib","class"],["CommRing.toCommSemiring","mathlib","instance"],["CommRing.toRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["Distrib.toMul","mathlib","instance"],["DistribLattice.toLattice","mathlib","instance"],["Eq","lean4","inductive"],["Finset","mathlib","structure"],["Finset.instSetLike","mathlib","instance"],["Finset.sum","mathlib","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["IsStrictOrderedRing","mathlib","class"],["LE.le","lean4","definition"],["Lattice.toSemilatticeInf","mathlib","instance"],["LinearOrder","mathlib","class"],["Membership.mem","lean4","definition"],["MulZeroClass.toZero","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLE","mathlib","instance"],["Ring.toAddGroupWithOne","mathlib","instance"],["SemilatticeInf.toPartialOrder","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["SetLike.instMembership","mathlib","instance"],["SubNegMonoid.toSub","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["abs","mathlib","definition"],["instDistribLatticeOfLinearOrder","mathlib","instance"],["instDistribOfSemiring","mathlib","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"],["instMulZeroClassOfSemiring","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"directExternal":["AddGroup.toSubNegMonoid","AddGroupWithOne.toAddGroup","AddGroupWithOne.toAddMonoidWithOne","AddMonoidWithOne.toOne","CommRing","CommRing.toCommSemiring","CommRing.toRing","CommSemiring.toSemiring","Distrib.toMul","DistribLattice.toLattice","Eq","Finset","Finset.instSetLike","Finset.sum","HMul.hMul","HSub.hSub","IsStrictOrderedRing","LE.le","Lattice.toSemilatticeInf","LinearOrder","Membership.mem","MulZeroClass.toZero","OfNat.ofNat","One.toOfNat1","PartialOrder.toPreorder","Preorder.toLE","Ring.toAddGroupWithOne","SemilatticeInf.toPartialOrder","Semiring.toAddCommMonoid","SetLike.instMembership","SubNegMonoid.toSub","Zero.toOfNat0","abs","instDistribLatticeOfLinearOrder","instDistribOfSemiring","instHMul","instHSub","instMulZeroClassOfSemiring"],"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}}]