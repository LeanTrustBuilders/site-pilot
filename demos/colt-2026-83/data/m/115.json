[{"id":1569,"name":"ProbabilityTheory.integral_Ioi_mul_exp_neg_mul_sq","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.GaussianAbsMoment","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"b6084fd7fee0eef9","local":"d57c51f8c06012f7","content":"11c4179247b918ca"},"doc":"`∫_0^∞ x e^{-b x²} dx = 1 / (2 b)`. ","statement":{"binders":[{"explicit":false,"name":"b","role":"variable","type":"ℝ"},{"explicit":true,"name":"hb","role":"hypothesis","type":"0 < b"}],"conclusion":"∫ (x : ℝ) in Set.Ioi 0, x * Real.exp (-b * x ^ 2) = (2 * b)⁻¹","decl":"ProbabilityTheory.integral_Ioi_mul_exp_neg_mul_sq"},"code":"/-- `∫_0^∞ x e^{-b x²} dx = 1 / (2 b)`. -/\nlemma integral_Ioi_mul_exp_neg_mul_sq {b : ℝ} (hb : 0 < b) :\n    ∫ x in Ioi (0 : ℝ), x * rexp (-b * x ^ 2) = (2 * b)⁻¹","proof":":= by\n  have hderiv : ∀ x ∈ Ici (0 : ℝ),\n      HasDerivAt (fun x ↦ -(2 * b)⁻¹ * rexp (-b * x ^ 2)) (x * rexp (-b * x ^ 2)) x := by\n    intro x _\n    have h1 : HasDerivAt (fun x : ℝ ↦ -b * x ^ 2) (-b * (2 * x)) x := by\n      simpa using (hasDerivAt_pow 2 x).const_mul (-b)\n    have h2 : HasDerivAt (fun x ↦ -(2 * b)⁻¹ * rexp (-b * x ^ 2))\n        (-(2 * b)⁻¹ * (rexp (-b * x ^ 2) * (-b * (2 * x)))) x :=\n      h1.exp.const_mul (-(2 * b)⁻¹)\n    refine h2.congr_deriv ?_\n    field_simp\n  have hint : IntegrableOn (fun x : ℝ ↦ x * rexp (-b * x ^ 2)) (Ioi 0) :=\n    (integrable_mul_exp_neg_mul_sq hb).integrableOn\n  have hlim : Tendsto (fun x : ℝ ↦ -(2 * b)⁻¹ * rexp (-b * x ^ 2)) atTop (𝓝 0) := by\n    have h1 : Tendsto (fun x : ℝ ↦ -b * x ^ 2) atTop atBot := by\n      have := (tendsto_pow_atTop two_ne_zero).const_mul_atTop hb\n      simpa [neg_mul, Function.comp_def] using tendsto_neg_atTop_atBot.comp this\n    have := (Real.tendsto_exp_atBot.comp h1).const_mul (-(2 * b)⁻¹)\n    simpa [Function.comp_def] using this\n  rw [integral_Ioi_of_hasDerivAt_of_tendsto' hderiv hint hlim]\n  simp","source":{"path":"Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean","start":26,"end":48,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean#L26-L48"},"deps":[],"outside":[],"external":[["Eq","lean4","inductive"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["Inv.inv","lean4","definition"],["LT.lt","lean4","definition"],["MeasureTheory.Measure.restrict","mathlib","definition"],["MeasureTheory.MeasureSpace.toMeasurableSpace","mathlib","instance"],["MeasureTheory.MeasureSpace.volume","mathlib","definition"],["MeasureTheory.integral","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Neg.neg","lean4","definition"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.exp","mathlib","definition"],["Real.instInv","mathlib","instance"],["Real.instLT","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instNeg","mathlib","instance"],["Real.instPreorder","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.measureSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Set.Ioi","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1570,"name":"ProbabilityTheory.integral_abs_eval_multivariateGaussian","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.GaussianAbsMoment","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"9d4cf18ac050d3b3","local":"ddc252657a9a656a","content":"eed801e46510feb3"},"doc":"`E|Yᵢ| = √(2 Sᵢᵢ / π)` for `Y ~ N(0, S)`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":false,"name":"S","role":"variable","type":"Matrix ι ι ℝ"},{"explicit":true,"name":"hS","role":"hypothesis","type":"S.PosSemidef"},{"explicit":true,"name":"i","role":"variable","type":"ι"}],"conclusion":"∫ (x : EuclideanSpace ℝ ι), |x.ofLp i| ∂multivariateGaussian 0 S = √(2 * S i i / Real.pi)","decl":"ProbabilityTheory.integral_abs_eval_multivariateGaussian"},"code":"/-- `E|Yᵢ| = √(2 Sᵢᵢ / π)` for `Y ~ N(0, S)`. -/\nlemma integral_abs_eval_multivariateGaussian (hS : S.PosSemidef) (i : ι) :\n    ∫ x, |x i| ∂multivariateGaussian 0 S = √(2 * S i i / π)","proof":":= by\n  have h : MeasurePreserving (fun x : EuclideanSpace ℝ ι ↦ x i) (multivariateGaussian 0 S)\n      (gaussianReal 0 (S i i).toNNReal) := by\n    simpa using measurePreserving_eval_multivariateGaussian (μ := 0) hS (i := i)\n  have := integral_map (μ := multivariateGaussian 0 S) h.measurable.aemeasurable\n    (f := fun y : ℝ ↦ |y|) (by fun_prop)\n  rw [← this, h.map_eq, integral_abs_gaussianReal]\n  simp [Real.coe_toNNReal _ hS.diag_nonneg]","source":{"path":"Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean","start":73,"end":82,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean#L73-L82"},"deps":[],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Fintype","mathlib","class"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["Matrix","mathlib","definition"],["Matrix.PosSemidef","mathlib","definition"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.integral","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["NegZeroClass.toZero","mathlib","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["ProbabilityTheory.multivariateGaussian","mathlib","definition"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddGroup","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.pi","mathlib","definition"],["Real.sqrt","mathlib","definition"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.measurableSpace","mathlib","instance"],["WithLp.ofLp","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["abs","mathlib","definition"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1571,"name":"ProbabilityTheory.sum_mul_sqrt_diag_le_integral_norm_multivariateGaussian","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.GaussianAbsMoment","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"338a05aea54a049a","local":"de57f76be9d476aa","content":"4db54b86bf113a68"},"doc":"**Lower bound on the expected norm of a Gaussian vector**: for `Y ~ N(0, S)` and\nnonnegative weights `c` with `∑ cᵢ² ≤ 1`, `√(2/π) ∑ cᵢ √(Sᵢᵢ) = ∑ cᵢ E|Yᵢ| ≤ E‖Y‖`. ","statement":{"binders":[{"explicit":false,"name":"ι","role":"type","type":"Type u_1"},{"explicit":false,"name":"","role":"instance","type":"Fintype ι"},{"explicit":false,"name":"","role":"instance","type":"DecidableEq ι"},{"explicit":false,"name":"S","role":"variable","type":"Matrix ι ι ℝ"},{"explicit":true,"name":"hS","role":"hypothesis","type":"S.PosSemidef"},{"explicit":false,"name":"c","role":"variable","type":"ι → ℝ"},{"explicit":true,"name":"hc0","role":"hypothesis","type":"∀ (i : ι), 0 ≤ c i"},{"explicit":true,"name":"hc","role":"hypothesis","type":"∑ i, c i ^ 2 ≤ 1"}],"conclusion":"√(2 / Real.pi) * ∑ i, c i * √(S i i) ≤ ∫ (x : EuclideanSpace ℝ ι), ‖x‖ ∂multivariateGaussian 0 S","decl":"ProbabilityTheory.sum_mul_sqrt_diag_le_integral_norm_multivariateGaussian"},"code":"/-- **Lower bound on the expected norm of a Gaussian vector**: for `Y ~ N(0, S)` and\nnonnegative weights `c` with `∑ cᵢ² ≤ 1`, `√(2/π) ∑ cᵢ √(Sᵢᵢ) = ∑ cᵢ E|Yᵢ| ≤ E‖Y‖`. -/\nlemma sum_mul_sqrt_diag_le_integral_norm_multivariateGaussian (hS : S.PosSemidef) {c : ι → ℝ}\n    (hc0 : ∀ i, 0 ≤ c i) (hc : ∑ i, c i ^ 2 ≤ 1) :\n    √(2 / π) * ∑ i, c i * √(S i i) ≤ ∫ x, ‖x‖ ∂multivariateGaussian 0 S","proof":":= by\n  have hpt : ∀ x : EuclideanSpace ℝ ι, ∑ i, c i * |x i| ≤ ‖x‖ := by\n    intro x\n    have h1 := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ c fun i ↦ |x i|\n    have h2 : ∑ i, |x i| ^ 2 = ‖x‖ ^ 2 := by\n      rw [EuclideanSpace.real_norm_sq_eq]\n      simp [sq_abs]\n    have h3 : (∑ i, c i * |x i|) ^ 2 ≤ ‖x‖ ^ 2 := by\n      calc (∑ i, c i * |x i|) ^ 2 ≤ (∑ i, c i ^ 2) * ∑ i, |x i| ^ 2 := h1\n        _ ≤ 1 * ‖x‖ ^ 2 := by rw [h2]; gcongr\n        _ = ‖x‖ ^ 2 := one_mul _\n    exact (pow_le_pow_iff_left₀ (Finset.sum_nonneg fun i _ ↦ mul_nonneg (hc0 i) (abs_nonneg _))\n      (norm_nonneg _) two_ne_zero).1 h3\n  have hint : ∀ i, Integrable (fun x : EuclideanSpace ℝ ι ↦ |x i|) (multivariateGaussian 0 S) :=\n    fun i ↦ ((memLp_two_eval_multivariateGaussian 0 S i).integrable one_le_two).abs\n  calc √(2 / π) * ∑ i, c i * √(S i i)\n      = ∑ i, c i * ∫ x, |x i| ∂multivariateGaussian 0 S := by\n        rw [Finset.mul_sum]\n        refine Finset.sum_congr rfl fun i _ ↦ ?_\n        rw [integral_abs_eval_multivariateGaussian hS i, show 2 * S i i / π = 2 / π * S i i by ring,\n          Real.sqrt_mul (by positivity)]\n        ring\n    _ = ∫ x, ∑ i, c i * |x i| ∂multivariateGaussian 0 S := by\n        rw [integral_finsetSum _ fun i _ ↦ (hint i).const_mul _]\n        simp_rw [integral_const_mul]\n    _ ≤ ∫ x, ‖x‖ ∂multivariateGaussian 0 S :=\n        integral_mono (integrable_finsetSum _ fun i _ ↦ (hint i).const_mul _)\n          IsGaussian.integrable_id.norm hpt","source":{"path":"Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean","start":84,"end":115,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean#L84-L115"},"deps":[],"outside":[],"external":[["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DecidableEq","lean4","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["EuclideanSpace","mathlib","definition"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HPow.hPow","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["Matrix","mathlib","definition"],["Matrix.PosSemidef","mathlib","definition"],["MeasurableSpace.pi","mathlib","instance"],["MeasureTheory.integral","mathlib","definition"],["Monoid.toNPow","mathlib","instance"],["NPow.toPow","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["NegZeroClass.toZero","mathlib","instance"],["Norm.norm","mathlib","definition"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.instNorm","mathlib","instance"],["ProbabilityTheory.multivariateGaussian","mathlib","definition"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommGroup","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instLE","mathlib","instance"],["Real.instMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instRing","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.norm","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.partialOrder","mathlib","instance"],["Real.pi","mathlib","definition"],["Real.sqrt","mathlib","definition"],["SubNegZeroMonoid.toNegZeroClass","mathlib","instance"],["SubtractionCommMonoid.toSubtractionMonoid","mathlib","instance"],["SubtractionMonoid.toSubNegZeroMonoid","mathlib","instance"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.measurableSpace","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHPow","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"],["instStarRingReal","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1572,"name":"ProbabilityTheory.integral_abs_gaussianReal","kind":"Lemma","keyword":"lemma","module":"Maiti2026Power.Mathlib.Probability.GaussianAbsMoment","package":"Maiti2026Power","isProp":true,"hashes":{"meaning":"944b1f7b20e2f694","local":"e1d9d22dbe5cc36e","content":"075128b3dfc9e3ab"},"doc":"`E|Z| = √(2 v / π)` for `Z ~ N(0, v)`. ","statement":{"binders":[{"explicit":true,"name":"v","role":"variable","type":"NNReal"}],"conclusion":"∫ (x : ℝ), |x| ∂gaussianReal 0 v = √(2 * ↑v / Real.pi)","decl":"ProbabilityTheory.integral_abs_gaussianReal"},"code":"/-- `E|Z| = √(2 v / π)` for `Z ~ N(0, v)`. -/\nlemma integral_abs_gaussianReal (v : ℝ≥0) : ∫ x, |x| ∂gaussianReal 0 v = √(2 * v / π)","proof":":= by\n  by_cases hv : v = 0\n  · subst hv\n    simp [gaussianReal_zero_var]\n  have hvpos : (0 : ℝ) < v := NNReal.coe_pos.2 (pos_iff_ne_zero.2 hv)\n  rw [integral_gaussianReal_eq_integral_smul hv]\n  have hfun : ∀ x : ℝ, gaussianPDFReal 0 v x • |x| =\n      (fun y ↦ (√(2 * π * v))⁻¹ * (y * rexp (-(2 * (v : ℝ))⁻¹ * y ^ 2))) |x| := by\n    intro x\n    simp only [gaussianPDFReal_def, sub_zero, smul_eq_mul, sq_abs]\n    rw [show -x ^ 2 / (2 * (v : ℝ)) = -(2 * (v : ℝ))⁻¹ * x ^ 2 by ring]\n    ring\n  simp_rw [hfun]\n  rw [integral_comp_abs (f := fun y ↦ (√(2 * π * v))⁻¹ * (y * rexp (-(2 * (v : ℝ))⁻¹ * y ^ 2))),\n    integral_const_mul, integral_Ioi_mul_exp_neg_mul_sq (by positivity)]\n  have h2v : (2 * (2 * (v : ℝ))⁻¹)⁻¹ = v := by field_simp\n  rw [h2v, eq_comm, Real.sqrt_eq_iff_mul_self_eq (by positivity) (by positivity)]\n  field_simp\n  exact Real.sq_sqrt (by positivity)","source":{"path":"Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean","start":50,"end":69,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Probability/GaussianAbsMoment.lean#L50-L69"},"deps":[],"outside":[],"external":[["DivInvMonoid.toDiv","mathlib","instance"],["Eq","lean4","inductive"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["MeasureTheory.integral","mathlib","definition"],["NNReal","mathlib","definition"],["NNReal.toReal","mathlib","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["ProbabilityTheory.gaussianReal","mathlib","definition"],["RCLike.toInnerProductSpaceReal","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddGroup","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instNatCast","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Real.instZero","mathlib","instance"],["Real.lattice","mathlib","instance"],["Real.measurableSpace","mathlib","instance"],["Real.normedAddCommGroup","mathlib","instance"],["Real.pi","mathlib","definition"],["Real.sqrt","mathlib","definition"],["Zero.toOfNat0","lean4","instance"],["abs","mathlib","definition"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instOfNatAtLeastTwo","mathlib","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}}]