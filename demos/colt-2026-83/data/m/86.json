Lin A) ((toEuclideanLin B) v)","decl":"Matrix.toEuclideanLin_mul_apply"},"code":"lemma toEuclideanLin_mul_apply {ι : Type*} [Fintype ι] [DecidableEq ι] (A B : Matrix ι ι ℝ)\n    (v : EuclideanSpace ℝ ι) :\n    Matrix.toEuclideanLin (A * B) v = Matrix.toEuclideanLin A (Matrix.toEuclideanLin B v)","proof":":= by\n  apply WithLp.ofLp_injective\n  change (A * B) *ᵥ WithLp.ofLp v = A *ᵥ (B *ᵥ WithLp.ofLp v)\n  rw [Matrix.mulVec_mulVec]","source":{"path":"Maiti2026Power/Mathlib/Analysis/InnerProductSpace/EuclideanMatrix.lean","start":29,"end":34,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/Mathlib/Analysis/InnerProductSpace/EuclideanMatrix.lean#L29-L34"},"deps":[],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddCommMonoid.toAddMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["Algebra.id","mathlib","instance"],["Algebra.to_smulCommClass","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["DFinsupp.instEquivLikeLinearEquiv","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["DenselyNormedField.toNormedField","mathlib","instance"],["DistribMulAction.toMulAction","mathlib","instance"],["DivisionRing.toRing","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EquivLike.toFunLike","mathlib","instance"],["EuclideanSpace","mathlib","definition"],["Field.toDivisionRing","mathlib","instance"],["Field.toSemifield","mathlib","instance"],["Fintype","mathlib","class"],["Function.smulCommClass","mathlib","instance"],["HMul.hMul","lean4","definition"],["LinearEquiv","mathlib","structure"],["LinearMap","mathlib","structure"],["LinearMap.addCommMonoid","mathlib","instance"],["LinearMap.instFunLike","mathlib","instance"],["LinearMap.module","mathlib","instance"],["Matrix","mathlib","definition"],["Matrix.addCommMonoid","mathlib","instance"],["Matrix.instHMulOfFintypeOfMulOfAddCommMonoid","mathlib","instance"],["Matrix.module","mathlib","instance"],["Matrix.toEuclideanLin","mathlib","definition"],["Module.toDistribMulAction","mathlib","instance"],["Monoid.toSemigroup","mathlib","instance"],["MulAction.toSemigroupAction","mathlib","instance"],["NormedField.toField","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Pi.Function.module","mathlib","instance"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["RCLike.toDenselyNormedField","mathlib","instance"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instRCLike","mathlib","instance"],["Ring.toAddCommGroup","mathlib","instance"],["Ring.toSemiring","mathlib","instance"],["RingHom.id","mathlib","definition"],["RingHomInvPair.ids","mathlib","instance"],["Semifield.toCommSemiring","mathlib","instance"],["SemigroupAction.toSMul","mathlib","instance"],["Semiring.toAddCommMonoid","mathlib","instance"],["Semiring.toModule","mathlib","instance"],["Semiring.toMonoid","mathlib","instance"],["Semiring.toNonAssocSemiring","mathlib","instance"],["SubNegMonoid.toAddMonoid","mathlib","instance"],["WithLp.instAddCommGroup","mathlib","instance"],["WithLp.instModule","mathlib","instance"],["WithLp.instSMulCommClass","mathlib","instance"],["instOfNatAtLeastTwo","mathlib","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[],"characterizations":[],"pulled":false,"provenance":null,"edited":{"commit":"1ec0b8efcde2f6b90d5a93948bd0b2d039f26428","date":"2026-09-07"}},{"id":1303,"name":"Matrix.span_image_toEuclideanCLM_eq_top","kind":"Lemma","key