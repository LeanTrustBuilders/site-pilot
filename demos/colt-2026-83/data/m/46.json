 _\n  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ i)]\n  have hzero : ∀ i' ∈ univ.erase i,\n      ((if i' ∈ B then Δ else 0) - if i' ∈ insert i B then Δ else 0) * y i' = 0 := by\n    intro i' hi'\n    have hne : i' ≠ i := (Finset.mem_erase.1 hi').1\n    simp [Finset.mem_insert, hne]\n  rw [Finset.sum_eq_zero hzero, zero_add, ite_eq_right hi,\n    ite_eq_left (Finset.mem_insert_self i B)]\n  ring","source":{"path":"Maiti2026Power/MXJ2026/MSetInstances.lean","start":78,"end":91,"url":"https://github.com/RemyDegenne/colt-2026-83/blob/3f6c0f296a3b7e4aa8fe333225505f5b2f61f9e0/Maiti2026Power/MXJ2026/MSetInstances.lean#L78-L91"},"deps":[725],"outside":[],"external":[["AddCommGroup.toAddGroup","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["DecidableEq","lean4","definition"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["Eq","lean4","inductive"],["EuclideanSpace","mathlib","definition"],["Finset","mathlib","structure"],["Finset.decidableMem","mathlib","instance"],["Finset.instInsert","mathlib","instance"],["Finset.instSetLike","mathlib","instance"],["Fintype","mathlib","class"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Inner.inner","mathlib","definition"],["InnerProductSpace.toInner","mathlib","instance"],["Insert.insert","lean4","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Nat.instAtLeastTwoHAddOfNat","mathlib","instance"],["Nat.instNeZeroSucc","lean4","instance"],["Neg.neg","lean4","definition"],["NormedAddCommGroup.toSeminormedAddCommGroup","mathlib","instance"],["Not","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Pi.addCommGroup","mathlib","instance"],["PiLp.innerProductSpace","mathlib","instance"],["PiLp.innerProductSpace._proof_1","mathlib","theorem"],["PiLp.seminormedAddCommGroup","mathlib","in