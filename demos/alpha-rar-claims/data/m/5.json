t":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"𝓐","role":"type","type":"Type u_2"},{"explicit":false,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐"},{"explicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass 𝓐"},{"explicit":false,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P"},{"explicit":false,"name":"A","role":"variable","type":"ℕ → Ω → 𝓐"},{"explicit":true,"name":"hA","role":"hypothesis","type":"∀ (n : ℕ), Measurable (A n)"},{"explicit":false,"name":"k","role":"variable","type":"𝓐"},{"explicit":false,"name":"𝔽","role":"variable","type":"MeasureTheory.Filtration ℕ mΩ"},{"explicit":false,"name":"n","role":"variable","type":"ℕ"},{"explicit":false,"name":"g","role":"variable","type":"Ω → ℝ"},{"explicit":true,"name":"hg","role":"hypothesis","type":"IsCondExp P (↑𝔽.shiftDown n) (Learning.actionIndicator A k n) g"}],"conclusion":"g =ᵐ[P] aRTSSelProb A k 𝔽 P n","decl":"AlphaRAR.IsCondExp.ae_eq_aRTSSelProb"},"code":"/-- **Nothing else does** — the uniqueness half: any `ℱ_{n-1}`-measurable function with the\nintegrals of `𝟙{A n = k}` agrees a.e. with `p_{n,k}`. -/\n@[characterization uniqueness]\nlemma IsCondExp.ae_eq_aRTSSelProb (hA : ∀ n, Measurable (A n)) {k : 𝓐} {𝔽 : Filtration ℕ mΩ}\n    {n : ℕ} {g : Ω → ℝ} (hg : IsCondExp P (𝔽.shiftDown n) (actionIndicator A k n) g) :\n    g =ᵐ[P] aRTSSelProb A k 𝔽 P n","proof":":=\n  hg.ae_eq_condExp (𝔽.shiftDown.le n) (integrable_actionIndicator P k (hA n))","source":{"path":"AlphaRAR/YDK2026/ARTSConsistency.lean","start":97,"end":103,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/ARTSConsistency.lean#L97-L103"},"deps":[14,22,394],"outside":[],"external":[["Bot.bot","mathlib","definition"],["BoundedOrder