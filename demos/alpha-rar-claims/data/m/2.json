[{"id":21,"name":"MeasureTheory.Filtration.shiftDown_zero","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.Filtration","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"9d9d201ca663057a","local":"c52bec10a48981c5","content":"5eecdb1ade3e3fb1"},"doc":"At time `0` there is no previous index, so the previous-index filtration is trivial. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m0","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Filtration","implicit":false,"name":"ℱ","role":"variable","type":"Filtration ℕ m0","typeRefs":[[0,10,"MeasureTheory.Filtration"],[11,12,"Nat"]]}],"conclusion":"↑ℱ.shiftDown 0 = ⊥","conclusionHead":"Eq","conclusionRefs":[[3,12,"MeasureTheory.Filtration.shiftDown"],[15,16,"Eq"],[17,18,"Bot.bot"]],"decl":"MeasureTheory.Filtration.shiftDown_zero"},"code":"/-- At time `0` there is no previous index, so the previous-index filtration is trivial. -/\n@[simp, specifies shiftDown \"fixes the base case, the one place where \\\"shift by one\\\" has to \\\nmake a choice: step `0` sees no history at all rather than the history at step `0`\"]\nlemma shiftDown_zero (ℱ : Filtration ℕ m0) : ℱ.shiftDown 0 = ⊥","proof":":= rfl","source":{"path":"AlphaRAR/Mathlib/Filtration.lean","start":43,"end":46,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/Filtration.lean#L43-L46"},"deps":[22],"outside":[],"external":[["Bot.bot","mathlib","definition"],["BoundedOrder.toOrderBot","mathlib","instance"],["CompleteLattice.toBoundedOrder","mathlib","instance"],["CompleteLattice.toLattice","mathlib","instance"],["Eq","lean4","inductive"],["Lattice.toSemilatticeSup","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.instCompleteLattice","mathlib","instance"],["M