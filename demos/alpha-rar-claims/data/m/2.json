s":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m0","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Filtration","implicit":false,"name":"ℱ","role":"variable","type":"Filtration ℕ m0","typeRefs":[[0,10,"MeasureTheory.Filtration"],[11,12,"Nat"]]}],"conclusion":"Filtration ℕ m0","conclusionHead":"MeasureTheory.Filtration","conclusionRefs":[[0,10,"MeasureTheory.Filtration"],[11,12,"Nat"]],"decl":"MeasureTheory.Filtration.shiftDown","value":"{\n  seq := fun n =>\n    match n with\n    | 0 => ⊥\n    | m.succ => ↑ℱ m,\n  mono' := ⋯, le' := ⋯ }","valueRefs":[[48,49,"Bot.bot"],[58,62,"Nat.succ"]]},"code":"/-- **Previous-index filtration**: `(ℱ.shiftDown) n = ℱ (n-1)`, with `(ℱ.shiftDown) 0 = ⊥`\n(the trivial σ-algebra). Applied to a history filtration it is the \"history strictly before\nstep `n`\". -/\ndef shiftDown (ℱ : Filtration ℕ m0) : Filtration ℕ m0 where\n  seq n := match n with\n    | 0 => ⊥\n    | m + 1 => ℱ m\n  mono' := monotone_nat_of_le_succ fun n ↦ by\n    cases n with\n    | zero => exact bot_le\n    | succ m => exact ℱ.mono (Nat.le_succ m)\n  le' n := by\n    cases n with\n    | zero => exact bot_le\n    | succ m => exact ℱ.le m","proof":"","source":{"path":"AlphaRAR/Mathlib/Filtration.lean","start":27,"end":41,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/Filtration.lean#L27-L41"},"deps":[],"outside":[],"external":[["Bot.bot","mathlib","definition"],["BoundedOrder.toOrderBot","mathlib","instance"],["CompleteLattice.toBoundedOrder","mathlib","instance"],["CompleteLattice.toLattice","mathlib","instance"],["Lattice.toSemilatticeSup","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.instCompleteLattice","mathlib","instance"],["MeasureTheory.Filtration","mathlib","structure"],["MeasureTheory.Filtration.mk","mathlib","constructor"],["MeasureTheory.Filtration.seq","mathlib","definition"],["Nat","lean4","inductive"],["Nat.casesOn","lean4","definition"],["Nat.instPreorder","mathlib","instance"],["Nat.succ","lean4","constructor"],["OfNat.ofNat","lean4","definition"],["OrderBot.toBot","mathlib","instance"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLE","mathlib","instance"],["SemilatticeSup.toPartialOrder","mathlib","instance"],["Unit","lean4","definition"],["Unit.unit","lean4","definition"],["instOfNatNat","lean4","instance"]],"users":[21,23,394,399,400],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[{"decl":"MeasureTheory.Filtration.shiftDown_zero","comment":"fixes the base case, the one place where \"shift by one\" has to make a choice: step `0` sees no history at all rather than the history at step `0`","kind":"specifies"},{"decl":"MeasureTheory.Filtration.shiftDown_succ","comment":"the shift itself, which together with `shiftDown_zero` determines every value of the filtration","kind":"specifies"}],"characterizations":[],"pulled":false,"directExternal":["Bot.bot","BoundedOrder.toOrderBot","CompleteLattice.toBoundedOrder","CompleteLattice.toLattice","Lattice.toSemilatticeSup","MeasurableSpace","MeasurableSpace.instCompleteLattice","MeasureTheory.Filtration","MeasureTheory.Filtration.mk","MeasureTheory.Filtration.seq","Nat","Nat.casesOn","Nat.instPreorder","Nat.succ","OfNat.ofNat","OrderBot.toBot","PartialOrder.toPreorder","Preorder.toLE","SemilatticeSup.toPartialOrder","Unit","Unit.unit","instOfNatNat"],"provenance":null,"edited":{"commit":"9c97c6b035ac350efe572511d115065fe2785be5","date":"2026-09-01"}},{"id":23,"name":"MeasureTheory.Filtration.shiftDown_succ","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.Filtration","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"dc960c2284529bf5","local":"5d26cfffd87626df","content":"69391b2f23640130"},"doc":"Away from `0` the previous-index filtration is the shift: `(ℱ.shiftDown) (n+1) = ℱ n`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m0","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":true,"head":"MeasureTheory.Filtration","implicit":false,"name":"ℱ","role":"variable","type":"Filtration ℕ m0","typeRefs":[[0,10,"MeasureTheory.Filtration"],[11,12,"Nat"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"↑ℱ.shiftDown (n + 1) = ↑ℱ n","conclusionHead":"Eq","conclusionRefs":[[3,12,"MeasureTheory.Filtration.shiftDown"],[16,17,"HAdd.hAdd"],[21,22,"Eq"]],"decl":"MeasureTheory.Filtration.shiftDown_succ"},"code":"/-- Away from `0` the previous-index filtration is the shift: `(ℱ.shiftDown) (n+1) = ℱ n`. -/\n@[simp, specifies shiftDown \"the shift itself, which together with `shiftDown_zero` determines \\\nevery value of the filtration\"]\nlemma shiftDown_succ (ℱ : Filtration ℕ m0) (n : ℕ) : ℱ.shiftDown (n + 1) = ℱ n","proof":":= rfl","source":{"path":"AlphaRAR/Mathlib/Filtration.lean","start":48,"end":51,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/Filtration.lean#L48-L51"},"deps":[22],"outside":[],"external":[["Bot.bot","mathlib","definition"],["BoundedOrder.toOrderBot","mathlib","instance"],["CompleteLattice.toBoundedOrder","mathlib","instance"],["CompleteLattice.toLattice","mathlib","instance"],["Eq","lean4","inductive"],["HAdd.hAdd","lean4","definition"],["Lattice.toSemilatticeSup","mathlib","instance"],["MeasurableSpace","mathlib","class"],["MeasurableSpace.instCompleteLattice","mathlib","instance"],["MeasureTheory.Filtration","mathlib","structure"],["MeasureTheory.Filtration.mk","mathlib","constructor"],["MeasureTheory.Filtration.seq","mathlib","definition"],["Nat","lean4","inductive"],["Nat.casesOn","lean4","definition"],["Nat.instPreorder","mathlib","instance"],["Nat.succ","lean4","constructor"],["OfNat.ofNat","lean4","definition"],["OrderBot.toBot","mathlib","instance"],["PartialOrder.toPreorder","mathlib","instance"],["Preorder.toLE","mathlib","instance"],["SemilatticeSup.toPartialOrder","mathlib","instance"],["Unit","lean4","definition"],["Unit.unit","lean4","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"the shift itself, which together with `shiftDown_zero` determines every value of the filtration","target":"MeasureTheory.Filtration.shiftDown"}],"specifiedBy":[],"characterizations":[],"pulled":true,"directExternal":["Eq","HAdd.hAdd","MeasurableSpace","MeasureTheory.Filtration","MeasureTheory.Filtration.seq","Nat","Nat.instPreorder","OfNat.ofNat","instAddNat","instHAdd","instOfNatNat"],"provenance":null,"edited":{"commit":"9c97c6b035ac350efe572511d115065fe2785be5","date":"2026-09-01"}}]