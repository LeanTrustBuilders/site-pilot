q O A Y alg (Learning.stationaryEnv ν) P","typeRefs":[[0,20,"Learning.IsAlgEnvSeq"],[32,54,"Learning.stationaryEnv"]]},{"explicit":true,"implicit":false,"name":"hνk","role":"hypothesis","type":"∀ (a : 𝓐), MeasureTheory.MemLp id 2 (ν a)","typeRefs":[[11,30,"MeasureTheory.MemLp"],[31,33,"id"]]},{"explicit":true,"implicit":false,"name":"θ₀","role":"variable","type":"𝓐 → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"T","role":"variable","type":"(𝓐 → ℝ) → 𝓐 → ℝ","typeRefs":[[5,6,"Real"],[14,15,"Real"]]},{"explicit":true,"implicit":false,"name":"hTnn","role":"hypothesis","type":"∀ (z : 𝓐 → ℝ) (k : 𝓐), 0 ≤ T z k","typeRefs":[[11,12,"Real"],[25,26,"LE.le"]]},{"explicit":true,"implicit":false,"name":"hTsum","role":"hypothesis","type":"∀ (z : 𝓐 → ℝ), ∑ k, T z k = 1","typeRefs":[[11,12,"Real"],[26,27,"Eq"]]},{"explicit":true,"head":"Real","implicit":false,"name":"α","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hα","role":"hypothesis","type":"α ∈ Set.Icc 0 1","typeRefs":[[2,3,"Membership.mem"],[4,11,"Set.Icc"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hα1","role":"hypothesis","type":"α < 1","typeRefs":[[2,3,"LT.lt"]]},{"explicit":true,"head":"AlphaRAR.IsARTS","implicit":false,"name":"hARTS","role":"hypothesis","type":"IsARTS alg θ₀ T α","typeRefs":[[0,6,"AlphaRAR.IsARTS"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"K","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":true,"head":"LipschitzWith","implicit":false,"name":"hlip","role":"hypothesis","type":"LipschitzWith K T","typeRefs":[[0,13,"LipschitzWith"]]},{"explicit":true,"implicit":false,"name":"hTpos","role":"hypothesis","type":"∀ (z : 𝓐 → ℝ), (∀ (k : 𝓐), z k ∈ attainableSet A Y (θ₀ k) k) → ∀ (k : 𝓐), 0 < T z k","typeRefs":[[11,12,"Real"],[31,32,"Membership.mem"],[33,46,"AlphaRAR.attainableSet"],[76,77,"LT.lt"]]},{"explicit":true,"head":"Matrix","implicit":false,"name":"G","role":"variable","type":"Matrix 𝓐 𝓐 ℝ","typeRefs":[[0,6,"Matrix"],[11,12,"Real"]]},{"explicit":true,"head":"HasFDerivAt","implicit":false,"name":"hTderiv","role":"hypothesis","type":"HasFDerivAt (fun x => WithLp.toLp 2 (T x.ofLp)) (Matrix.toEuclideanCLM G) (WithLp.toLp 2 ν.means)","typeRefs":[[0,11,"HasFDerivAt"],[22,33,"WithLp.toLp"],[41,45,"WithLp.ofLp"],[49,70,"Matrix.toEuclideanCLM"],[75,86,"WithLp.toLp"],[91,96,"ProbabilityTheory.Kernel.means"]]}],"conclusion":"MeasureTheory.TendstoInDistribution (jointSqrtNVec ν A Y θ₀ T (T ν.means)) Filter.atTop id\n  (fun x => P)\n  (ProbabilityTheory.multivariateGaussian 0\n    (Matrix.fromBlocks\n      ((G * Matrix.diagonal fun a => ProbabilityTheory.variance id (ν a) / T ν.means a) *\n        G.transpose)\n      ((G * Matrix.diagonal fun a => ProbabilityTheory.variance id (ν a) / T ν.means a) *\n        G.transpose)\n      ((G * Matrix.diagonal fun a => ProbabilityTheory.variance id (ν a) / T ν.means a) *\n        G.transpose)\n      ((G * Matrix.diagonal fun a => ProbabilityTheory.variance id (ν a) / T ν.means a) *\n        G.transpose)))","conclusionHead":"MeasureTheory.TendstoInDistribution","conclusionRefs":[[0,35,"MeasureTheory.TendstoInDistribution"],[37,50,"AlphaRAR.jointSqrtNVec"],[67,72,"ProbabilityTheory.Kernel.means"],[75,87,"Filter.atTop"],[88,90,"id"],[109,147,"ProbabilityTheory.multivariateGaussian"],[155,172,"Matrix.fromBlocks"],[183,184,"HMul.hMul"],[185,200,"Matrix.diagonal"],[210,236,"ProbabilityTheory.variance"],[237,239,"id"],[246,247,"HDiv.hDiv"],[252,257,"ProbabilityTheory.Kernel.means"],[261,262,"HMul.hMul"],[273,282,"Matrix.transpose"],[294,295,"HMul.hMul"],[296,311,"Matrix.diagonal"],[321,347,"ProbabilityTheory.variance"],[348,350,"id"],[357,358,"HDiv.hDiv"],[363,368,"ProbabilityTheory.Kernel.means"],[372,373,"HMul.hMul"],[384,393,"Matrix.transpose"],[405,406,"HMul.hMul"],[407,422,"Matrix.diagonal"],[432,458,"ProbabilityTheory.variance"],[459,461,"id"],[468,469,"HDiv.hDiv"],[474,479,"ProbabilityTheory.Kernel.means"],[483,484,"HMul.hMul"],[495,504,"Matrix.transpose"],[516,517,"HMul.hMul"],[518,533,"Matrix.diagonal"],[543,569,"ProbabilityTheory.variance"],[570,572,"id"],[579,580,"HDiv.hDiv"],[585,590,"ProbabilityTheory.Kernel.means"],[594,595,"HMul.hMul"],[606,615,"Matrix.transpose"]],"decl":"AlphaRAR.aRTS_clt_joint"},"code":"/-- **Joint central limit theorem for the aRTS design**, equation (9) of Theorem 4.2 (ii) of the\npaper, fully self-contained. From the `aRTS` design bundle — an `IsAlgEnvSeq` sequence, Condition\n**A** (the kernel `L²` bound `hνk`), a simplex-valued target `T` that is `LipschitzWith K`\n(Condition **B**), the algorithm-level predicate `IsARTS`, `α ∈ [0,1)`, the non-sparsity `hTpos`,\nand the first-order differentiability of `T` at `θ` with Jacobian `G` (`hTderiv`) — the `√n`-scaled\njoint vector `(√n(N_n/n - v), √n(ρ̂_n - v))` converges weakly to the block-Gaussian `𝒩(0, Ω)`, with\nevery block equal to `G · diag(V_k / v_k) · Gᵀ` with `V_k = Var[id; ν k]`, and\n`v_k = T ν.means k`.\n\nThe `aRTS` instantiation of `clt_joint_of_hitting` at the last under-sampling time: the throttle is\n`throttle_of_isARTS` (from `IsARTS`), the consistency smallness is `aRTS_smallness_all`, and the\n`o_p`-smallness is `aRTS_smallness_op`, both automatic because `N_ℓ - ℓ ρ̂_ℓ ≤ 0` at that time\n(`preliminary_small`). -/\ntheorem aRTS_clt_joint [Fintype 𝓐] [DecidableEq 𝓐] [StandardBorelSpace 𝓐] [Nonempty 𝓐]\n    (h : IsAlgEnvSeq O A Y alg (stationaryEnv ν) P)\n    (hνk : ∀ a, MemLp id 2 (ν a)) (θ₀ : 𝓐 → ℝ) (T : (𝓐 → ℝ) → 𝓐 → ℝ)\n    (hTnn : ∀ z k, 0 ≤ T z k) (hTsum : ∀ z, ∑ k, T z k = 1)\n    (α : ℝ) (hα : α ∈ Set.Icc (0 : ℝ) 1) (hα1 : α < 1) (hARTS : IsARTS alg θ₀ T α)\n    {K : ℝ≥0} (hlip : LipschitzWith K T)\n    (hTpos : ∀ z : 𝓐 → ℝ, (∀ k, z k ∈ attainableSet A Y (θ₀ k) k) → ∀ k, 0 < T z k)\n    (G : Matrix 𝓐 𝓐 ℝ)\n    (hTderiv : HasFDerivAt\n      (fun x : EuclideanSpace ℝ 𝓐 ↦ (WithLp.toLp 2 (T (WithLp.ofLp x)) : EuclideanSpace ℝ 𝓐))\n      (Matrix.toEuclideanCLM (𝕜 := ℝ) G) (WithLp.toLp 2 ν.means)) :\n    TendstoInDistribution (jointSqrtNVec ν A Y θ₀ T (T ν.means)) atTop id (fun _ ↦ P)\n      (multivariateGaussian 0 (Matrix.fromBlocks\n        (G * Matrix.diagonal (fun a ↦ Var[id; ν a] / T ν.means a) * Gᵀ)\n        (G * Matrix.diagonal (fun a ↦ Var[id; ν a] / T ν.means a) * Gᵀ)\n        (G * Matrix.diagonal (fun a ↦ Var[id; ν a] / T ν.means a) * Gᵀ)\n        (G * Matrix.diagonal (fun a ↦ Var[id; ν a] / T ν.means a) * Gᵀ)))","proof":":=\n  clt_joint_of_hitting h hνk θ₀ T hTnn hTsum α hα hα1 hlip hTpos G hTderiv\n    (aRTSUnder A Y θ₀ T) (fun k m ↦ measurableSet_aRTSUnder h θ₀ hlip.continuous k m)\n    (fun k ↦ throttle_of_isARTS h hARTS k)\n    (aRTS_smallness_all θ₀ T) (aRTS_smallness_op θ₀ T)","source":{"path":"AlphaRAR/YDK2026/ARTSNormality.lean","start":172,"end":205,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/ARTSNormality.lean#L172-L205"},"deps":[5,385,624,748],"outside":[],"external":[["AddCommGroup.toAddCommMonoid","mathlib","instance"],["AddCommGroup.toAddGroup","mathlib","instance"],["AddCommGroup.toDivisionAddCommMonoid","mathlib","instance"],["AddCommMonoid","mathlib","class"],["AddCommMonoid.toAddMonoid","mathlib","instance"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddGroup.toSubNegMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["AddZero.toZero","mathlib","instance"],["AddZeroClass.toAddZero","mathlib","instance"],["Algebra.id","mathlib","instance"],["Algebra.to_smulCommClass","mathlib","instance"],["BorelSpace.opensMeasurable","mathlib","instance"],["CommRing.toNonUnitalCommRing","mathlib","instance"],["CommSemiring.toSemiring","mathlib","instance"],["ContinuousENorm.toENorm","mathlib","instance"],["ContinuousLinearMap","mathlib","structure"],["ContinuousLinearMap.add","mathlib","instance"],["ContinuousLinearMap.instM