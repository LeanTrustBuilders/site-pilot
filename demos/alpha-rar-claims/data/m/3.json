"],[13,14,"LT.lt"],[19,33,"Filter.Tendsto"],[49,50,"Set.ofPred"],[53,54,"LE.le"],[55,56,"abs"],[61,62,"abs"],[65,77,"Filter.atTop"],[79,83,"nhds"]]}],"conclusion":"IsLittleOpOne μ Y","conclusionHead":"AlphaRAR.IsLittleOpOne","conclusionRefs":[[0,13,"AlphaRAR.IsLittleOpOne"]],"decl":"AlphaRAR.isLittleOpOne_of_tendsto_abs"},"code":"/-- Build `o_p(1)` from the `|·|`-form: if `μ {ε ≤ |Y n|} → 0` for all real `ε > 0`,\nthen `Y = o_p(1)`. -/\n@[specifies IsLittleOpOne \"the converse of `IsLittleOpOne.tendsto_abs`; together the two make the \\\ntextbook `ℙ(|Y n| ≥ ε) → 0` an equivalent form, so the definition is neither stronger nor weaker \\\nthan convergence in probability\"]\nlemma isLittleOpOne_of_tendsto_abs {Y : ℕ → Ω → ℝ}\n    (h : ∀ ε : ℝ, 0 < ε → Tendsto (fun n ↦ μ {ω | ε ≤ |Y n ω|}) atTop (𝓝 0)) :\n    IsLittleOpOne μ Y","proof":":=\n  tendstoInMeasure_iff_norm.2 fun ε hε ↦ by simpa using h ε hε","source":{"path":"AlphaRAR/Mathlib/StochasticOrder.lean","start":115,"end":123,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/StochasticOrder.lean#L115-L123"},"deps":[356],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["EMetricSpace.toPseudoEMetricSpace","mathlib","instance"],["EMetricSpace.toWeakEMetricSpace","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instTopologicalSpace","mathlib","instance"],["ENNReal.instZero","mathlib","instance"],["Filter.Tendsto","mathlib","definition"],["Filter.atTop","mathlib","definition"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["MeasurableSpace","mathlib","class"],["MeasureTheory.Measure","mathlib","structure"],["MeasureTheory.Measure.instFunLike","mathlib","instance"],["MeasureTheory.TendstoInMeasure","mathlib","definition"],["MetricSpace.toEMetricSpace","mathlib","instance"],["Nat","lean4","inductive"],["Nat.instPreorder","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["Pi.instZero","mathlib","instanc