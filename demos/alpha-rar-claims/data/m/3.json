[{"id":334,"name":"AlphaRAR.IsLittleOpOne.tendsto_abs","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.Mathlib.StochasticOrder","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"0a5d4b21718ae8d6","local":"15d738838db3013c","content":"c7615f074a1d21df"},"doc":"The `|·|`-form of `o_p(1)`: `μ {ε ≤ |Y n|} → 0` for every real `ε > 0`. ","statement":{"binders":[{"explicit":false,"name":"Ω","role":"type","type":"Type u_1"},{"explicit":false,"name":"m0","role":"instance","type":"MeasurableSpace Ω"},{"explicit":false,"name":"μ","role":"variable","type":"MeasureTheory.Measure Ω"},{"explicit":false,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ"},{"explicit":true,"name":"hY","role":"hypothesis","type":"IsLittleOpOne μ Y"},{"explicit":false,"name":"ε","role":"variable","type":"ℝ"},{"explicit":true,"name":"hε","role":"hypothesis","type":"0 < ε"}],"conclusion":"Filter.Tendsto (fun n => μ {ω | ε ≤ |Y n ω|}) Filter.atTop (nhds 0)","decl":"AlphaRAR.IsLittleOpOne.tendsto_abs"},"code":"/-- The `|·|`-form of `o_p(1)`: `μ {ε ≤ |Y n|} → 0` for every real `ε > 0`. -/\n@[specifies IsLittleOpOne \"unwinds the `TendstoInMeasure`/`edist` packaging into the textbook \\\n`ℙ(|Y n| ≥ ε) → 0`, so a referee can read the definition off without chasing `ℝ≥0∞` coercions; \\\n`isLittleOpOne_of_tendsto_abs` is the converse\"]\nlemma IsLittleOpOne.tendsto_abs {Y : ℕ → Ω → ℝ} (hY : IsLittleOpOne μ Y) {ε : ℝ}\n    (hε : 0 < ε) : Tendsto (fun n ↦ μ {ω | ε ≤ |Y n ω|}) atTop (𝓝 0)","proof":":= by\n  simpa using tendstoInMeasure_iff_norm.1 hY ε hε","source":{"path":"AlphaRAR/Mathlib/StochasticOrder.lean","start":107,"end":113,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/Mathlib/StochasticOrder.lean#L107-L113"},"deps":[356],"outside":[],"external":[["DFunLike.coe","mathlib","definition"],["EMetricSpace.toPseudoEMetricSpace","mathlib","instance"],["EMetricSpace.toWeakEMetricSpace","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNRea