[{"id":469,"name":"AlphaRAR.count_zero","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Count","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"db2814b0b83b0e2d","local":"ed46e0fb48b5588b","content":"29947551e9166670"},"doc":"","statement":{"binders":[{"explicit":false,"implicit":true,"name":"M","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"AddCommMonoid","implicit":false,"name":"","role":"instance","type":"AddCommMonoid M","typeRefs":[[0,13,"AddCommMonoid"]]},{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → M","typeRefs":[[0,1,"Nat"]]}],"conclusion":"count X 0 = 0","conclusionHead":"Eq","conclusionRefs":[[0,5,"AlphaRAR.count"],[10,11,"Eq"]],"decl":"AlphaRAR.count_zero"},"code":"@[simp, specifies count \"fixes the base of the count; with `count_succ` it determines every value, \\\nand it records the 0-indexing convention: nothing has been counted before patient `0`\"]\nlemma count_zero {M : Type*} [AddCommMonoid M] (X : ℕ → M) : count X 0 = 0","proof":":= by\n  simp [count]","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":48,"end":51,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L48-L51"},"deps":[475],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["AddCommMonoid.toAddMonoid","mathlib","instance"],["AddMonoid.toAddZeroClass","mathlib","instance"],["AddZero.toZero","mathlib","instance"],["AddZeroClass.toAddZero","mathlib","instance"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["Zero.toOfNat0","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"fixes the base of the count; with `count_succ` it determines every value, and it records the 0-indexing convention: nothing has been counted before patient `0`","target":"AlphaRAR.count"}],"specifiedBy":[],"characterizations":[],"pulled":true,"directExternal":["AddCommMonoid","AddCommMonoid.toAddMonoid","AddMonoid.toAddZeroClass","AddZero.toZero","AddZeroClass.toAddZero","Eq","Nat","OfNat.ofNat","Zero.toOfNat0","instOfNatNat"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":473,"name":"AlphaRAR.count_succ","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Count","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"daacb7c5fbceba9a","local":"cf101066a00a1dd8","content":"e72faa67f4ac5e1e"},"doc":"Increment of the count: `N (n+1) = N n + X n`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"M","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"AddCommMonoid","implicit":false,"name":"","role":"instance","type":"AddCommMonoid M","typeRefs":[[0,13,"AddCommMonoid"]]},{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → M","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"count X (n + 1) = count X n + X n","conclusionHead":"Eq","conclusionRefs":[[0,5,"AlphaRAR.count"],[11,12,"HAdd.hAdd"],[16,17,"Eq"],[18,23,"AlphaRAR.count"],[28,29,"HAdd.hAdd"]],"decl":"AlphaRAR.count_succ"},"code":"/-- Increment of the count: `N (n+1) = N n + X n`. -/\n@[specifies count \"the step `n → n+1` adds patient `n`, so `count X n` covers patients \\\n`0, …, n-1` — the half-open convention every index computation in the development relies on\"]\nlemma count_succ {M : Type*} [AddCommMonoid M] (X : ℕ → M) (n : ℕ) :\n    count X (n + 1) = count X n + X n","proof":":= by\n  unfold count\n  rw [Finset.sum_range_succ]","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":53,"end":59,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L53-L59"},"deps":[475],"outside":[],"external":[["AddCommMagma.toAdd","mathlib","instance"],["AddCommMonoid","mathlib","class"],["AddCommMonoid.toAddCommSemigroup","mathlib","instance"],["AddCommSemigroup.toAddCommMagma","mathlib","instance"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["instAddNat","lean4","instance"],["instHAdd","lean4","instance"],["instOfNatNat","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"the step `n → n+1` adds patient `n`, so `count X n` covers patients `0, …, n-1` — the half-open convention every index computation in the development relies on","target":"AlphaRAR.count"}],"specifiedBy":[],"characterizations":[],"pulled":true,"directExternal":["AddCommMagma.toAdd","AddCommMonoid","AddCommMonoid.toAddCommSemigroup","AddCommSemigroup.toAddCommMagma","Eq","HAdd.hAdd","Nat","OfNat.ofNat","instAddNat","instHAdd","instOfNatNat"],"provenance":null,"edited":{"commit":"6af52f16df6126afeafe3ee85eb43a7c9dc0c535","date":"2026-09-12"}},{"id":475,"name":"AlphaRAR.count","kind":"Definition","keyword":"def","module":"AlphaRAR.YDK2026.Count","package":"AlphaRAR","isProp":false,"hashes":{"meaning":"7e4a93eeda1787ab","local":"0ced566996aedd26","content":"cf4f2029f970ae87"},"doc":"Allocation count of a fixed arm, `N n = ∑_{j<n} X j`, the count `N_{n,k}` of Section 2 of the\npaper. Stated for a general `AddCommMonoid` so it serves both the deterministic per-path counts\n(`X : ℕ → ℝ`) and the process-level count (`X : ℕ → Ω → ℝ`, the assignment count process of\n`Assignment.lean`). ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"M","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"head":"AddCommMonoid","implicit":false,"name":"","role":"instance","type":"AddCommMonoid M","typeRefs":[[0,13,"AddCommMonoid"]]},{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → M","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"M","conclusionRefs":[],"decl":"AlphaRAR.count","value":"∑ j ∈ Finset.range n, X j","valueRefs":[[6,18,"Finset.range"]]},"code":"/-- Allocation count of a fixed arm, `N n = ∑_{j<n} X j`, the count `N_{n,k}` of Section 2 of the\npaper. Stated for a general `AddCommMonoid` so it serves both the deterministic per-path counts\n(`X : ℕ → ℝ`) and the process-level count (`X : ℕ → Ω → ℝ`, the assignment count process of\n`Assignment.lean`). -/\ndef count {M : Type*} [AddCommMonoid M] (X : ℕ → M) (n : ℕ) : M := ∑ j ∈ range n, X j","proof":"","source":{"path":"AlphaRAR/YDK2026/Count.lean","start":42,"end":46,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Count.lean#L42-L46"},"deps":[],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["Nat","lean4","inductive"]],"users":[469,473,490,499,500,511,540,574,619,620],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[{"decl":"AlphaRAR.count_zero","comment":"fixes the base of the count; with `count_succ` it determines every value, and it records the 0-indexing convention: nothing has been counted before patient `0`","kind":"specifies"},{"decl":"AlphaRAR.count_succ","comment":"the step `n → n+1` adds patient `n`, so `count X n` covers patients `0, …, n-1` — the half-open convention every index computation in the development relies on","kind":"specifies"}],"characterizations":[],"pulled":false,"directExternal":["AddCommMonoid","Finset.range","Finset.sum","Nat"],"provenance":null,"edited":{"commit":"