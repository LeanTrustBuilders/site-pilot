tionIndicator"],[106,118,"Filter.atTop"],[120,124,"nhds"]]}],"conclusion":"L ∈ attainableSet A Y θ₀ k","conclusionHead":"Membership.mem","conclusionRefs":[[2,3,"Membership.mem"],[4,17,"AlphaRAR.attainableSet"]],"decl":"AlphaRAR.estimator_limit_mem_attainableSet"},"code":"/-- Any pointwise limit of the sequential estimator lies in the attainable set: it is a limit of\nestimator values, hence in the closure of their range. -/\n@[specifies attainableSet \"the only property Condition **B** needs, and the reason the definition \\\ntakes a *closure* of the range rather than the range itself: limits of estimator values must \\\nbelong to it, and they need not be attained at any finite time\"]\nlemma estimator_limit_mem_attainableSet (k : 𝓐) (θ₀ : ℝ) {ω : Ω} {L : ℝ}\n    (hL : Tendsto (fun n ↦ estimator (fun j ↦ actionIndicator A k j ω)\n      (Y · ω) θ₀ n) atTop (𝓝 L)) :\n    L ∈ attainableSet A Y θ₀ k","proof":":=\n  mem_closure_of_tendsto hL (Eventually.of_forall fun n ↦ ⟨(n, ω), rfl⟩)","source":{"path":"AlphaRAR/YDK2026/ResponseConsistency.lean","start":327,"end":336,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/ResponseConsistency.lean#L327-L336"},"deps":[500,748],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["DivInvMonoid.toDiv","mathlib","instance"],["Filter.Tendsto","mathlib","definition"],["Filter.atTop","mathlib","definition"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["Learning.actionIndicator","LeanMachineLearning","definition"],["Membership.mem","lean4","definition"],["Nat","lean4","inductive"],["Nat.instPreorder","mathlib","instance"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Prod","lean4","structure"],["Prod.fst","lean4","definition"],["Prod.snd","lean4","definition"],["PseudoMetricSpace.toUniformSpace","math