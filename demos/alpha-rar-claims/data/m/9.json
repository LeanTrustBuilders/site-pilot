[{"id":485,"name":"AlphaRAR.respMG","kind":"Definition","keyword":"def","module":"AlphaRAR.YDK2026.Deterministic","package":"AlphaRAR","isProp":false,"hashes":{"meaning":"d2e48d50f5edb204","local":"a6d5ea145cb7616d","content":"e02e022f40450ee3"},"doc":"Centered response martingale of a fixed arm,\n`Q n = ∑_{j<n} X j (ξ j - θ)`. ","statement":{"binders":[{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"ξ","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"ℝ","conclusionHead":"Real","conclusionRefs":[[0,1,"Real"]],"decl":"AlphaRAR.respMG","value":"∑ j ∈ Finset.range n, X j * (ξ j - θ)","valueRefs":[[6,18,"Finset.range"],[26,27,"HMul.hMul"],[33,34,"HSub.hSub"]]},"code":"/-- Centered response martingale of a fixed arm,\n`Q n = ∑_{j<n} X j (ξ j - θ)`. -/\ndef respMG (ξ : ℕ → ℝ) (θ : ℝ) (n : ℕ) : ℝ := ∑ j ∈ range n, X j * (ξ j - θ)","proof":"","source":{"path":"AlphaRAR/YDK2026/Deterministic.lean","start":451,"end":453,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Deterministic.lean#L451-L453"},"deps":[],"outside":[],"external":[["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Nat","lean4","inductive"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instSub","mathlib","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[490,499,511],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[{"decl":"AlphaRAR.theta_error_Q","comment":"what `Q` is for: divided by the count it is exactly the sample-mean error, so every rate proved for `Q` is a rate for the estimator","kind":"specifies"},{"decl":"AlphaRAR.respMG_eq","comment":"the centring is applied once per *pull*, not once per patient: `Q` subtracts `θ` times the count `N n`, not `θ n`","kind":"specifies"}],"characterizations":[],"pulled":false,"directExternal":["Finset.range","Finset.sum","HMul.hMul","HSub.hSub","Nat","Real","Real.instAddCommMonoid","Real.instMul","Real.instSub","instHMul","instHSub"],"provenance":null,"edited":{"commit":"9c97c6b035ac350efe572511d115065fe2785be5","date":"2026-09-01"}},{"id":490,"name":"AlphaRAR.theta_error_Q","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Deterministic","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"4d8f7a8131df9efd","local":"4568c9df0cb1de94","content":"3870f40e1cacddf7"},"doc":"**Estimator error via `Q`**.\n\nOn `{N n ≠ 0}`, the leading term of the estimator error equals `Q n / N n`:\n`(∑ X ξ) / N n - θ = Q n / N n`. ","statement":{"binders":[{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"ξ","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hN","role":"hypothesis","type":"count X n ≠ 0","typeRefs":[[0,5,"AlphaRAR.count"],[10,11,"Ne"]]}],"conclusion":"(∑ j ∈ Finset.range n, X j * ξ j) / count X n - θ = respMG X ξ θ n / count X n","conclusionHead":"Eq","conclusionRefs":[[7,19,"Finset.range"],[27,28,"HMul.hMul"],[34,35,"HDiv.hDiv"],[36,41,"AlphaRAR.count"],[46,47,"HSub.hSub"],[50,51,"Eq"],[52,58,"AlphaRAR.respMG"],[67,68,"HDiv.hDiv"],[69,74,"AlphaRAR.count"]],"decl":"AlphaRAR.theta_error_Q"},"code":"/-- **Estimator error via `Q`**.\n\nOn `{N n ≠ 0}`, the leading term of the estimator error equals `Q n / N n`:\n`(∑ X ξ) / N n - θ = Q n / N n`. -/\n@[specifies respMG \"what `Q` is for: divided by the count it is exactly the sample-mean error, so \\\nevery rate proved for `Q` is a rate for the estimator\"]\nlemma theta_error_Q (ξ : ℕ → ℝ) (θ : ℝ) (n : ℕ) (hN : count X n ≠ 0) :\n    (∑ j ∈ range n, X j * ξ j) / count X n - θ = respMG X ξ θ n / count X n","proof":":= by\n  rw [respMG_eq, sub_div, mul_div_assoc, div_self hN, mul_one]","source":{"path":"AlphaRAR/YDK2026/Deterministic.lean","start":466,"end":474,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Deterministic.lean#L466-L474"},"deps":[475,485],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["DivInvMonoid.toDiv","mathlib","instance"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Nat","lean4","inductive"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"what `Q` is for: divided by the count it is exactly the sample-mean error, so every rate proved for `Q` is a rate for the estimator","target":"AlphaRAR.respMG"}],"specifiedBy":[],"characterizations":[],"pulled":true,"directExternal":["DivInvMonoid.toDiv","Eq","Finset.range","Finset.sum","HDiv.hDiv","HMul.hMul","HSub.hSub","Nat","Ne","OfNat.ofNat","Real","Real.instAddCommMonoid","Real.instDivInvMonoid","Real.instMul","Real.instSub","Real.instZero","Zero.toOfNat0","instHDiv","instHMul","instHSub"],"provenance":null,"edited":{"commit":"9c97c6b035ac350efe572511d115065fe2785be5","date":"2026-09-01"}},{"id":499,"name":"AlphaRAR.respMG_eq","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Deterministic","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"5a863373c2b1fe84","local":"30beb4261f270717","content":"d67c1f483991db6b"},"doc":"`Q n = ∑ X ξ - θ N n`: the response martingale rewritten via the count. ","statement":{"binders":[{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"ξ","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"respMG X ξ θ n = ∑ j ∈ Finset.range n, X j * ξ j - θ * count X n","conclusionHead":"Eq","conclusionRefs":[[0,6,"AlphaRAR.respMG"],[15,16,"Eq"],[23,35,"Finset.range"],[43,44,"HMul.hMul"],[49,50,"HSub.hSub"],[53,54,"HMul.hMul"],[55,60,"AlphaRAR.count"]],"decl":"AlphaRAR.respMG_eq"},"code":"/-- `Q n = ∑ X ξ - θ N n`: the response martingale rewritten via the count. -/\n@[specifies respMG \"the centring is applied once per *pull*, not once per patient: `Q` subtracts \\\n`θ` times the count `N n`, not `θ n`\"]\nlemma respMG_eq (ξ : ℕ → ℝ) (θ : ℝ) (n : ℕ) :\n    respMG X ξ θ n = (∑ j ∈ range n, X j * ξ j) - θ * count X n","proof":":= by\n  unfold respMG count\n  rw [Finset.mul_sum, ← Finset.sum_sub_distrib]\n  apply Finset.sum_congr rfl\n  intro j _\n  ring","source":{"path":"AlphaRAR/YDK2026/Deterministic.lean","start":455,"end":464,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Deterministic.lean#L455-L464"},"deps":[475,485],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Nat","lean4","inductive"],["Real","mathlib","structure"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instSub","mathlib","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"the centring is applied once per *pull*, not once per patient: `Q` subtracts `θ` times the count `N n`, not `θ n`","target":"AlphaRAR.respMG"}],"specifiedBy":[],"characterizations":[],"pulled":true,"directExternal":["Eq","Finset.range","Finset.sum","HMul.hMul","HSub.hSub","Nat","Real","Real.instAddCommMonoid","Real.instMul","Real.instSub","instHMul","instHSub"],"provenance":null,"edited":{"commit":"9c97c6b035ac350efe572511d115065fe2785be5","date":"2026-09-01"}},{"id":500,"name":"AlphaRAR.estimator","kind":"Definition","keyword":"def","module":"AlphaRAR.YDK2026.Deterministic","package":"AlphaRAR","isProp":false,"hashes":{"meaning":"ba9f1792249b2d76","local":"5e768e18b7401551","content":"57f21bc7c0c2f1ac"},"doc":"Sequential estimator of a fixed arm, equation (1) of the paper:\n`θ̂ n = (∑_{j<n} X j ξ j + θ₀) / (N n + 1)`, with initial value `θ₀` and the `+1`\nregularization in the denominator. ","statement":{"binders":[{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"ξ","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ₀","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]}],"conclusion":"ℝ","conclusionHead":"Real","conclusionRefs":[[0,1,"Real"]],"decl":"AlphaRAR.estimator","value":"(∑ j ∈ Finset.range n, X j * ξ j + θ₀) / (count X n + 1)","valueRefs":[[7,19,"Finset.range"],[27,28,"HMul.hMul"],[33,34,"HAdd.hAdd"],[39,40,"HDiv.hDiv"],[42,47,"AlphaRAR.count"],[52,53,"HAdd.hAdd"]]},"code":"/-- Sequential estimator of a fixed arm, equation (1) of the paper:\n`θ̂ n = (∑_{j<n} X j ξ j + θ₀) / (N n + 1)`, with initial value `θ₀` and the `+1`\nregularization in the denominator. -/\nnoncomputable def estimator (ξ : ℕ → ℝ) (θ₀ : ℝ) (n : ℕ) : ℝ :=\n  ((∑ j ∈ range n, X j * ξ j) + θ₀) / (count X n + 1)","proof":"","source":{"path":"AlphaRAR/YDK2026/Deterministic.lean","start":476,"end":480,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Deterministic.lean#L476-L480"},"deps":[475],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["DivInvMonoid.toDiv","mathlib","instance"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["Nat","lean4","inductive"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instOne","mathlib","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"]],"users":[393,451,511,540,567,574,619,623,748,752],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[],"specifiedBy":[{"decl":"AlphaRAR.estimator_sub_eq","comment":"accounts exactly for the `+θ₀` / `+1` regularization: it contributes the single constant `θ₀ - θ` to the numerator and nothing else, so the regularized estimator has the same error expansion as the plain sample mean with no remainder term","kind":"specifies"}],"characterizations":[],"pulled":false,"directExternal":["DivInvMonoid.toDiv","Finset.range","Finset.sum","HAdd.hAdd","HDiv.hDiv","HMul.hMul","Nat","OfNat.ofNat","One.toOfNat1","Real","Real.instAdd","Real.instAddCommMonoid","Real.instDivInvMonoid","Real.instMul","Real.instOne","instHAdd","instHDiv","instHMul"],"provenance":null,"edited":{"commit":"9c97c6b035ac350efe572511d115065fe2785be5","date":"2026-09-01"}},{"id":511,"name":"AlphaRAR.estimator_sub_eq","kind":"Lemma","keyword":"lemma","module":"AlphaRAR.YDK2026.Deterministic","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"4811c6183eeb16f9","local":"9ce52175290f9513","content":"7f7ddb12499db33e"},"doc":"**Exact estimator error**, the exact form of the Bahadur representation.\n\nThe regularized estimator has the *exact* error decomposition\n`θ̂ n - θ = (Q n + (θ₀ - θ)) / (N n + 1)`, valid whenever `N n + 1 ≠ 0` (always, for\n`{0,1}`-valued assignment indicators). Since `Q n = O(√(n \\log n))` and the numerator offset\n`θ₀ - θ` is constant, this is the Bahadur representation of equation (2) of the paper,\n`θ̂ n = \\tfrac1{N n}∑ X ξ + o(N n^{-1/2})`, in sharp, remainder-free form. ","statement":{"binders":[{"explicit":true,"implicit":false,"name":"X","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"ξ","role":"variable","type":"ℕ → ℝ","typeRefs":[[0,1,"Nat"],[4,5,"Real"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Real","implicit":false,"name":"θ₀","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Nat","implicit":false,"name":"n","role":"variable","type":"ℕ","typeRefs":[[0,1,"Nat"]]},{"explicit":true,"head":"Ne","implicit":false,"name":"hN","role":"hypothesis","type":"count X n + 1 ≠ 0","typeRefs":[[0,5,"AlphaRAR.count"],[10,11,"HAdd.hAdd"],[14,15,"Ne"]]}],"conclusion":"estimator X ξ θ₀ n - θ = (respMG X ξ θ n + (θ₀ - θ)) / (count X n + 1)","conclusionHead":"Eq","conclusionRefs":[[0,9,"AlphaRAR.estimator"],[19,20,"HSub.hSub"],[23,24,"Eq"],[26,32,"AlphaRAR.respMG"],[41,42,"HAdd.hAdd"],[47,48,"HSub.hSub"],[53,54,"HDiv.hDiv"],[56,61,"AlphaRAR.count"],[66,67,"HAdd.hAdd"]],"decl":"AlphaRAR.estimator_sub_eq"},"code":"/-- **Exact estimator error**, the exact form of the Bahadur representation.\n\nThe regularized estimator has the *exact* error decomposition\n`θ̂ n - θ = (Q n + (θ₀ - θ)) / (N n + 1)`, valid whenever `N n + 1 ≠ 0` (always, for\n`{0,1}`-valued assignment indicators). Since `Q n = O(√(n \\log n))` and the numerator offset\n`θ₀ - θ` is constant, this is the Bahadur representation of equation (2) of the paper,\n`θ̂ n = \\tfrac1{N n}∑ X ξ + o(N n^{-1/2})`, in sharp, remainder-free form. -/\n@[specifies estimator \"accounts exactly for the `+θ₀` / `+1` regularization: it contributes the \\\nsingle constant `θ₀ - θ` to the numerator and nothing else, so the regularized estimator has the \\\nsame error expansion as the plain sample mean with no remainder term\"]\nlemma estimator_sub_eq (ξ : ℕ → ℝ) (θ θ₀ : ℝ) (n : ℕ) (hN : count X n + 1 ≠ 0) :\n    estimator X ξ θ₀ n - θ = (respMG X ξ θ n + (θ₀ - θ)) / (count X n + 1)","proof":":= by\n  rw [estimator, respMG_eq]\n  field_simp\n  ring","source":{"path":"AlphaRAR/YDK2026/Deterministic.lean","start":482,"end":496,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/Deterministic.lean#L482-L496"},"deps":[475,485,500],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["DivInvMonoid.toDiv","mathlib","instance"],["Eq","lean4","inductive"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["Nat","lean4","inductive"],["Ne","lean4","definition"],["OfNat.ofNat","lean4","definition"],["One.toOfNat1","lean4","instance"],["Real","mathlib","structure"],["Real.instAdd","mathlib","instance"],["Real.instAddCommMonoid","mathlib","instance"],["Real.instDivInvMonoid","mathlib","instance"],["Real.instMul","mathlib","instance"],["Real.instOne","mathlib","instance"],["Real.instSub","mathlib","instance"],["Real.instZero","mathlib","instance"],["Zero.toOfNat0","lean4","instance"],["instHAdd","lean4","instance"],["instHDiv","lean4","instance"],["instHMul","lean4","instance"],["instHSub","lean4","instance"]],"users":[],"sorry":false,"ownSorry":false,"sorryVia":[],"axioms":[],"change":null,"reviews":[],"claim":null,"specifies":[{"comment":"accounts exactly for the `+θ₀` / `+1` regularization: it contributes the single constant `θ₀ - θ` to the numerator and nothing else, so the regularized estimator has the same error expansion as the plain sample mean with no remainder term","target":"AlphaRAR.estimator"}],"specifiedBy":[],"characterizations":[],"pulled":true,"directExternal":["DivInvMonoid.toDiv","Eq","HAdd.hAdd","HDiv.hDiv","HSub.hSub","Nat","Ne","OfNat.ofNat","One.toOfNat1","Real","Real.instAdd","Real.instAddCommMonoid","Real.instDivInvMonoid","Real.instOne","Real.instSub","Real.instZero","Zero.toOfNat0","instHAdd","instHDiv","instHSub"],"provenance":null,"edited":{"commit":"9c97c6b035ac350efe572511d115065fe2785be5","date":"2026-09-01"}}]