[{"id":652,"name":"AlphaRAR.aRTS_prop_dev_ae","kind":"Theorem","keyword":"theorem","module":"AlphaRAR.YDK2026.PropDevLIL","package":"AlphaRAR","isProp":true,"hashes":{"meaning":"cfb43097c12b2f48","local":"45f12e1cc9f6213f","content":"61d5a884eded291d"},"doc":"**A.s. loglog deviation between proportions and plug-in target for the aRTS design**\n(Theorem 4.2 (i) of the paper, equation (6)). For every arm `k`, almost surely\n`N_{n,k} - n ρ̂_{n,k} = O(√(n log log n))`.\n\nThe `aRTS` instantiation of `prop_dev_ae_of_hitting`: the estimator consistency and loglog rate\ncome from the `aRTS_LLN` bundle, the throttle from `throttle_of_isARTS`, and the smallness is\nautomatic (`N_ℓ - ℓ ρ̂_ℓ ≤ 0`, `preliminary_small`). Condition **A** (`hνk`) and the Condition\n**B** differentiability `hT_diff` feed the loglog rate `aRTS_rho_rate`. ","statement":{"binders":[{"explicit":false,"implicit":true,"name":"Ω","role":"type","type":"Type u_1","typeRefs":[]},{"explicit":false,"implicit":true,"name":"𝓐","role":"type","type":"Type u_2","typeRefs":[]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"mΩ","role":"instance","type":"MeasurableSpace Ω","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSpace","implicit":true,"name":"m𝓐","role":"instance","type":"MeasurableSpace 𝓐","typeRefs":[[0,15,"MeasurableSpace"]]},{"explicit":false,"head":"MeasurableSingletonClass","implicit":false,"name":"","role":"instance","type":"MeasurableSingletonClass 𝓐","typeRefs":[[0,24,"MeasurableSingletonClass"]]},{"explicit":false,"head":"ProbabilityTheory.Kernel","implicit":true,"name":"ν","role":"variable","type":"ProbabilityTheory.Kernel 𝓐 ℝ","typeRefs":[[0,24,"ProbabilityTheory.Kernel"],[27,28,"Real"]]},{"explicit":false,"head":"ProbabilityTheory.IsMarkovKernel","implicit":false,"name":"","role":"instance","type":"ProbabilityTheory.IsMarkovKernel ν","typeRefs":[[0,32,"ProbabilityTheory.IsMarkovKernel"]]},{"explicit":false,"head":"MeasureTheory.Measure","implicit":true,"name":"P","role":"variable","type":"MeasureTheory.Measure Ω","typeRefs":[[0,21,"MeasureTheory.Measure"]]},{"explicit":false,"head":"MeasureTheory.IsProbabilityMeasure","implicit":false,"name":"","role":"instance","type":"MeasureTheory.IsProbabilityMeasure P","typeRefs":[[0,34,"MeasureTheory.IsProbabilityMeasure"]]},{"explicit":false,"implicit":true,"name":"O","role":"variable","type":"ℕ → Ω → Unit","typeRefs":[[0,1,"Nat"],[8,12,"Unit"]]},{"explicit":false,"implicit":true,"name":"A","role":"variable","type":"ℕ → Ω → 𝓐","typeRefs":[[0,1,"Nat"]]},{"explicit":false,"implicit":true,"name":"Y","role":"variable","type":"ℕ → Ω → ℝ","typeRefs":[[0,1,"Nat"],[8,9,"Real"]]},{"explicit":false,"head":"Learning.Algorithm","implicit":true,"name":"alg","role":"variable","type":"Learning.Algorithm Unit 𝓐 ℝ","typeRefs":[[0,18,"Learning.Algorithm"],[19,23,"Unit"],[26,27,"Real"]]},{"explicit":false,"head":"Fintype","implicit":false,"name":"","role":"instance","type":"Fintype 𝓐","typeRefs":[[0,7,"Fintype"]]},{"explicit":false,"head":"DecidableEq","implicit":false,"name":"","role":"instance","type":"DecidableEq 𝓐","typeRefs":[[0,11,"DecidableEq"]]},{"explicit":false,"head":"StandardBorelSpace","implicit":false,"name":"","role":"instance","type":"StandardBorelSpace 𝓐","typeRefs":[[0,18,"StandardBorelSpace"]]},{"explicit":false,"head":"Nonempty","implicit":false,"name":"","role":"instance","type":"Nonempty 𝓐","typeRefs":[[0,8,"Nonempty"]]},{"explicit":true,"head":"Learning.IsAlgEnvSeq","implicit":false,"name":"h","role":"hypothesis","type":"Learning.IsAlgEnvSeq O A Y alg (Learning.stationaryEnv ν) P","typeRefs":[[0,20,"Learning.IsAlgEnvSeq"],[32,54,"Learning.stationaryEnv"]]},{"explicit":true,"implicit":false,"name":"hνk","role":"hypothesis","type":"∀ (a : 𝓐), MeasureTheory.MemLp id 2 (ν a)","typeRefs":[[11,30,"MeasureTheory.MemLp"],[31,33,"id"]]},{"explicit":true,"implicit":false,"name":"θ₀","role":"variable","type":"𝓐 → ℝ","typeRefs":[[4,5,"Real"]]},{"explicit":true,"implicit":false,"name":"T","role":"variable","type":"(𝓐 → ℝ) → 𝓐 → ℝ","typeRefs":[[5,6,"Real"],[14,15,"Real"]]},{"explicit":true,"implicit":false,"name":"hTnn","role":"hypothesis","type":"∀ (z : 𝓐 → ℝ) (k : 𝓐), 0 ≤ T z k","typeRefs":[[11,12,"Real"],[25,26,"LE.le"]]},{"explicit":true,"implicit":false,"name":"hTsum","role":"hypothesis","type":"∀ (z : 𝓐 → ℝ), ∑ k, T z k = 1","typeRefs":[[11,12,"Real"],[26,27,"Eq"]]},{"explicit":true,"head":"Real","implicit":false,"name":"α","role":"variable","type":"ℝ","typeRefs":[[0,1,"Real"]]},{"explicit":true,"head":"Membership.mem","implicit":false,"name":"hα","role":"hypothesis","type":"α ∈ Set.Icc 0 1","typeRefs":[[2,3,"Membership.mem"],[4,11,"Set.Icc"]]},{"explicit":true,"head":"LT.lt","implicit":false,"name":"hα1","role":"hypothesis","type":"α < 1","typeRefs":[[2,3,"LT.lt"]]},{"explicit":true,"head":"AlphaRAR.IsARTS","implicit":false,"name":"hARTS","role":"hypothesis","type":"IsARTS alg θ₀ T α","typeRefs":[[0,6,"AlphaRAR.IsARTS"]]},{"explicit":false,"head":"NNReal","implicit":true,"name":"K","role":"variable","type":"NNReal","typeRefs":[[0,6,"NNReal"]]},{"explicit":true,"head":"LipschitzWith","implicit":false,"name":"hlip","role":"hypothesis","type":"LipschitzWith K T","typeRefs":[[0,13,"LipschitzWith"]]},{"explicit":true,"implicit":false,"name":"hTpos","role":"hypothesis","type":"∀ (z : 𝓐 → ℝ), (∀ (k : 𝓐), z k ∈ attainableSet A Y (θ₀ k) k) → ∀ (k : 𝓐), 0 < T z k","typeRefs":[[11,12,"Real"],[31,32,"Membership.mem"],[33,46,"AlphaRAR.attainableSet"],[76,77,"LT.lt"]]},{"explicit":true,"head":"DifferentiableAt","implicit":false,"name":"hT_diff","role":"hypothesis","type":"DifferentiableAt ℝ T ν.means","typeRefs":[[0,16,"DifferentiableAt"],[17,18,"Real"],[23,28,"ProbabilityTheory.Kernel.means"]]},{"explicit":true,"implicit":false,"name":"k","role":"variable","type":"𝓐","typeRefs":[]}],"conclusion":"∀ᵐ (ω : Ω) ∂P,\n  (fun n => ↑(Learning.pullCount A k n ω) - ↑n * aRTSTarget A Y θ₀ T n ω k) =O[Filter.atTop]\n    fun n => √(↑n * Real.log (Real.log ↑n))","conclusionHead":"Filter.Eventually","conclusionRefs":[[0,2,"Filter.Eventually"],[11,12,"Filter.Eventually"],[29,47,"Learning.pullCount"],[57,58,"HSub.hSub"],[62,63,"HMul.hMul"],[64,74,"AlphaRAR.aRTSTarget"],[91,94,"Asymptotics.IsBigO"],[94,106,"Filter.atTop"],[121,122,"Real.sqrt"],[126,127,"HMul.hMul"],[128,136,"Real.log"],[138,146,"Real.log"]],"decl":"AlphaRAR.aRTS_prop_dev_ae"},"code":"/-- **A.s. loglog deviation between proportions and plug-in target for the aRTS design**\n(Theorem 4.2 (i) of the paper, equation (6)). For every arm `k`, almost surely\n`N_{n,k} - n ρ̂_{n,k} = O(√(n log log n))`.\n\nThe `aRTS` instantiation of `prop_dev_ae_of_hitting`: the estimator consistency and loglog rate\ncome from the `aRTS_LLN` bundle, the throttle from `throttle_of_isARTS`, and the smallness is\nautomatic (`N_ℓ - ℓ ρ̂_ℓ ≤ 0`, `preliminary_small`). Condition **A** (`hνk`) and the Condition\n**B** differentiability `hT_diff` feed the loglog rate `aRTS_rho_rate`. -/\ntheorem aRTS_prop_dev_ae [Fintype 𝓐] [DecidableEq 𝓐] [StandardBorelSpace 𝓐] [Nonempty 𝓐]\n    (h : IsAlgEnvSeq O A Y alg (stationaryEnv ν) P) (hνk : ∀ a, MemLp id 2 (ν a))\n    (θ₀ : 𝓐 → ℝ) (T : (𝓐 → ℝ) → 𝓐 → ℝ)\n    (hTnn : ∀ z k, 0 ≤ T z k) (hTsum : ∀ z, ∑ k, T z k = 1)\n    (α : ℝ) (hα : α ∈ Set.Icc (0 : ℝ) 1) (hα1 : α < 1) (hARTS : IsARTS alg θ₀ T α)\n    {K : ℝ≥0} (hlip : LipschitzWith K T)\n    (hTpos : ∀ z : 𝓐 → ℝ, (∀ k, z k ∈ attainableSet A Y (θ₀ k) k) → ∀ k, 0 < T z k)\n    (hT_diff : DifferentiableAt ℝ T ν.means) (k : 𝓐) :\n    ∀ᵐ ω ∂P, (fun n ↦ (pullCount A k n ω : ℝ) - (n : ℝ) * aRTSTarget A Y θ₀ T n ω k)\n      =O[atTop] fun n ↦ √(n * log (log n))","proof":":=\n  prop_dev_ae_of_hitting h θ₀ T hlip.continuous hTnn hTsum α hα hα1 hTpos\n    (aRTS_theta_consistent h hνk hlip.continuous hTnn hTsum hα hARTS hTpos)\n    (aRTSUnder A Y θ₀ T) (fun k ↦ throttle_of_isARTS h hARTS k)\n    (fun k' ↦ aRTS_rho_rate h hνk hlip.continuous hTnn hTsum hα hARTS hTpos hT_diff k')\n    (fun k' ↦ Eventually.of_forall fun ω ↦ ⟨0, Eventually.of_forall fun n ↦ by\n      rw [zero_mul, ← count_indicator_eq_pullCount]\n      exact preliminary_small (fun j ↦ actionIndicator A k' j ω)\n        (fun m ↦ aRTSTarget A Y θ₀ T m ω k') (aRTSUnder A Y θ₀ T k' ω) n\n        (fun m hm ↦ by rwa [count_indicator_eq_pullCount])⟩) k","source":{"path":"AlphaRAR/YDK2026/PropDevLIL.lean","start":426,"end":452,"url":"https://github.com/RemyDegenne/alpha-rar/blob/e7164a80baea3f4f65e108de31d2d561dd35e350/AlphaRAR/YDK2026/PropDevLIL.lean#L426-L452"},"deps":[5,385,393,748],"outside":[],"external":[["AddCommMonoid","mathlib","class"],["AddCommMonoidWithOne.toAddMonoidWithOne","mathlib","instance"],["AddMonoidWithOne.toNatCast","mathlib","instance"],["Asymptotics.IsBigO","mathlib","definition"],["CommSemiring.toSemiring","mathlib","instance"],["ContinuousENorm.toENorm","mathlib","instance"],["DFunLike.coe","mathlib","definition"],["DecidableEq","lean4","definition"],["DenselyNormedField.toNontriviallyNormedField","mathlib","instance"],["DifferentiableAt","mathlib","definition"],["DivInvMonoid.toDiv","mathlib","instance"],["EMetricSpace.toPseudoEMetricSpace","mathlib","instance"],["ENNReal","mathlib","definition"],["ENNReal.instAddCommMonoidWithOne","mathlib","instance"],["ENNReal.toReal","mathlib","definition"],["Eq","lean4","inductive"],["Field.toSemifield","mathlib","instance"],["Filter.Eventually","mathlib","definition"],["Filter.atTop","mathlib","definition"],["Fin","lean4","structure"],["Finset.range","mathlib","definition"],["Finset.sum","mathlib","definition"],["Finset.univ","mathlib","definition"],["Fintype","mathlib","class"],["HAdd.hAdd","lean4","definition"],["HDiv.hDiv","lean4","definition"],["HMul.hMul","lean4","definition"],["HSub.hSub","lean4","definition"],["InnerProductSpace.toNormedSpace","mathlib","instance"],["LE.le","lean4","definition"],["LT.lt","lean4","definition"],["Learning.Algorithm","LeanMachineLearning","structure"],["Learning.Algorithm.policy","LeanMachineLearning","definition"],[